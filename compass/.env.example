# Compass configuration. Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------
# true = nothing ever leaves the server: emails are simulated, sources read fixtures.
DEMO_MODE=true
# libSQL URL. Local file for development, Turso URL in production (libsql://...).
DATABASE_URL=file:data/local/compass.db
# Only for Turso:
DATABASE_AUTH_TOKEN=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
# Shared secret for scheduled-job HTTP endpoints (/api/cron/*). Sent as "Authorization: Bearer <value>".
CRON_SECRET=change-me-too
# Public URL of the app, used for links in the daily email.
APP_URL=http://localhost:3000

# --- First accounts (used once by `npm run db:seed` when the DB is empty) ---
# The first person's account ("Entra") and your admin account. Change the passwords after first
# login. More people: Admin > Persone (create directly, or send an invitation link).
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-compass
# Optional: name and track of the first person (lavoro = jobs, stage = internships for students).
SEED_USER_NAME=
SEED_USER_TRACK=lavoro
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-compass

# --- Dedicated Gmail mailboxes (IMAP + SMTP with an app password) ------
# Needs 2-Step Verification on the dedicated account, then Google Account > Security > App passwords.
# "Collega Gmail" (each person connects their own Gmail, read-only, in one click): the OAuth client
# of a Google Cloud project (docs/setup.md, section 2). Empty = only forwarding is offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MAILBOX_USER/MAILBOX_APP_PASSWORD is the mailbox called "default".
MAILBOX_USER=
MAILBOX_APP_PASSWORD=
MAILBOX_IMAP_HOST=imap.gmail.com
MAILBOX_SMTP_HOST=smtp.gmail.com
# One more mailbox per person who sends from their own address: MAILBOX_<KEY>_USER and
# MAILBOX_<KEY>_APP_PASSWORD, then pick the key for that person in Admin > Persone. Example:
# MAILBOX_STUDENTE_USER=
# MAILBOX_STUDENTE_APP_PASSWORD=
# The morning e-mail goes to each person's "e-mail per il riepilogo" (Admin > Persone),
# or to the address they sign in with.
# Your inbox: you get an e-mail when a source breaks (parser finds nothing, blocked, wrong password).
ADMIN_ALERT_EMAIL=

# --- Honest User-Agent contact for web requests (W2, ATS, APIs) --------
CONTACT_EMAIL=
# Privacy notice (/privacy): who runs this Compass, e.g. "Nome Cognome". Leave empty in demo.
PRIVACY_OWNER=

# --- Job APIs (free tiers) --------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- W1 search discovery ----------------------------------------------
TAVILY_API_KEY=
