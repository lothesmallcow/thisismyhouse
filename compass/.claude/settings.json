{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx drizzle-kit *)",
      "Bash(npx prisma *)",
      "Bash(npx next *)",
      "Bash(node *)",
      "Bash(git init)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(chmod +x *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "env": {
    "GOAL_MAX_CONTINUATIONS": "50"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/skills/goal/scripts/stop-gate.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
