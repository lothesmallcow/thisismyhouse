# Copy to .env on the VPS (chmod 600). Never commit .env.
EDGELAB_DATA_DIR=/home/edgelab/data
# SEC requires "Name email" in the User-Agent
EDGELAB_SEC_UA="Your Name your.email@example.com"
# Alpaca PAPER keys (dashboard -> paper account -> API keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ntfy: pick a long random topic, e.g. output of: python3 -c "import secrets;print('edgelab-'+secrets.token_hex(12))"
EDGELAB_NTFY_TOPIC=
# healthchecks.io ping URL for the 'edgelab-health' check (period 15 min, grace 30 min)
EDGELAB_HC_URL=
# git remote used to publish reports/exports (SSH, deploy key with write access)
EDGELAB_PUBLISH=1
