---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { whatsappHref } from "../lib/util";
---
<div class="sb" data-sticky>
  <a href="/anteprima-gratuita" class="btn btn--primary sb__cta">Anteprima gratuita</a>
  <a href={whatsappHref(`Ciao, ho visto il sito di ${site.brand} e vorrei l'anteprima gratuita per la mia attività.`)} target="_blank" rel="noopener" class="btn btn--secondary sb__wa" aria-label="WhatsApp">
    <Icon name="whatsapp" />
    <span>WhatsApp</span>
  </a>
</div>
<style>
  .sb {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem;
    /* Solid, not blurred: it lives on phones, where a backdrop blur over moving content stutters. */
    background: rgba(255, 255, 255, 0.97);
    border: 1px solid var(--filo);
    border-radius: var(--radius-ui);
    box-shadow: 0 10px 30px -12px rgba(11, 27, 63, 0.25);
    transform: translateY(calc(100% + 2rem));
    transition: transform 0.45s var(--ease-out);
  }
  :global(.sticky-on) .sb {
    transform: none;
  }
  .sb .btn {
    --h: 48px;
    white-space: nowrap;
    font-size: 0.9375rem;
    padding: 0 1rem;
  }
  .sb__cta {
    flex: 1;
  }
  @media (min-width: 768px) {
    .sb {
      display: none;
    }
  }
  @media (max-width: 767px) {
    :global(body.has-sticky) {
      --sticky-h: calc(84px + env(safe-area-inset-bottom));
    }
  }
</style>
<script>
  /* Shows once the opening's button has scrolled away; hides again over the closing band, any form
     and the makeover's caption (the visitor is already where the bar would take them, or the
     makeover's own button sits right under it) and while typing (keyboard open). */
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  if (bar) {
    const root = document.documentElement;
    const hero = document.querySelector(".hero__cta, [data-hero]");
    const quiet = Array.from(document.querySelectorAll<HTMLElement>(".closing, .hs-end, form, .mk__cap"));
    let pastHero = false;
    const inQuiet = new Set<Element>();
    let typing = false;
    const update = () => {
      const on = pastHero && inQuiet.size === 0 && !typing;
      root.classList.toggle("sticky-on", on);
      bar.inert = !on;
    };
    update();
    if ("IntersectionObserver" in window) {
      if (hero) new IntersectionObserver(([e]) => ((pastHero = !e.isIntersecting && e.boundingClientRect.top < 0), update())).observe(hero);
      else pastHero = true;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? inQuiet.add(e.target) : inQuiet.delete(e.target)));
        update();
      });
      quiet.forEach((q) => io.observe(q));
    } else {
      const onScroll = () => ((pastHero = scrollY > 400), update());
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
    }
    document.addEventListener("focusin", (e) => {
      const t = e.target as HTMLElement;
      typing = t.matches("input:not([type=radio]):not([type=checkbox]), textarea, select");
      update();
    });
    document.addEventListener("focusout", () => ((typing = false), update()));
  }
</script>
