---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { whatsappHref } from "../lib/util";
---
<div class="sb" data-sticky>
  <a href="/anteprima-gratuita" class="btn btn--primary sb__cta">Anteprima gratuita</a>
  <a href={whatsappHref(`Ciao, ho visto il sito di ${site.brand} e vorrei l'anteprima gratuita per la mia attività.`)} target="_blank" rel="noopener" class="btn btn--secondary sb__wa" aria-label="WhatsApp">
    <Icon name="whatsapp" />
    <span>WhatsApp</span>
  </a>
</div>
<style>
  .sb {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem;
    background: rgba(255, 248, 242, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--filo);
    border-radius: var(--radius-ui);
    box-shadow: 0 10px 30px -12px rgba(60, 25, 8, 0.25);
    transform: translateY(calc(100% + 2rem));
    transition: transform 0.45s var(--ease-out);
  }
  :global(.sticky-on) .sb {
    transform: none;
  }
  .sb .btn {
    --h: 48px;
    white-space: nowrap;
    font-size: 0.9375rem;
    padding: 0 1rem;
  }
  .sb__cta {
    flex: 1;
  }
  @media (min-width: 768px) {
    .sb {
      display: none;
    }
  }
  @media (max-width: 767px) {
    :global(body.has-sticky) {
      --sticky-h: calc(84px + env(safe-area-inset-bottom));
    }
  }
</style>
<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  if (bar) {
    const root = document.documentElement;
    const hero = document.querySelector("[data-hero]");
    const setVisible = (on: boolean) => {
      root.classList.toggle("sticky-on", on);
      bar.inert = !on;
    };
    setVisible(false);
    if (hero && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => setVisible(!entry.isIntersecting && entry.boundingClientRect.top < 0)).observe(hero);
    } else {
      const onScroll = () => setVisible(window.scrollY > 400);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  }
</script>
