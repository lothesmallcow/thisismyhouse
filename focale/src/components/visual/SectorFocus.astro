---
/**
 * Lo studio: a sentence that keeps finishing itself. "Siti per [sector] che lavorano bene.",
 * the sector rolling inside an orange pill that resizes to each word, five ticks below.
 * Decorative copy of the lead's list, hidden from screen readers. scripts/inner.ts rolls it;
 * without JS or with reduced motion it reads with the first sector.
 */
const sectors = ["Ristrutturazioni", "Serramentisti", "B&B", "Agriturismi", "Location per eventi"];
---
<div class="sk" data-sector-focus aria-hidden="true">
  <p class="sk__line">Siti per</p>
  <span class="sk__pill" data-sk-pill>
    {
      sectors.map((s, i) => (
        <span class:list={["sk__word", { "is-on": i === 0 }]} data-sk-word>
          {s}
        </span>
      ))
    }
  </span>
  <p class="sk__line">che lavorano bene.</p>
  <span class="sk__ticks">
    {sectors.map((_, i) => <i class:list={{ "is-on": i === 0 }} />)}
  </span>
</div>
<style>
  .sk {
    width: min(100%, 32rem);
    font-size: clamp(1.9rem, 0.8rem + 2.4vw, 3.2rem);
    font-weight: 300;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .sk__line {
    margin: 0;
  }
  .sk__pill {
    position: relative;
    display: inline-block;
    margin: 0.18em 0 0.22em -0.1em;
    height: 1.45em;
    padding: 0 0.45em;
    border-radius: 999px;
    background: var(--mandarino);
    color: var(--inchiostro);
    overflow: hidden;
    vertical-align: middle;
    transition: width 0.7s cubic-bezier(0.65, 0, 0.25, 1);
  }
  .sk__word {
    display: none;
    white-space: nowrap;
    line-height: 1.45em;
    font-weight: 400;
  }
  .sk__word.is-on {
    display: block;
  }
  .sk__ticks {
    display: flex;
    gap: 6px;
    margin-top: 1.4rem;
  }
  .sk__ticks i {
    width: 22px;
    height: 4px;
    border-radius: 2px;
    background: rgba(36, 19, 12, 0.18);
    transition:
      background-color 0.4s,
      width 0.4s;
  }
  .sk__ticks i.is-on {
    width: 44px;
    background: var(--mandarino);
  }
  /* Live: every word sits in the pill; the one in front at rest, the old one leaves upwards,
     the next one waits below. The pill width is set by inner.ts to fit the word in front. */
  .sk.is-live .sk__word {
    display: block;
    position: absolute;
    left: 0.45em;
    top: 0;
    transform: translateY(110%);
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.25, 1);
  }
  .sk.is-live .sk__word.is-on {
    transform: translateY(0);
  }
  .sk.is-live .sk__word.is-out {
    transform: translateY(-110%);
  }
</style>
