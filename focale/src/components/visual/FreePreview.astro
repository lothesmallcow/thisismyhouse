---
/**
 * La garanzia: the price of the preview, as big as the type gets, with the two promises under it.
 * Type only (no ring, no symbols that phones turn into emoji). It comes into focus like every
 * [data-focus] heading.
 */
import { site } from "../../config/site";
const promises = ["Saldo solo a sito approvato", "Se non ti piace, finisce lì"];
---
<div class="fp" aria-hidden="true">
  <p class="fp__n" data-focus>0<span>€</span></p>
  <p class="fp__t">per vedere l'anteprima del tuo sito, entro {site.previewHours} ore</p>
  <ul class="fp__list">
    {
      promises.map((p) => (
        <li>
          <svg viewBox="0 0 12 12" width="14" height="14" aria-hidden="true">
            <path d="M2 6.4 4.8 9 10 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {p}
        </li>
      ))
    }
  </ul>
</div>
<style>
  .fp {
    width: min(100%, 26rem);
    color: var(--inchiostro);
  }
  .fp__n {
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.07em;
    font-size: clamp(7rem, 4rem + 12vw, 15rem);
    line-height: 0.8;
    display: flex;
    align-items: flex-start;
  }
  .fp__n span {
    font-size: 0.42em;
    letter-spacing: 0;
    margin: 0.12em 0 0 0.08em;
  }
  .fp__t {
    margin-top: 1.25rem !important;
    font-size: var(--fs-lead);
    line-height: 1.3;
    max-width: 20ch;
  }
  .fp__list {
    list-style: none;
    padding: 1rem 0 0;
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--inchiostro);
    display: grid;
    gap: 0.5rem;
    font-weight: 500;
  }
  .fp__list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fp__list svg {
    flex: none;
    padding: 4px;
    border-radius: 50%;
    background: var(--inchiostro);
    color: var(--mandarino);
    box-sizing: content-box;
  }
</style>
