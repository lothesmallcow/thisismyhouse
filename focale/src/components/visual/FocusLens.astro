---
/**
 * "Focus vuol dire mettere a fuoco", shown: a viewfinder. Inside, sharp, the three things a
 * visitor looks for; around it, going soft and drifting away with the scroll, everything else
 * old sites are full of. Decorative (the paragraph next to it says the same): hidden from
 * screen readers. scripts/inner.ts scrubs it; static without JS or with reduced motion.
 */
const keep = ["Chi sei", "Cosa fai", "Come contattarti"];
// Positions round the viewfinder, in the corners and on the sides (never over it).
const noise = [
  { t: "Benvenuti nel nostro sito", pos: "left:0;top:2%" },
  { t: "Slider automatico", pos: "right:0;top:6%" },
  { t: "Contatore visite", pos: "left:-3%;top:27%" },
  { t: "Mission e vision", pos: "right:-3%;bottom:29%" },
  { t: "Animazione d'ingresso", pos: "left:2%;bottom:3%" },
  { t: "Musica di sottofondo", pos: "right:0;bottom:7%" },
];
---
<div class="fl" data-lens aria-hidden="true">
  {
    noise.map((n) => (
      <span class="fl__noise" style={n.pos} data-lens-noise>
        {n.t}
      </span>
    ))
  }
  <div class="fl__view" data-lens-view>
    <span class="fl__c fl__c--tl"></span>
    <span class="fl__c fl__c--tr"></span>
    <span class="fl__c fl__c--bl"></span>
    <span class="fl__c fl__c--br"></span>
    <ul class="fl__keep" data-lens-keep>
      {keep.map((k) => <li>{k}</li>)}
    </ul>
  </div>
</div>
<style>
  .fl {
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 1.1;
    display: grid;
    place-items: center;
  }
  .fl__noise {
    position: absolute;
    white-space: nowrap;
    font-size: var(--fs-small);
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px dashed rgba(36, 19, 12, 0.35);
    color: #4a2a1c;
    filter: blur(1.5px);
    opacity: 0.7;
  }
  .fl__view {
    position: relative;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--carta);
    box-shadow:
      0 0 0 10px rgba(255, 91, 34, 0.18),
      0 40px 70px -40px rgba(60, 25, 8, 0.5);
    display: grid;
    place-items: center;
  }
  .fl__c {
    position: absolute;
    width: 18%;
    aspect-ratio: 1;
    border: 3px solid var(--mandarino);
  }
  .fl__c--tl {
    left: 4%;
    top: 4%;
    border-right: 0;
    border-bottom: 0;
    border-radius: 14px 0 0 0;
  }
  .fl__c--tr {
    right: 4%;
    top: 4%;
    border-left: 0;
    border-bottom: 0;
    border-radius: 0 14px 0 0;
  }
  .fl__c--bl {
    left: 4%;
    bottom: 4%;
    border-right: 0;
    border-top: 0;
    border-radius: 0 0 0 14px;
  }
  .fl__c--br {
    right: 4%;
    bottom: 4%;
    border-left: 0;
    border-top: 0;
    border-radius: 0 0 14px 0;
  }
  .fl__keep {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
    display: grid;
    gap: 0.2rem;
  }
  .fl__keep li {
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  @media (max-width: 520px) {
    .fl__noise {
      font-size: 0.75rem;
    }
    .fl__noise:nth-child(3),
    .fl__noise:nth-child(4) {
      display: none;
    }
  }
</style>
