---
/**
 * "Focus vuol dire mettere a fuoco", shown as a photo being taken. At first everything is sharp:
 * the three things a visitor looks for in the middle, and all the clutter old sites are full of
 * around them. The focus hunts ("AF" blinking), locks (the corners turn green), the six-blade iris
 * shutter closes and opens, a flash, and from then on only the middle is sharp. A small camera readout
 * (AF, shutter speed, aperture, ISO) frames it like a real viewfinder. Decorative (the paragraph next to it says the same): hidden from screen readers.
 * scripts/inner.ts sets .is-hunting then .is-shot; static and all sharp with reduced motion.
 */
const keep = ["Chi sei", "Cosa fai", "Come contattarti"];
// Positions round the viewfinder, in the corners and on the sides (never over it).
const noise = [
  { t: "Benvenuti nel nostro sito", pos: "left:0;top:2%" },
  { t: "Slider automatico", pos: "right:0;top:6%" },
  { t: "Contatore visite", pos: "left:-3%;top:27%" },
  { t: "Mission e vision", pos: "right:-3%;bottom:29%" },
  { t: "Animazione d'ingresso", pos: "left:2%;bottom:3%" },
  { t: "Musica di sottofondo", pos: "right:0;bottom:7%" },
];
---
<div class="fl" data-lens aria-hidden="true">
  {
    noise.map((n) => (
      <span class="fl__noise" style={n.pos} data-lens-noise>
        <span class="fl__chip">{n.t}</span>
      </span>
    ))
  }
  <div class="fl__view" data-lens-view>
    <span class="fl__c fl__c--tl"></span>
    <span class="fl__c fl__c--tr"></span>
    <span class="fl__c fl__c--bl"></span>
    <span class="fl__c fl__c--br"></span>
    <ul class="fl__keep" data-lens-keep>
      {keep.map((k) => <li>{k}</li>)}
    </ul>
    <span class="fl__iris">{[0, 1, 2, 3, 4, 5].map((n) => <i style={`--r: ${n * 60}deg`} />)}</span>
    <span class="fl__af"><b></b>AF-S</span>
    <span class="fl__exp"><span>1/250</span><span>f/1.8</span><span>ISO 100</span></span>
  </div>
  <span class="fl__flash"></span>
</div>
<style>
  .fl {
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 1.1;
    display: grid;
    place-items: center;
  }
  .fl__noise {
    position: absolute;
    white-space: nowrap;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .fl__chip {
    display: block;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px dashed rgba(11, 27, 63, 0.4);
    background: rgba(255, 255, 255, 0.55);
    color: #2c3655;
    transition:
      filter 0.25s ease,
      color 0.25s ease;
  }
  .fl__keep {
    transition: filter 0.2s ease;
  }
  .fl__flash {
    position: absolute;
    inset: -8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, #fff, rgba(255, 255, 255, 0.85) 60%, rgba(255, 255, 255, 0));
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The clutter floats about the whole time. */
    .fl__chip {
      animation: fl-float 6s ease-in-out infinite alternate;
    }
    .fl__noise:nth-child(2) .fl__chip {
      animation-duration: 7s;
      animation-delay: -2s;
    }
    .fl__noise:nth-child(3) .fl__chip {
      animation-duration: 5.4s;
      animation-delay: -1s;
    }
    .fl__noise:nth-child(4) .fl__chip {
      animation-duration: 6.6s;
      animation-delay: -3s;
    }
    .fl__noise:nth-child(5) .fl__chip {
      animation-duration: 5.8s;
      animation-delay: -4s;
    }
    .fl__noise:nth-child(6) .fl__chip {
      animation-duration: 7.4s;
      animation-delay: -2.5s;
    }
    /* 1. Hunting: the brackets breathe, the middle slips in and out of focus. */
    .fl.is-hunting .fl__c {
      animation: fl-breathe 0.55s ease-in-out infinite alternate;
    }
    .fl.is-hunting .fl__keep {
      animation: fl-hunt 0.85s ease-in-out infinite;
    }
    /* 2. Shot: flash, the brackets lock, everything but the middle falls out of focus. */
    .fl.is-shot .fl__flash {
      animation: fl-flash 0.6s ease-out 0.12s backwards;
    }
    .fl.is-shot .fl__view {
      animation: fl-click 0.35s ease-out;
    }
    .fl.is-shot .fl__c {
      border-color: var(--inchiostro);
      transition: border-color 0.2s;
    }
    .fl.is-shot .fl__chip {
      filter: blur(5px);
      color: #5c6684;
      transition:
        filter 0.5s ease 0.15s,
        color 0.5s ease 0.15s;
    }
  }
  @keyframes fl-float {
    from {
      transform: translate(-6px, -5px) rotate(-2deg);
    }
    to {
      transform: translate(6px, 5px) rotate(2deg);
    }
  }
  @keyframes fl-breathe {
    to {
      transform: scale(1.18);
    }
  }
  @keyframes fl-hunt {
    0%,
    100% {
      filter: blur(0px);
    }
    50% {
      filter: blur(3px);
    }
  }
  @keyframes fl-flash {
    0% {
      opacity: 0;
    }
    12% {
      opacity: 0.95;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes fl-click {
    40% {
      transform: scale(0.96);
    }
  }
  .fl__view {
    position: relative;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--carta);
    box-shadow:
      0 0 0 10px rgba(19, 48, 122, 0.18),
      0 40px 70px -40px rgba(11, 27, 63, 0.5);
    display: grid;
    place-items: center;
  }
  .fl__c {
    position: absolute;
    width: 18%;
    aspect-ratio: 1;
    border: 3px solid var(--mandarino);
  }
  .fl__c--tl {
    left: 4%;
    top: 4%;
    border-right: 0;
    border-bottom: 0;
    border-radius: 14px 0 0 0;
  }
  .fl__c--tr {
    right: 4%;
    top: 4%;
    border-left: 0;
    border-bottom: 0;
    border-radius: 0 14px 0 0;
  }
  .fl__c--bl {
    left: 4%;
    bottom: 4%;
    border-right: 0;
    border-top: 0;
    border-radius: 0 0 0 14px;
  }
  .fl__c--br {
    right: 4%;
    bottom: 4%;
    border-left: 0;
    border-top: 0;
    border-radius: 0 0 14px 0;
  }
  /* ---------- Camera readout ---------- */
  .fl__af,
  .fl__exp {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--grafite);
  }
  .fl__af {
    bottom: calc(100% + 18px);
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1.5px solid currentColor;
  }
  .fl__af b {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }
  .fl__exp {
    top: calc(100% + 20px);
  }
  /* ---------- Iris shutter: six blades close and open at the shot ---------- */
  .fl__iris {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  /* Each blade is a half-plane whose straight edge sits --d from the centre; six at 60 degrees leave
     a hexagonal opening that shrinks to nothing as --d goes to 0. */
  .fl__iris i {
    position: absolute;
    left: -50%;
    top: 50%;
    width: 200%;
    height: 100%;
    transform-origin: 50% 0;
    transform: rotate(var(--r)) translateY(53%);
    background: linear-gradient(180deg, #2a3350, #151b2e);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fl.is-hunting .fl__af {
      animation: fl-blink 0.45s steps(2, jump-none) infinite;
    }
    .fl.is-shot .fl__af {
      color: #1f8a4c;
    }
    .fl.is-shot .fl__c {
      border-color: #1f8a4c !important;
    }
    .fl.is-shot .fl__iris i {
      animation: fl-iris 0.36s cubic-bezier(0.5, 0, 0.3, 1);
    }
  }
  @keyframes fl-blink {
    to {
      opacity: 0.25;
    }
  }
  @keyframes fl-iris {
    45% {
      transform: rotate(var(--r)) translateY(0%);
    }
  }
  .fl__keep {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
    display: grid;
    gap: 0.2rem;
  }
  .fl__keep li {
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  @media (max-width: 520px) {
    .fl__noise {
      font-size: 0.75rem;
    }
    .fl__noise:nth-child(3),
    .fl__noise:nth-child(4) {
      display: none;
    }
  }
</style>
