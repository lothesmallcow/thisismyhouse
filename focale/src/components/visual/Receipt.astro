---
/**
 * Prezzi: the Professionale package printed by a little thermal printer: deposit, balance,
 * nothing hidden, a barcode and a "Prezzo finale" stamp. Every figure comes from config.
 * Pure CSS: it prints at first paint (step by step, like thermal paper), then hangs and sways.
 * With reduced motion it is simply there.
 */
import { site } from "../../config/site";
import { euro, foundersOpen } from "../../lib/util";
import { plans } from "../../lib/plans";

const plan = plans.find((p) => p.recommended)!;
const total = foundersOpen() ? plan.founders : plan.standard;
const deposit = Math.round((total * site.depositPercent) / 100);
const rows: [string, number][] = [
  [`Acconto quando partiamo, ${site.depositPercent}%`, deposit],
  ["Saldo, solo a sito approvato", total - deposit],
  ["Costi nascosti", 0],
];
---
<figure class="rc" data-receipt>
  <div class="rc__printer" aria-hidden="true">
    <span class="rc__led"></span>
    <span class="rc__name"><b>focus</b> design</span>
    <span class="rc__mouth"></span>
  </div>
  <div class="rc__clip">
    <div class="rc__paper">
      <div class="rc__sheet">
        <p class="rc__head" data-rc-line>Esempio di preventivo</p>
        <p class="rc__plan" data-rc-line>Pacchetto {plan.name}</p>
        <dl class="rc__rows">
          {
            rows.map(([k, v]) => (
              <div data-rc-line>
                <dt>{k}</dt>
                <dd>{euro(v)}</dd>
              </div>
            ))
          }
        </dl>
        <p class="rc__total" data-rc-line>
          <span>Totale</span>
          <span>{euro(total)}</span>
        </p>
        <p class="rc__note" data-rc-line>Il prezzo resta questo. Niente da aggiungere dopo.</p>
        <span class="rc__bars" aria-hidden="true" data-rc-line></span>
        <p class="rc__stamp">Prezzo finale</p>
      </div>
    </div>
  </div>
  <figcaption class="small muted rc__cap">Esempio con il pacchetto {plan.name}{foundersOpen() ? ", prezzo fondatori" : ""}.</figcaption>
</figure>
<style>
  .rc {
    margin: 0;
    width: min(100%, 26rem);
    display: grid;
    justify-items: center;
  }
  /* The printer: an orange block with a status light and the paper mouth underneath. */
  .rc__printer {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 4.25rem;
    border-radius: 22px 22px 14px 14px;
    background: var(--mandarino);
    box-shadow:
      inset 0 -10px 0 rgba(11, 27, 63, 0.14),
      0 24px 40px -24px rgba(11, 27, 63, 0.55);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.25rem 0.5rem;
    box-sizing: border-box;
  }
  .rc__led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.12);
  }
  .rc__name {
    font-size: 0.95rem;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .rc__name b {
    font-weight: 500;
  }
  .rc__mouth {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 9px;
    height: 6px;
    border-radius: 999px;
    background: #050b1c;
  }
  .rc__clip {
    width: 86%;
    margin-top: -12px;
    padding: 0 3% 3rem;
    overflow: hidden;
  }
  .rc__paper {
    transform-origin: 50% 0;
  }
  .rc__sheet {
    position: relative;
    background: linear-gradient(#eef1f6, #fff 28px);
    color: var(--inchiostro);
    padding: 1.75rem 1.5rem 2.6rem;
    font-variant-numeric: tabular-nums;
    filter: drop-shadow(0 22px 26px rgba(11, 27, 63, 0.28));
    transform-origin: 50% 0;
    /* Torn bottom edge. */
    --tooth: 12px;
    mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--tooth)) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--tooth) * 2) var(--tooth) repeat-x;
  }
  .rc__head {
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--grafite);
    padding-bottom: 0.9rem;
    border-bottom: 1px dashed #c9d2e3;
  }
  .rc__plan {
    margin-top: 0.9rem !important;
    font-weight: 500;
    font-stretch: 112%;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
  }
  .rc__rows {
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-small);
  }
  .rc__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .rc__rows dd {
    margin: 0;
    font-weight: 500;
    white-space: nowrap;
  }
  .rc__total {
    margin-top: 1.1rem !important;
    padding-top: 0.9rem;
    border-top: 1px dashed #c9d2e3;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    font-size: clamp(2.2rem, 1.6rem + 1.8vw, 3rem);
    line-height: 1;
  }
  .rc__total span:first-child {
    font-size: 0.4em;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
  }
  .rc__note {
    margin-top: 1rem !important;
    font-size: var(--fs-micro);
    color: var(--grafite);
  }
  .rc__bars {
    display: block;
    margin-top: 1rem;
    height: 34px;
    background: repeating-linear-gradient(
      90deg,
      #24130c 0 2px,
      transparent 2px 4px,
      #24130c 4px 5px,
      transparent 5px 8px,
      #24130c 8px 11px,
      transparent 11px 12px,
      #24130c 12px 13px,
      transparent 13px 16px
    );
    opacity: 0.85;
  }
  .rc__stamp {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    transform: rotate(-8deg);
    border: 2px solid var(--blu);
    color: var(--blu);
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    font-stretch: 112%;
    background: #fff;
  }
  .rc__cap {
    margin-top: -1.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Thermal printing: the paper comes out in small steps while the light blinks green. */
    .rc__paper {
      animation: rc-print 2.2s steps(18) 0.3s backwards;
    }
    .rc__led {
      animation: rc-led 0.18s steps(2) 0.3s 12;
    }
    [data-rc-line] {
      animation: rc-line 0.3s ease backwards;
    }
    .rc__head {
      animation-delay: 0.5s;
    }
    .rc__plan {
      animation-delay: 0.75s;
    }
    .rc__rows div:nth-child(1) {
      animation-delay: 1s;
    }
    .rc__rows div:nth-child(2) {
      animation-delay: 1.25s;
    }
    .rc__rows div:nth-child(3) {
      animation-delay: 1.5s;
    }
    .rc__total {
      animation-delay: 1.8s;
    }
    .rc__note {
      animation-delay: 2.05s;
    }
    .rc__bars {
      animation-delay: 2.25s;
    }
    .rc__stamp {
      animation: rc-stamp 0.5s cubic-bezier(0.3, 1.7, 0.5, 1) 2.7s backwards;
    }
    /* Then it hangs from the printer and sways a little. */
    .rc__sheet {
      animation: rc-swing 3.2s ease-in-out 2.6s infinite alternate;
    }
  }
  @keyframes rc-print {
    from {
      transform: translateY(-100%);
    }
  }
  @keyframes rc-led {
    to {
      background: #3ccf6e;
    }
  }
  /* Lines appear as if burnt in by the print head: wiped in, never transparent. */
  @keyframes rc-line {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
  @keyframes rc-stamp {
    from {
      transform: rotate(-40deg) scale(2.4);
      opacity: 0;
    }
  }
  @keyframes rc-swing {
    from {
      transform: rotate(-1.4deg);
    }
    to {
      transform: rotate(1.4deg);
    }
  }
</style>
