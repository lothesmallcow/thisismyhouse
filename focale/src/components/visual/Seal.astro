---
/**
 * La garanzia as a seal: the price of the preview in the middle, the two promises running
 * round it. It turns slowly (CSS, stops with reduced motion) and with the scroll (inner.ts).
 */
import { site } from "../../config/site";
const ring = `Anteprima gratuita ✳ Saldo solo a sito approvato ✳ Nessun impegno ✳ `;
---
<figure class="seal" data-seal>
  <svg class="seal__ring" viewBox="0 0 400 400" aria-hidden="true" data-seal-ring>
    <defs>
      <path id="seal-path" d="M200,200 m-162,0 a162,162 0 1,1 324,0 a162,162 0 1,1 -324,0" />
    </defs>
    <circle cx="200" cy="200" r="196" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="200" cy="200" r="128" fill="none" stroke="currentColor" stroke-width="2" />
    <text>
      <textPath href="#seal-path" textLength="1010" lengthAdjust="spacing">{ring}</textPath>
    </text>
  </svg>
  <div class="seal__mid">
    <p class="seal__n">0 €</p>
    <p class="seal__t">per vedere l'anteprima, entro {site.previewHours} ore</p>
  </div>
</figure>
<style>
  .seal {
    position: relative;
    margin: 0;
    width: min(100%, 26rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: var(--inchiostro);
  }
  .seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .seal__ring text {
    font-family: var(--font);
    font-size: 25px;
    font-weight: 500;
    font-stretch: 112%;
    fill: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .seal__ring {
      animation: seal-turn 40s linear infinite;
    }
  }
  @keyframes seal-turn {
    to {
      rotate: 360deg;
    }
  }
  .seal__mid {
    position: relative;
    text-align: center;
    width: 56%;
  }
  .seal__n {
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.06em;
    font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    line-height: 0.9;
  }
  .seal__t {
    margin-top: 0.6rem !important;
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.35;
  }
</style>
