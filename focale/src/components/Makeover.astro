---
/**
 * The makeover, filmed like the opening, as a mini film: the device starts alone in the middle of the
 * band, then glides to its place and the words come in. Phones see it on an iPhone, computers on a
 * laptop (it fills the right side; chosen by the screen width, no switch: Lorenzo found a switch too
 * much). The same invented firm's real-looking old website (a decent WordPress-style site made for
 * computers, as most firms' sites really look). It plays by itself like a video, one thing at a time:
 * the old site; its five problems one by one (a lens on that piece only, a red box, the rest dims, a
 * floating label says what is wrong); the phone turns around, or the laptop's lid shuts and opens
 * again, and the new site is there; the five fixes one by one (green box, the label turns green); a
 * tap calls, or a click asks for a quote. Under the device a slim bar: where we are, sound, replay.
 * The 3D bodies are real models (phone3d.ts); the screens stay live HTML. Without JS or with reduced
 * motion: the finished site, and the list of fixes for screen readers. Logic in scripts/makeover.ts.
 */
import IPhone from "./IPhone.astro";
import Laptop from "./Laptop.astro";
import { site } from "../config/site";
import OldSite from "./demo/OldSite.astro";
import ArcadiHero from "./demo/ArcadiHero.astro";

// Each problem of the old site and the part of the new site that fixes it (same number), for each
// device. `old` is a selector inside OldSite (its [data-old] pieces), `fix` a selector inside ArcadiHero.
type Fix = { old: string; fix: string; bad: string; good: string };
const devices: { id: "phone" | "laptop"; fixes: Fix[]; first: string; last: string }[] = [
  {
    id: "phone",
    first: "Il sito di oggi, dal telefono",
    last: "Un tocco, e ti chiamano",
    fixes: [
      { old: "[data-old='header']", fix: ".ah__call", bad: "Il numero è minuscolo e non si tocca", good: "Il tasto Chiama è sempre in alto" },
      { old: "[data-old='text']", fix: "[data-piece='title']", bad: "Testo minuscolo: bisogna zoomare", good: "Titoli grandi: si legge al volo" },
      { old: "[data-old='photo']", fix: "[data-piece='photo']", bad: "Le foto dei lavori sono francobolli", good: "Una foto grande dei lavori" },
      { old: "[data-old='cta']", fix: ".ah__btn--main", bad: "Per un preventivo devi cercare i Contatti", good: "Preventivo con un tocco" },
      { old: "[data-old='foot']", fix: "[data-piece='foot']", bad: "Ultima notizia del 2019: sembra chiuso", good: "Aggiornato: l'ultimo lavoro è di settembre" },
    ],
  },
  {
    id: "laptop",
    first: "Il sito di oggi, dal computer",
    last: "Un clic, e ti scrivono",
    fixes: [
      { old: "[data-old='header']", fix: ".ah__phone", bad: "Il telefono è scritto in piccolo, in un angolo", good: "Numero e tasto Chiama sempre in vista" },
      { old: "[data-old='text']", fix: "[data-piece='title']", bad: "Un muro di testo: nessuno lo legge", good: "Una frase dice cosa fate e dove" },
      { old: "[data-old='photo']", fix: "[data-piece='photo']", bad: "Le foto dei lavori sono francobolli", good: "Una foto grande dei lavori" },
      { old: "[data-old='cta']", fix: ".ah__btn--main", bad: "Per un preventivo devi cercare i Contatti", good: "Preventivo con un clic" },
      { old: "[data-old='foot']", fix: "[data-piece='foot']", bad: "Ultima notizia del 2019: sembra chiuso", good: "Aggiornato: l'ultimo lavoro è di settembre" },
    ],
  },
];
// The status in the bar under the device, in order. The film shows one at a time.
const beatsOf = (d: (typeof devices)[number]): { t: string; tone?: "bad" | "good" }[] => [
  { t: d.first },
  ...d.fixes.map((_, i) => ({ t: `Problema ${i + 1} di 5`, tone: "bad" as const })),
  { t: `Lo rifacciamo in ${site.deliveryDays.professionale} giorni` },
  ...d.fixes.map((_, i) => ({ t: `Risolto ${i + 1} di 5`, tone: "good" as const })),
  { t: d.last },
];
const [phone, laptop] = devices;
---
<section class="mk on-navy" id="makeover" aria-labelledby="mk-t" data-makeover>
  <div class="wrap mk__in">
    <div class="mk__text">
      <h2 id="mk-t" class="mk__t" data-mk-word>Prima e dopo: lo stesso sito, rifatto da noi.</h2>
      <p class="mk__lead" data-mk-word>
        Un'impresa edile inventata: il sito che ha oggi e quello che le faremmo noi. Guarda cosa cambia, un pezzo alla volta.
      </p>
      <ul class="sr-only">
        {phone.fixes.map((f) => <li>Prima: {f.bad}. Dopo: {f.good}.</li>)}
      </ul>
      <div class="mk__ask" data-mk-word>
        <a href="/anteprima-gratuita" class="btn btn--primary btn--big">Voglio l'anteprima gratuita</a>
      </div>
      <a class="textlink mk__more" href="/lavori/" data-mk-word>Vedi i tre siti completi</a>
    </div>

    <figure class="mk__stage">
      <div class="mk__devs">
        <div class="mk__dev mk__dev--phone" data-mk-dev="phone">
          <div class="mk__rig" data-phone3d>
            <div class="mk__obj" data-mk-obj>
              <div class="mk__phone">
                <IPhone solid label="Il sito di un'impresa edile inventata, prima e dopo il rifacimento, su un iPhone">
                  <div class="mk__screen" data-mk-screen>
                    <div class="mk__old" data-mk-old>
                      <div class="mk__oldpage" data-mk-oldpage><OldSite annotations={false} /></div>
                      {phone.fixes.map((f, i) => <span class="mk__mark" data-mk-mark={i} data-old-piece={f.old} aria-hidden="true"><i>{i + 1}</i></span>)}
                    </div>
                    <div class="mk__new" data-mk-new>
                      <div class="mk__newpage" data-mk-newpage><ArcadiHero extra={false} /></div>
                      {phone.fixes.map((f, i) => <span class="mk__mark mk__mark--good" data-mk-good={i} data-fix={f.fix} aria-hidden="true"><i>{i + 1}</i></span>)}
                    </div>
                    <span class="mk__sweep" data-mk-sweep aria-hidden="true"></span>
                  </div>
                  <span class="mk__finger" data-mk-fa aria-hidden="true"></span>
                </IPhone>
              </div>
            </div>
          </div>
          <ul class="mk__tags" aria-hidden="true">
            {
              phone.fixes.map((f, i) => (
                <li class="mk__tag" data-mk-tag={i}>
                  <span class="mk__tdot">
                    <span class="mk__tn">{i + 1}</span>
                    <svg viewBox="0 0 12 12" width="12" height="12"><path d="M2 6.4 4.8 9 10 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span class="mk__tx"><span class="mk__tbad">{f.bad}</span><span class="mk__tgood">{f.good}</span></span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mk__dev mk__dev--laptop" data-mk-dev="laptop">
          <div class="mk__rig mk__rig--lap" data-laptop3d>
            <div class="mk__obj mk__obj--lap" data-mk-obj>
              <Laptop url="arcadi-ristrutturazioni.demo" label="Lo stesso sito, prima e dopo il rifacimento, su un computer portatile">
                <div class="mk__screen mk__screen--lap" data-mk-screen>
                  <div class="mk__old" data-mk-old>
                    <div class="mk__oldpage mk__oldpage--desk" data-mk-oldpage data-desk><OldSite annotations={false} /></div>
                    {laptop.fixes.map((f, i) => <span class="mk__mark" data-mk-mark={i} data-old-piece={f.old} aria-hidden="true"><i>{i + 1}</i></span>)}
                  </div>
                  <div class="mk__new" data-mk-new>
                    <div class="mk__newpage mk__newpage--desk" data-mk-newpage data-desk><ArcadiHero extra={false} /></div>
                    {laptop.fixes.map((f, i) => <span class="mk__mark mk__mark--good" data-mk-good={i} data-fix={f.fix} aria-hidden="true"><i>{i + 1}</i></span>)}
                  </div>
                  <span class="mk__sweep" data-mk-sweep aria-hidden="true"></span>
                  <svg class="mk__cursor" data-mk-fa viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3v16.5l4.6-4.4 2.9 6.4 2.6-1.2-2.9-6.3H18.5Z" fill="#111" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" /></svg>
                </div>
              </Laptop>
            </div>
          </div>
          <ul class="mk__tags" aria-hidden="true">
            {
              laptop.fixes.map((f, i) => (
                <li class="mk__tag" data-mk-tag={i}>
                  <span class="mk__tdot">
                    <span class="mk__tn">{i + 1}</span>
                    <svg viewBox="0 0 12 12" width="12" height="12"><path d="M2 6.4 4.8 9 10 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span class="mk__tx"><span class="mk__tbad">{f.bad}</span><span class="mk__tgood">{f.good}</span></span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <figcaption class="mk__bar">
        <span class="mk__status">
          {
            devices.map((d) =>
              beatsOf(d).map((b, i) => (
                <span class:list={["mk__b", b.tone && `mk__b--${b.tone}`]} data-mk-beat={i} data-for={d.id}>
                  {b.t}
                </span>
              )),
            )
          }
        </span>
        <span class="mk__ctl" data-mk-ctl hidden>
          <button type="button" class="mk__btn" data-mk-sound aria-pressed="false" aria-label="Attiva il suono">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path class="mk__wave" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <button type="button" class="mk__btn" data-mk-replay aria-label="Rivedi il prima e dopo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12a7 7 0 1 0 2.1-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path d="M6 3.5v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .mk {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .mk__in {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    width: 100%;
  }
  @media (min-width: 900px) {
    .mk__in {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(2rem, 4vw, 4.5rem);
    }
  }
  .mk__t {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.4rem);
    line-height: 1.02;
    max-width: 16ch;
  }
  .mk__ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }
  .mk__more {
    display: inline-block;
    margin-top: 1.25rem;
  }
  /* The words stay readable above the phone while it turns. */
  .mk__text {
    position: relative;
    z-index: 2;
  }

  .mk__lead {
    margin-top: 1.25rem;
    max-width: 36ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--on-dark-muted);
  }

  /* ---------- Stage ---------- */
  .mk__stage {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
  }
  .mk__devs {
    display: grid;
    width: 100%;
    place-items: center;
  }
  .mk__dev {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    justify-items: center;
  }
  /* Computers see the laptop, phones the iPhone. */
  @media (min-width: 900px) {
    .mk__dev--phone {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .mk__dev--laptop {
      display: none;
    }
  }

  /* ---------- Phone ---------- */
  .mk__phone {
    position: relative;
    transform-style: preserve-3d;
  }
  .mk__rig {
    perspective: 1600px;
    perspective-origin: 50% 40%;
  }
  .mk__obj {
    position: relative;
    transform-style: preserve-3d;
    /* Phone and the bar under it fit in one screen (about 240 px of bar and padding round it). */
    --w: clamp(200px, calc((100svh - 240px) / 2.06), 300px);
  }
  .mk__phone::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: calc(var(--w) * -0.07);
    height: calc(var(--w) * 0.1);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(11, 27, 63, 0.3), rgba(11, 27, 63, 0));
    z-index: -1;
  }
  .mk__screen {
    position: absolute;
    inset: 13.7cqw 0 0;
    overflow: hidden;
    background: #fff;
  }
  .mk__newpage {
    position: relative;
    height: 100%;
  }

  /* ---------- Laptop: seen from a little above; its screen is drawn 1280 px wide and scaled (--k, makeover.ts) ---------- */
  .mk__rig--lap {
    position: relative;
    perspective: 2600px;
    perspective-origin: 50% 20%;
  }
  .mk__obj--lap {
    --w: clamp(320px, min(46vw, 100svh - 240px), 680px);
    /* Room for the keyboard coming towards the eye under the lid. */
    padding-bottom: calc(var(--w) * 0.23);
  }
  .mk__obj--lap :global(.lap) {
    transform: rotateX(-12deg);
  }
  .mk__screen--lap {
    inset: 0;
  }
  /* Doubled classes: the phone's .mk__oldpage (220%, further down) must not win. */
  .mk__oldpage.mk__oldpage--desk,
  .mk__newpage.mk__newpage--desk {
    width: 1280px;
    height: 780px;
    transform-origin: 0 0;
    transform: scale(var(--k, 0.45));
  }
  /* An old boxed theme: the page sits in a 1000 px column on a grey background. */
  .mk__oldpage.mk__oldpage--desk {
    background: #e3e0d9;
  }
  .mk__oldpage--desk :global(.os) {
    max-width: 1000px;
    margin-inline: auto;
    box-shadow: 0 0 0 1px #d3cfc6;
  }
  .mk__cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.6cqi;
    height: 2.6cqi;
    margin: -0.4cqi 0 0 -0.6cqi;
    opacity: 0;
    z-index: 8;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }
  .mk__old,
  .mk__new {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* A desktop page squeezed onto the phone (220% wide, scaled to fit), like a real non-responsive
     site: two columns, tiny text, and the page fills the whole screen. 220% keeps OldSite in its
     desktop layout (container >= 520 px) even on the smallest phone in the film. */
  .mk__oldpage {
    position: relative;
    width: 220%;
    height: 220%;
    transform-origin: 0 0;
    transform: scale(0.4545);
    background: #fffbe6;
  }
  .mk__oldpage :global(.os-wrap),
  .mk__oldpage :global(.os) {
    height: 100%;
  }
  .mk__new {
    background: #f2f2f0;
  }
  /* Final frame by default (no JS): the old page is hidden. */
  .mk__old {
    visibility: hidden;
  }
  :global(.mk-live) .mk__old {
    visibility: visible;
  }
  .mk__sweep {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -60%;
    width: 45%;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
    transform: skewX(-12deg);
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }
  .mk__finger {
    position: absolute;
    width: 11cqw;
    height: 11cqw;
    margin: -5.5cqw 0 0 -5.5cqw;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.65);
    box-shadow:
      0 0 0 1cqw rgba(29, 31, 33, 0.18),
      0 1cqw 3cqw rgba(0, 0, 0, 0.2);
    opacity: 0;
    z-index: 8;
    pointer-events: none;
  }
  /* Numbered boxes: red on the old site, green on the new one. One at a time. */
  .mk__mark {
    position: absolute;
    left: 0;
    top: 0;
    border: 2.5px solid #d92d20;
    border-radius: 6px;
    background: rgba(217, 45, 32, 0.1);
    box-shadow: 0 0 0 2000px rgba(11, 27, 63, 0);
    opacity: 0;
    visibility: hidden;
    z-index: 7;
    pointer-events: none;
  }
  .mk__mark i {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d92d20;
    color: #fff;
    font: 700 11px/1 var(--font);
    font-style: normal;
  }
  .mk__mark--good {
    border-color: #1f8a4c;
    background: rgba(31, 138, 76, 0.1);
  }
  .mk__mark--good i {
    background: #1f8a4c;
  }

  /* ---------- Floating labels: one beside the phone at a time ---------- */
  .mk__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
  }
  :global(.mk-live) .mk__tags {
    display: block;
  }
  .mk__tag {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 15.5rem;
    padding: 0.55rem 0.95rem 0.55rem 0.55rem;
    border-radius: 14px;
    background: #fff;
    color: var(--notte);
    box-shadow:
      0 18px 40px -18px rgba(3, 10, 30, 0.7),
      0 0 0 1px rgba(11, 27, 63, 0.06);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  /* Computers: one line, so the label is exactly as wide as its words. */
  @media (min-width: 900px) {
    .mk__tag {
      max-width: none;
      white-space: nowrap;
    }
  }
  /* A thin line from the label to the box it talks about (computers). */
  .mk__tag::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: var(--reach, 0px);
    border-top: 1.5px dashed var(--tone, #d92d20);
  }
  .mk__tdot {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d92d20;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .mk__tdot > * {
    grid-area: 1 / 1;
  }
  .mk__tdot svg {
    opacity: 0;
  }
  .mk__tx {
    display: grid;
  }
  /* One text at a time (the problem, then the fix), so the label is as wide as its own words. */
  .mk__tgood {
    display: none;
  }

  /* ---------- The bar under the phone: where we are, sound, replay ---------- */
  .mk__bar {
    display: none;
  }
  :global(.mk-live) .mk__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100%, 22rem);
    margin-top: 1.5rem;
    padding: 0.35rem 0.35rem 0.35rem 1.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  /* All statuses share one cell: the bar never changes size. */
  .mk__status {
    display: grid;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
  }
  .mk__b {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s 0.25s;
  }
  .mk__b::before {
    content: "";
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--on-dark-muted);
  }
  .mk__b--bad::before {
    background: #ff6b5e;
  }
  .mk__b--good::before {
    background: #4cd387;
  }
  .mk__b:global(.is-on) {
    opacity: 1;
    visibility: visible;
    transition-delay: 0.1s, 0s;
  }
  .mk__ctl {
    display: flex;
    gap: 0.4rem;
    flex: none;
  }
  .mk__ctl[hidden] {
    display: none;
  }
  .mk__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    .mk__btn:hover {
      border-color: #fff;
    }
  }
  .mk__btn svg {
    width: 18px;
    height: 18px;
  }
  .mk__btn {
    touch-action: manipulation;
  }
  .mk__btn[aria-pressed="false"] .mk__wave {
    opacity: 0.3;
  }
  .mk__btn[aria-pressed="true"] {
    background: #fff;
    border-color: #fff;
    color: var(--notte);
  }

  /* ---------- Phones: title, the film big, then the button ---------- */
  @media (max-width: 899px) {
    .mk__obj {
      --w: min(72vw, 290px, 44svh);
    }
    :global(.mk-live) .mk__text {
      display: contents;
    }
    :global(.mk-live) .mk__text > * {
      position: relative;
      z-index: 2;
    }
    :global(.mk-live) .mk__stage {
      order: 1;
    }
    :global(.mk-live) .mk__ask {
      order: 2;
      margin-top: 0.25rem;
    }
    :global(.mk-live) .mk__more {
      order: 3;
      justify-self: start;
      margin-top: 0;
    }
    :global(.mk-live) .mk__bar {
      margin-top: 1.1rem;
    }
    .mk__lead {
      margin-top: -0.75rem;
      font-size: 1rem;
    }
  }
</style>
<script>
  import { later } from "../scripts/later";
  later(() => import("../scripts/makeover").then((m) => m.initMakeover()));
</script>
