---
/**
 * The makeover, filmed like the opening: one iPhone with a real-looking old website (a desktop
 * layout squeezed onto a phone, as non-responsive sites really look). Scrolling plays it like a
 * video: a scan finds the five problems in one pass (numbered boxes on the screen, labels beside
 * the phone), the phone turns around in 3D and comes back with the new site, then each label turns
 * green on the part of the new site that fixes it, and a tap calls.
 * Without JS or with reduced motion: the finished site and the steps as a list.
 * Logic in scripts/makeover.ts.
 */
import IPhone from "./IPhone.astro";
import OldSite from "./demo/OldSite.astro";
import ArcadiHero from "./demo/ArcadiHero.astro";

const steps = [
  { t: "Il sito di oggi, aperto dal telefono.", d: "Fatto per il computer, nel 2011." },
  { t: "Cinque problemi, in un colpo d'occhio.", d: "Numero nascosto, foto sgranate, testo minuscolo, niente preventivo, fermo al 2011." },
  { t: "Il makeover.", d: "Stessa impresa, sito nuovo: in 10 giorni." },
  { t: "Ogni problema, risolto.", d: "Chiama con un tocco, si legge senza zoom, preventivo in 3 domande." },
  { t: "Chi lo apre, ti chiama.", d: "Un tocco e il telefono squilla." },
];
// Each problem of the old site and the part of the new site that fixes it (same number).
// `old` is a [data-old] piece of OldSite, `fix` a selector inside ArcadiHero.
const fixes = [
  { old: "header", fix: ".ah__phone", bad: "Numero nascosto", good: "Chiama con un tocco" },
  { old: "photo", fix: "[data-piece='photo']", bad: "Foto sgranate", good: "Lavori in primo piano" },
  { old: "text", fix: "[data-piece='title']", bad: "Testo minuscolo", good: "Si legge senza zoom" },
  { old: "cta", fix: ".ah__btn--main", bad: "Niente preventivo", good: "Preventivo in 3 domande" },
  { old: "foot", fix: "[data-piece='foot']", bad: "Fermo al 2011", good: "Ultimi lavori in vista" },
];
---
<section class="mk" id="makeover" aria-labelledby="mk-t" data-makeover>
  <div class="mk__pin" data-mk-pin>
    <div class="wrap mk__in">
      <div class="mk__text">
        <h2 id="mk-t" class="mk__t">Prima e dopo, sullo schermo che conta.</h2>
        <ol class="mk__steps" data-mk-steps>
          {
            steps.map((s, i) => (
              <li data-mk-step={i}>
                <span class="mk__st">{s.t}</span>
                <span class="mk__sd">{s.d}</span>
              </li>
            ))
          }
        </ol>
        <a class="textlink mk__more" href="/lavori/">I tre siti completi</a>
      </div>

      <figure class="mk__stage">
        <div class="mk__rig" data-phone3d>
        <div class="mk__obj" data-mk-obj>
        <div class="mk__phone" data-mk-phone>
          <IPhone solid label="Il sito di un'impresa edile inventata, prima e dopo il rifacimento, su un iPhone">
            <div class="mk__screen" data-mk-screen>
              <div class="mk__old" data-mk-old>
                <div class="mk__oldpage" data-mk-oldpage><OldSite annotations={false} /></div>
              </div>
              <div class="mk__new" data-mk-new><ArcadiHero /></div>
              <span class="mk__sweep" data-mk-sweep aria-hidden="true"></span>
              <span class="mk__scan" data-mk-scan aria-hidden="true"></span>
              {
                fixes.map((f, i) => (
                  <span class="mk__mark" data-mk-mark={i} data-old-piece={f.old} aria-hidden="true">
                    <i>{i + 1}</i>
                  </span>
                ))
              }
              {
                fixes.map((f, i) => (
                  <span class="mk__mark mk__mark--good" data-mk-good={i} data-fix={f.fix} aria-hidden="true">
                    <i>{i + 1}</i>
                  </span>
                ))
              }
            </div>
            <span class="mk__finger mk__finger--a" data-mk-fa aria-hidden="true"></span>
            <span class="mk__finger mk__finger--b" data-mk-fb aria-hidden="true"></span>
          </IPhone>
        </div>
        </div>
        </div>
        <ul class="mk__tags" aria-hidden="true" data-mk-tags>
          {
            fixes.map((f, i) => (
              <li class:list={["mk__tag", i % 2 ? "mk__tag--r" : "mk__tag--l"]} data-mk-tag={i}>
                <span class="mk__dot">
                  <span class="mk__dot-bad">{i + 1}</span>
                  <span class="mk__dot-good">✓</span>
                </span>
                <span class="mk__tx">
                  <span class="mk__bad">{f.bad}</span>
                  <span class="mk__good">{f.good}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </figure>
    </div>
  </div>
</section>

<style>
  .mk {
    overflow-x: clip;
  }
  .mk__pin {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    box-sizing: border-box;
    padding-block: calc(var(--header-h) + 1.5rem) 2rem;
  }
  .mk__in {
    display: grid;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  @media (min-width: 900px) {
    .mk__in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 6vw, 7rem);
    }
  }
  .mk__t {
    font-size: clamp(2rem, 1rem + 3vw, 4rem);
    line-height: 1;
    max-width: 13ch;
  }
  .mk__steps {
    list-style: none;
    padding: 0;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 1.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .mk__steps li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0 0.6rem 1rem;
    border-left: 2px solid var(--filo);
    transition: border-color 0.4s;
  }
  .mk__st {
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--grafite);
    transition: color 0.4s;
  }
  .mk__sd {
    font-size: var(--fs-small);
    color: var(--grafite);
  }
  /* The step being played */
  .mk__steps li.is-on {
    border-left-color: var(--mandarino);
  }
  .mk__steps li.is-on .mk__st {
    color: var(--inchiostro);
  }
  /* While the film runs, only the current description shows: less to read. */
  :global(.mk-live) .mk__steps li:not(.is-on) .mk__sd {
    display: none;
  }
  @media (max-width: 899px) {
    .mk__t {
      font-size: clamp(1.8rem, 1rem + 4vw, 2.4rem);
    }
    :global(.mk-live) .mk__steps li:not(.is-on) {
      display: none;
    }
    :global(.mk-live) .mk__steps {
      margin-block: 1rem 0;
      min-height: 4.5em;
    }
    :global(.mk-live) .mk__more {
      display: none;
    }
    .mk__in {
      gap: 1rem;
    }
    .mk__pin {
      padding-bottom: calc(var(--sticky-h) + 1rem);
    }
  }

  /* The words stay readable above the phone while it turns. */
  .mk__text {
    position: relative;
    z-index: 2;
  }
  .mk__stage {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
  }
  .mk__phone {
    position: relative;
    transform-style: preserve-3d;
  }
  /* ---------- 3D rig ---------- */
  .mk__rig {
    perspective: 1600px;
    perspective-origin: 50% 40%;
  }
  .mk__obj {
    position: relative;
    transform-style: preserve-3d;
    --w: clamp(190px, 34vh, 310px);
  }
  @media (max-width: 899px) {
    .mk__obj {
      --w: clamp(170px, 30vh, 240px);
    }
  }
  .mk__phone::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: calc(var(--w) * -0.07);
    height: calc(var(--w) * 0.1);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(60, 25, 8, 0.3), rgba(60, 25, 8, 0));
    z-index: -1;
  }
  .mk__screen {
    position: absolute;
    inset: 13.7cqw 0 0;
    overflow: hidden;
    background: #fff;
  }
  .mk__old,
  .mk__new {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* A desktop page squeezed onto the phone (180% wide, scaled to fit), like a real non-responsive
     site: tiny text, and the page fills the whole screen. */
  .mk__oldpage {
    width: 180%;
    height: 180%;
    transform-origin: 0 0;
    transform: scale(0.5556);
    background: #fffbe6;
  }
  .mk__oldpage :global(.os-wrap),
  .mk__oldpage :global(.os) {
    height: 100%;
  }
  .mk__new {
    background: #f2f2f0;
  }
  /* Final frame by default (no JS): the old page is hidden. */
  .mk__old {
    visibility: hidden;
  }
  :global(.mk-live) .mk__old {
    visibility: visible;
  }
  /* A band of light crossing the glass when the new site lands. */
  .mk__sweep {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -60%;
    width: 45%;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
    transform: skewX(-12deg);
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }
  .mk__finger {
    position: absolute;
    width: 11cqw;
    height: 11cqw;
    margin: -5.5cqw 0 0 -5.5cqw;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.65);
    box-shadow:
      0 0 0 1cqw rgba(29, 31, 33, 0.18),
      0 1cqw 3cqw rgba(0, 0, 0, 0.2);
    opacity: 0;
    z-index: 8;
    pointer-events: none;
  }

  /* The scan: a band of warm light running down the old site, finding the problems. */
  .mk__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -25%;
    height: 22%;
    background: linear-gradient(180deg, rgba(255, 91, 34, 0) 0%, rgba(255, 91, 34, 0.18) 70%, rgba(255, 91, 34, 0.75) 98%, rgba(255, 91, 34, 0) 100%);
    opacity: 0;
    visibility: hidden;
    z-index: 6;
    pointer-events: none;
  }
  /* Numbered boxes on the screen: red on the old site, green on the new one. */
  .mk__mark {
    position: absolute;
    left: 0;
    top: 0;
    border: 2px solid #d92d20;
    border-radius: 6px;
    background: rgba(217, 45, 32, 0.08);
    opacity: 0;
    visibility: hidden;
    z-index: 7;
    pointer-events: none;
  }
  .mk__mark i {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #d92d20;
    color: #fff;
    font: 700 11px/1 var(--font);
    font-style: normal;
  }
  .mk__mark--good {
    border-color: #1f8a4c;
    background: rgba(31, 138, 76, 0.08);
  }
  .mk__mark--good i {
    background: #1f8a4c;
  }

  /* Labels beside the phone, one per problem; each turns into its fix. Positioned by makeover.ts. */
  .mk__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    visibility: hidden;
  }
  :global(.mk-live) .mk__tags {
    visibility: visible;
  }
  .mk__tag {
    position: absolute;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: var(--carta);
    box-shadow: 0 12px 26px -14px rgba(60, 25, 8, 0.55);
    font-size: 0.86rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    z-index: 4;
  }
  .mk__dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    flex: none;
    background: #d92d20;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .mk__dot > span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .mk__tx {
    display: grid;
  }
  .mk__bad,
  .mk__good {
    grid-area: 1 / 1;
  }
  .mk__bad {
    color: #9b1c12;
  }
  .mk__good,
  .mk__dot-good {
    opacity: 0;
  }
  /* On phones the step line says it all: no labels around the phone. */
  @media (max-width: 899px) {
    .mk__tags {
      display: none;
    }
  }
</style>
<script>
  import { later } from "../scripts/later";
  later(() => import("../scripts/makeover").then((m) => m.initMakeover()));
</script>
