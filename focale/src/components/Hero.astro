---
/**
 * Home hero. Top: the promise in huge type. Below: the stage, a warm white panel with a phone.
 * On scroll (motion allowed) the panel opens to the full screen, an orange light rises behind
 * the phone and requests arrive one per caption. Without JS or with reduced motion everything
 * is shown at once, in its final state.
 */
import PhoneFrame from "./PhoneFrame.astro";
import ArcadiHero from "./demo/ArcadiHero.astro";
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import imgArcadi from "../assets/demo/arcadi-ristrutturazioni/cucina-dopo.jpg";
import imgCascina from "../assets/demo/cascina-rovere/hero.jpg";
import imgVilla from "../assets/demo/villa-ortensia/terrazza.jpg";

// The paths a visitor can take from the hero: one per sector, plus "something else".
const settori = (await getCollection("settori")).sort((a, b) => a.data.order - b.data.order);
const lavori = await getCollection("lavori");
const look: Record<string, { img: ImageMetadata; chip: string; title: string; cta: string }> = {
  "ristrutturazioni-e-serramenti": {
    img: imgArcadi,
    chip: "Ristrutturazioni e serramenti",
    title: "Per un'impresa edile il sito deve portare preventivi seri.",
    cta: "Voglio l'anteprima per la mia impresa",
  },
  "b-and-b-e-agriturismi": {
    img: imgCascina,
    chip: "B&B e agriturismi",
    title: "Per un agriturismo il sito deve far prenotare da te, non dai portali.",
    cta: "Voglio l'anteprima per la mia struttura",
  },
  "location-per-matrimoni": {
    img: imgVilla,
    chip: "Location per eventi",
    title: "Per una location il sito deve far venire voglia di visitarla.",
    cta: "Voglio l'anteprima per la mia location",
  },
};
const pathRules = [...settori.map((s) => s.id), "altro"]
  .map((id) => `.hero:has(input[value="${id}"]:checked) .path[data-path="${id}"]{display:grid}`)
  .join("");
const paths = settori.map((s) => {
  const demo = lavori.find((l) => l.id === s.data.demo)!;
  return { slug: s.id, data: s.data, demo, ...look[s.id] };
});

const story = [
  { n: "1", t: "Ti chiamano con un tocco.", d: "Il numero è sempre in alto." },
  { n: "2", t: "Ti scrivono con la richiesta già pronta.", d: "Cosa, dove, quando: su WhatsApp." },
  { n: "3", t: "E la trovi anche nella tua email.", d: "Non se ne perde nessuna." },
];
---
<section class="hero" data-hero data-hero-anim>
  <div class="wrap hero__top">
    <p class="hero__kicker" data-hero-fade>Studio di web design per piccole imprese, Milano</p>
    <h1 class="hero__title" data-hero-h1>
      <span class="hero__l" data-hero-line>Siti che fanno</span>
      <span class="hero__l hero__l--2" data-hero-line>squillare il telefono.</span>
    </h1>
    <div class="hero__cols">
      <p class="hero__aside" data-hero-fade>
        Imprese di ristrutturazione, serramentisti, B&amp;B, agriturismi e location per eventi in Lombardia.
      </p>
      <div class="hero__main" data-hero-fade>
        <p class="lead">
          Rifacciamo i siti delle piccole imprese perché portino richieste vere. Prima di spendere un euro, vedi l'anteprima del tuo.
        </p>
      </div>
    </div>

    <fieldset class="pick" data-pick data-hero-fade>
      <legend class="pick__q">Che attività hai?</legend>
      <div class="pick__opts">
        {
          paths.map((p) => (
            <label class="pick__opt">
              <input type="radio" name="percorso" value={p.slug} class="sr-only" data-path-input />
              <Image src={p.img} alt="" widths={[240, 480]} sizes="(min-width: 900px) 15vw, 40vw" class="pick__img" loading="eager" />
              <span class="pick__name">{p.chip}</span>
            </label>
          ))
        }
        <label class="pick__opt pick__opt--altro">
          <input type="radio" name="percorso" value="altro" class="sr-only" data-path-input />
          <span class="pick__plus" aria-hidden="true"></span>
          <span class="pick__name">Un'altra attività</span>
        </label>
      </div>
      <p class="small muted pick__note">
        Oppure <a class="link" href="/anteprima-gratuita">chiedi subito l'anteprima gratuita</a>: pronta in {site.previewHours} ore, senza impegno.
      </p>
    </fieldset>

    <style is:inline set:html={pathRules}></style>
    <div class="paths" data-paths aria-live="polite">
      {
        paths.map((p) => (
          <article class="path" data-path={p.slug} aria-label={p.chip}>
            <div class="path__media">
              <Image src={p.img} alt="" widths={[640, 960, 1400]} sizes="(min-width: 900px) 55vw, 92vw" class="path__img" data-path-img />
              <div class="path__phone" data-path-phone>
                <Image src={p.demo.data.shotPhone} alt={`Il sito dimostrativo di ${p.demo.data.name} visto dal telefono`} widths={[240, 480]} sizes="200px" />
              </div>
            </div>
            <div class="path__body">
              <p class="path__kicker" data-path-item>{p.chip}</p>
              <h2 class="path__title" data-path-item>{p.title}</h2>
              <ul class="path__list" data-path-item>
                {p.data.build.slice(0, 3).map((b) => <li>{b}</li>)}
              </ul>
              <div class="path__mock" data-path-item>
                <p class="path__mock-h">{p.data.mock.heading}</p>
                <dl>
                  {p.data.mock.lines.slice(0, 3).map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <div class="btn-row" data-path-item>
                <a class="btn btn--primary" href={`/anteprima-gratuita?settore=${p.slug}`} data-magnetic>{p.cta}</a>
                <a class="btn btn--secondary" href={`/lavori/${p.demo.id}/demo/`}>Guarda il sito demo</a>
              </div>
              <a class="textlink path__more" href={`/per/${p.slug}/`} data-path-item>Tutto per {p.chip.toLowerCase()}</a>
            </div>
          </article>
        ))
      }
      <article class="path path--altro" data-path="altro" aria-label="Un'altra attività">
        <div class="path__body">
          <h2 class="path__title" data-path-item>Fai un altro lavoro? Raccontacelo.</h2>
          <p class="lead" data-path-item>
            Partiamo da imprese edili, strutture ricettive e location, ma il metodo è lo stesso per ogni piccola impresa che vive di richieste.
          </p>
          <div class="btn-row" data-path-item>
            <a class="btn btn--primary" href="/anteprima-gratuita" data-magnetic>Voglio l'anteprima gratuita</a>
            <a class="btn btn--secondary" href="/lavori/">Guarda i lavori</a>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="lens" data-lens>
    <figure class="lens__frame" data-lens-frame>
      <div class="lens__glow" data-lens-glow aria-hidden="true"></div>
      <p class="lens__head">Un sito fatto bene lavora mentre lavori tu.</p>
      <div class="lens__phone" data-lens-phone>
        <PhoneFrame label="Esempio: il sito di un'impresa di ristrutturazioni visto dal telefono, mentre arrivano le richieste">
          <div class="lens__canvas"><ArcadiHero /></div>
          <div class="notifs" slot="overlay">
            <div class="notif notif--call" data-notif>
              <span class="notif__icon" aria-hidden="true"><Icon name="phone" size={17} /></span>
              <span class="notif__body">
                <strong>Chiamata in arrivo</strong>
                <span>Dal pulsante Chiama del tuo sito</span>
              </span>
            </div>
            <div class="notif" data-notif>
              <span class="notif__icon notif__icon--wa" aria-hidden="true"><Icon name="whatsapp" size={17} /></span>
              <span class="notif__body">
                <strong>Nuova richiesta di preventivo</strong>
                <span>Bagno completo, zona Città Studi. Vorrebbero iniziare a marzo.</span>
              </span>
            </div>
            <div class="notif" data-notif>
              <span class="notif__icon notif__icon--mail" aria-hidden="true"><Icon name="mail" size={17} /></span>
              <span class="notif__body">
                <strong>Copia della richiesta</strong>
                <span>Nella tua email, con tutti i dettagli.</span>
              </span>
            </div>
          </div>
        </PhoneFrame>
      </div>
      <ol class="lens__story">
        {
          story.map((s) => (
            <li class="lens__step" data-lens-step>
              <span class="lens__n" aria-hidden="true">{s.n}</span>
              <p class="lens__t">{s.t}</p>
              <p class="lens__d">{s.d}</p>
            </li>
          ))
        }
      </ol>
      <figcaption class="lens__cap">
        Arcadi Ristrutturazioni, progetto dimostrativo per un'attività inventata.
        <a class="link" href="/lavori/arcadi-ristrutturazioni/">Il progetto</a>
      </figcaption>
    </figure>
  </div>

  <ul class="wrap hero__trust">
    <li><span>Parli con chi costruisce il sito, non con un centralino.</span></li>
    <li><span>Saldo solo a sito approvato.</span></li>
    <li><span>Il sito, il dominio e gli accessi sono tuoi.</span></li>
  </ul>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 0.5rem + 3vw, 3.5rem);
    overflow-x: clip;
  }
  .hero__kicker {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--grafite);
    margin-bottom: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }
  .hero__title {
    font-size: min(var(--fs-mega), 7.6vw);
    line-height: 0.95;
  }
  .hero__l {
    display: block;
    white-space: nowrap;
  }
  .hero__l--2 {
    padding-left: 6vw;
  }
  @media (max-width: 699px) {
    .hero__title {
      font-size: clamp(2.5rem, 0.6rem + 9.4vw, 3.9rem);
    }
    .hero__l {
      white-space: normal;
    }
    .hero__l--2 {
      padding-left: 0;
    }
  }
  .hero__cols {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .hero__cols {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    }
    .hero__aside {
      grid-column: 1 / span 3;
    }
    .hero__main {
      grid-column: 6 / span 7;
    }
  }
  .hero__aside {
    font-size: var(--fs-small);
    color: var(--grafite);
    max-width: 26ch;
    padding-top: 0.45rem;
  }
  .hero__main .lead {
    max-width: 38ch;
  }
  .hero__btns {
    margin: 2.25rem 0 1rem;
  }

  /* ---------- Sector chooser ---------- */
  .pick {
    border: 0;
    margin: clamp(1.5rem, 1rem + 1.5vw, 2.5rem) 0 0;
    padding: 0;
    min-width: 0;
  }
  .pick__q {
    padding: 0;
    font-weight: 300;
    font-stretch: 125%;
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .pick__opts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  @media (min-width: 900px) {
    .pick__opts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.9rem;
    }
  }
  .pick__opt {
    position: relative;
    display: grid;
    align-items: end;
    height: clamp(112px, 6rem + 4vw, 160px);
    border-radius: 20px;
    overflow: hidden;
    background: var(--nebbia);
    cursor: pointer;
    isolation: isolate;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .pick__opt :global(.pick__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transition: transform 0.8s var(--ease-out);
  }
  .pick__opt:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -22px rgba(120, 40, 5, 0.5);
  }
  .pick__opt:hover :global(.pick__img) {
    transform: scale(1.06);
  }
  .pick__name {
    justify-self: start;
    margin: 0.6rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-ui);
    background: rgba(255, 248, 242, 0.95);
    font-weight: 500;
    font-size: 0.92rem;
    line-height: 1.2;
    transition: background-color 0.25s ease;
  }
  .pick__opt:has(input:checked) {
    box-shadow:
      0 0 0 3px var(--carta),
      0 0 0 6px var(--mandarino);
  }
  .pick__opt:has(input:checked) .pick__name {
    background: var(--mandarino);
  }
  .pick__opt:has(input:focus-visible) {
    outline: 2px solid var(--inchiostro);
    outline-offset: 8px;
  }
  .pick__opt--altro {
    background:
      radial-gradient(120% 120% at 100% 100%, rgba(255, 91, 34, 0.75), rgba(255, 178, 63, 0.4) 40%, rgba(252, 235, 220, 0) 75%),
      var(--nebbia);
  }
  .pick__plus {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1.5px solid var(--inchiostro);
    border-radius: 50%;
    background:
      linear-gradient(var(--inchiostro), var(--inchiostro)) center / 12px 1.5px no-repeat,
      linear-gradient(var(--inchiostro), var(--inchiostro)) center / 1.5px 12px no-repeat;
  }
  .pick__note {
    margin-top: 1rem;
  }

  /* ---------- The chosen path ---------- */
  .paths {
    margin-top: 1rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .path {
    display: none;
    background: var(--nebbia);
    border-radius: clamp(22px, 1vw + 14px, 32px);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .path {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  .path__media {
    position: relative;
    min-height: clamp(260px, 30vw, 520px);
    overflow: hidden;
  }
  .path__media :global(.path__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .path__phone {
    position: absolute;
    right: 7%;
    bottom: -14%;
    width: clamp(120px, 12vw, 200px);
    border: 7px solid #1b1f1d;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 30px 60px -25px rgba(60, 25, 8, 0.6);
  }
  .path__phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .path__body {
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
  }
  .path__kicker {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--grafite);
  }
  .path__title {
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.04;
    max-width: 18ch;
  }
  .path__list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    border-top: 1px solid var(--filo);
  }
  .path__list li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--filo);
    font-size: 0.98rem;
  }
  .path__mock {
    width: min(100%, 22rem);
    background: var(--carta);
    border-radius: 14px;
    padding: 0.8rem 1rem;
    box-shadow: 0 14px 30px -20px rgba(60, 25, 8, 0.45);
    font-size: 0.85rem;
  }
  .path__mock-h {
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .path__mock dl {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .path__mock dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .path__mock dt {
    color: var(--grafite);
  }
  .path__mock dd {
    margin: 0;
    font-weight: 500;
  }
  .path__more {
    margin-top: 0.25rem;
  }
  .path--altro {
    background:
      radial-gradient(90% 140% at 100% 100%, rgba(255, 91, 34, 0.7), rgba(255, 178, 63, 0.35) 40%, rgba(252, 235, 220, 0) 72%),
      var(--nebbia);
  }
  .path--altro .path__body {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .path--altro .lead {
    max-width: 44ch;
  }

  /* ---------- The stage: warm white with an orange light ---------- */
  .lens {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    --inset-x: var(--gutter);
    --inset-y: 0px;
    --r: clamp(22px, 1.2vw + 14px, 34px);
  }
  .lens__frame {
    position: relative;
    margin: 0;
    min-height: min(100svh, 1000px);
    background: var(--nebbia);
    color: var(--inchiostro);
    overflow: hidden;
    clip-path: inset(var(--inset-y) var(--inset-x) round var(--r));
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(1.1rem, 0.6rem + 2.2vh, 2.25rem);
    padding: clamp(2rem, 1rem + 4vh, 4rem) calc(var(--gutter) * 2) clamp(3.5rem, 2rem + 4vh, 4.5rem);
  }
  @media (min-width: 900px) {
    .lens__frame {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(2rem, 1rem + 3vw, 5rem);
    }
    .lens__head {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .lens__phone {
      grid-column: 2;
      grid-row: 1;
    }
    .lens__story {
      grid-column: 3;
      grid-row: 1;
      justify-self: start;
    }
  }
  .lens__glow {
    position: absolute;
    left: 50%;
    top: 100%;
    width: max(1000px, 120vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      #ff5b22 0%,
      rgba(255, 91, 34, 0.92) 22%,
      rgba(255, 140, 50, 0.75) 38%,
      rgba(255, 178, 63, 0.5) 55%,
      rgba(255, 211, 188, 0.28) 75%,
      rgba(252, 235, 220, 0) 100%
    );
    pointer-events: none;
  }
  .lens__head {
    position: relative;
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(1.5rem, 0.6rem + 2vw + 1vh, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
    max-width: 12ch;
  }
  .lens__phone {
    position: relative;
  }
  /* The phone is sized by the screen height so the stage always fits in one view. */
  .lens__phone :global(.pf) {
    --pw: 150;
    box-shadow:
      0 50px 90px -40px rgba(120, 40, 5, 0.55),
      0 16px 30px -18px rgba(60, 25, 8, 0.35);
  }
  @media (min-height: 720px) {
    .lens__phone :global(.pf) {
      --pw: 180;
    }
  }
  @media (min-height: 800px) {
    .lens__phone :global(.pf) {
      --pw: 205;
    }
  }
  @media (min-height: 880px) {
    .lens__phone :global(.pf) {
      --pw: 240;
    }
  }
  @media (min-height: 880px) and (min-width: 900px) {
    .lens__phone :global(.pf) {
      --pw: 290;
    }
  }
  /* Stacked layout (head, phone, captions in one column) needs a shorter phone. */
  @media (max-width: 899px) {
    .lens__phone :global(.pf) {
      --pw: 140;
    }
  }
  @media (max-width: 899px) and (min-height: 720px) {
    .lens__phone :global(.pf) {
      --pw: 165;
    }
  }
  @media (max-width: 899px) and (min-height: 800px) {
    .lens__phone :global(.pf) {
      --pw: 180;
    }
  }
  @media (max-width: 899px) and (min-height: 900px) {
    .lens__phone :global(.pf) {
      --pw: 205;
    }
  }
  @media (max-width: 899px) and (min-height: 1100px) {
    .lens__phone :global(.pf) {
      --pw: 260;
    }
  }
  .lens__canvas {
    width: 390px;
    height: 844px;
    padding-top: 34px;
    box-sizing: border-box;
    background: #f2f2f0;
  }
  .lens__story {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.6rem;
    max-width: 24rem;
  }
  .lens__step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    align-items: baseline;
  }
  .lens__n {
    font-weight: 600;
    font-size: var(--fs-micro);
    width: 1.9rem;
    height: 1.9rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    translate: 0 -0.15rem;
  }
  .lens__t {
    font-weight: 400;
    font-stretch: 125%;
    font-size: clamp(1.1rem, 0.95rem + 0.5vw, 1.5rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .lens__d {
    grid-column: 2;
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    max-width: 30ch;
  }
  .lens__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.1rem;
    padding-inline: calc(var(--gutter) * 2);
    font-size: var(--fs-micro);
    z-index: 1;
  }
  .lens__cap .link {
    color: inherit;
  }
  @media (max-width: 899px) {
    .lens__head {
      text-align: center;
      max-width: 18ch;
