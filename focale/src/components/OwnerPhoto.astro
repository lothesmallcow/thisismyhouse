---
import { Image } from "astro:assets";
import { site } from "../config/site";
import { isPlaceholder } from "../lib/util";
interface Props {
  size?: "sm" | "lg";
}
const { size = "lg" } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/chi-sono.{jpg,jpeg,png,webp}", { eager: true });
const photo = site.photo ? Object.values(photos)[0]?.default : undefined;
const initial = isPlaceholder(site.ownerFirstName) ? "?" : site.ownerFirstName.charAt(0).toUpperCase();
---
{
  photo ? (
    <figure class:list={["op", `op--${size}`]}>
      <Image src={photo} alt={`Foto di ${site.ownerFirstName}`} widths={[360, 720]} sizes="(min-width: 768px) 360px, 100vw" />
    </figure>
  ) : (
    <figure class:list={["op", "op--empty", `op--${size}`]} data-placeholder aria-label="Foto da aggiungere">
      <span class="op__initial" aria-hidden="true">{initial}</span>
      <span class="op__bar" aria-hidden="true" />
    </figure>
  )
}
<style>
  .op {
    margin: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 26rem;
    position: relative;
    background: var(--pietra);
    overflow: hidden;
  }
  .op--sm {
    max-width: 14rem;
  }
  .op img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .op--empty {
    display: grid;
    place-items: center;
  }
  .op {
    border-radius: 18px;
  }
  .op__initial {
    font-weight: 200;
    font-stretch: 100%;
    font-size: 9rem;
    letter-spacing: -0.05em;
    color: var(--inchiostro);
    line-height: 1;
  }
  .op__bar {
    display: none;
  }
</style>
