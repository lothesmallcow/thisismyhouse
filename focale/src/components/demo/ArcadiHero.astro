---
/**
 * Arcadi Ristrutturazioni hero. Laid out with container queries so the same markup works in
 * the home phone mockup, in the renovation demo (desktop frame and phone frame) and on the
 * full demo site. Grid areas mirror OldSite so each new piece sits exactly on the old one.
 */
import { Image } from "astro:assets";
import photo from "../../assets/demo/arcadi-ristrutturazioni/bagno-dopo.jpg";
interface Props {
  eager?: boolean;
  class?: string;
  callHref?: string;
  quoteHref?: string;
  headingTag?: "h1" | "p";
}
const { eager = false, class: cls, callHref, quoteHref, headingTag = "p" } = Astro.props;
const Tag = headingTag;
const CallEl = callHref ? "a" : "span";
const QuoteEl = quoteHref ? "a" : "span";
---
<div class:list={["ah-wrap", cls]}>
  <div class="ah">
    <div class="ah__header" data-piece="header">
      <span class="ah__logo">ARCADI<small>Ristrutturazioni</small></span>
      <span class="ah__phone">
        <span class="ah__phone-label">Chiama</span>
        <span class="ah__call" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>
        </span>
      </span>
    </div>
    <div class="ah__title" data-piece="title">
      <p class="ah__kicker">Milano e prima cintura</p>
      <Tag class="ah__h1" data-headline>Ristrutturiamo case a Milano. Bene, e nei tempi detti.</Tag>
    </div>
    <div class="ah__photo" data-piece="photo">
      <Image src={photo} alt="Bagno ristrutturato con doccia in vetro e mobile in legno" widths={[390, 640, 960]} sizes="(min-width: 1000px) 560px, 390px" loading={eager ? "eager" : "lazy"} />
    </div>
    <p class="ah__text" data-piece="text">Bagni, cucine e appartamenti completi. Sopralluogo e preventivo gratuiti entro 48 ore.</p>
    <div class="ah__cta" data-piece="cta">
      <QuoteEl class="ah__btn ah__btn--main" href={quoteHref}>Chiedi un preventivo</QuoteEl>
      <CallEl class="ah__btn ah__btn--ghost" href={callHref}>Chiama ora</CallEl>
    </div>
    <ul class="ah__extra" data-piece="extra">
      <li>Preventivo scritto</li>
      <li>Cantiere pulito</li>
      <li>Garanzia sui lavori</li>
    </ul>
    <p class="ah__foot" data-piece="foot">Ultimo lavoro consegnato: bagno in zona Lambrate, settembre 2026.</p>
  </div>
</div>
<style>
  .ah-wrap {
    container-type: inline-size;
    width: 100%;
    height: 100%;
  }
  .ah {
    --o: #c4510e;
    --ink: #1d1f21;
    --bg: #f2f2f0;
    height: 100%;
    box-sizing: border-box;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-head);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: "header" "photo" "title" "text" "cta" "extra" "foot";
    align-content: start;
    overflow: hidden;
  }
  .ah > * {
    background: var(--bg);
  }
  .ah__header {
    grid-area: header;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
  }
  .ah__logo {
    font-weight: 900;
    font-stretch: 68%;
    font-size: 26px;
    letter-spacing: 0.02em;
    line-height: 1;
    display: flex;
    flex-direction: column;
  }
  .ah__logo small {
    font-size: 11px;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0.08em;
    color: var(--o);
  }
  .ah__phone {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 15px;
  }
  .ah__phone-label {
    display: none;
  }
  .ah__call {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--o);
    color: #fff;
  }
  .ah__photo {
    grid-area: photo;
    overflow: hidden;
  }
  .ah__photo img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .ah__title {
    grid-area: title;
    padding: 20px 18px 0;
  }
  .ah__kicker {
    font-size: 13px;
    font-weight: 700;
    color: var(--o);
    margin-bottom: 8px;
  }
  .ah__h1 {
    font-family: var(--font-head);
    font-weight: 820;
    font-stretch: 100%;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ah__text {
    grid-area: text;
    font-size: 16px;
    line-height: 1.45;
    padding: 12px 18px 0;
    color: #3f4347;
    font-weight: 450;
    margin: 0;
  }
  .ah__cta {
    grid-area: cta;
    display: grid;
    gap: 10px;
    padding: 18px 18px 0;
  }
  .ah__btn {
    display: grid;
    place-items: center;
    min-height: 52px;
    padding: 0 16px;
    border-radius: 4px;
    font-weight: 750;
    font-size: 17px;
    text-decoration: none;
    color: inherit;
  }
  .ah__btn--main {
    background: var(--o);
    color: #fff;
  }
  .ah__btn--ghost {
    border: 2px solid var(--ink);
  }
  .ah__extra {
    grid-area: extra;
    list-style: none;
    padding: 18px 18px 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
  }
  .ah__extra li {
    padding: 6px 10px;
    background: #e2e2de;
    border-radius: 3px;
  }
  .ah__foot {
    grid-area: foot;
    font-size: 12px;
    color: #55595d;
    padding: 18px 18px 22px;
    margin: 0;
  }

  @container (min-width: 520px) {
    .ah {
      grid-template-columns: 42% 1fr;
      grid-template-areas: "header header" "title title" "photo text" "photo cta" "extra extra" "foot foot";
    }
    .ah__phone-label {
      display: inline;
    }
    .ah__header {
      border-bottom: 1px solid #dcdcd8;
    }
    .ah__h1 {
      font-size: 32px;
    }
    .ah__photo {
      margin: 16px 0 0 18px;
    }
    .ah__photo img {
      aspect-ratio: 4 / 3;
    }
    .ah__text {
      padding-top: 16px;
      font-size: 15px;
    }
    .ah__cta {
      grid-template-columns: 1fr 1fr;
      align-content: start;
    }
    .ah__btn {
      font-size: 15px;
      min-height: 44px;
    }
  }
  @container (min-width: 960px) {
    .ah {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "header header" "title photo" "text photo" "cta photo" "extra photo" "foot foot";
      column-gap: 48px;
    }
    .ah__header {
      padding: 18px 40px;
    }
    .ah__title {
      padding: 64px 0 0 40px;
    }
    .ah__h1 {
      font-size: 60px;
    }
    .ah__text {
      font-size: 19px;
      padding: 20px 0 0 40px;
      max-width: 34ch;
    }
    .ah__cta {
      padding: 28px 0 0 40px;
      grid-template-columns: auto auto;
      justify-content: start;
    }
    .ah__btn {
      min-height: 54px;
      font-size: 17px;
      padding: 0 24px;
    }
    .ah__extra {
      padding: 24px 0 0 40px;
      font-size: 14px;
    }
    .ah__photo {
      margin: 0;
    }
    .ah__photo img {
      aspect-ratio: 4 / 5;
      max-height: 640px;
    }
    .ah__foot {
      padding: 18px 40px;
      border-top: 1px solid #dcdcd8;
      font-size: 14px;
    }
  }
</style>
