---
/**
 * Before/after comparison that fills whatever box it is given (the hero, a gallery cell).
 * Same mechanism as BeforeAfter.astro: a native range input drives it, so arrows, touch and
 * screen readers work. The line moves with transform (container units), never with left.
 * `intro`: with motion allowed, the line sweeps once to show it can be dragged (on load for the
 * hero, when it scrolls in otherwise) and stops for good at the first touch.
 */
import { Image } from "astro:assets";
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  /** What the picture shows, e.g. "bagno in zona Lambrate" (prefixed with Prima/Dopo). */
  alt: string;
  /** Read out by the slider, e.g. "Bagno, zona Lambrate, 9 giorni di lavoro". */
  label: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  intro?: "load" | "view";
  class?: string;
}
const { before, after, alt, label, widths = [480, 800, 1200], sizes = "(min-width: 900px) 50vw, 100vw", eager = false, intro, class: cls } = Astro.props;
const loading = eager ? "eager" : "lazy";
const priority = eager ? "high" : undefined;
---
<figure class:list={["cmp", cls]} data-cmp data-intro={intro} style="--pos: 50">
  <div class="cmp__media">
    <Image src={before} alt={`Prima: ${alt}`} widths={widths} sizes={sizes} loading={loading} fetchpriority={priority} class="cmp__img" />
    <div class="cmp__after">
      <Image src={after} alt={`Dopo: ${alt}`} widths={widths} sizes={sizes} loading={loading} fetchpriority={priority} class="cmp__img" />
    </div>
    <span class="cmp__tag cmp__tag--l" aria-hidden="true">Prima</span>
    <span class="cmp__tag cmp__tag--r" aria-hidden="true">Dopo</span>
    <span class="cmp__line" aria-hidden="true"><span class="cmp__knob"></span></span>
    <input class="cmp__range" type="range" min="0" max="100" value="50" aria-label={`Confronta prima e dopo: ${label}`} />
  </div>
  <slot />
</figure>
<style>
  .cmp {
    position: relative;
    margin: 0;
  }
  .cmp__media {
    position: relative;
    container-type: inline-size;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: #d9d4cc;
    touch-action: pan-y;
  }
  .cmp__media :global(.cmp__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cmp__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 calc(var(--pos) * 1%));
  }
  .cmp__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    transform: translateX(calc(var(--pos) * 1cqw));
    pointer-events: none;
  }
  .cmp__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--knob, 56px);
    height: var(--knob, 56px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 20px rgba(10, 25, 20, 0.28);
  }
  /* Two chevrons, drawn as borders: no glyphs that a phone could turn into emoji. */
  .cmp__knob::before,
  .cmp__knob::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    border: solid var(--knob-ink, #1e3b34);
    border-width: 0 0 2.5px 2.5px;
  }
  .cmp__knob::before {
    left: 28%;
    transform: translateY(-50%) rotate(45deg);
  }
  .cmp__knob::after {
    right: 28%;
    transform: translateY(-50%) rotate(-135deg);
  }
  .cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .cmp__media:has(.cmp__range:focus-visible) {
    outline: 3px solid var(--cmp-focus, #1e3b34);
    outline-offset: 3px;
  }
  .cmp__tag {
    position: absolute;
    top: var(--tag-top, 14px);
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: #1e3b34;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    pointer-events: none;
  }
  .cmp__tag--l {
    left: var(--tag-x, 14px);
  }
  .cmp__tag--r {
    right: var(--tag-x, 14px);
  }
</style>
<script>
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
  // One sweep: right, left, back to the middle. Eased, about 2.4 s.
  const sweep = (fig: HTMLElement, r: HTMLInputElement) => {
    const keys = [50, 74, 28, 50];
    const seg = 800;
    let t0 = 0;
    let stop = false;
    const halt = () => (stop = true);
    r.addEventListener("pointerdown", halt, { once: true });
    r.addEventListener("keydown", halt, { once: true });
    r.addEventListener("focus", halt, { once: true });
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const frame = (now: number) => {
      if (stop) return;
      if (!t0) t0 = now;
      const t = (now - t0) / seg;
      const i = Math.min(Math.floor(t), keys.length - 2);
      const v = keys[i] + (keys[i + 1] - keys[i]) * ease(Math.min(t - i, 1));
      fig.style.setProperty("--pos", v.toFixed(2));
      r.value = String(Math.round(v));
      if (t < keys.length - 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  };
  document.querySelectorAll<HTMLElement>("[data-cmp]").forEach((fig) => {
    const r = fig.querySelector<HTMLInputElement>(".cmp__range")!;
    const set = () => fig.style.setProperty("--pos", r.value);
    r.addEventListener("input", set);
    set();
    const intro = fig.dataset.intro;
    if (!motion || !intro) return;
    if (intro === "load") {
      window.setTimeout(() => sweep(fig, r), 900);
      return;
    }
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        window.setTimeout(() => sweep(fig, r), 250);
      },
      { threshold: 0.6 },
    );
    io.observe(fig);
  });
</script>
