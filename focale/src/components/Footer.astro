---
import Logo from "./Logo.astro";
import P from "./P.astro";
import { site } from "../config/site";
import { whatsappHref, telHref, mailHref } from "../lib/util";
const year = new Date().getFullYear();
---
<footer class="ftr section--sole">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__intro">
        <p class="ftr__claim">Siti web per piccole imprese che vogliono più richieste.</p>
        <p class="ftr__where">Lavoriamo da Milano, per tutta la Lombardia e online.</p>
        <a href="/anteprima-gratuita" class="btn btn--primary">Voglio l'anteprima gratuita</a>
      </div>
      <nav class="ftr__cols" aria-label="Piè di pagina">
        <div>
          <h2>Studio</h2>
          <ul>
            <li><a href="/come-funziona">Come funziona</a></li>
            <li><a href="/prezzi">Prezzi</a></li>
            <li><a href="/lavori">Lavori</a></li>
            <li><a href="/chi-sono">Lo studio</a></li>
            <li><a href="/anteprima-gratuita">Anteprima gratuita</a></li>
          </ul>
        </div>
        <div>
          <h2>Settori</h2>
          <ul>
            <li><a href="/per/ristrutturazioni-e-serramenti">Imprese di ristrutturazione e serramenti</a></li>
            <li><a href="/per/b-and-b-e-agriturismi">B&amp;B e agriturismi</a></li>
            <li><a href="/per/location-per-matrimoni">Location per matrimoni</a></li>
          </ul>
        </div>
        <div>
          <h2>Contatti</h2>
          <ul>
            <li><a href={whatsappHref(`Ciao, vi scrivo dal sito di ${site.brand}.`)} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={telHref()}><P value={site.phoneDisplay} /></a></li>
            <li><a href={mailHref()}><P value={site.email} /></a></li>
          </ul>
        </div>
        <div>
          <h2>Legale</h2>
          <ul>
            <li><a href="/condizioni">Condizioni del servizio</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/cookie">Cookie</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <a href="/" class="ftr__mark" aria-label={`${site.brand}, torna alla home`}><Logo /></a>
    <div class="ftr__legal">
      <p>
        © {year} <P value={site.legalName} />. P.IVA <P value={site.vatNumber} />. <P value={site.registeredAddress} />.
      </p>
      <p>Sito costruito da {site.brand}, ovviamente.</p>
    </div>
  </div>
</footer>
<style>
  .ftr {
    background: var(--mandarino);
    color: var(--inchiostro);
    padding: clamp(4.5rem, 3rem + 6vw, 9rem) 0 2rem;
  }
  .ftr a:not(.btn) {
    color: var(--inchiostro);
  }
  .ftr__top {
    display: grid;
    gap: 4rem;
  }
  @media (min-width: 1000px) {
    .ftr__top {
      grid-template-columns: 1fr 1.5fr;
      gap: 3rem;
    }
  }
  .ftr__claim {
    font-weight: 300;
    font-stretch: 125%;
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 18ch;
  }
  .ftr__where {
    margin: 1rem 0 2rem !important;
    color: #3a1a0b;
  }
  .ftr__cols {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .ftr h2 {
    font-size: var(--fs-micro);
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
    color: #3a1a0b;
    margin-bottom: 1rem;
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .ftr ul a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.9375rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }
  .ftr ul a:hover {
    background-size: 100% 1px;
  }
  .ftr__mark {
    display: block;
    margin: clamp(4rem, 2rem + 8vw, 9rem) 0 2rem;
  }
  .ftr__mark :global(.logo) {
    width: 100%;
    height: auto;
  }
  .ftr__legal {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(36, 19, 12, 0.22);
    font-size: var(--fs-micro);
    color: #3a1a0b;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .ftr__legal p + p {
    margin: 0;
  }
</style>
