---
/**
 * A living background for the home: warm light (latte, peach, honey, a touch of tangerine)
 * slowly flowing behind the content, like the gradient backgrounds of product sites.
 * WebGL shader with fine grain against banding; drifts with time, follows the pointer softly
 * and warms up as the page goes on. Stays light enough that cacao text keeps its contrast.
 * Without WebGL or with reduced motion: a still CSS gradient (the same colours).
 */
---
<div class="live" aria-hidden="true">
  <canvas class="live__c" data-live></canvas>
</div>
<style>
  .live {
    position: fixed;
    inset: 0 0 auto;
    /* The large viewport height: constant while Safari's bars come and go. */
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 85% 20%, rgba(255, 178, 63, 0.28), rgba(255, 178, 63, 0) 70%),
      radial-gradient(70% 60% at 10% 90%, rgba(255, 140, 90, 0.22), rgba(255, 140, 90, 0) 70%),
      #fff8f2;
  }
  .live__c {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .live__c.is-on {
    opacity: 1;
  }
</style>
<script>
  import { later } from "../scripts/later";
  later(() => import("../scripts/live").then((m) => m.initLive()));
</script>
