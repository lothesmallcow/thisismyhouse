---
/**
 * The section marker: a thick bar that turns down at its left end like the corner of an
 * autofocus frame. One per major section, never stacked, never decorative.
 */
interface Props {
  dark?: boolean;
  class?: string;
}
const { dark = false, class: cls } = Astro.props;
---
<div class:list={["fuoco", { "fuoco--dark": dark }, cls]} aria-hidden="true"></div>
<style>
  .fuoco {
    position: relative;
    width: min(100%, 44rem);
    height: var(--bar);
    background: var(--pietra-scura);
    margin-bottom: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
  }
  .fuoco::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: var(--bar);
    height: calc(var(--bar) * 3);
    background: inherit;
  }
  :global(.section--pietra) .fuoco {
    background: var(--calce);
  }
  .fuoco--dark,
  :global(.section--dark) .fuoco {
    background: var(--ottone);
  }
</style>
