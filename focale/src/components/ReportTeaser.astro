---
/**
 * Home: the example report next to the site it judges. The site ("Respiro", invented, says so) looks
 * polished, yet scores about half: the card shows the score ring, then the site in a phone with a pin
 * on every spot that costs points (ExampleSite.astro), the climb after the first five fixes, and the
 * way into the full report. Everything comes from the real engine run on that page at build time.
 */
import { sample } from "../scorer/samples";
import ExampleSite from "./ExampleSite.astro";

const r = sample.results.fitness.report;
const HUE: Record<string, number> = { speed: 35, conversion: 80, local: 135, trust: 180, a11y: 240, legal: 290, content: 345 };
const col = (id: string) => `oklch(0.72 0.15 ${HUE[id] ?? 250})`;
const verdict = (v: number) => (v >= 90 ? "Ottimo" : v >= 75 ? "Buono" : v >= 50 ? "Discreto" : "Da sistemare");

const measuredMax = r.checks.filter((c) => c.max > 0 && c.status !== "unmeasured").reduce((t, c) => t + c.max, 0) || 100;
const after = Math.min(100, Math.round(r.total + r.fixes.reduce((t, f) => t + f.gain, 0) * (100 / measuredMax)));
const lostTotal = Math.round(r.checks.reduce((t, c) => t + Math.max(0, c.max - c.earned), 0));

const cats = r.categories.filter((c) => c.max > 0);
const R = 120;
const C = 2 * Math.PI * R;
const GAP = 8;
const total = cats.reduce((t, c) => t + c.max, 0) || 100;
let start = 0;
const arcs = cats.map((c) => {
  const len = (c.max / total) * C - GAP;
  const off = -(start + GAP / 2);
  start += (c.max / total) * C;
  return { id: c.id, len, off, got: len * (c.earned / c.max) };
});
const host = r.url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---
<div class="rt" data-rt>
  <div class="rt__top">
    <div class="rt__say">
      <p class="rt__pill">Esempio su un sito inventato: {host}</p>
      <h3 class="rt__h">Bello da vedere.<br />{r.total} su 100.</h3>
      <p class="rt__line">Il sito sembra curato, ma perde {lostTotal} punti in cose che a colpo d'occhio non si notano. Tocca un punto e guarda dove si trova.</p>
    </div>
    <div class="rt__ring" role="img" aria-label={`Voto ${r.total} su 100: ${verdict(r.total)}`}>
      <svg viewBox="0 0 300 300" aria-hidden="true" focusable="false">
        {arcs.map((a) => (
          <>
            <circle class="rt__arc" cx="150" cy="150" r={R} stroke="#EDEDF0" stroke-dasharray={`${a.len} ${C}`} stroke-dashoffset={a.off} />
            {a.got > 0.5 && <circle class="rt__arc rt__fill" cx="150" cy="150" r={R} stroke={col(a.id)} stroke-dasharray={`${a.got} ${C}`} stroke-dashoffset={a.off} />}
          </>
        ))}
      </svg>
      <span class="rt__score" aria-hidden="true">
        <span class="rt__n" data-rt-n data-to={r.total}>{r.total}</span>
        <span class="rt__w">{verdict(r.total)}</span>
      </span>
    </div>
  </div>

  <h4 class="sr-only" id="home-xs-t">Dove perde punti</h4>
  <ExampleSite id="home-xs" limit={6} />

  <div class="rt__end">
    <p class="rt__climb">
      <span class="rt__climb-t">Con le prime {r.fixes.length} correzioni</span>
      <span class="rt__climb-n"><span>{r.total}</span><span class="rt__arrow" aria-hidden="true">→</span><span class="sr-only">diventa</span><span class="rt__to">{after}</span></span>
    </p>
    <div class="rt__links">
      <a class="btn btn--secondary rt__cta" href="/analisi-sito/?esempio=1#voto-esempio">Apri il report completo</a>
      <a class="textlink" href="/esempi/respiro/" target="_blank" rel="noopener">Guarda il sito d'esempio dal vivo</a>
    </div>
  </div>
</div>

<script>
  const card = document.querySelector<HTMLElement>("[data-rt]");
  if (card && window.matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
    card.classList.add("rt--wait");
    const n = card.querySelector<HTMLElement>("[data-rt-n]")!;
    const to = Number(n.dataset.to);
    n.textContent = "0";
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        requestAnimationFrame(() => card.classList.remove("rt--wait"));
        const t0 = performance.now() + 200;
        const tick = (t: number) => {
          const p = Math.max(0, Math.min(1, (t - t0) / 1400));
          n.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.25 },
    );
    io.observe(card);
  }
</script>

<style>
  .rt {
    container-type: inline-size;
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 0.5rem + 2.5vw, 3rem);
    border-radius: var(--radius-card);
    background: #fff;
  }
  .rt__top {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @container (min-width: 620px) {
    .rt__top {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem;
    }
  }
  .rt__say {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .rt__pill {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--nebbia);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .rt__h {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .rt__line {
    max-width: 46ch;
    color: var(--grafite);
  }
  .rt__ring {
    position: relative;
    width: 10rem;
    aspect-ratio: 1;
    justify-self: center;
  }
  .rt__ring svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .rt__arc {
    fill: none;
    stroke-width: 24;
    transform: rotate(-90deg);
    transform-origin: 150px 150px;
  }
  .rt__score {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  .rt__n {
    font-size: 3.25rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rt__w {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--grafite);
  }

  .rt__end {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--filo);
  }
  @container (min-width: 620px) {
    .rt__end {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
  .rt__climb {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: var(--nebbia);
  }
  .rt__climb-t {
    color: var(--grafite);
  }
  .rt__climb-n {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .rt__arrow {
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--grafite);
  }
  .rt__to {
    color: var(--link);
  }
  .rt__links {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .rt__cta {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rt__fill {
      transition: stroke-dasharray 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
    }
    .rt--wait .rt__fill {
      stroke-dasharray: 0 800;
    }
  }
</style>
