---
/**
 * Home: three example reports, one tab each (Lorenzo, 22 Nov 2026): an ugly old site, a polished one that
 * misses what makes people book, and the same studio done right. Each tab: headline with the score, the
 * ring, the site in a phone with pins (ExampleSite.astro), the climb and the way into the full report.
 * All three sites are invented (src/scorer/samples.ts) and scored by the real engine at build time.
 */
import { examples } from "../scorer/samples";
import ExampleSite from "./ExampleSite.astro";
import { BANDS, bandOf, verdict, PRACTICALLY_PERFECT, SCORE_DISCLAIMER } from "../scorer/scale";

const HUE: Record<string, number> = { speed: 35, conversion: 80, local: 135, trust: 180, a11y: 240, legal: 290, content: 345 };
const col = (id: string) => `oklch(0.72 0.15 ${HUE[id] ?? 250})`;
const R = 120;
const C = 2 * Math.PI * R;
const GAP = 8;

const tabs = examples.map((e) => {
  const r = e.full.results.fitness.report;
  const measuredMax = r.checks.filter((c) => c.max > 0 && c.status !== "unmeasured").reduce((t, c) => t + c.max, 0) || 100;
  const after = Math.min(100, Math.round(r.total + r.fixes.reduce((t, f) => t + f.gain, 0) * (100 / measuredMax)));
  const cats = r.categories.filter((c) => c.max > 0);
  const total = cats.reduce((t, c) => t + c.max, 0) || 100;
  let start = 0;
  const arcs = cats.map((c) => {
    const len = (c.max / total) * C - GAP;
    const off = -(start + GAP / 2);
    start += (c.max / total) * C;
    return { id: c.id, len, off, got: len * (c.earned / c.max) };
  });
  const fixes = r.fixes.length;
  const climbLabel = fixes === 1 ? "Con l'ultima correzione" : `Con le prime ${fixes} correzioni`;
  return { e, r, after, arcs, fixes, climbLabel };
});
---
<div class="rt" data-rt>
  <div class="rt__tabs" role="tablist" aria-label="Tre siti d'esempio">
    {tabs.map(({ e, r }, i) => (
      <button type="button" role="tab" class="rt__tab" id={`rt-tab-${e.key}`} aria-controls={`rt-panel-${e.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-rt-tab={i}>
        <span class="rt__tab-l">{e.label}</span>
        <span class="rt__tab-n">{r.total}</span>
      </button>
    ))}
  </div>

  {tabs.map(({ e, r, after, arcs, fixes, climbLabel }, i) => (
    <div class="rt__panel" role="tabpanel" id={`rt-panel-${e.key}`} aria-labelledby={`rt-tab-${e.key}`} hidden={i !== 0} data-rt-panel={i}>
      <div class="rt__top">
        <div class="rt__say">
          <p class="rt__pill">Sito inventato per l'esempio</p>
          <h3 class="rt__h">{e.say}<br />{r.total} su 100.</h3>
          <p class="rt__line">{e.line}</p>
          <ol class="rt__scale" aria-label="Come leggere il voto">
            {BANDS.map((b) => (
              <li class={`rt__band${bandOf(r.total) === b ? " is-here" : ""}`} aria-current={bandOf(r.total) === b ? "true" : undefined}>
                <span class="rt__band-r">{b.min}-{b.max}</span>
                <span class="rt__band-w">{b.word}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="rt__ring" role="img" aria-label={`Voto ${r.total} su 100: ${verdict(r.total)}`}>
          <svg viewBox="0 0 300 300" aria-hidden="true" focusable="false">
            {arcs.map((a) => (
              <>
                <circle class="rt__arc" cx="150" cy="150" r={R} stroke="#EDEDF0" stroke-dasharray={`${a.len} ${C}`} stroke-dashoffset={a.off} />
                {a.got > 0.5 && <circle class="rt__arc rt__fill" cx="150" cy="150" r={R} stroke={col(a.id)} stroke-dasharray={`${a.got} ${C}`} stroke-dashoffset={a.off} />}
              </>
            ))}
          </svg>
          <span class="rt__score" aria-hidden="true">
            <span class="rt__n" data-rt-n data-to={r.total}>{r.total}</span>
            <span class="rt__w">{verdict(r.total)}</span>
          </span>
        </div>
      </div>

      <h4 class="sr-only" id={`rt-xs-${e.key}-t`}>{e.pins === "won" ? "Dove prende i punti" : "Dove perde i punti"}</h4>
      <ExampleSite example={e.key} id={`rt-xs-${e.key}`} limit={6} />

      <div class="rt__end">
        {r.total >= PRACTICALLY_PERFECT ? (
          <p class="rt__climb"><span class="rt__climb-t">Sopra 90 un sito è praticamente perfetto: i punti che mancano sono ritocchi, non urgenze.</span></p>
        ) : fixes > 0 ? (
          <p class="rt__climb">
            <span class="rt__climb-t">{climbLabel}</span>
            <span class="rt__climb-n"><span>{r.total}</span><span class="rt__arrow" aria-hidden="true">→</span><span class="sr-only">diventa</span><span class="rt__to">{after}</span></span>
          </p>
        ) : (
          <p class="rt__climb"><span class="rt__climb-t">Tutti i controlli superati.</span></p>
        )}
        <div class="rt__links">
          <a class="btn btn--secondary rt__cta" href={`/analisi-sito/?esempio=${e.key}#voto-${e.key}`}>Apri il report completo</a>
          <a class="textlink" href={e.path} target="_blank" rel="noopener">Guarda il sito dal vivo</a>
        </div>
      </div>
    </div>
  ))}
  <p class="rt__fine">{SCORE_DISCLAIMER}</p>
</div>

<script>
  const card = document.querySelector<HTMLElement>("[data-rt]");
  if (card) {
    const tabs = [...card.querySelectorAll<HTMLButtonElement>("[data-rt-tab]")];
    const panels = [...card.querySelectorAll<HTMLElement>("[data-rt-panel]")];
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
    const played = new Set<HTMLElement>();
    let inView = false;

    // The ring fills and the number counts up the first time a panel is seen.
    const play = (panel: HTMLElement) => {
      if (!motion || played.has(panel)) return;
      played.add(panel);
      const n = panel.querySelector<HTMLElement>("[data-rt-n]")!;
      const to = Number(n.dataset.to);
      panel.classList.add("rt--wait");
      n.textContent = "0";
      requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.remove("rt--wait")));
      const t0 = performance.now() + 200;
      const tick = (t: number) => {
        const p = Math.max(0, Math.min(1, (t - t0) / 1400));
        n.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (motion) panels.forEach((p) => !p.hidden && p.classList.add("rt--wait"));

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
      if (inView) play(panels[i]);
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k !== "ArrowRight" && k !== "ArrowLeft" && k !== "Home" && k !== "End") return;
        e.preventDefault();
        const n = tabs.length;
        select(k === "Home" ? 0 : k === "End" ? n - 1 : (i + (k === "ArrowRight" ? 1 : -1) + n) % n, true);
      });
    });
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          inView = true;
          io.disconnect();
          play(panels.find((p) => !p.hidden)!);
        },
        { threshold: 0.2 },
      );
      io.observe(card);
    }
  }
</script>

<style>
  .rt {
    container-type: inline-size;
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 0.5rem + 2.5vw, 3rem);
    border-radius: var(--radius-card);
    background: #fff;
  }

  /* Tabs: a segmented control */
  .rt__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: 16px;
    background: var(--nebbia);
  }
  .rt__tab {
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    min-height: 56px;
    padding: 0.5rem;
    border: 0;
    border-radius: 12px;
    background: transparent;
    font: inherit;
    color: var(--grafite);
    cursor: pointer;
    text-align: center;
  }
  .rt__tab[aria-selected="true"] {
    background: #fff;
    color: var(--inchiostro);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }
  .rt__tab:focus-visible {
    outline: 2px solid var(--inchiostro);
    outline-offset: 2px;
  }
  .rt__tab-l {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .rt__tab-n {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  @container (min-width: 620px) {
    .rt__tab {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
    }
    .rt__tab-l {
      font-size: 0.9375rem;
    }
    .rt__tab-n {
      padding: 0.1rem 0.5rem;
      border-radius: 999px;
      background: var(--nebbia);
    }
  }

  .rt__panel {
    display: grid;
    gap: 2rem;
  }
  .rt__panel[hidden] {
    display: none;
  }
  .rt__top {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @container (min-width: 620px) {
    .rt__top {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem;
    }
  }
  .rt__say {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .rt__pill {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--nebbia);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .rt__h {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
  }
  .rt__line {
    max-width: 46ch;
    color: var(--grafite);
  }
  .rt__fine {
    margin: -0.75rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--grafite);
    max-width: 70ch;
  }
  .rt__scale {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    width: min(100%, 26rem);
  }
  .rt__band {
    display: grid;
    gap: 1px;
    padding: 0.4rem 0.3rem;
    border-radius: 10px;
    background: var(--nebbia);
    color: var(--grafite);
    text-align: center;
  }
  .rt__band.is-here {
    background: var(--inchiostro);
    color: #fff;
  }
  .rt__band-r {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .rt__band-w {
    font-size: 0.6875rem;
    line-height: 1.2;
  }
  .rt__ring {
    position: relative;
    width: 10rem;
    aspect-ratio: 1;
    justify-self: center;
  }
  .rt__ring svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .rt__arc {
    fill: none;
    stroke-width: 24;
    transform: rotate(-90deg);
    transform-origin: 150px 150px;
  }
  .rt__score {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  .rt__n {
    font-size: 3.25rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rt__w {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--grafite);
  }

  .rt__end {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--filo);
  }
  @container (min-width: 620px) {
    .rt__end {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
  .rt__climb {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: var(--nebbia);
  }
  .rt__climb-t {
    color: var(--grafite);
  }
  .rt__climb-n {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .rt__arrow {
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--grafite);
  }
  .rt__to {
    color: var(--link);
  }
  .rt__links {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .rt__cta {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rt__fill {
      transition: stroke-dasharray 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
    }
    .rt--wait .rt__fill {
      transition: none;
      stroke-dasharray: 0 800;
    }
    .rt__tab {
      transition: background-color 0.2s, color 0.2s;
    }
  }
</style>
