---
import Logo from "./Logo.astro";
import { site } from "../config/site";
interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/come-funziona", label: "Metodo" },
  { href: "/lavori", label: "Lavori" },
  { href: "/prezzi", label: "Prezzi" },
  { href: "/chi-sono", label: "Studio" },
  { href: "/contatti", label: "Contatti" },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---
<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <a href="/" class="hdr__logo" aria-label={`${site.brand}, home`}>
      <Logo />
    </a>
    {
      !minimal && (
        <>
          <nav class="hdr__nav" aria-label="Principale">
            <ul>
              {nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="hdr__end">
            <a href="/anteprima-gratuita" class="btn btn--primary hdr__cta">
              Anteprima gratuita
            </a>
            <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-open>
              <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
              <span>Menu</span>
            </button>
          </div>
        </>
      )
    }
  </div>
</header>
<div class="hdr-spacer" aria-hidden="true"></div>
{
  !minimal && (
    <div class="mm section--sole" id="menu-mobile" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
      <div class="wrap mm__top">
        <a href="/" class="hdr__logo" aria-label={`${site.brand}, home`}>
          <Logo />
        </a>
        <button class="hdr__menu hdr__menu--dark" type="button" data-menu-close>
          <span>Chiudi</span>
        </button>
      </div>
      <nav class="wrap mm__nav" aria-label="Principale, mobile">
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/anteprima-gratuita" class="btn btn--primary mm__cta">
          Voglio l'anteprima gratuita
        </a>
      </nav>
    </div>
  )
}

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(255, 248, 242, 0);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  :global(.is-compact) .hdr {
    background: rgba(255, 248, 242, 0.94);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    box-shadow: 0 1px 0 var(--filo);
  }
  :global(.hdr-hidden) .hdr {
    transform: translateY(-100%);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .hdr-spacer {
    height: var(--header-h);
  }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .hdr__nav {
    display: none;
  }
  .hdr__nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr__nav a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--inchiostro);
    text-decoration: none;
    padding: 0.75rem 0;
  }
  .hdr__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .hdr__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hdr__cta {
    --h: 44px;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
    display: none;
  }
  .hdr__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--inchiostro);
    border-radius: var(--radius-ui);
    background: transparent;
    color: var(--inchiostro);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }
  .hdr__burger {
    display: grid;
    gap: 5px;
  }
  .hdr__burger i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
  }
  .hdr__menu--dark {
    color: var(--inchiostro);
    border-color: var(--inchiostro);
  }
  @media (min-width: 720px) {
    .hdr__cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1040px) {
    .hdr__nav {
      display: block;
    }
    .hdr__menu {
      display: none;
    }
  }
  .mm {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--mandarino);
    color: var(--inchiostro);
    overflow-y: auto;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
  }
  .mm[hidden] {
    display: none;
  }
  .mm__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .mm__nav ul {
    list-style: none;
    margin: 2.5rem 0 3rem;
    padding: 0;
  }
  .mm__nav a:not(.btn) {
    display: block;
    padding: 0.55rem 0;
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    font-size: clamp(2.4rem, 1.5rem + 5vw, 3.5rem);
    line-height: 1.05;
    color: var(--inchiostro);
    text-decoration: none;
  }
  .mm__nav a[aria-current="page"] {
    color: #3a1a0b;
  }
  .mm__cta {
    width: 100%;
  }
</style>

<script>
  const root = document.documentElement;
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    root.classList.toggle("is-compact", y > 40);
    // Hide while scrolling down past the first screen, show again on the way up.
    const menuOpen = document.body.classList.contains("menu-open");
    if (!menuOpen) root.classList.toggle("hdr-hidden", y > 500 && y > lastY + 2);
    if (y < lastY - 2) root.classList.remove("hdr-hidden");
    lastY = y;
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  document.addEventListener("focusin", (e) => {
    if ((e.target as HTMLElement).closest?.("[data-header]")) root.classList.remove("hdr-hidden");
  });

  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  if (menu && openBtn && closeBtn) {
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")).filter((el) => el.offsetParent !== null);
    const open = () => {
      menu.hidden = false;
      openBtn.setAttribute("aria-expanded", "true");
      document.body.classList.add("menu-open");
      closeBtn.focus();
    };
    const close = (restore = true) => {
      menu.hidden = true;
      openBtn.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
      if (restore) openBtn.focus();
    };
    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", () => close());
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close(false);
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== "Tab") return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
    window.matchMedia("(min-width: 1040px)").addEventListener("change", (m) => {
      if (m.matches && !menu.hidden) close(false);
    });
  }
</script>
