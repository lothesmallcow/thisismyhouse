---
interface Props {
  title: string;
  lead?: string;
  label?: string;
  class?: string;
}
const { title, lead, label, class: cls } = Astro.props;
---
<section class:list={["ph", cls]} data-hero>
  <div class="ph__glow" aria-hidden="true"></div>
  <div class="wrap ph__in">
    {label && <p class="ph__label">{label}</p>}
    <h1 class="ph__title">{title}</h1>
    {
      (lead || Astro.slots.has("default")) && (
        <div class="ph__row">
          <div class="ph__col">
            {lead && <p class="lead">{lead}</p>}
            <slot />
          </div>
        </div>
      )
    }
  </div>
</section>
<style>
  .ph {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 6vw, 7rem) clamp(3.5rem, 2rem + 4vw, 6.5rem);
  }
  /* The warm light of the home stage, rising from the top right corner. */
  .ph__glow {
    position: absolute;
    right: -18vw;
    top: -30vw;
    width: max(620px, 62vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(255, 91, 34, 0.55) 0%,
      rgba(255, 140, 50, 0.38) 30%,
      rgba(255, 178, 63, 0.2) 55%,
      rgba(255, 248, 242, 0) 100%
    );
    pointer-events: none;
  }
  .ph__in {
    position: relative;
  }
  .ph__label {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--grafite);
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }
  .ph__title {
    max-width: 15ch;
  }
  .ph__row {
    margin-top: clamp(2rem, 1rem + 3vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .ph__row {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    }
    .ph__col {
      grid-column: 6 / span 7;
    }
  }
  .ph__col .lead {
    max-width: 38ch;
  }
</style>
