---
/**
 * The opening of every inner page: label, title, lead and actions on the left, the page's own
 * picture on the right (slot "visual": a receipt on Prezzi, a chat on Come funziona...).
 * No empty columns: without a visual the text simply runs at full width.
 */
interface Props {
  title: string;
  lead?: string;
  label?: string;
  class?: string;
}
const { title, lead, label, class: cls } = Astro.props;
const hasVisual = Astro.slots.has("visual");
---
<section class:list={["ph", cls, { "ph--visual": hasVisual }]} data-hero>
  <div class="ph__glow" aria-hidden="true"></div>
  <div class="wrap ph__in">
    <div class="ph__text">
      {label && <p class="ph__label">{label}</p>}
      <h1 class="ph__title">{title}</h1>
      {
        (lead || Astro.slots.has("default")) && (
          <div class="ph__col">
            {lead && <p class="lead">{lead}</p>}
            <slot />
          </div>
        )
      }
    </div>
    {
      hasVisual && (
        <div class="ph__visual">
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>
<style>
  .ph {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem) clamp(3rem, 2rem + 3.5vw, 5.5rem);
  }
  /* The warm light of the home stage, rising from the top right corner. */
  .ph__glow {
    position: absolute;
    right: -18vw;
    top: -30vw;
    width: max(620px, 62vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(255, 91, 34, 0.55) 0%,
      rgba(255, 140, 50, 0.38) 30%,
      rgba(255, 178, 63, 0.2) 55%,
      rgba(255, 248, 242, 0) 100%
    );
    pointer-events: none;
  }
  .ph__in {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .ph__label {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--grafite);
    margin-bottom: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }
  .ph__title {
    max-width: 15ch;
  }
  .ph__col {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .ph__col .lead {
    max-width: 38ch;
  }
  .ph__visual {
    position: relative;
    display: grid;
    place-items: center;
  }
  @media (min-width: 960px) {
    .ph--visual .ph__in {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      column-gap: clamp(2rem, 1rem + 3vw, 5rem);
    }
    .ph--visual .ph__title {
      font-size: clamp(2.5rem, 1rem + 4.4vw, 5.75rem);
      max-width: 13ch;
    }
  }
</style>
