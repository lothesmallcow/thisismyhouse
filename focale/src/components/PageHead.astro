---
/**
 * The opening of every inner page: label, title, lead and actions on the left, the page's own
 * picture on the right (slot "visual": a receipt on Prezzi, a chat on Come funziona...).
 * No empty columns: without a visual the text simply runs at full width.
 */
interface Props {
  title: string;
  lead?: string;
  label?: string;
  class?: string;
}
const { title, lead, label, class: cls } = Astro.props;
const hasVisual = Astro.slots.has("visual");
---
<section class:list={["ph", cls, { "ph--visual": hasVisual }]} data-hero>
  <div class="wrap ph__in">
    <div class="ph__text">
      {label && <p class="ph__label">{label}</p>}
      <h1 class="ph__title">{title}</h1>
      {
        (lead || Astro.slots.has("default")) && (
          <div class="ph__col">
            {lead && <p class="lead">{lead}</p>}
            <slot />
          </div>
        )
      }
    </div>
    {
      hasVisual && (
        <div class="ph__visual">
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>
<style>
  .ph {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem) clamp(3rem, 2rem + 3.5vw, 5.5rem);
  }
  .ph__in {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .ph__label {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    background: var(--nebbia);
    color: var(--blu);
    font-size: var(--fs-small);
    font-weight: 600;
    margin-bottom: clamp(1rem, 0.8rem + 1vw, 1.75rem);
  }
  .ph__title {
    max-width: 15ch;
  }
  .ph__col {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .ph__col .lead {
    max-width: 38ch;
  }
  .ph__visual {
    position: relative;
    display: grid;
    place-items: center;
  }
  @media (min-width: 960px) {
    .ph--visual .ph__in {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      column-gap: clamp(2rem, 1rem + 3vw, 5rem);
    }
    .ph--visual .ph__title {
      font-size: clamp(2.4rem, 1rem + 3.8vw, 5rem);
      max-width: 13ch;
    }
  }
</style>
