---
/**
 * Opening scene. One iPhone showing the business's website. While it is on screen the phone
 * rings in the Dynamic Island and the requests slide down as iOS banners, with sound if the
 * visitor turns it on. Without JS or with reduced motion: the final frame (site + one banner).
 * Logic in scripts/hero.ts.
 */
import IPhone from "./IPhone.astro";
import ArcadiHero from "./demo/ArcadiHero.astro";
import { site } from "../config/site";

const banners = [
  { app: "mail", from: "Nuova richiesta dal sito", text: "Preventivo bagno: circa 6 mq, Città Studi, entro 3 mesi." },
  {
    app: "whatsapp",
    from: "Giulia R.",
    text: "Ciao, vi scrivo dal sito. Bagno completo in zona Città Studi, vorremmo iniziare a marzo.",
  },
];
---
<section class="scene hero" id="inizio" aria-labelledby="hero-t" data-hero-anim>
  <div class="wrap hero__in">
    <div class="hero__text">
      <h1 class="hero__title" id="hero-t" data-hero-h1>Siti che fanno squillare il telefono.</h1>
      <p class="lead hero__lead" data-hero-fade>Rifacciamo i siti delle piccole imprese perché portino richieste vere.</p>
      <div class="hero__cta" data-hero-fade>
        <a href="/anteprima-gratuita" class="btn btn--primary" data-magnetic>Voglio l'anteprima gratuita</a>
        <span class="small muted">Pronta in {site.previewHours} ore, senza impegno.</span>
      </div>
    </div>

    <figure class="film" data-film data-tilt-area>
      <div class="film__phone" data-tilt="7">
        <IPhone label="Il sito di Arcadi Ristrutturazioni, un'impresa inventata, su un iPhone: arriva una chiamata e poi le richieste su WhatsApp e per email">
          <div class="film__site" data-site>
            <div data-site-scroll><ArcadiHero /></div>
          </div>
          <span class="film__tap" data-tap aria-hidden="true"></span>
          <ul class="film__banners" data-banners>
            {
              banners.map((n) => (
                <li class="bn" data-banner={n.app}>
                  <span class:list={["bn__icon", `bn__icon--${n.app}`]}>
                    {n.app === "whatsapp" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 3.2a8.7 8.7 0 0 0-7.5 13.1L3.3 20.7l4.5-1.2A8.7 8.7 0 1 0 12 3.2Zm0 1.6a7.1 7.1 0 1 1-3.6 13.2l-.3-.2-2.6.7.7-2.5-.2-.3A7.1 7.1 0 0 1 12 4.8Zm-3 3.3c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.8 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a5.8 5.8 0 0 1-2.9-2.5c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4Z" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24">
                        <rect x="3.5" y="6" width="17" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
                        <path d="m4.5 7.5 7.5 6 7.5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="bn__body">
                    <span class="bn__top">
                      <strong>{n.from}</strong>
                      <span>ora</span>
                    </span>
                    <span class="bn__text">{n.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div slot="island" class="isl" data-island-call aria-hidden="true">
            <span class="isl__avatar">GR</span>
            <span class="isl__who">
              <span class="isl__sub">Chiamata dal sito</span>
              <span class="isl__name">Giulia R.</span>
            </span>
            <span class="isl__btn isl__btn--no"><svg viewBox="0 0 24 24"><path d="M3.5 13.5c4.7-4 12.3-4 17 0l-1.6 2.6-3.2-1.2v-2.4a12 12 0 0 0-7.4 0v2.4l-3.2 1.2-1.6-2.6Z" /></svg></span>
            <span class="isl__btn isl__btn--yes"><svg viewBox="0 0 24 24"><path d="M7.2 3.8h2.6l1.3 3.6-1.8 1.1a10 10 0 0 0 6.2 6.2l1.1-1.8 3.6 1.3v2.6c0 1-.8 1.8-1.8 1.8A15 15 0 0 1 5.4 5.6c0-1 .8-1.8 1.8-1.8Z" /></svg></span>
          </div>
        </IPhone>
      </div>
      <figcaption class="film__cap">
        <span class="film__beat" data-beat-line>Il tuo sito lavora, tu ricevi le richieste.</span>
        <span class="film__ctl" data-film-ctl hidden>
          <button type="button" class="film__btn" data-sound aria-pressed="false" aria-label="Attiva il suono">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path class="film__wave" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <button type="button" class="film__btn" data-replay aria-label="Rivedi">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12a7 7 0 1 0 2.1-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path d="M6 3.5v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero__in {
    display: grid;
    gap: clamp(2rem, 5vh, 3.5rem);
    align-items: center;
    width: 100%;
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      column-gap: clamp(2rem, 4vw, 5rem);
    }
  }
  .hero__title {
    font-size: clamp(2.8rem, 1rem + 5.6vw, 7.2rem);
    line-height: 0.94;
    max-width: 10ch;
  }
  .hero__lead {
    margin-top: clamp(1.25rem, 3.5vh, 2.25rem);
    max-width: 26ch;
    color: var(--grafite);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }

  .film {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    position: relative;
    isolation: isolate;
  }
  /* The one warm light of the page, behind the phone. */
  .film::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 46%;
    width: 210%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 91, 34, 0.42), rgba(255, 178, 63, 0.2) 45%, rgba(255, 248, 242, 0) 72%);
    z-index: -1;
    pointer-events: none;
  }
  .film__phone {
    position: relative;
    --w: clamp(200px, 33vh, 320px);
  }
  @media (max-width: 899px) {
    .film__phone {
      --w: clamp(100px, min(48vw, calc((100svh - 440px) / 2.35)), 250px);
    }
  }
  /* Phones: text tight enough that the whole iPhone sits in the first screen. */
  @media (max-width: 699px) {
    .hero__in {
      gap: 1.25rem;
    }
    .hero__title {
      font-size: clamp(2.1rem, 0.6rem + 7.4vw, 2.8rem);
    }
    .hero__lead {
      margin-top: 0.75rem;
      font-size: 1rem;
    }
    .hero__cta {
      margin-top: 1rem;
    }
    .hero__cta .small {
      display: none;
    }
    .film__cap {
      font-size: 0.85rem;
    }
  }
  /* Contact shadow under the phone */
  .film__phone::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: calc(var(--w) * -0.07);
    height: calc(var(--w) * 0.1);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(60, 25, 8, 0.32), rgba(60, 25, 8, 0));
    z-index: -1;
  }
  .film__site {
    position: absolute;
    inset: 13.7cqw 0 0;
    overflow: hidden;
    background: #f2f2f0;
  }
  .film__tap {
    position: absolute;
    width: 11cqw;
    height: 11cqw;
    margin: -5.5cqw 0 0 -5.5cqw;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    box-shadow:
      0 0 0 1cqw rgba(29, 31, 33, 0.18),
      0 1cqw 3cqw rgba(0, 0, 0, 0.2);
    z-index: 8;
    opacity: 0;
    pointer-events: none;
  }
  /* iOS banners over an app: frosted, rounded, under the Dynamic Island. */
  .film__banners {
    position: absolute;
    top: 14.5cqw;
    left: 2.5cqw;
    right: 2.5cqw;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6cqw;
    z-index: 6;
  }
  .bn {
    display: grid;
    grid-template-columns: 9.7cqw minmax(0, 1fr);
    gap: 2.8cqw;
    align-items: start;
    padding: 3.2cqw 3.6cqw;
    border-radius: 6cqw;
    background: rgba(246, 244, 242, 0.86);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    backdrop-filter: blur(22px) saturate(180%);
    box-shadow: 0 2cqw 7cqw rgba(0, 0, 0, 0.18);
    color: #1d1d1f;
    font-size: 3.65cqw;
    line-height: 1.3;
  }
  /* Without JS: the final frame shows the newest banner only. */
  .bn + .bn {
    display: none;
  }
  .bn__icon {
    width: 9.7cqw;
    height: 9.7cqw;
    border-radius: 2.2cqw;
    display: grid;
    place-items: center;
    color: #fff;
    margin-top: 0.4cqw;
  }
  .bn__icon svg {
    width: 64%;
    height: 64%;
    fill: currentColor;
  }
  .bn__icon--whatsapp {
    background: linear-gradient(180deg, #5ff27a, #20b844);
  }
  .bn__icon--mail {
    background: linear-gradient(180deg, #4fb4ff, #1677f2);
  }
  .bn__body {
    display: grid;
    gap: 0.3cqw;
    min-width: 0;
  }
  .bn__top {
    display: flex;
    justify-content: space-between;
    gap: 2cqw;
  }
  .bn__top strong {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bn__top span {
    flex: none;
    color: rgba(60, 60, 67, 0.6);
    font-size: 3.3cqw;
  }
  .bn__text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Incoming call inside the Dynamic Island */
  .isl {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 2.4cqw;
    padding: 0 3cqw;
    color: #fff;
    opacity: 0;
    visibility: hidden;
  }
  .isl__avatar {
    width: 12cqw;
    height: 12cqw;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #a8a29c, #6e6862);
    font-size: 4.4cqw;
    font-weight: 600;
  }
  .isl__who {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .isl__sub {
    font-size: 3.2cqw;
    color: rgba(255, 255, 255, 0.6);
  }
  .isl__name {
    font-size: 4.6cqw;
    font-weight: 600;
    white-space: nowrap;
  }
  .isl__btn {
    width: 11.5cqw;
    height: 11.5cqw;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .isl__btn svg {
    width: 56%;
    height: 56%;
    fill: #fff;
  }
  .isl__btn--no {
    background: #ff3b30;
  }
  .isl__btn--yes {
    background: #34c759;
  }

  .film__cap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--grafite);
  }
  .film__ctl {
    display: flex;
    gap: 0.4rem;
  }
  .film__ctl[hidden] {
    display: none;
  }
  .film__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--filo);
    border-radius: 50%;
    background: var(--carta);
    color: var(--inchiostro);
    cursor: pointer;
  }
  .film__btn svg {
    width: 18px;
    height: 18px;
  }
  .film__btn[aria-pressed="false"] .film__wave {
    opacity: 0.25;
  }
  .film__btn[aria-pressed="true"] {
    background: var(--mandarino);
    border-color: var(--mandarino);
  }
</style>
<script>
  import { initHero } from "../scripts/hero";
  initHero();
</script>
