---
/**
 * A real client's site to scroll, on its project page (Lorenzo: no numbered steps, just the site).
 * The whole page of the real site sits in a browser window (computers) or an iPhone (phones) and
 * scrolls inside it like the real thing; a switch shows the other device's version. Pictures from
 * scripts/tour-shots.mjs. Without JS: the window on computers, the phone on phones.
 */
import { Image } from "astro:assets";
import IPhone from "./IPhone.astro";

interface Props {
  slug: string;
  name: string;
  url: string;
}
const { slug, name, url } = Astro.props;
const pics = import.meta.glob<{ default: ImageMetadata }>("../assets/lavori/*-tour-*.jpg", { eager: true });
const desk = pics[`../assets/lavori/${slug}-tour-desktop.jpg`]?.default;
const phone = pics[`../assets/lavori/${slug}-tour-phone.jpg`]?.default;
if (!desk || !phone) throw new Error(`RealTour: run node scripts/tour-shots.mjs ${slug} <url>`);
const domain = new URL(url).host;
---
<section class="section rt" aria-labelledby="rt-t" data-rt>
  <div class="wrap rt__in">
    <div class="rt__head">
      <h2 id="rt-t" class="rt__t">Il sito, da scorrere</h2>
      <p class="rt__lead">Scorrilo come farebbe un ospite: è la pagina intera, com'è online.</p>
    </div>
    <div class="rt__stage">
      <div class="rt__desk">
        <div class="rt__win">
          <div class="rt__chrome" aria-hidden="true">
            <span class="rt__dots"><i></i><i></i><i></i></span>
            <span class="rt__url">{domain}</span>
          </div>
          <div class="rt__screen rt__screen--desk" tabindex="0" role="region" aria-label={`Il sito di ${name} come su un computer, da scorrere`}>
            <Image src={desk} alt={`La pagina intera del sito di ${name}, come si vede da un computer`} widths={[760, 1280]} sizes="(min-width: 1180px) 1120px, 92vw" format="webp" loading="lazy" class="rt__img" />
          </div>
        </div>
      </div>
      <div class="rt__phone">
        <IPhone>
          <div class="rt__screen rt__screen--phone" tabindex="0" role="region" aria-label={`Il sito di ${name} come su un telefono, da scorrere`}>
            <Image src={phone} alt={`La pagina intera del sito di ${name}, come si vede da un telefono`} widths={[600, 780]} sizes="300px" format="webp" loading="lazy" class="rt__img" />
          </div>
        </IPhone>
      </div>
      <div class="rt__switch" role="group" aria-label="Guarda il sito come su" data-rt-switch hidden>
        <button type="button" data-rt-to="phone" aria-pressed="false">Telefono</button>
        <button type="button" data-rt-to="desk" aria-pressed="true">Computer</button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Right under the project's head (its own bottom padding is the gap). */
  .rt.section {
    padding-top: 0;
  }
  .rt__in {
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .rt__lead {
    margin-top: 0.75rem;
    color: var(--grafite);
    max-width: 48ch;
  }
  .rt__stage {
    display: grid;
    justify-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .rt__desk {
    width: 100%;
    max-width: 1120px;
  }
  /* Computers see the window first, phones the phone; the switch shows the other one.
     Without JS by the screen's width; with it, data-mode (set from the width, then by the switch). */
  .rt__phone {
    display: none;
    --w: clamp(220px, 34svh, 290px);
    filter: drop-shadow(0 30px 40px rgba(11, 27, 63, 0.28));
  }
  @media (max-width: 899px) {
    .rt:not([data-mode]) .rt__desk {
      display: none;
    }
    .rt:not([data-mode]) .rt__phone {
      display: block;
    }
  }
  .rt[data-mode="phone"] .rt__desk {
    display: none;
  }
  .rt[data-mode="phone"] .rt__phone {
    display: block;
  }
  @media (pointer: coarse) {
    /* The site scrolls inside: a filter would repaint it on every frame. */
    .rt__phone {
      filter: none;
    }
  }
  .rt__win {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 50px 90px -45px rgba(11, 27, 63, 0.6),
      0 0 0 1px rgba(11, 27, 63, 0.1);
  }
  .rt__chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 34px;
    padding: 0 12px;
    background: #f3f0ec;
    border-bottom: 1px solid #e2ddd6;
  }
  .rt__dots {
    display: flex;
    gap: 7px;
    flex: none;
  }
  .rt__dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .rt__dots i:nth-child(2) {
    background: #febc2e;
  }
  .rt__dots i:nth-child(3) {
    background: #28c840;
  }
  .rt__url {
    flex: 1;
    min-width: 0;
    max-width: 22rem;
    margin-inline: auto;
    padding: 4px 12px;
    border-radius: 6px;
    background: #fff;
    font-size: 12px;
    color: #5a5550;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rt__screen {
    position: relative;
    overflow-y: auto;
    overflow-x: hidden;
    background: #f2f1ec;
    scrollbar-width: thin;
  }
  .rt__screen:focus-visible {
    outline: 3px solid var(--blu);
    outline-offset: -3px;
  }
  /* A computer's screen: 1280 x 800, the size the page was shot at. */
  .rt__screen--desk {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 72svh;
  }
  /* Under the status bar, like a page in Safari. */
  .rt__screen--phone {
    position: absolute;
    inset: 13.7cqw 0 0;
  }
  /* :global: the picture is an Image component, scoped classes do not reach it. */
  .rt__screen :global(.rt__img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .rt__switch {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(11, 27, 63, 0.1);
  }
  .rt__switch[hidden] {
    display: none;
  }
  .rt__switch button {
    min-height: 44px;
    padding: 0 1.15rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: 500 0.92rem/1 var(--font);
    color: var(--inchiostro);
    cursor: pointer;
    touch-action: manipulation;
  }
  .rt__switch button[aria-pressed="true"] {
    background: var(--blu);
    color: #fff;
  }
</style>
<script>
  // Telefono | Computer: by the width at first, then the switch.
  document.querySelectorAll<HTMLElement>("[data-rt]").forEach((root) => {
    const sw = root.querySelector<HTMLElement>("[data-rt-switch]")!;
    const btns = Array.from(sw.querySelectorAll<HTMLButtonElement>("[data-rt-to]"));
    const mode = (m: string) => {
      root.dataset.mode = m;
      btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.rtTo === m)));
    };
    mode(window.matchMedia("(min-width: 900px)").matches ? "desk" : "phone");
    btns.forEach((b) => b.addEventListener("click", () => mode(b.dataset.rtTo!)));
    sw.hidden = false;
  });
</script>
