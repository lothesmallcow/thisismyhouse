---
/**
 * A laptop for the makeover film. Built to the measures of the 3D model in public/models/macbook.glb
 * (see docs/CREDITI.md), so the WebGL body drawn by scripts/phone3d.ts lines up with the live HTML
 * screen, exactly as the iPhone does. Until the model loads, or without WebGL, the CSS body below
 * stands in: an aluminium lid with a black bezel, hinged on a base seen from a little above.
 *
 * Everything is sized in model units: --u is the width divided by 35.48 (the model's width).
 * The lid turns on its hinge: --lid is its angle (20deg open, the model's pose; -90deg shut),
 * --lift raises it while it closes (the hinge sits under the keys). Width with --w (default 560px).
 * The slot fills the screen, under a menu bar and a browser bar with `url`.
 */
interface Props {
  label?: string;
  class?: string;
  url?: string;
}
const { label, class: cls, url = "" } = Astro.props;
---
<div class:list={["lap", cls]} role={label ? "img" : undefined} aria-label={label}>
  <span class="lap__deck" aria-hidden="true"><i class="lap__keys"></i><i class="lap__pad"></i></span>
  <span class="lap__lip" aria-hidden="true"></span>
  <div class="lap__lid" data-lap-lid>
    <span class="lap__back" aria-hidden="true"></span>
    <div class="lap__front">
      <div class="lap__screen" aria-hidden={label ? "true" : undefined}>
        <div class="lap__menu"><span>9:41</span></div>
        <div class="lap__bar">
          <span class="lap__dots"><i></i><i></i><i></i></span>
          <span class="lap__url">{url}</span>
        </div>
        <div class="lap__view" data-lap-view>
          <slot />
        </div>
        <span class="lap__notch" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>
<style>
  .lap {
    --_w: var(--w, 560px);
    --u: calc(var(--_w) / 35.48);
    /* The hinge, from the lid's bottom edge (model: 0.21 under the chin's edge, 0.34 in front of the glass). */
    --hy: calc(var(--u) * 0.21);
    --hz: calc(var(--u) * 0.34);
    position: relative;
    width: var(--_w);
    transform-style: preserve-3d;
  }
  /* ---------- Lid: bezel 0.51 at the sides, 0.53 on top, a 2.2 chin; glass 34.38 x 22.26 ---------- */
  .lap__lid {
    position: relative;
    width: calc(var(--u) * 35.4);
    margin-inline: auto;
    transform-origin: 50% calc(100% - var(--hy)) var(--hz);
    transform: translateY(var(--lift, 0px)) rotateX(var(--lid, 20deg));
    transform-style: preserve-3d;
  }
  .lap__front {
    position: relative;
    padding: calc(var(--u) * 0.53) calc(var(--u) * 0.51) calc(var(--u) * 2.2);
    border-radius: calc(var(--u) * 0.9) calc(var(--u) * 0.9) calc(var(--u) * 0.25) calc(var(--u) * 0.25);
    background: #0b0c0e;
    box-shadow: 0 0 0 calc(var(--u) * 0.12) #c6c7ca;
    backface-visibility: hidden;
  }
  .lap__back {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--u) * 0.9) calc(var(--u) * 0.9) calc(var(--u) * 0.25) calc(var(--u) * 0.25);
    background:
      radial-gradient(70% 60% at 40% 35%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #d9dadd, #bfc0c4);
    transform: rotateX(180deg) translateZ(1px);
    backface-visibility: hidden;
  }
  .lap__screen {
    position: relative;
    aspect-ratio: 34.38 / 22.26;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }
  /* The screen is drawn as 1280 px wide: 1cqi = 12.8 of those pixels. */
  .lap__menu {
    flex: none;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 2.1cqi;
    padding: 0 1.2cqi;
    background: #e9e9eb;
    color: #1d1f21;
    font: 600 0.95cqi/1 var(--font);
  }
  .lap__notch {
    position: absolute;
    left: 50%;
    top: 0;
    width: 10.4cqi;
    height: 2.1cqi;
    translate: -50% 0;
    border-radius: 0 0 0.9cqi 0.9cqi;
    background: #0b0c0e;
    z-index: 9;
  }
  .lap__bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2cqi;
    height: 3cqi;
    padding: 0 1.2cqi;
    background: #f5f5f6;
    border-bottom: 1px solid #dcdcdf;
  }
  .lap__dots {
    display: flex;
    gap: 0.5cqi;
  }
  .lap__dots i {
    width: 0.85cqi;
    height: 0.85cqi;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lap__dots i:nth-child(2) {
    background: #febc2e;
  }
  .lap__dots i:nth-child(3) {
    background: #28c840;
  }
  .lap__url {
    flex: 0 1 34%;
    margin: 0 auto;
    padding: 0.35cqi 1cqi;
    border-radius: 0.7cqi;
    background: #e8e8ea;
    color: #3f4347;
    font: 500 1.05cqi/1.2 var(--font);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lap__view {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  /* ---------- Base (CSS body only): the deck 0.85 over the hinge, 25.1 deep, a 1.43 slab ---------- */
  .lap__deck,
  .lap__lip {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(100% - var(--hy) - var(--u) * 0.85);
    transform-origin: 50% 0;
  }
  .lap__deck {
    height: calc(var(--u) * 25.1);
    transform: translateZ(calc(var(--hz) - var(--u) * 0.52)) rotateX(90deg);
    border-radius: 0 0 calc(var(--u) * 0.9) calc(var(--u) * 0.9);
    background: linear-gradient(180deg, #c3c4c8, #dfe0e2 30%, #d4d5d8);
  }
  .lap__keys {
    position: absolute;
    left: 13%;
    right: 13%;
    top: 7%;
    height: 40%;
    border-radius: calc(var(--u) * 0.3);
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(100% / 14 - 2px), #b9babe calc(100% / 14 - 2px) calc(100% / 14)),
      repeating-linear-gradient(180deg, transparent 0 calc(100% / 6 - 2px), #b9babe calc(100% / 6 - 2px) calc(100% / 6)),
      #26282c;
  }
  .lap__pad {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 54%;
    height: 38%;
    border-radius: calc(var(--u) * 0.4);
    background: #cdced2;
    box-shadow: inset 0 0 0 1px rgba(110, 112, 118, 0.25);
  }
  .lap__lip {
    height: calc(var(--u) * 1.43);
    transform: translateZ(calc(var(--hz) + var(--u) * 24.58));
    border-radius: 0 0 calc(var(--u) * 0.9) calc(var(--u) * 0.9);
    background: linear-gradient(180deg, #e6e7e9, #a3a4a8);
  }
  /* The WebGL model (scripts/phone3d.ts) has taken over the body: only the live screen stays. */
  :global(.lap--gl) .lap__deck,
  :global(.lap--gl) .lap__lip,
  :global(.lap--gl) .lap__back {
    display: none;
  }
  :global(.lap--gl) .lap__front {
    background: transparent;
    box-shadow: none;
  }
</style>
