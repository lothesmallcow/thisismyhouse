---
/**
 * A believable iPhone (Pro proportions: 393 x 852 pt screen). Titanium band, black bezel, side
 * buttons, Dynamic Island, status bar, home indicator and a faint glass reflection.
 * Everything inside the screen is sized in container units (1pt = 100cqw / 393), so the phone
 * can be any width and its content scales with it: nothing can spill out of the screen.
 * Set the width with --w on the element or a parent (default 300px).
 */
interface Props {
  label?: string;
  class?: string;
  time?: string;
  /** Status bar and home indicator in white, for dark or colourful screens. */
  light?: boolean;
  /** A solid 3D phone: titanium sides with real thickness and a back with cameras, so it can turn around. */
  solid?: boolean;
}
const { label, class: cls, time = "9:41", light = false, solid = false } = Astro.props;
// Thickness is built from thin slices stacked in depth (the "layered" 3D pattern).
const slices = solid ? Array.from({ length: 22 }, (_, i) => i) : [];
---
<div class:list={["iph", cls, { "iph--light": light, "iph--solid": solid }]} role={label ? "img" : undefined} aria-label={label}>
  {
    solid && (
      <>
        {slices.map((i) => (
          <span class="iph__slice" style={`--i:${i}`} aria-hidden="true" />
        ))}
        <span class="iph__back" aria-hidden="true">
          <span class="iph__plateau">
            <i class="iph__lens iph__lens--a" />
            <i class="iph__lens iph__lens--b" />
            <i class="iph__lens iph__lens--c" />
            <i class="iph__flash" />
            <i class="iph__lidar" />
            <i class="iph__mic" />
          </span>
        </span>
      </>
    )
  }
  <span class="iph__b iph__b--action" aria-hidden="true"></span>
  <span class="iph__b iph__b--up" aria-hidden="true"></span>
  <span class="iph__b iph__b--down" aria-hidden="true"></span>
  <span class="iph__b iph__b--power" aria-hidden="true"></span>
  <div class="iph__band">
    <div class="iph__bezel">
      <div class="iph__screen" aria-hidden={label ? "true" : undefined}>
        <slot />
        <div class="iph__status">
          <span class="iph__time">{time}</span>
          <span class="iph__icons">
            <svg viewBox="0 0 18 12" class="iph__sig"><rect x="0" y="8" width="3" height="4" rx="0.8"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="0.8"></rect><rect x="10" y="3" width="3" height="9" rx="0.8"></rect><rect x="15" y="0" width="3" height="12" rx="0.8"></rect></svg>
            <svg viewBox="0 0 16 12" class="iph__wifi"><path d="M8 2.2c2.3 0 4.4.9 6 2.4l1.3-1.3A10.3 10.3 0 0 0 8 .4 10.3 10.3 0 0 0 .7 3.3L2 4.6a8.5 8.5 0 0 1 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.4l1.3-1.3A6.6 6.6 0 0 0 8 4a6.6 6.6 0 0 0-4.7 1.9l1.3 1.3c.9-.9 2.1-1.4 3.4-1.4Zm0 3.6c-.5 0-1 .2-1.3.5L8 11.2l1.3-1.3c-.3-.3-.8-.5-1.3-.5Z"></path></svg>
            <svg viewBox="0 0 28 13" class="iph__bat"><rect x="0.5" y="0.5" width="24" height="12" rx="3.6" fill="none" stroke="currentColor" stroke-opacity="0.4"></rect><rect x="2.2" y="2.2" width="18.5" height="8.6" rx="2.2"></rect><path d="M26 4.3v4.4c.9-.3 1.5-1.2 1.5-2.2s-.6-1.9-1.5-2.2Z" fill-opacity="0.45"></path></svg>
          </span>
        </div>
        <div class="iph__island" data-island><slot name="island" /></div>
        <span class="iph__home" aria-hidden="true"></span>
        <span class="iph__glare" aria-hidden="true" data-tilt-glare></span>
      </div>
    </div>
  </div>
</div>
<style>
  .iph {
    /* --w comes from the parent; 300px if nobody sets it. */
    --_w: var(--w, 300px);
    position: relative;
    width: var(--_w);
    flex: none;
  }
  /* ---------- Solid 3D body ---------- */
  .iph--solid {
    --_t: calc(var(--_w) * 0.115);
    transform-style: preserve-3d;
  }
  .iph--solid .iph__b {
    display: none;
  }
  .iph--solid .iph__band {
    position: relative;
    background: linear-gradient(135deg, #b4b5b8 0%, #f4f4f5 16%, #c4c5c8 34%, #ececed 58%, #a9aaad 80%, #d9d9db 100%);
    transform: translateZ(0.5px);
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  /* The WebGL model (scripts/phone3d.ts) has taken over the body: only the live screen stays. */
  .iph--gl .iph__slice,
  .iph--gl .iph__back,
  .iph--gl .iph__b {
    display: none;
  }
  .iph--gl .iph__band,
  .iph--gl .iph__bezel {
    background: transparent;
    box-shadow: none;
  }
  .iph__slice {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--_w) * 0.172);
    /* Silver aluminium edge: bright where it catches the light, softer on the curve. */
    background: linear-gradient(90deg, #a9aaad, #f2f2f3 14%, #cfd0d3 34%, #e4e4e6 70%, #a3a4a7 100%);
    transform: translateZ(calc(var(--_t) * var(--i) / -21));
  }
  /* The back, modelled on the current Pro: silver aluminium, a camera plateau across the whole
     top, matte glass below. From the back the lenses sit on the left. */
  .iph__back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: calc(var(--_w) * 0.172);
    background:
      radial-gradient(90% 55% at 70% 75%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 70%),
      linear-gradient(175deg, #f4f4f5, #e3e3e5 60%, #d6d6d9);
    transform: translateZ(calc(var(--_t) * -1)) rotateY(180deg);
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 calc(var(--_w) * 0.008) #c4c5c8;
  }
  .iph__plateau {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--_w) * 0.6);
    border-radius: calc(var(--_w) * 0.172) calc(var(--_w) * 0.172) calc(var(--_w) * 0.05) calc(var(--_w) * 0.05);
    background:
      linear-gradient(100deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 45%),
      linear-gradient(180deg, #ececee, #d9dadc);
    box-shadow:
      0 calc(var(--_w) * 0.012) calc(var(--_w) * 0.025) rgba(40, 40, 45, 0.22),
      inset 0 calc(var(--_w) * -0.004) 0 rgba(255, 255, 255, 0.8);
  }
  .iph__lens {
    position: absolute;
    width: calc(var(--_w) * 0.222);
    aspect-ratio: 1;
    border-radius: 50%;
    /* Glass: deep blue-black with a coloured coating reflection. */
    background:
      radial-gradient(circle at 36% 32%, rgba(190, 210, 255, 0.55) 0 6%, rgba(190, 210, 255, 0) 14%),
      radial-gradient(circle at 50% 50%, #1b2234 0 30%, #07090e 31% 58%, #23262d 59% 64%, #050608 65%);
    box-shadow:
      0 0 0 calc(var(--_w) * 0.016) #c9cacd,
      0 0 0 calc(var(--_w) * 0.02) #9fa0a4,
      0 calc(var(--_w) * 0.012) calc(var(--_w) * 0.03) calc(var(--_w) * 0.01) rgba(30, 30, 35, 0.35);
  }
  .iph__lens--a {
    left: calc(var(--_w) * 0.06);
    top: calc(var(--_w) * 0.06);
  }
  .iph__lens--b {
    left: calc(var(--_w) * 0.06);
    top: calc(var(--_w) * 0.32);
  }
  .iph__lens--c {
    left: calc(var(--_w) * 0.295);
    top: calc(var(--_w) * 0.19);
  }
  .iph__flash {
    position: absolute;
    right: calc(var(--_w) * 0.1);
    top: calc(var(--_w) * 0.12);
    width: calc(var(--_w) * 0.075);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fffdf3 0 35%, #e8e2c8 60%, #cfc9b1);
    box-shadow: 0 0 0 calc(var(--_w) * 0.006) #b9babd;
  }
  .iph__lidar {
    position: absolute;
    right: calc(var(--_w) * 0.105);
    top: calc(var(--_w) * 0.36);
    width: calc(var(--_w) * 0.065);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, #3a3d44, #0c0d10 70%);
    box-shadow: 0 0 0 calc(var(--_w) * 0.006) #b9babd;
  }
  .iph__mic {
    position: absolute;
    right: calc(var(--_w) * 0.13);
    top: calc(var(--_w) * 0.26);
    width: calc(var(--_w) * 0.016);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #6e7075;
  }
  .iph__band {
    padding: calc(var(--_w) * 0.011);
    border-radius: calc(var(--_w) * 0.172);
    /* Natural titanium: brushed metal with soft highlights on the edges. */
    background: linear-gradient(135deg, #8e8c88 0%, #e6e3dd 16%, #7a7873 34%, #cfccc6 58%, #6f6d68 80%, #bdbab4 100%);
    box-shadow:
      0 calc(var(--_w) * 0.2) calc(var(--_w) * 0.32) calc(var(--_w) * -0.14) rgba(11, 27, 63, 0.5),
      0 calc(var(--_w) * 0.04) calc(var(--_w) * 0.09) rgba(11, 27, 63, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .iph__bezel {
    padding: calc(var(--_w) * 0.03);
    border-radius: calc(var(--_w) * 0.162);
    background: #0a0a0b;
    box-shadow: inset 0 0 0 1px #1d1d1f;
  }
  .iph__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 393 / 852;
    border-radius: calc(var(--_w) * 0.13);
    container-type: inline-size;
    background: #fff;
    isolation: isolate;
    /* Safari can let transformed or composited children (the lens, the boxes, the turning site)
       escape a rounded overflow clip: a mask makes the rounded corners hold. */
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    font-family: var(--font);
    font-stretch: 100%;
    color: #1d1d1f;
  }
  /* Side buttons */
  .iph__b {
    position: absolute;
    width: calc(var(--_w) * 0.013);
    border-radius: 2px;
    background: linear-gradient(90deg, #6f6d68, #d6d3cd 55%, #8e8c88);
  }
  .iph__b--action {
    left: calc(var(--_w) * -0.009);
    top: 17%;
    height: 5%;
  }
  .iph__b--up {
    left: calc(var(--_w) * -0.009);
    top: 25%;
    height: 9%;
  }
  .iph__b--down {
    left: calc(var(--_w) * -0.009);
    top: 36%;
    height: 9%;
  }
  .iph__b--power {
    right: calc(var(--_w) * -0.009);
    top: 28%;
    height: 14%;
  }
  /* Status bar: 54 pt tall, time centred in the left "ear" */
  .iph__status {
    position: absolute;
    inset: 0 0 auto;
    height: 13.7cqw;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1cqw 7.5cqw 0 10.5cqw;
    font-size: 4.3cqw;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1d1d1f;
    pointer-events: none;
  }
  .iph__icons {
    display: flex;
    align-items: center;
    gap: 1.5cqw;
  }
  .iph__icons svg {
    display: block;
    height: 3.1cqw;
    width: auto;
    fill: currentColor;
  }
  .iph__bat {
    height: 3.3cqw !important;
  }
  .iph--light .iph__status {
    color: #fff;
  }
  /* Dynamic Island: 126 x 37 pt, 11 pt from the top. Auto margins keep it centred while it grows. */
  .iph__island {
    position: absolute;
    top: 2.8cqw;
    left: 0;
    right: 0;
    margin-inline: auto;
    width: 32cqw;
    height: 9.4cqw;
    border-radius: 6cqw;
    background: #000;
    z-index: 6;
    overflow: hidden;
  }
  .iph__home {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2.2cqw;
    margin-inline: auto;
    width: 34cqw;
    height: 1.35cqw;
    border-radius: 1cqw;
    background: rgba(0, 0, 0, 0.85);
    z-index: 5;
  }
  .iph--light .iph__home {
    background: rgba(255, 255, 255, 0.9);
  }
  .iph__glare {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -30%;
    width: 160%;
    z-index: 7;
    pointer-events: none;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 26%, rgba(255, 255, 255, 0) 40%);
  }
</style>
