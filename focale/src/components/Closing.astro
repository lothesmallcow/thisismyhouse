---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { whatsappHref } from "../lib/util";
interface Props {
  title?: string;
  text?: string;
  whatsapp?: string;
  ctaHref?: string;
}
const {
  title = "Guarda il tuo nuovo sito prima di decidere.",
  text = `Ti mandiamo l'anteprima in ${site.previewHours} ore. Se non ti convince, non ci devi niente.`,
  whatsapp = `Ciao, ho visto il sito di ${site.brand} e vorrei l'anteprima gratuita per la mia attività.`,
  ctaHref = "/anteprima-gratuita",
} = Astro.props;
---
<section class="closing">
  <div class="wrap closing__in">
    <h2 class="closing__title">{title}</h2>
    <div class="closing__row">
      <p class="lead closing__text">{text}</p>
      <div class="btn-row">
        <a href={ctaHref} class="btn btn--primary" data-magnetic>Voglio l'anteprima gratuita</a>
        <a href={whatsappHref(whatsapp)} class="btn btn--secondary" target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Scrivici su WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  /* The last word before the footer: the site's one dark band ("più gas", 22 Nov 2026; colours in
     global.css, shared with the home's statement band), the title as wide as the page. */
  .closing {
    padding-block: clamp(4rem, 2rem + 6vw, 8rem);
  }
  .closing__title {
    font-size: var(--fs-closing);
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 15ch;
  }
  .closing__row {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    padding-top: clamp(1.5rem, 1rem + 1vw, 2rem);
    border-top: 1px solid var(--filo);
  }
  @media (min-width: 900px) {
    .closing__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .closing__text {
    max-width: 36ch;
    color: var(--grafite);
  }
</style>
