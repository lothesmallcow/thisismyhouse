---
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { whatsappHref } from "../lib/util";
interface Props {
  title?: string;
  text?: string;
  whatsapp?: string;
  ctaHref?: string;
}
const {
  title = "Guarda il tuo nuovo sito prima di decidere.",
  text = `Ti mandiamo l'anteprima in ${site.previewHours} ore. Se non ti convince, non ci devi niente.`,
  whatsapp = `Ciao, ho visto il sito di ${site.brand} e vorrei l'anteprima gratuita per la mia attività.`,
  ctaHref = "/anteprima-gratuita",
} = Astro.props;
---
<section class="closing section--sole" data-tone="sole">
  <div class="wrap closing__in">
    <h2 class="closing__title" data-focus>{title}</h2>
    <div class="closing__row">
      <p class="lead closing__text">{text}</p>
      <div class="btn-row">
        <a href={ctaHref} class="btn btn--primary" data-magnetic>Voglio l'anteprima gratuita</a>
        <a href={whatsappHref(whatsapp)} class="btn btn--secondary" target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Scrivici su WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  /* The last word before the footer: orange like the footer, the title as wide as the page.
     With motion the whole page floods orange as it arrives (data-tone, scripts/inner.ts). */
  .closing {
    padding-block: var(--space-section) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .closing__title {
    font-size: clamp(2.75rem, 0.6rem + 8.4vw, 10rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 15ch;
  }
  .closing__row {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--inchiostro);
  }
  @media (min-width: 900px) {
    .closing__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .closing__text {
    max-width: 36ch;
  }
</style>
