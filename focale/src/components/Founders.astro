---
/** Founders' programme. The counter is static text read from config: never animated. */
import { site } from "../config/site";
const open = site.foundersSpotsLeft > 0;
---
<section class="section section--pietra fd" id="fondatori" aria-labelledby="fondatori-t">
  <div class="wrap sec">
    <p class="sec__label">Fondatori</p>
    <div class="sec__body">
      {
        open ? (
          <div class="fd__grid">
            <div>
              <h2 id="fondatori-t" data-focus>Cerchiamo i primi {site.foundersSpotsTotal} clienti.</h2>
              <p class="fd__text">
                Ai primi cinque clienti facciamo un prezzo fondatori. In cambio ti chiediamo di poter mostrare il tuo sito tra i nostri lavori
                e di indicarti come referenza.
              </p>
            </div>
            <div class="fd__count">
              <p class="fd__label">Posti fondatori ancora liberi:</p>
              <p class="fd__num">
                {site.foundersSpotsLeft} su {site.foundersSpotsTotal}
              </p>
              <p class="small muted fd__note">
                Il numero è aggiornato a mano ed è quello vero.
              </p>
              <a href="/anteprima-gratuita?fondatori=1" class="btn btn--primary">
                Prenota un posto fondatori
              </a>
            </div>
          </div>
        ) : (
          <div>
            <h2 id="fondatori-t">Il programma fondatori è chiuso.</h2>
            <p class="fd__text">Grazie ai primi cinque clienti. Da qui in poi valgono i prezzi standard.</p>
          </div>
        )
      }
    </div>
  </div>
</section>
<style>
  .fd h2 {
    max-width: 12ch;
  }
  .fd__grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1000px) {
    .fd__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
      align-items: end;
    }
  }
  .fd__text {
    margin-top: 2rem;
    color: var(--grafite);
    max-width: 50ch;
  }
  .fd__count {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .fd__label {
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .fd__num {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(4rem, 2.5rem + 6vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    margin: 0 !important;
    font-variant-numeric: tabular-nums;
  }
  .fd__note {
    max-width: 38ch;
    margin: 1rem 0 1.5rem !important;
  }
</style>
