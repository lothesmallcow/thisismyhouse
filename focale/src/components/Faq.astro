---
import { fill } from "../lib/util";
interface Props {
  items: { q: string; a: string }[];
  /** Rounded cards instead of a ruled list, for short lists on light sections. */
  compact?: boolean;
  /** Two columns on wide screens, for long lists. */
  cols?: boolean;
}
const { items, compact = false, cols = false } = Astro.props;
---
<div class:list={["faq", { "faq--compact": compact || cols, "faq--cols": cols }]}>
  {
    items.map((it) => (
      <details class="faq__item">
        <summary>
          <span>{fill(it.q)}</span>
          <span class="faq__sign" aria-hidden="true" />
        </summary>
        <div class="faq__body">
          <div>
            <p>{fill(it.a)}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>
<style>
  /* Compact: each question is a card, smaller type, no rules. */
  .faq.faq--compact {
    border-top: 0;
    max-width: none;
    display: grid;
    gap: 0.6rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .faq--cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .faq--compact .faq__item {
    border-bottom: 0;
    background: var(--carta);
    border-radius: 18px;
    padding-inline: 1.25rem;
    transition: box-shadow 0.3s var(--ease-out);
  }
  .faq--compact .faq__item:hover,
  .faq--compact .faq__item[open] {
    box-shadow: 0 14px 30px -22px rgba(120, 40, 5, 0.45);
  }
  .faq--compact summary {
    padding: 1.05rem 0;
    font-size: 1.08rem;
    font-weight: 500;
    font-stretch: 105%;
    letter-spacing: -0.01em;
  }
  .faq--compact .faq__body > div {
    padding-bottom: 1.15rem;
  }
  .faq {
    border-top: 1px solid var(--inchiostro);
    max-width: 58rem;
  }
  .faq__item {
    border-bottom: 1px solid var(--filo);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 0;
    min-height: 44px;
    cursor: pointer;
    font-size: var(--fs-h3);
    font-weight: 400;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__sign {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .faq__sign::before,
  .faq__sign::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .faq__sign::after {
    transform: rotate(90deg);
  }
  details[open] .faq__sign::after {
    transform: rotate(0deg);
  }
  .faq__body > div {
    padding: 0 0 1.75rem;
    max-width: 60ch;
    color: var(--grafite);
  }
  @supports selector(::details-content) {
    .faq__item::details-content {
      display: grid;
      grid-template-rows: 0fr;
      transition:
        grid-template-rows 0.4s var(--ease-out),
        content-visibility 0.4s allow-discrete;
    }
    .faq__item[open]::details-content {
      grid-template-rows: 1fr;
    }
    .faq__body {
      overflow: hidden;
      min-height: 0;
    }
  }
</style>
