---
import { plans, cura } from "../lib/plans";
import { euro, foundersOpen } from "../lib/util";
const open = foundersOpen();
---
<section class="section ps" aria-labelledby="prezzi-t">
  <div class="wrap sec">
    <p class="sec__label">Prezzi</p>
    <div class="sec__body">
      <h2 id="prezzi-t" data-focus>Prezzi chiari, scritti qui.</h2>
      <p class="lead ps__intro">Niente "preventivo su richiesta": sai subito quanto spendi.</p>
      <div class="ps__list">
        {
          plans.map((p) => (
            <div class:list={["ps__plan", { "ps__plan--rec section--sole": p.recommended }]}>
              <div class="ps__name">
                <h3>{p.name}</h3>
                {p.recommended && <span class="ps__tag">Consigliato</span>}
              </div>
              <p class="ps__for">{p.forWhom}</p>
              <dl class="ps__prices">
                {open && (
                  <div>
                    <dt>Prezzo fondatori</dt>
                    <dd class="ps__main">
                      {p.from && <span class="ps__from">da </span>}
                      {euro(p.founders)}
                    </dd>
                  </div>
                )}
                <div>
                  <dt>{open ? "Dal sesto cliente" : "Prezzo"}</dt>
                  <dd class:list={{ ps__main: !open }}>
                    {p.from && "da "}
                    {euro(p.standard)}
                  </dd>
                </div>
              </dl>
            </div>
          ))
        }
      </div>
      <div class="ps__foot">
        <p>
          <strong>{cura.name}, {euro(cura.price)} al mese.</strong>{" "}
          {cura.forWhom} Dominio, hosting, modifiche e controlli, disdici quando vuoi.
        </p>
        <a href="/prezzi" class="btn btn--secondary">Confronta tutto nella pagina prezzi</a>
      </div>
    </div>
  </div>
</section>
<style>
  .ps__intro {
    margin: 2rem 0 var(--space-block);
    max-width: 40ch;
  }
  .ps__list {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 1000px) {
    .ps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
  .ps__plan {
    padding: clamp(1.5rem, 1rem + 1.2vw, 2.25rem);
    border: 1px solid var(--filo);
    border-radius: 18px;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .ps__plan--rec {
    background: var(--mandarino);
    border-color: var(--mandarino);
    color: var(--inchiostro);
  }
  .ps__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .ps__tag {
    font-size: var(--fs-micro);
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-ui);
  }
  .ps__for {
    color: var(--grafite);
    min-height: 3em;
  }
  .ps__plan--rec .ps__for {
    color: #3a1a0b;
  }
  .ps__prices {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .ps__prices dt {
    font-size: var(--fs-micro);
    font-weight: 500;
  }
  .ps__prices dd {
    margin: 0.2rem 0 0;
    font-weight: 500;
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
  }
  .ps__prices dd {
    white-space: nowrap;
  }
  .ps__prices dd.ps__main {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2.4rem, 1.6rem + 2vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .ps__from {
    font-size: 0.4em;
    letter-spacing: 0;
    font-stretch: 100%;
    font-weight: 500;
  }
  .ps__foot {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  @media (min-width: 1000px) {
    .ps__foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .ps__foot p {
    max-width: 52ch;
  }
</style>
