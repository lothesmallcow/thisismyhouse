---
/** A real four-step sequence, so numbering is information here. */
interface Props {
  steps: { title: string; text: string }[];
  level?: "h2" | "h3";
}
const { steps, level = "h3" } = Astro.props;
const H = level;
---
<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="steps__item">
        <span class="steps__num" aria-hidden="true">{String(i + 1)}</span>
        <H class="steps__title">{s.title}</H>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>
<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--filo);
  }
  @media (min-width: 1000px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 0;
    }
  }
  .steps__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--filo);
  }
  @media (min-width: 1000px) {
    .steps__item {
      grid-template-columns: 1fr;
      padding: 0 1.75rem 0 0;
      border-bottom: 0;
      border-top: 1px solid var(--inchiostro);
      padding-top: 1.5rem;
      position: relative;
    }
  }
  .steps__num {
    grid-row: span 2;
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.75rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  @media (min-width: 1000px) {
    .steps__num {
      grid-row: auto;
      margin-bottom: 2.5rem;
    }
  }
  .steps__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    line-height: 1.18;
  }
  .steps p {
    color: var(--grafite);
    max-width: 34ch;
    grid-column: 2;
  }
  @media (min-width: 1000px) {
    .steps p {
      grid-column: auto;
    }
  }
  :global(.section--dark) .steps p {
    color: var(--on-dark-muted);
  }
</style>
