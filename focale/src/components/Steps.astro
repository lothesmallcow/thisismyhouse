---
/** A real four-step sequence. The connecting line draws with the scroll (A4, CSS only). */
interface Props {
  steps: { title: string; text: string }[];
  dark?: boolean;
  level?: "h2" | "h3";
}
const { steps, dark = false, level = "h3" } = Astro.props;
const H = level;
---
<ol class:list={["steps", { "steps--dark": dark }]}>
  {
    steps.map((s, i) => (
      <li class="steps__item">
        <span class="steps__num" aria-hidden="true">{i + 1}</span>
        <div>
          <H class="steps__title">{s.title}</H>
          <p>{s.text}</p>
        </div>
      </li>
    ))
  }
  <span class="steps__line" aria-hidden="true"></span>
</ol>
<style>
  .steps {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    max-width: 50rem;
  }
  .steps__item {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: var(--calce);
    border: 3px solid var(--portone);
    color: var(--portone);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.375rem;
    border-radius: 50%;
  }
  .steps__title {
    font-size: var(--step-2);
    margin: 0.55rem 0 0.4rem;
  }
  .steps p {
    max-width: 58ch;
  }
  .steps__line {
    position: absolute;
    left: calc(1.625rem - 1px);
    top: 1.5rem;
    bottom: 2rem;
    width: 2px;
    background: var(--portone);
    transform-origin: top;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps__line {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 60%;
      }
    }
  }
  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  :global(.section--pietra) .steps__num {
    background: var(--pietra);
  }
</style>
