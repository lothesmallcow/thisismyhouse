---
import logo from "../assets/logo/logo.json";
import { site } from "../config/site";
interface Props {
  variant?: "light" | "dark";
  class?: string;
  title?: string;
}
const { variant = "light", class: cls, title = site.brand } = Astro.props;
const ink = variant === "dark" ? "var(--carta)" : "var(--inchiostro)";
---
<svg class:list={["logo", cls]} viewBox={logo.viewBox} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <path d={logo.focus} fill={ink} />
  <path d={logo.design} fill={ink} />
</svg>
<style>
  .logo {
    height: 1.35rem;
    width: auto;
    overflow: visible;
  }
</style>
