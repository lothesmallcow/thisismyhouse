---
/**
 * The signature "messa a fuoco": a screenshot that comes from soft to sharp, once.
 * The sharp picture is always there in the flow; a pre-blurred copy (scripts/soft-shots.mjs) sits on top,
 * hidden by default. Only when scripts/focus.ts arms it (motion allowed, below the fold) does the soft copy
 * show, then fade out when the picture comes into view: opacity and a small scale, never a CSS blur.
 * Without JS or with reduced motion the sharp picture is all there is.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  soft?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}
const { src, soft, alt, widths, sizes, loading = "lazy", class: cls } = Astro.props;
---
<div class:list={["fshot", cls]} data-fshot>
  <Picture src={src} alt={alt} widths={widths} sizes={sizes} formats={["avif", "webp"]} loading={loading} decoding="async" class="fshot__sharp" />
  {
    soft && (
      <Picture src={soft} alt="" aria-hidden="true" widths={[soft.width]} sizes={sizes} formats={["avif", "webp"]} loading={loading} decoding="async" class="fshot__soft" />
    )
  }
</div>
