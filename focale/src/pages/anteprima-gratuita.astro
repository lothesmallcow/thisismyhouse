---
import Base from "../layouts/Base.astro";
import PreviewForm from "../components/PreviewForm.astro";
import { site } from "../config/site";
import { breadcrumbs } from "../lib/schema";
---
<Base
  title={`Anteprima gratuita del tuo nuovo sito | ${site.brand}`}
  description={`Tre domande e in ${site.previewHours} ore ricevi la homepage del tuo nuovo sito. Nessun impegno, nessun pagamento anticipato.`}
  sticky={false}
  jsonLd={[breadcrumbs([{ name: "Anteprima gratuita", path: "/anteprima-gratuita/" }])]}
>
  <section class="ag" data-hero>
    <div class="wrap ag-grid">
      <div class="ag-head">
        <p class="ag-label">Anteprima gratuita</p>
        <h1>Ricevi l'anteprima del tuo nuovo sito. Gratis, in {site.previewHours} ore.</h1>
        <p class="lead ag-lead">Tre domande veloci. Poi ti scriviamo noi.</p>
      </div>
      <PreviewForm />
    </div>
  </section>
</Base>
<style>
  .ag {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) var(--space-section);
  }
  .ag-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1040px) {
    .ag-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
      align-items: start;
    }
    .ag-head {
      position: sticky;
      top: 7rem;
    }
  }
  .ag-label {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--grafite);
    margin-bottom: 1.75rem;
  }
  .ag h1 {
    font-size: var(--fs-h2);
  }
  .ag-lead {
    margin-top: 1.25rem;
  }
</style>
<script>
  import { initPreviewForm } from "../scripts/forms";
  initPreviewForm();
</script>
