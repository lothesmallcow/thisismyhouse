---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closing from "../../components/Closing.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import WhatsAppMock from "../../components/WhatsAppMock.astro";
import PhoneFan from "../../components/visual/PhoneFan.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { site } from "../../config/site";
import { whatsappHref } from "../../lib/util";
import { breadcrumbs, faqPage } from "../../lib/schema";

export async function getStaticPaths() {
  const settori = await getCollection("settori");
  return settori.map((s) => ({ params: { slug: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: CollectionEntry<"settori"> };
const d = s.data;
const demo = await getEntry("lavori", d.demo);
import { kindLabel, siteAlt, siteHref } from "../../lib/lavori";
---
<Base
  title={d.title.replace("Focale", site.brand)}
  description={d.description.replace("72 ore", `${site.previewHours} ore`)}
  jsonLd={[breadcrumbs([{ name: d.short, path: `/per/${s.id}/` }]), faqPage(d.faq)]}
>
  <PageHead label={d.short} title={d.h1} lead={d.lead} class="st-head">
    <div class="btn-row st-cta">
      <a class="btn btn--primary btn--big" href={`/anteprima-gratuita?settore=${s.id}`}>Voglio l'anteprima gratuita</a>
    </div>
    <p class="muted small st-micro">Gratis e senza impegno. Rispondiamo in giornata.</p>
    <PhoneFan slot="visual" only={d.demo} />
  </PageHead>

  <section class="section section--pietra" aria-labelledby="problemi">
    <div class="wrap">
      <div class="hs-head">
        <p class="eyebrow">Il problema</p>
        <h2 id="problemi">Quello che vediamo più spesso nei siti come il tuo.</h2>
      </div>
      <ul class="st-problems">
        {
          d.problems.map((p) => (
            <li>
              <span class="st-problems__icon"><Icon name="alert" /></span>
              <p>{p}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="costruisco">
    <div class="wrap st-two">
      <div>
        <div class="hs-head">
          <p class="eyebrow">La soluzione</p>
          <h2 id="costruisco">Cosa costruiamo per te.</h2>
        </div>
        <ul class="st-build">
          {d.build.map((b) => <li><Icon name="check" size={18} />{b}</li>)}
        </ul>
      </div>
      <div class="st-req-card">
        <h3>Come ti arrivano le richieste</h3>
        <p class="st-req">{d.requests}</p>
        <WhatsAppMock heading={d.mock.heading} lines={d.mock.lines} />
      </div>
    </div>
  </section>

  {
    demo && (
      <section class="section section--pietra" aria-labelledby="esempio">
        <div class="wrap">
          <div class="hs-head">
            <p class="eyebrow">Un esempio</p>
            <h2 id="esempio">{demo.data.name}: com'è fatto un sito così.</h2>
          </div>
          <div class="st-demo">
            <a class="st-demo__media" href={`/lavori/${demo.id}/`}>
              <Image src={demo.data.shotDesktop} alt={siteAlt(demo)} widths={[600, 1000]} sizes="(min-width: 1000px) 50vw, 92vw" />
            </a>
            <div>
              <p class="muted">{kindLabel(demo)}</p>
              <p class="st-demo__goal">{demo.data.goal}</p>
              <div class="st-links">
                <a class="textlink" href={`/lavori/${demo.id}/`}>Leggi il progetto</a>
                <a class="textlink" href={siteHref(demo)} target="_blank" rel="noopener">Apri il sito</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--pietra" aria-labelledby="dom-settore">
    <div class="wrap">
      <div class="hs-head">
        <p class="eyebrow">Domande</p>
        <h2 id="dom-settore">Le domande del tuo settore.</h2>
      </div>
      <Faq items={d.faq} cols />
    </div>
  </section>

  <Closing whatsapp={d.whatsapp} ctaHref={`/anteprima-gratuita?settore=${s.id}`} />
</Base>
<style>
  :global(.st-head) .ph__title {
    max-width: 17ch;
  }
  .st-cta {
    margin-top: 1.75rem;
  }
  .st-micro {
    margin-top: 0.6rem !important;
  }
  .st-problems {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .st-problems {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .st-problems li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: 20px;
    background: #fff;
    font-size: var(--fs-lead);
    line-height: 1.4;
  }
  .st-problems__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: #fde8e6;
    color: #b3261a;
  }
  .st-two {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .st-two {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
  }
  .st-build {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .st-build li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--filo);
  }
  .st-build :global(.icon) {
    margin-top: 0.3rem;
    color: var(--blu);
  }
  .st-req-card {
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.25rem);
    border-radius: 24px;
    background: var(--nebbia);
  }
  .st-req {
    margin: 0.75rem 0 1.5rem !important;
    color: var(--grafite);
    max-width: 40ch;
  }
  .st-demo {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .st-demo {
      grid-template-columns: 1.4fr 1fr;
      gap: 3rem;
    }
  }
  .st-demo__media {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(11, 27, 63, 0.45);
  }
  .st-demo__media :global(img) {
    width: 100%;
    transition: transform 0.9s var(--ease-out);
  }
  @media (hover: hover) {
    .st-demo__media:hover :global(img) {
      transform: scale(1.02);
    }
  }
  .st-demo__goal {
    margin: 1rem 0 1.5rem !important;
    font-size: var(--fs-lead);
    line-height: 1.4;
    max-width: 28ch;
  }
  .st-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
