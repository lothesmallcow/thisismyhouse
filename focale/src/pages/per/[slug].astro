---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closing from "../../components/Closing.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import WhatsAppMock from "../../components/WhatsAppMock.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { site } from "../../config/site";
import { whatsappHref } from "../../lib/util";
import { breadcrumbs, faqPage } from "../../lib/schema";

export async function getStaticPaths() {
  const settori = await getCollection("settori");
  return settori.map((s) => ({ params: { slug: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: CollectionEntry<"settori"> };
const d = s.data;
const demo = await getEntry("lavori", d.demo);
---
<Base
  title={d.title.replace("Focale", site.brand)}
  description={d.description.replace("72 ore", `${site.previewHours} ore`)}
  jsonLd={[breadcrumbs([{ name: d.short, path: `/per/${s.id}/` }]), faqPage(d.faq)]}
>
  <PageHead label={d.short} title={d.h1} lead={d.lead} class="st-head">
    <div class="btn-row st-cta">
      <a class="btn btn--primary" href={`/anteprima-gratuita?settore=${s.id}`}>Voglio l'anteprima gratuita</a>
    </div>
  </PageHead>

  <section class="section section--pietra" aria-labelledby="problemi">
    <div class="wrap sec">
      <p class="sec__label">Il problema</p>
      <div class="sec__body">
        <h2 id="problemi" data-focus>I problemi che vediamo più spesso</h2>
        <ul class="st-problems">
          {d.problems.map((p) => <li><p>{p}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="costruisco">
    <div class="wrap sec">
      <p class="sec__label">La soluzione</p>
      <div class="sec__body st-two">
        <div>
          <h2 id="costruisco" data-focus>Cosa costruiamo per te</h2>
          <ul class="st-build">
            {d.build.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div>
          <h2 data-focus>Come ti arrivano le richieste</h2>
          <p class="lead st-req">{d.requests}</p>
          <WhatsAppMock heading={d.mock.heading} lines={d.mock.lines} />
        </div>
      </div>
    </div>
  </section>

  {
    demo && (
      <section class="section section--pietra" aria-labelledby="esempio">
        <div class="wrap sec">
          <p class="sec__label">Un esempio</p>
          <div class="sec__body st-demo">
            <a class="st-demo__media" href={`/lavori/${demo.id}/`}>
              <Image src={demo.data.shotDesktop} alt={`Il sito dimostrativo di ${demo.data.name}`} widths={[600, 1000]} sizes="(min-width: 1000px) 50vw, 92vw" />
            </a>
            <div>
              <h2 id="esempio" class="st-demo__t">{demo.data.name}</h2>
              <p class="muted">Progetto dimostrativo per un'attività inventata</p>
              <p class="st-demo__goal">{demo.data.goal}</p>
              <div class="st-links">
                <a class="textlink" href={`/lavori/${demo.id}/`}>Leggi il progetto</a>
                <a class="textlink" href={`/lavori/${demo.id}/demo/`} target="_blank" rel="noopener">Apri il sito</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--pietra" aria-labelledby="dom-settore">
    <div class="wrap sec">
      <p class="sec__label">Domande</p>
      <div class="sec__body">
        <h2 id="dom-settore" class="st-h2" data-focus>Domande</h2>
        <Faq items={d.faq} cols />
      </div>
    </div>
  </section>

  <Closing whatsapp={d.whatsapp} ctaHref={`/anteprima-gratuita?settore=${s.id}`} />
</Base>
<style>
  :global(.st-head) .ph__title {
    max-width: 17ch;
  }
  .st-cta {
    margin-top: 2.25rem;
  }
  .st-problems {
    list-style: none;
    padding: 0;
    margin: var(--space-block) 0 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--inchiostro);
  }
  @media (min-width: 1000px) {
    .st-problems {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  .st-problems li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--filo);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }
  @media (min-width: 1000px) {
    .st-problems li {
      border-bottom: 0;
    }
  }
  .st-two {
    display: grid;
    gap: 4rem;
  }
  @media (min-width: 1000px) {
    .st-two {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .st-two h2 {
    font-size: var(--fs-h2);
    max-width: 12ch;
  }
  .st-build {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--inchiostro);
  }
  .st-build li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--filo);
  }
  .st-req {
    margin: 2rem 0 2.5rem;
    max-width: 32ch;
  }
  .st-demo {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 1000px) {
    .st-demo {
      grid-template-columns: 1.4fr 1fr;
      gap: 3rem;
    }
  }
  .st-demo__media {
    display: block;
    border-radius: 16px;
    overflow: hidden;
  }
  .st-demo__media :global(img) {
    width: 100%;
    transition: transform 0.9s var(--ease-out);
  }
  @media (hover: hover) {
    .st-demo__media:hover :global(img) {
      transform: scale(1.02);
    }
  }
  .st-demo__t {
    font-size: var(--fs-h2);
    margin-bottom: 0.75rem;
  }
  .st-demo__goal {
    margin: 1.5rem 0 !important;
    font-size: var(--fs-lead);
    line-height: 1.4;
    max-width: 28ch;
  }
  .st-links {
    display: flex;
    gap: 1.5rem;
  }
  .st-h2 {
    margin-bottom: var(--space-block);
  }
</style>
