---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Closing from "../components/Closing.astro";
import P from "../components/P.astro";
import SectorFocus from "../components/visual/SectorFocus.astro";
import FocusLens from "../components/visual/FocusLens.astro";
import { site } from "../config/site";
import { breadcrumbs } from "../lib/schema";

const cols = [
  { t: "Prezzi e tempi scritti", d: "Sai quanto spendi e quando è pronto, prima di cominciare." },
  { t: "Rispondiamo in giornata", d: "Entro la giornata lavorativa, dal lunedì al venerdì: telefono, WhatsApp o email." },
  { t: "Tutto intestato a te", d: "Dominio, sito e accessi sono tuoi, anche se un giorno cambi fornitore." },
  { t: "Una cosa sola", d: "Niente pubblicità, social o negozi online. Se ti servono, ti diciamo a chi rivolgerti." },
  { t: "A Milano", d: "Di persona in tutta la Lombardia, online ovunque." },
  { t: "Dati in chiaro", d: "" },
];
---
<Base
  title={`Lo studio | ${site.brand}`}
  description={`${site.brand} è uno studio di web design a Milano che costruisce siti per piccole imprese: una cosa sola, fatta bene.`}
  jsonLd={[breadcrumbs([{ name: "Lo studio", path: "/chi-sono/" }])]}
>
  <PageHead
    class="studio-head"
    label="Lo studio"
    title="Uno studio piccolo, a Milano, che fa una cosa sola."
    lead="Siti per piccole imprese che lavorano bene: ristrutturazioni, serramenti, B&B, agriturismi, location per eventi."
  >
    <SectorFocus slot="visual" />
  </PageHead>

  <section class="section section--pietra st-name" style="overflow: clip" aria-labelledby="nome">
    <div class="wrap st-name__grid">
      <div>
        <p class="eyebrow">Il nome</p>
        <h2 id="nome" class="st-name__t">Focus vuol dire mettere a fuoco.</h2>
        <p class="lead st-name__p">
          Chi apre il tuo sito guarda poche cose: chi sei, cosa fai, come contattarti. Noi mettiamo a fuoco quelle e togliamo tutto il resto.
        </p>
        <p class="st-name__more">
          <a class="textlink" href="/lavori/">Guarda i nostri lavori</a>
        </p>
      </div>
      <FocusLens />
    </div>
  </section>

  <section class="section" aria-labelledby="come-t">
    <div class="wrap">
      <div class="hs-head">
        <h2 id="come-t">Cosa puoi aspettarti da noi.</h2>
      </div>
      <ul class="st-cols">
        {
          cols.map((c) => (
            <li>
              <h3>{c.t}</h3>
              {c.d ? (
                <p>{c.d}</p>
              ) : (
                <p>
                  {site.brand}, P.IVA <P value={site.vatNumber} />. Sede: <P value={site.registeredAddress} />.
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing />
</Base>
<style>
  /* Phones: the rolling pill's dashes close the opening; the band follows without a second gap. */
  @media (max-width: 599px) {
    :global(section.ph.studio-head) {
      padding-bottom: 1.5rem;
    }
  }
  .st-name__grid {
    display: grid;
    gap: 3rem;
    justify-items: center;
  }
  .st-name__grid > div {
    justify-self: stretch;
  }
  /* Computers: the lens about as tall as the text beside it (no empty block above and under the text). */
  @media (min-width: 1000px) {
    .st-name__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
    }
    .st-name__grid > :global(.fl) {
      zoom: 0.8;
    }
  }
  .st-name__more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .st-name__t {
    margin-top: 1rem;
    max-width: 16ch;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem);
  }
  .st-name__p {
    margin-top: 1.5rem;
    max-width: 34ch;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.5;
    color: var(--grafite);
  }
  .st-cols {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .st-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .st-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  /* "Più gas" (22 Nov 2026): six plain ruled columns, no icon cards. */
  .st-cols {
    row-gap: 0;
  }
  .st-cols li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem 0 1.75rem;
    border-top: 1px solid var(--filo);
  }
  .st-cols h3 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
  }
  .st-cols p {
    color: var(--grafite);
    max-width: 34ch;
  }
</style>
