---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Closing from "../components/Closing.astro";
import P from "../components/P.astro";
import { site } from "../config/site";
import { breadcrumbs } from "../lib/schema";

const cols = [
  { t: "Come lavoriamo", d: "Prezzi scritti, tempi scritti, niente gergo. Rispondiamo entro la giornata lavorativa." },
  { t: "Cosa non facciamo", d: "Pubblicità, social, negozi online. Se ti servono, ti diciamo a chi rivolgerti." },
  { t: "Dove siamo", d: "A Milano. Di persona in tutta la Lombardia, online ovunque." },
];
---
<Base
  title={`Lo studio | ${site.brand}`}
  description={`${site.brand} è uno studio di web design a Milano che costruisce siti per piccole imprese: una cosa sola, fatta bene.`}
  jsonLd={[breadcrumbs([{ name: "Lo studio", path: "/chi-sono/" }])]}
>
  <PageHead
    label="Lo studio"
    title="Uno studio piccolo, che fa una cosa sola."
    lead="Costruiamo siti per piccole imprese che lavorano bene: imprese di ristrutturazione, serramentisti, B&B, agriturismi e location per eventi."
  />

  <section class="section section--pietra st-name" aria-labelledby="nome">
    <div class="wrap sec">
      <p class="sec__label">Il nome</p>
      <div class="sec__body">
        <h2 id="nome" class="st-name__t" data-focus>Focus vuol dire mettere a fuoco.</h2>
        <p class="lead st-name__p">
          Chi apre il tuo sito guarda poche cose: chi sei, cosa fai, come contattarti. Noi mettiamo a fuoco quelle e togliamo tutto il resto.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Come lavoriamo">
    <div class="wrap">
      <ul class="st-cols">
        {
          cols.map((c) => (
            <li>
              <h2>{c.t}</h2>
              <p>{c.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section st-founder" aria-labelledby="fondatore">
    <div class="wrap sec">
      <p class="sec__label">Chi l'ha fondato</p>
      <div class="sec__body st-founder__body">
        {/* DA CONFERMARE: Lorenzo può modificare o togliere questo paragrafo */}
        <h2 id="fondatore" class="st-founder__t"><P value={site.ownerFirstName} />, fondatore.</h2>
        <p>
          Studia International Economics and Finance all'Università Bocconi. Prima di {site.brand} ha costruito da zero un videogioco su
          Roblox con il suo studio, Damalis. Allena una squadra di ragazzi a calcio da quattro stagioni.
        </p>
      </div>
    </div>
  </section>

  <Closing />
</Base>
<style>
  .st-name__t {
    max-width: 16ch;
  }
  .st-name__p {
    margin-top: 1.5rem;
    max-width: 40ch;
    color: var(--grafite);
  }
  .st-cols {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .st-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  .st-cols li {
    border-top: 1px solid var(--inchiostro);
    padding-top: 1.5rem;
  }
  .st-cols h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
  }
  .st-cols p {
    color: var(--grafite);
    max-width: 34ch;
  }
  .st-founder {
    padding-top: 0;
  }
  .st-founder__body {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  .st-founder__t {
    font-size: var(--fs-h3);
  }
  .st-founder__body p {
    color: var(--grafite);
  }
</style>
