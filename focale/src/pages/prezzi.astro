---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Calculator from "../components/Calculator.astro";
import Icon from "../components/Icon.astro";
import P from "../components/P.astro";
import Receipt from "../components/visual/Receipt.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { euro, fill, foundersOpen, absUrl } from "../lib/util";
import { plans, cura } from "../lib/plans";
import { breadcrumbs } from "../lib/schema";

const open = foundersOpen();
const faqs = (await getCollection("faq")).filter((f) => [10, 11, 15, 16].includes(f.data.order)).sort((a, b) => a.data.order - b.data.order);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const included = [
  "Testi scritti da noi",
  `${site.revisionRounds} giri di modifiche`,
  "Privacy e cookie in regola",
  "Dominio e accessi intestati a te",
  "Punteggio di velocità sopra 90 da telefono",
  "Una breve videochiamata per mostrarti come funziona tutto",
];
const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Siti web per piccole imprese",
  provider: { "@type": "ProfessionalService", name: site.brand, url: absUrl("/") },
  areaServed: "Lombardia",
  offers: [
    ...plans.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: open ? p.founders : p.standard,
      priceCurrency: "EUR",
      description: p.forWhom,
    })),
    {
      "@type": "Offer",
      name: cura.name,
      price: cura.price,
      priceCurrency: "EUR",
      description: cura.forWhom,
      priceSpecification: { "@type": "UnitPriceSpecification", price: cura.price, priceCurrency: "EUR", unitCode: "MON" },
    },
  ],
};
---
<Base
  title={`Prezzi dei siti web per piccole imprese | ${site.brand}`}
  description={`Prezzi chiari e scritti: Essenziale, Professionale, Su misura e il piano Cura mensile. Prezzo fondatori per i primi ${site.foundersSpotsTotal} clienti.`}
  jsonLd={[breadcrumbs([{ name: "Prezzi", path: "/prezzi/" }]), service]}
>
  <PageHead
    label="Prezzi"
    title="Quanto costa un sito che porta richieste."
    lead={`Prezzi finali, scritti qui. Paghi il ${site.depositPercent}% quando partiamo e il resto solo a sito approvato.`}
  >
    {
      open && (
        <p class="pz-banner">
          Prezzo fondatori per i primi {site.foundersSpotsTotal} clienti. Posti ancora liberi: {site.foundersSpotsLeft} su {site.foundersSpotsTotal}.{" "}
          <a class="link" href="/#fondatori">Come funziona il programma</a>
        </p>
      )
    }
    <Receipt slot="visual" />
  </PageHead>

  <section class="pz" aria-label="Pacchetti">
    <div class="wrap">
      <div class="pz__plans">
        {
          plans.map((p) => (
            <article class:list={["pz__plan", { "pz__plan--rec section--sole": p.recommended }]} aria-labelledby={`piano-${p.slug}`}>
              <div class="pz__top">
                <h2 id={`piano-${p.slug}`}>{p.name}</h2>
                {p.recommended && <span class="pz__tag">Consigliato</span>}
              </div>
              <p class="pz__for">{p.forWhom}</p>
              <dl class="pz__prices">
                {open && (
                  <div class="pz__price pz__price--main">
                    <dt>Prezzo fondatori</dt>
                    <dd>
                      {p.from && <span class="pz__from">da </span>}
                      {euro(p.founders)}
                    </dd>
                  </div>
                )}
                <div class:list={["pz__price", { "pz__price--main": !open }]}>
                  <dt>{open ? "Dal sesto cliente" : "Prezzo"}</dt>
                  <dd>
                    {p.from && <span class="pz__from">da </span>}
                    {euro(p.standard)}
                  </dd>
                </div>
              </dl>
              {p.intro && <p class="pz__intro">{p.intro}</p>}
              <ul class="pz__feat">
                {p.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    {f}
                  </li>
                ))}
              </ul>
              <a href={`/anteprima-gratuita?pacchetto=${p.slug}`} class:list={["btn", p.recommended ? "btn--primary" : "btn--secondary", "pz__btn"]}>
                Voglio l'anteprima gratuita
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sole pz-cura" data-tone="sole" aria-labelledby="piano-cura">
    <div class="wrap pz-cura__grid">
      <div class="pz-cura__head">
        <p class="sec__label">Dopo la consegna</p>
        <h2 id="piano-cura" class="pz-cura__name" data-focus>{cura.name}</h2>
        <p class="lead pz-cura__for">{cura.forWhom}</p>
      </div>
      <p class="pz-cura__price">{euro(cura.price)} <span>al mese</span></p>
      <ul class="pz-cura__list">
        {
          cura.features.map((f) => (
            <li>
              <Icon name="check" size={20} />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Calculator />

  <section class="section pz-inc" aria-labelledby="compreso">
    <div class="wrap">
      <div class="pz-inc__head">
        <p class="sec__label">Incluso</p>
        <h2 id="compreso" data-focus>Compreso in tutti i pacchetti</h2>
      </div>
      <ul class="pz-inc__grid">
        {
          included.map((i) => (
            <li>
              <span class="pz-inc__n" aria-hidden="true"><Icon name="check" size={18} /></span>
              {i}
            </li>
          ))
        }
      </ul>
      <div class="pz-extra">
        <h2 class="pz-extra__t">Costi a parte</h2>
        <p class="pz-extra__p">Il dominio, {site.domainCostRange}, intestato a te. Con il piano Cura è compreso. Nient'altro.</p>
        <p class="small pz-vat"><P value={site.vatNote} /></p>
      </div>
    </div>
  </section>

  <section class="section section--pietra" aria-labelledby="dom-prezzi">
    <div class="wrap sec">
      <p class="sec__label">Domande</p>
      <div class="sec__body">
        <h2 id="dom-prezzi" class="pz-h2" data-focus>Domande sui prezzi</h2>
        <Faq items={faqItems} cols />
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .pz-banner {
    margin-top: 2rem !important;
    padding-top: 1.25rem;
    border-top: 1px solid var(--filo);
    font-size: var(--fs-small);
    max-width: 52ch;
  }
  .pz-banner a {
    white-space: nowrap;
  }
  .pz__plans {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 1040px) {
    .pz__plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pz__plan {
    border: 1px solid var(--filo);
    border-radius: 20px;
    padding: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .pz__plan--rec {
    background: var(--mandarino);
    border-color: var(--mandarino);
    color: var(--inchiostro);
  }
  .pz__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pz__top h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
  }
  .pz__tag {
    font-size: var(--fs-micro);
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-ui);
  }
  .pz__for {
    color: var(--grafite);
  }
  .pz__plan--rec .pz__for {
    color: #3a1a0b;
  }
  .pz__prices {
    margin: 1rem 0;
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--filo);
  }
  .pz__plan--rec .pz__prices {
    border-color: rgba(36, 19, 12, 0.25);
  }
  .pz__price dt {
    font-size: var(--fs-micro);
    font-weight: 500;
  }
  .pz__price dd {
    margin: 0.25rem 0 0;
    font-weight: 500;
    font-size: 1.125rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .pz__price--main dd {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2.6rem, 1.8rem + 2.2vw, 3.75rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .pz__from {
    font-size: 0.4em;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
  }
  .pz__intro {
    font-weight: 500;
  }
  .pz__feat {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.7rem;
    font-size: 1rem;
  }
  .pz__feat li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
  }
  .pz__feat :global(.icon) {
    margin-top: 0.2rem;
  }
  .pz__btn {
    margin-top: auto;
  }
  /* Cura: name and promise, the price, what it covers: three full columns, nothing empty. */
  .pz-cura__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .pz-cura__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
      column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      align-items: start;
    }
  }
  /* The plans sit right above (and with motion share its orange): no tall gap between them. */
  .pz-cura {
    padding-block: clamp(2.5rem, 1.5rem + 2.5vw, 4rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .pz {
    padding-bottom: clamp(1rem, 0.5rem + 1vw, 1.5rem);
  }
  .pz-cura__name {
    margin-top: 1rem;
    font-size: var(--fs-display);
    line-height: 0.9;
  }
  @media (min-width: 1000px) {
    .pz-cura__price {
      margin-top: 2rem;
    }
  }
  .pz-cura__for {
    margin-top: 1rem;
    max-width: 22ch;
  }
  .pz-cura__price {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(4.5rem, 2rem + 7vw, 9rem);
    letter-spacing: -0.06em;
    line-height: 0.85;
    white-space: nowrap;
  }
  .pz-cura__price span {
    display: block;
    margin-top: 0.8rem;
    font-size: var(--fs-body);
    letter-spacing: 0;
    font-stretch: 100%;
    font-weight: 500;
  }
  .pz-cura__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--inchiostro);
  }
  .pz-cura__list li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 0.6rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(36, 19, 12, 0.25);
    font-weight: 500;
  }
  .pz-cura__list :global(.icon) {
    margin-top: 0.2rem;
  }
  /* Included: six tiles, then the one extra cost as a band. */
  .pz-inc__head {
    display: grid;
    gap: 1rem;
  }
  .pz-inc__head h2 {
    max-width: 14ch;
  }
  .pz-inc__grid {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 1rem + 2vw, 3rem) 0 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .pz-inc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .pz-inc__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pz-inc__grid li {
    display: grid;
    gap: 1.5rem;
    align-content: space-between;
    min-height: 9.5rem;
    padding: 1.4rem 1.5rem;
    border-radius: 20px;
    background: var(--nebbia);
    font-size: var(--fs-lead);
    line-height: 1.3;
    letter-spacing: -0.012em;
    transition:
      background-color 0.35s ease,
      transform 0.35s ease;
  }
  @media (hover: hover) {
    .pz-inc__grid li:hover {
      background: var(--pesca);
      transform: translateY(-4px);
    }
  }
  .pz-inc__n {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--mandarino);
  }
  .pz-extra {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.75rem 2rem;
    padding: 1.6rem 1.5rem;
    border-radius: 20px;
    border: 1px solid var(--inchiostro);
    align-items: baseline;
  }
  @media (min-width: 1000px) {
    .pz-extra {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    }
  }
  .pz-extra__t {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
  }
  .pz-extra__p {
    max-width: 40ch;
  }
  .pz-vat {
    color: var(--grafite);
  }
  .pz-h2 {
    margin-bottom: var(--space-block);
  }
</style>
