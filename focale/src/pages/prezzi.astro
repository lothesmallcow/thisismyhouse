---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Icon from "../components/Icon.astro";
import P from "../components/P.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { euro, fill, foundersOpen, absUrl } from "../lib/util";
import { plans, cura } from "../lib/plans";
import { breadcrumbs } from "../lib/schema";

const open = foundersOpen();
const faqs = (await getCollection("faq")).filter((f) => [10, 11, 15, 16].includes(f.data.order)).sort((a, b) => a.data.order - b.data.order);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const included = [
  "Testi scritti da noi",
  `${site.revisionRounds} giri di modifiche`,
  "Privacy e cookie in regola",
  "Dominio e accessi intestati a te",
  "Punteggio di velocità sopra 90 da telefono",
  "Una breve videochiamata per mostrarti come funziona tutto",
];
const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Siti web per piccole imprese",
  provider: { "@type": "ProfessionalService", name: site.brand, url: absUrl("/") },
  areaServed: "Lombardia",
  offers: [
    ...plans.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: open ? p.founders : p.standard,
      priceCurrency: "EUR",
      description: p.forWhom,
    })),
    {
      "@type": "Offer",
      name: cura.name,
      price: cura.price,
      priceCurrency: "EUR",
      description: cura.forWhom,
      priceSpecification: { "@type": "UnitPriceSpecification", price: cura.price, priceCurrency: "EUR", unitCode: "MON" },
    },
  ],
};
---
<Base
  title={`Prezzi dei siti web per piccole imprese | ${site.brand}`}
  description={`Prezzi chiari e scritti: Essenziale, Professionale, Su misura e il piano Cura mensile. Prezzo fondatori per i primi ${site.foundersSpotsTotal} clienti.`}
  jsonLd={[breadcrumbs([{ name: "Prezzi", path: "/prezzi/" }]), service]}
>
  <PageHead
    label="Prezzi"
    title="Quanto costa un sito che porta richieste."
    lead={`Prezzi finali, scritti qui. Paghi il ${site.depositPercent}% quando partiamo e il resto solo a sito approvato.`}
  >
    {
      open && (
        <p class="pz-banner">
          Prezzo fondatori per i primi {site.foundersSpotsTotal} clienti. Posti ancora liberi: {site.foundersSpotsLeft} su {site.foundersSpotsTotal}.{" "}
          <a class="link" href="/#fondatori">Come funziona il programma</a>
        </p>
      )
    }
  </PageHead>

  <section class="pz" aria-label="Pacchetti">
    <div class="wrap">
      <div class="pz__plans">
        {
          plans.map((p) => (
            <article class:list={["pz__plan", { "pz__plan--rec section--sole": p.recommended }]} aria-labelledby={`piano-${p.slug}`}>
              <div class="pz__top">
                <h2 id={`piano-${p.slug}`}>{p.name}</h2>
                {p.recommended && <span class="pz__tag">Consigliato</span>}
              </div>
              <p class="pz__for">{p.forWhom}</p>
              <dl class="pz__prices">
                {open && (
                  <div class="pz__price pz__price--main">
                    <dt>Prezzo fondatori</dt>
                    <dd>
                      {p.from && <span class="pz__from">da </span>}
                      {euro(p.founders)}
                    </dd>
                  </div>
                )}
                <div class:list={["pz__price", { "pz__price--main": !open }]}>
                  <dt>{open ? "Dal sesto cliente" : "Prezzo"}</dt>
                  <dd>
                    {p.from && <span class="pz__from">da </span>}
                    {euro(p.standard)}
                  </dd>
                </div>
              </dl>
              {p.intro && <p class="pz__intro">{p.intro}</p>}
              <ul class="pz__feat">
                {p.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    {f}
                  </li>
                ))}
              </ul>
              <a href={`/anteprima-gratuita?pacchetto=${p.slug}`} class:list={["btn", p.recommended ? "btn--primary" : "btn--secondary", "pz__btn"]}>
                Voglio l'anteprima gratuita
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pz-cura" aria-labelledby="piano-cura">
    <div class="wrap sec">
      <p class="sec__label">Dopo la consegna</p>
      <div class="sec__body pz-cura__grid">
        <div>
          <h2 id="piano-cura" data-focus>{cura.name}</h2>
          <p class="lead pz-cura__for">{cura.forWhom}</p>
          <p class="pz-cura__price">{euro(cura.price)} <span>al mese</span></p>
        </div>
        <ul class="pz-list">
          {cura.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--pietra" aria-labelledby="compreso">
    <div class="wrap sec">
      <p class="sec__label">Incluso</p>
      <div class="sec__body pz-two">
        <div>
          <h2 id="compreso" data-focus>Compreso in tutti i pacchetti</h2>
          <ul class="pz-list">
            {included.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div>
          <h2 data-focus>Costi a parte</h2>
          <p class="lead pz-extra">Il dominio, {site.domainCostRange}, intestato a te. Con il piano Cura è compreso. Nient'altro.</p>
          <p class="small muted pz-vat"><P value={site.vatNote} /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="dom-prezzi">
    <div class="wrap sec">
      <p class="sec__label">Domande</p>
      <div class="sec__body">
        <h2 id="dom-prezzi" class="pz-h2" data-focus>Domande sui prezzi</h2>
        <Faq items={faqItems} />
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .pz-banner {
    margin-top: 2rem !important;
    padding-top: 1.25rem;
    border-top: 1px solid var(--filo);
    font-size: var(--fs-small);
    max-width: 52ch;
  }
  .pz-banner a {
    white-space: nowrap;
  }
  .pz__plans {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 1040px) {
    .pz__plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pz__plan {
    border: 1px solid var(--filo);
    border-radius: 20px;
    padding: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .pz__plan--rec {
    background: var(--mandarino);
    border-color: var(--mandarino);
    color: var(--inchiostro);
  }
  .pz__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pz__top h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
  }
  .pz__tag {
    font-size: var(--fs-micro);
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-ui);
  }
  .pz__for {
    color: var(--grafite);
  }
  .pz__plan--rec .pz__for {
    color: #3a1a0b;
  }
  .pz__prices {
    margin: 1rem 0;
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--filo);
  }
  .pz__plan--rec .pz__prices {
    border-color: rgba(36, 19, 12, 0.25);
  }
  .pz__price dt {
    font-size: var(--fs-micro);
    font-weight: 500;
  }
  .pz__price dd {
    margin: 0.25rem 0 0;
    font-weight: 500;
    font-size: 1.125rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .pz__price--main dd {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2.6rem, 1.8rem + 2.2vw, 3.75rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .pz__from {
    font-size: 0.4em;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
  }
  .pz__intro {
    font-weight: 500;
  }
  .pz__feat {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.7rem;
    font-size: 1rem;
  }
  .pz__feat li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
  }
  .pz__feat :global(.icon) {
    margin-top: 0.2rem;
  }
  .pz__btn {
    margin-top: auto;
  }
  .pz-cura__grid,
  .pz-two {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .pz-cura__grid,
    .pz-two {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .pz-cura__for {
    margin-top: 1.5rem;
    color: var(--grafite);
    max-width: 24ch;
  }
  .pz-cura__price {
    margin-top: 2rem !important;
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .pz-cura__price span {
    font-size: 0.3em;
    letter-spacing: 0;
    font-stretch: 100%;
    font-weight: 500;
  }
  .pz-two h2 {
    font-size: var(--fs-h2);
    max-width: 12ch;
  }
  .pz-list {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--inchiostro);
  }
  .pz-cura__grid .pz-list {
    margin-top: 0.5rem;
  }
  .pz-list li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--filo);
  }
  .pz-extra {
    margin-top: 2.5rem;
    max-width: 30ch;
  }
  .pz-vat {
    margin-top: 1.25rem !important;
  }
  .pz-h2 {
    margin-bottom: var(--space-block);
  }
</style>
