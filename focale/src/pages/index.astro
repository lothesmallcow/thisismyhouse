---
/**
 * Home ("più gas", 22 Nov 2026): one idea per screen. The opening with the iPhone film (it opens with the
 * "messa a fuoco"), the analysis entry, the works on one pinned stage (Works.astro: the only thing that
 * pins), what you get, the four steps, the one dark statement band, prices, the studio, FAQ and the close.
 * See docs/RICERCA-DESIGN.md and reports/Più gas al sito Focus Design.md.
 */
import Base from "../layouts/Base.astro";
import HeroScene from "../components/HeroScene.astro";
import Works from "../components/Works.astro";
import PreviewForm from "../components/PreviewForm.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import PlanHelp from "../components/PlanHelp.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill, euro, foundersOpen, whatsappHref, telHref } from "../lib/util";
import P from "../components/P.astro";
import { plans } from "../lib/plans";
import { faqPage, professionalService } from "../lib/schema";

const faqs = (await getCollection("faq")).filter((f) => f.data.home).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const open = foundersOpen();
const from = open ? site.prices.essenziale.founders : site.prices.essenziale.standard;

const gets = [
  { t: "Ti chiamano con un tocco", d: "Chiamata e WhatsApp sempre a portata di pollice." },
  { t: "Ti trovano su Google", d: "Pagine scritte per le ricerche della tua zona." },
  { t: "Richieste già complete", d: "Poche domande, e sai subito cosa vuole chi ti scrive." },
  { t: "Veloce anche in campagna", d: "Si apre in un attimo con poco segnale. Punteggio Google sopra 90." },
  { t: "Tutto intestato a te", d: "Dominio, sito e accessi sono tuoi, anche se un giorno cambi fornitore." },
];
const steps = [
  { when: "Oggi", t: "Ci racconti l'attività", d: "Dieci minuti, al telefono o su WhatsApp." },
  { when: `Entro ${site.previewHours} ore`, t: "Vedi l'anteprima", d: "La homepage del tuo nuovo sito, con il tuo nome. Gratis." },
  { when: `${site.deliveryDays.essenziale}-${site.deliveryDays.professionale} giorni`, t: "Se ti convince, partiamo", d: `Acconto del ${site.depositPercent}%. Tu mandi le foto, noi costruiamo.` },
  { when: "Alla fine", t: "Approvi e va online", d: "Il saldo lo paghi solo quando lo approvi." },
];
---
<Base
  title={`${site.brand} | Il nuovo sito della tua attività, lo vedi prima di pagarlo`}
  description={`Rifacciamo il sito di imprese edili, serramentisti, B&B, agriturismi e location. Anteprima gratuita in ${site.previewHours} ore, prezzi scritti, saldo solo a sito approvato.`}
  jsonLd={[professionalService(), faqPage(faqItems)]}
  bodyClass="home"
>
  <div class="scenes">
    <HeroScene />

    <section class="section hs-check" id="analisi" aria-labelledby="check-t">
      <div class="wrap hs-check__in">
        <h2 id="check-t">Quanto lavora il tuo sito oggi?</h2>
        <div class="hs-check__go">
          <form class="hs-check__form" action="/analisi-sito/" method="get">
            <label for="check-url" class="sr-only">Indirizzo del tuo sito</label>
            <div class="hs-check__row">
              <input id="check-url" class="hs-check__input" name="url" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder="www.nomeattivita.it" required />
              <button class="btn btn--primary btn--big" type="submit">Analizza</button>
            </div>
          </form>
          <p class="hs-check__note">Un voto su 100 in un minuto, gratis. <a class="textlink" href="/analisi-sito/#esempi">Guarda tre esempi</a></p>
        </div>
      </div>
    </section>

    <Works />

    <section class="section hs-get" aria-labelledby="get-t">
      <div class="wrap hs-get__in">
        <div class="hs-get__big">
          <h2 id="get-t">Fatto per il telefono. Fatto per farti chiamare.</h2>
          <p class="lead">Testi scritti da noi, i tuoi lavori in primo piano, il numero a un tocco.</p>
        </div>
        <div class="hs-get__card" data-in>
          <ul class="hs-get__list">
            {
              gets.map((g) => (
                <li>
                  <h3>{g.t}</h3>
                  <p>{g.d}</p>
                </li>
              ))
            }
          </ul>
          <a class="textlink" href="/come-funziona/">Tutto quello che è compreso</a>
        </div>
      </div>
    </section>

    <section class="section hs-how" id="metodo" aria-labelledby="metodo-t">
      <div class="wrap">
        <div class="hs-head hs-head--row">
          <h2 id="metodo-t">Quattro passi. Il primo è gratis.</h2>
          <a class="textlink" href="/condizioni/">Le condizioni, scritte</a>
        </div>
        <ol class="hs-how__steps">
          {
            steps.map((st, i) => (
              <li data-in style={`--d: ${0.08 * i}s`}>
                <span class="hs-how__when">{st.when}</span>
                <h3>{st.t}</h3>
                <p>{st.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section hs-say" aria-labelledby="say-t">
      <div class="wrap">
        <h2 id="say-t" class="hs-say__t">Da {euro(from)}. Prima lo vedi, poi decidi.</h2>
        <div class="hs-say__row">
          <p class="lead">L'anteprima arriva in {site.previewHours} ore, è gratis e resta a te. Se non ti convince, ci salutiamo.</p>
          <a href="/anteprima-gratuita" class="btn btn--primary btn--big">Voglio l'anteprima gratuita</a>
        </div>
      </div>
    </section>

    <section class="section hs-price" id="prezzi" aria-labelledby="prezzi-t">
      <div class="wrap">
        <div class="hs-head hs-head--row">
          <h2 id="prezzi-t">Prezzi scritti, non "su richiesta".</h2>
          {open && <p class="hs-price__founders">Prezzo fondatori per i primi {site.foundersSpotsTotal} clienti.</p>}
        </div>
        <ul class="hs-price__plans">
          {
            plans.map((p) => (
              <li class:list={["hs-plan", { "hs-plan--rec": p.recommended }]}>
                <div class="hs-plan__top">
                  <h3>{p.name}</h3>
                  {p.recommended && <span class="hs-plan__tag">Consigliato</span>}
                </div>
                <p class="hs-plan__for">{p.forWhom}</p>
                <p class="hs-plan__num">
                  {p.from && <small>da </small>}
                  {euro(open ? p.founders : p.standard)}
                </p>
                {open && <p class="hs-plan__old">poi {euro(p.standard)}</p>}
                {p.intro && <p class="hs-plan__intro">{p.intro}</p>}
                <ul class="hs-plan__feat">
                  {p.features.map((f) => (
                    <li>
                      <Icon name="check" size={16} />
                      {f}
                    </li>
                  ))}
                </ul>
                {p.from && <a class="textlink hs-plan__est" href="/prezzi/#stima">Calcola una stima per il tuo caso</a>}
                <a href={`/anteprima-gratuita?pacchetto=${p.slug}`} class:list={["btn", p.recommended ? "btn--primary" : "btn--secondary", "hs-plan__btn"]}>
                  Anteprima gratuita
                </a>
              </li>
            ))
          }
        </ul>
        <PlanHelp />
      </div>
    </section>

    <section class="section hs-studio" aria-labelledby="studio-t">
      <div class="wrap hs-studio__in">
        <div>
          <h2 id="studio-t">Uno studio piccolo, a Milano, che ti risponde.</h2>
        </div>
        <div class="hs-studio__body">
          <p class="lead">Facciamo una cosa sola: siti per piccole imprese che vivono di richieste.</p>
          <ul class="hs-studio__facts">
            <li><Icon name="pin" /> Milano, di persona in tutta la Lombardia</li>
            <li><Icon name="clock" /> Rispondiamo entro la giornata lavorativa</li>
            <li><Icon name="shield" /> P.IVA <P value={site.vatNumber} /></li>
          </ul>
          <a class="textlink" href="/chi-sono/">Chi siamo</a>
        </div>
      </div>
    </section>

    <section class="section hs-faq" id="domande" aria-labelledby="domande-t">
      <div class="wrap hs-faq__in">
        <div class="hs-head hs-head--split" style="--hs-gap: 0.6rem">
          <h2 id="domande-t">Le domande che ci fanno tutti.</h2>
          <div class="hs-head__side">
            <p class="lead">Le risposte brevi. Le altre sono in Come funziona.</p>
            <a class="textlink" href="/come-funziona/#domande">Tutte le domande</a>
          </div>
        </div>
        <div><Faq items={faqItems} cols /></div>
      </div>
    </section>

    <section class="section hs-end on-navy" id="anteprima" aria-labelledby="end-t">
      <div class="wrap hs-end__in">
        <div class="hs-end__text">
          <h2 id="end-t">Guarda il tuo nuovo sito prima di decidere.</h2>
          <p class="lead">Tre domande. Entro {site.previewHours} ore ti mandiamo la homepage del tuo nuovo sito.</p>
          <ul class="hs-end__direct">
            <li>
              <a class="btn btn--secondary" href={whatsappHref(`Ciao, vorrei l'anteprima gratuita del nuovo sito per la mia attività.`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Scrivici su WhatsApp
              </a>
            </li>
            <li>
              <a class="hs-end__tel" href={telHref()}><Icon name="phone" /> <P value={site.phoneDisplay} /></a>
            </li>
          </ul>
          <ol class="hs-end__next" aria-label="Cosa succede dopo">
            {steps.map((st) => (
              <li><span class="hs-end__when">{st.when}</span><span>{st.t}</span></li>
            ))}
          </ol>
        </div>
        <div class="hs-end__form">
          <PreviewForm />
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initScenes } from "../scripts/scenes";
  import { initTilt } from "../scripts/tilt";
  import { later } from "../scripts/later";
  initScenes();
  import("../scripts/forms").then((m) => m.initPreviewForm());
  initTilt();
  // The real 3D phone (three.js and the model): computers only ("più gas", 22 Nov 2026: about 1 MB that a
  // phone does not need, the CSS phone is drawn underneath anyway). Downloaded once the page is idle,
  // drawn from the visitor's first gesture, so it does not weigh on the first paint.
  const desk3d = matchMedia("(min-width: 900px) and (hover: hover) and (pointer: fine)").matches;
  if (desk3d) {
    later(() => import("../scripts/phone3d").then((m) => m.preloadModels(false)));
    const wake = ["pointermove", "pointerdown", "wheel", "touchstart", "keydown", "scroll"];
    const go = () => {
      wake.forEach((e) => removeEventListener(e, go));
      later(() => import("../scripts/phone3d").then((m) => m.initPhone3D()));
    };
    wake.forEach((e) => addEventListener(e, go, { passive: true }));
  }
</script>
