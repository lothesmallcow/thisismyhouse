---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Icon from "../components/Icon.astro";
import Renovation from "../components/Renovation.astro";
import Calculator from "../components/Calculator.astro";
import Steps from "../components/Steps.astro";
import Founders from "../components/Founders.astro";
import PriceSummary from "../components/PriceSummary.astro";
import WorkReel from "../components/WorkReel.astro";
import Faq from "../components/Faq.astro";
import Reviews from "../components/Reviews.astro";
import Closing from "../components/Closing.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill } from "../lib/util";
import { faqPage, professionalService } from "../lib/schema";

const faqs = (await getCollection("faq")).filter((f) => f.data.home).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));

const steps = [
  { title: "Ci racconti la tua attività.", text: "Dieci minuti, al telefono o su WhatsApp." },
  {
    title: "Ricevi l'anteprima gratuita.",
    text: `Entro ${site.previewHours} ore vedi la homepage del tuo nuovo sito.`,
  },
  {
    title: "Se ti convince, partiamo.",
    text: `Acconto del ${site.depositPercent}%. Il sito è pronto in ${site.deliveryDays.professionale} giorni lavorativi.`,
  },
  {
    title: "Paghi il saldo solo a sito approvato.",
    text: "Lo provi, chiedi le modifiche, lo approvi. Poi va online.",
  },
];

const inside = [
  { icon: "mobile", t: "Si legge bene da ogni telefono.", d: "Testi grandi, pulsanti comodi, niente zoom." },
  { icon: "phone", t: "Ti chiamano con un tocco.", d: "Telefono e WhatsApp sempre a portata di pollice." },
  {
    icon: "list",
    t: "Le richieste arrivano già ordinate.",
    d: "Su WhatsApp, già complete: cosa serve, dove, quando. Più una copia via email.",
  },
  { icon: "search", t: "Ti trovano su Google.", d: "Pagine scritte per le ricerche della tua zona, scheda Google collegata." },
  { icon: "bolt", t: "Si apre in fretta.", d: "Sopra 90 su PageSpeed di Google, da telefono." },
  { icon: "shield", t: "In regola.", d: "Privacy, cookie e dati aziendali a posto, senza banner inutili." },
  { icon: "key", t: "È tuo.", d: "Dominio, codice e accessi intestati a te." },
] as const;

---
<Base
  title={`${site.brand} | Siti web che portano richieste, per piccole imprese`}
  description={`Rifacciamo il sito della tua attività perché si legga bene dal telefono e porti più richieste. Anteprima gratuita in ${site.previewHours} ore, saldo solo a sito approvato.`}
  jsonLd={[professionalService(), faqPage(faqItems)]}
>
  <Hero />

  <Manifesto />

  <Renovation />

  <Calculator />

  <section class="section" aria-labelledby="metodo">
    <div class="wrap sec">
      <p class="sec__label">Metodo</p>
      <div class="sec__body">
        <h2 id="metodo" class="h2-gap" data-focus>Quattro passi. Il primo è gratis.</h2>
        <Steps steps={steps} />
        <a class="textlink after-link" href="/come-funziona">Tutti i dettagli</a>
      </div>
    </div>
  </section>

  <section class="section section--sole guarantee" aria-labelledby="garanzia">
    <div class="wrap sec">
      <p class="sec__label">Garanzia</p>
      <div class="sec__body">
        <h2 id="garanzia" class="guarantee__title" data-focus>Il rischio ce lo prendiamo noi.</h2>
        <div class="guarantee__cols">
          <p class="lead">
            L'anteprima è gratuita. Se non ti piace, finisce lì. Se partiamo, il saldo lo paghi solo a sito approvato.
          </p>
          <div>
            <p class="muted">{site.revisionRounds} giri di modifiche inclusi. Le condizioni sono scritte, chiare e senza asterischi.</p>
            <a class="textlink guarantee__link" href="/condizioni">Leggi le condizioni</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WorkReel />

  <section class="section bento-sec" aria-labelledby="dentro">
    <div class="wrap">
      <h2 id="dentro" class="bento__title" data-focus>Cosa trovi nel tuo nuovo sito.</h2>
      <ul class="bento">
        {
          inside.map((it, i) => (
            <li class:list={["bento__tile", `bento__tile--${i + 1}`]} data-tile>
              <Icon name={it.icon} size={30} />
              <h3>{it.t}</h3>
              <p>{it.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Founders />

  <PriceSummary />

  <Reviews />

  <section class="section" aria-labelledby="domande">
    <div class="wrap sec">
      <p class="sec__label">Domande</p>
      <div class="sec__body">
        <h2 id="domande" class="h2-gap" data-focus>Le domande che ci fanno tutti</h2>
        <Faq items={faqItems} />
        <a class="textlink after-link" href="/come-funziona#domande">Tutte le domande</a>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .h2-gap {
    margin-bottom: var(--space-block);
  }
  .after-link {
    margin-top: 3rem;
  }
  .guarantee__title {
    font-size: var(--fs-display);
    max-width: 12ch;
  }
  .guarantee__cols {
    display: grid;
    gap: 2rem;
    margin-top: var(--space-block);
  }
  @media (min-width: 900px) {
    .guarantee__cols {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: end;
    }
  }
  .guarantee__link {
    margin-top: 1rem;
  }
  .bento-sec {
    background: var(--nebbia);
  }
  .bento__title {
    text-align: center;
    font-size: var(--fs-h2);
    margin: 0 auto var(--space-block);
    max-width: 16ch;
  }
  .bento {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 760px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__tile--1,
    .bento__tile--7 {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bento__tile {
      grid-column: span 2;
    }
    .bento__tile--1 {
      grid-column: span 4;
    }
    .bento__tile--2 {
      grid-column: span 2;
    }
    .bento__tile--3 {
      grid-column: span 3;
    }
    .bento__tile--4 {
      grid-column: span 3;
    }
    .bento__tile--7 {
      grid-column: 1 / -1;
    }
  }
  .bento__tile {
    background: var(--carta);
    border-radius: 28px;
    padding: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
    min-height: clamp(15rem, 12rem + 8vw, 21rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    color: var(--inchiostro);
  }
  .bento__tile :global(.icon) {
    color: var(--mandarino);
  }
  .bento__tile h3 {
    align-self: end;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 14ch;
  }
  .bento__tile p {
    color: var(--grafite);
    max-width: 40ch;
  }
  .bento__tile--1 {
    background:
      radial-gradient(120% 140% at 100% 100%, rgba(255, 91, 34, 0.9) 0%, rgba(255, 178, 63, 0.55) 35%, rgba(255, 248, 242, 0) 70%),
      var(--carta);
  }
  .bento__tile--5 {
    background: var(--mandarino);
  }
  .bento__tile--5 :global(.icon) {
    color: var(--inchiostro);
  }
  .bento__tile--5 p {
    color: var(--inchiostro);
  }
</style>
