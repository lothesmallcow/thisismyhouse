---
/**
 * Home: the opening with the iPhone film, then the makeover on a navy band (the proof, high up), the
 * sector chooser, method, prices and the close. Natural heights, nothing pins, no ambient motion. See docs/RICERCA-DESIGN.md.
 */
import Base from "../layouts/Base.astro";
import HeroScene from "../components/HeroScene.astro";
import PreviewForm from "../components/PreviewForm.astro";
import { Image } from "astro:assets";
import Makeover from "../components/Makeover.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import PlanHelp from "../components/PlanHelp.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill, euro, foundersOpen, whatsappHref, telHref } from "../lib/util";
import P from "../components/P.astro";
import { plans } from "../lib/plans";
import { faqPage, professionalService } from "../lib/schema";

const faqs = (await getCollection("faq")).filter((f) => f.data.home).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const open = foundersOpen();

const settori = (await getCollection("settori")).sort((a, b) => a.id.localeCompare(b.id));
const lavori = await getCollection("lavori");
const sectors = ["ristrutturazioni-e-serramenti", "b-and-b-e-agriturismi", "location-per-matrimoni"].map((id) => {
  const s = settori.find((x) => x.id === id)!;
  const demo = lavori.find((l) => l.id === s.data.demo)!;
  return { id, name: s.data.short, problem: s.data.problems[0], demo };
});
const gets = [
  { icon: "phone", t: "Ti chiamano con un tocco", d: "Pulsanti per chiamarti e scriverti su WhatsApp sempre a portata di pollice." },
  { icon: "search", t: "Ti trovano su Google", d: "Pagine scritte per le ricerche della tua zona, collegate alla scheda Google." },
  { icon: "list", t: "Richieste già complete", d: "Un modulo in poche domande: sai subito cosa vuole chi ti scrive." },
  { icon: "bolt", t: "Veloce anche in campagna", d: "Si apre in un attimo anche con poco segnale. Punteggio Google sopra 90." },
  { icon: "key", t: "Tutto intestato a te", d: "Dominio, sito e accessi sono tuoi. Se un giorno cambi fornitore, te li porti via." },
];
const steps = [
  { when: "Oggi", t: "Ci racconti l'attività", d: "Dieci minuti al telefono o su WhatsApp: cosa fai, dove, per chi." },
  { when: `Entro ${site.previewHours} ore`, t: "Vedi l'anteprima", d: "La homepage del tuo nuovo sito, con il tuo nome e i tuoi servizi. Gratis." },
  { when: `${site.deliveryDays.essenziale}-${site.deliveryDays.professionale} giorni`, t: "Se ti convince, partiamo", d: `Acconto del ${site.depositPercent}%. Ci mandi le foto, noi costruiamo il sito.` },
  { when: "Alla fine", t: "Approvi e va online", d: "Lo provi dal telefono. Il saldo lo paghi solo quando lo approvi." },
];
---
<Base
  title={`${site.brand} | Il nuovo sito della tua attività, lo vedi prima di pagarlo`}
  description={`Rifacciamo il sito di imprese edili, serramentisti, B&B, agriturismi e location. Anteprima gratuita in ${site.previewHours} ore, prezzi scritti, saldo solo a sito approvato.`}
  jsonLd={[professionalService(), faqPage(faqItems)]}
  bodyClass="home"
>
  <div class="scenes">
    <HeroScene />

    <Makeover />

    <section class="section hs-sec" id="settori" aria-labelledby="settori-t">
      <div class="wrap">
        <div class="hs-head" data-in>
          <p class="eyebrow">Per chi lavoriamo</p>
          <h2 id="settori-t">Tre mestieri diversi, lo stesso problema: il sito non ti fa chiamare.</h2>
        </div>
        <ul class="hs-sec__grid">
          {
            sectors.map((x, i) => (
              <li class="hs-card" data-in style={`--d: ${0.08 * i}s`}>
                <a class="hs-card__media" href={`/per/${x.id}/`} tabindex="-1" aria-hidden="true">
                  <Image src={x.demo.data.shotDesktop} alt="" widths={[480, 800]} sizes="(min-width: 900px) 30vw, 92vw" />
                </a>
                <div class="hs-card__body">
                  <h3>{x.name}</h3>
                  <p class="hs-card__problem">{x.problem}</p>
                  <div class="hs-card__links">
                    <a class="textlink" href={`/per/${x.id}/`}>Cosa facciamo per te</a>
                    <a class="textlink" href={`/lavori/${x.demo.id}/`}>Guarda il sito demo</a>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section hs-get" aria-labelledby="get-t">
      <div class="wrap hs-get__in">
        <div class="hs-get__big" data-in>
          <p class="eyebrow">Cosa ricevi</p>
          <h2 id="get-t">Un sito che si legge dal telefono e ti fa chiamare.</h2>
          <p class="lead">Testi scritti da noi, foto dei tuoi lavori in primo piano, il numero sempre a un tocco. Niente da imparare: lo usi come usi WhatsApp.</p>
          <a class="textlink" href="/come-funziona/">Tutto quello che è compreso</a>
        </div>
        {
          gets.map((g, i) => (
            <div class="hs-get__tile" data-in style={`--d: ${0.06 * i}s`}>
              <span class="hs-get__icon"><Icon name={g.icon as never} /></span>
              <h3>{g.t}</h3>
              <p>{g.d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section hs-how" id="metodo" aria-labelledby="metodo-t">
      <div class="wrap">
        <div class="hs-head hs-head--row" data-in>
          <div>
            <p class="eyebrow">Come funziona</p>
            <h2 id="metodo-t">Quattro passi. Il primo è gratis.</h2>
          </div>
          <a class="textlink" href="/condizioni/">Le condizioni, scritte</a>
        </div>
        <ol class="hs-how__steps">
          {
            steps.map((st, i) => (
              <li data-in style={`--d: ${0.08 * i}s`}>
                <span class="hs-how__when">{st.when}</span>
                <h3>{st.t}</h3>
                <p>{st.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section hs-price" id="prezzi" aria-labelledby="prezzi-t">
      <div class="wrap">
        <div class="hs-head hs-head--row" data-in>
          <div>
            <p class="eyebrow">Prezzi</p>
            <h2 id="prezzi-t">Prezzi scritti qui, non "su richiesta".</h2>
          </div>
          {open && <p class="hs-price__founders">Prezzo fondatori per i primi {site.foundersSpotsTotal} clienti.</p>}
        </div>
        <ul class="hs-price__plans">
          {
            plans.map((p, i) => (
              <li class:list={["hs-plan", { "hs-plan--rec": p.recommended }]} data-in style={`--d: ${0.08 * i}s`}>
                <div class="hs-plan__top">
                  <h3>{p.name}</h3>
                  {p.recommended && <span class="hs-plan__tag">Consigliato</span>}
                </div>
                <p class="hs-plan__for">{p.forWhom}</p>
                <p class="hs-plan__num">
                  {p.from && <small>da </small>}
                  {euro(open ? p.founders : p.standard)}
                </p>
                {open && <p class="hs-plan__old">poi {euro(p.standard)}</p>}
                {p.intro && <p class="hs-plan__intro">{p.intro}</p>}
                <ul class="hs-plan__feat">
                  {p.features.map((f) => (
                    <li>
                      <Icon name="check" size={16} />
                      {f}
                    </li>
                  ))}
                </ul>
                <a href={`/anteprima-gratuita?pacchetto=${p.slug}`} class:list={["btn", p.recommended ? "btn--primary" : "btn--secondary", "hs-plan__btn"]}>
                  Anteprima gratuita
                </a>
              </li>
            ))
          }
        </ul>
        <div data-in><PlanHelp /></div>
        <p class="hs-price__micro" data-in>
          L'anteprima è gratis. Se ti convince: acconto del {site.depositPercent}%, saldo solo a sito approvato.
        </p>
      </div>
    </section>

    <section class="section hs-studio" aria-labelledby="studio-t">
      <div class="wrap hs-studio__in">
        <div data-in>
          <p class="eyebrow">Lo studio</p>
          <h2 id="studio-t">Uno studio piccolo, a Milano, che ti risponde.</h2>
        </div>
        <div class="hs-studio__body" data-in style="--d: 0.1s">
          <p class="lead">Facciamo una cosa sola: siti per piccole imprese che vivono di richieste. Niente pubblicità, niente social, niente gergo.</p>
          <ul class="hs-studio__facts">
            <li><Icon name="pin" /> Milano, di persona in tutta la Lombardia</li>
            <li><Icon name="clock" /> Rispondiamo entro la giornata lavorativa</li>
            <li><Icon name="shield" /> P.IVA <P value={site.vatNumber} /></li>
          </ul>
          <a class="textlink" href="/chi-sono/">Chi siamo</a>
        </div>
      </div>
    </section>

    <section class="section hs-faq" id="domande" aria-labelledby="domande-t">
      <div class="wrap hs-faq__in">
        <div class="hs-head" data-in>
          <p class="eyebrow">Domande</p>
          <h2 id="domande-t">Le domande che ci fanno tutti.</h2>
          <a class="textlink" href="/come-funziona/#domande">Tutte le domande</a>
        </div>
        <div data-in style="--d: 0.1s"><Faq items={faqItems} compact /></div>
      </div>
    </section>

    <section class="section hs-end on-navy" id="anteprima" aria-labelledby="end-t">
      <div class="wrap hs-end__in">
        <div class="hs-end__text">
          <p class="eyebrow">Anteprima gratuita</p>
          <h2 id="end-t">Guarda il tuo nuovo sito prima di decidere.</h2>
          <p class="lead">Tre domande. Entro {site.previewHours} ore ti mandiamo la homepage del tuo nuovo sito. Se non ti convince, finisce lì.</p>
          <ul class="hs-end__direct">
            <li>
              <a class="btn btn--secondary" href={whatsappHref(`Ciao, vorrei l'anteprima gratuita del nuovo sito per la mia attività.`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Scrivici su WhatsApp
              </a>
            </li>
            <li>
              <a class="hs-end__tel" href={telHref()}><Icon name="phone" /> <P value={site.phoneDisplay} /></a>
            </li>
          </ul>
        </div>
        <div class="hs-end__form">
          <PreviewForm />
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initScenes } from "../scripts/scenes";
  import { initTilt } from "../scripts/tilt";
  import { later } from "../scripts/later";
  initScenes();
  import("../scripts/forms").then((m) => m.initPreviewForm());
  initTilt();
  // The real 3D phone (three.js and the model, about 1 MB) loads at the visitor's first gesture,
  // so it never weighs on the first load; until then the CSS phone stands in, almost identical.
  const wake = ["pointermove", "pointerdown", "wheel", "touchstart", "keydown", "scroll"];
  const go = () => {
    wake.forEach((e) => removeEventListener(e, go));
    later(() => import("../scripts/phone3d").then((m) => m.initPhone3D()));
  };
  wake.forEach((e) => addEventListener(e, go, { passive: true }));
</script>

