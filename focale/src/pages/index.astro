---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Icon from "../components/Icon.astro";
import Renovation from "../components/Renovation.astro";
import Calculator from "../components/Calculator.astro";
import Steps from "../components/Steps.astro";
import Founders from "../components/Founders.astro";
import PriceSummary from "../components/PriceSummary.astro";
import WorkReel from "../components/WorkReel.astro";
import Faq from "../components/Faq.astro";
import Reviews from "../components/Reviews.astro";
import Closing from "../components/Closing.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill } from "../lib/util";
import { faqPage, professionalService } from "../lib/schema";

const faqs = (await getCollection("faq")).filter((f) => f.data.home).sort((a, b) => a.data.order - b.data.order);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));

const steps = [
  { title: "Ci racconti la tua attività.", text: "Dieci minuti al telefono o su WhatsApp: cosa fai, per chi, dove." },
  {
    title: "Ricevi l'anteprima gratuita.",
    text: `Entro ${site.previewHours} ore ti mandiamo la homepage del tuo nuovo sito, con il tuo nome e i tuoi servizi. La guardi dal telefono, con calma.`,
  },
  {
    title: "Se ti convince, partiamo.",
    text: `Ci versi un acconto del ${site.depositPercent}%. In ${site.deliveryDays.professionale} giorni lavorativi dall'arrivo di foto e informazioni, il sito è pronto.`,
  },
  {
    title: "Paghi il saldo solo a sito approvato.",
    text: "Lo provi, chiedi le modifiche, lo approvi. Solo allora paghi il resto e lo mettiamo online.",
  },
];

const inside = [
  { icon: "mobile", t: "Si legge bene da ogni telefono.", d: "Testi grandi, pulsanti comodi, niente zoom." },
  { icon: "phone", t: "Ti chiamano con un tocco.", d: "Telefono e WhatsApp sempre a portata di pollice." },
  {
    icon: "list",
    t: "Le richieste arrivano già ordinate.",
    d: "Chi compila il modulo ti scrive su WhatsApp con un messaggio pronto: cosa serve, dove, quando. E tu ricevi anche una copia via email.",
  },
  { icon: "search", t: "Ti trovano su Google.", d: "Pagine scritte per le ricerche della tua zona, scheda Google collegata." },
  { icon: "bolt", t: "Si apre in fretta.", d: "Punteggio di velocità sopra 90 su PageSpeed di Google, da telefono. Te lo mostriamo prima di consegnare." },
  { icon: "shield", t: "In regola.", d: "Privacy, cookie e dati aziendali a posto, senza banner inutili." },
  { icon: "key", t: "È tuo.", d: "Dominio, codice e accessi intestati a te. Se un giorno vuoi cambiare, porti via tutto." },
] as const;

---
<Base
  title={`${site.brand} | Siti web che portano richieste, per piccole imprese`}
  description={`Rifacciamo il sito della tua attività perché si legga bene dal telefono e porti più richieste. Anteprima gratuita in ${site.previewHours} ore, saldo solo a sito approvato.`}
  jsonLd={[professionalService(), faqPage(faqItems)]}
>
  <Hero />

  <Manifesto />

  <Renovation />

  <Calculator />

  <section class="section" aria-labelledby="metodo">
    <div class="wrap sec">
      <p class="sec__label">Metodo</p>
      <div class="sec__body">
        <h2 id="metodo" class="h2-gap" data-focus>Quattro passi. Il primo è gratis.</h2>
        <Steps steps={steps} />
        <a class="textlink after-link" href="/come-funziona">Tutti i dettagli</a>
      </div>
    </div>
  </section>

  <section class="section section--sole guarantee" aria-labelledby="garanzia">
    <div class="wrap sec">
      <p class="sec__label">Garanzia</p>
      <div class="sec__body">
        <h2 id="garanzia" class="guarantee__title" data-focus>Il rischio ce lo prendiamo noi.</h2>
        <div class="guarantee__cols">
          <p class="lead">
            L'anteprima è gratuita. Se non ti piace, finisce lì: non ci devi niente e non ti richiamiamo dieci volte. Se ti piace e partiamo, il
            saldo lo paghi solo dopo aver approvato il sito finito.
          </p>
          <div>
            <p class="muted">{site.revisionRounds} giri di modifiche inclusi. Le condizioni sono scritte, chiare e senza asterischi.</p>
            <a class="textlink guarantee__link" href="/condizioni">Leggi le condizioni</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WorkReel />

  <section class="section bento-sec" aria-labelledby="dentro">
    <div class="wrap">
      <h2 id="dentro" class="bento__title" data-focus>Cosa trovi nel tuo nuovo sito.</h2>
      <ul class="bento">
        {
          inside.map((it, i) => (
            <li class:list={["bento__tile", `bento__tile--${i + 1}`]} data-tile>
              <Icon name={it.icon} size={30} />
              <h3>{it.t}</h3>
              <p>{it.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Founders />

  <PriceSummary />

  <section class="section student" aria-labelledby="studio">
    <div class="wrap sec">
      <p class="sec__label">Perché noi</p>
      <div class="sec__body student__grid">
        <div>
          <h2 id="studio" data-focus>Uno studio piccolo, apposta.</h2>
          <p class="lead student__p">
            Non siamo un'agenzia con quaranta persone e non vogliamo diventarlo. Facciamo una cosa sola, per un tipo di cliente solo. Per te
            significa tre cose.
          </p>
          <ul class="student__list">
            <li>
              <h3>Parli con chi costruisce il sito.</h3>
              <p>Niente commerciali, niente centralino: chi ti risponde è chi ci lavora.</p>
            </li>
            <li>
              <h3>Costiamo meno, senza fare peggio.</h3>
              <p>Usiamo l'intelligenza artificiale per le parti ripetitive. Il progetto, i testi e il controllo finale li facciamo a mano, uno per uno.</p>
            </li>
            <li>
              <h3>Ogni sito è il nostro biglietto da visita.</h3>
              <p>Siamo all'inizio: non possiamo permetterci di farne uno mediocre, e non vogliamo.</p>
            </li>
          </ul>
          <a href="/chi-sono" class="btn btn--secondary">Lo studio</a>
        </div>
        <figure class="student__card">
          <blockquote>Un sito fatto bene non deve costare una follia. Deve costare attenzione.</blockquote>
          <figcaption>Il principio con cui lavoriamo</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="section" aria-labelledby="domande">
    <div class="wrap sec">
      <p class="sec__label">Domande</p>
      <div class="sec__body">
        <h2 id="domande" class="h2-gap" data-focus>Le domande che ci fanno tutti</h2>
        <Faq items={faqItems} />
        <a class="textlink after-link" href="/come-funziona#domande">Tutte le domande</a>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .h2-gap {
    margin-bottom: var(--space-block);
  }
  .after-link {
    margin-top: 3rem;
  }
  .guarantee__title {
    font-size: var(--fs-display);
    max-width: 12ch;
  }
  .guarantee__cols {
    display: grid;
    gap: 2rem;
    margin-top: var(--space-block);
  }
  @media (min-width: 900px) {
    .guarantee__cols {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: end;
    }
  }
  .guarantee__link {
    margin-top: 1rem;
  }
  .bento-sec {
    background: var(--nebbia);
  }
  .bento__title {
    text-align: center;
    font-size: var(--fs-h2);
    margin: 0 auto var(--space-block);
    max-width: 16ch;
  }
  .bento {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 760px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__tile--1,
    .bento__tile--7 {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bento__tile {
      grid-column: span 2;
    }
    .bento__tile--1 {
      grid-column: span 4;
    }
    .bento__tile--2 {
      grid-column: span 2;
    }
    .bento__tile--3 {
      grid-column: span 3;
    }
    .bento__tile--4 {
      grid-column: span 3;
    }
    .bento__tile--7 {
      grid-column: 1 / -1;
    }
  }
  .bento__tile {
    background: var(--carta);
    border-radius: 28px;
    padding: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
    min-height: clamp(15rem, 12rem + 8vw, 21rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    color: var(--inchiostro);
  }
  .bento__tile :global(.icon) {
    color: var(--mandarino);
  }
  .bento__tile h3 {
    align-self: end;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 14ch;
  }
  .bento__tile p {
    color: var(--grafite);
    max-width: 40ch;
  }
  .bento__tile--1 {
    background:
      radial-gradient(120% 140% at 100% 100%, rgba(255, 91, 34, 0.9) 0%, rgba(255, 178, 63, 0.55) 35%, rgba(255, 248, 242, 0) 70%),
      var(--carta);
  }
  .bento__tile--5 {
    background: var(--mandarino);
  }
  .bento__tile--5 :global(.icon) {
    color: var(--inchiostro);
  }
  .bento__tile--5 p {
    color: var(--inchiostro);
  }
  .student__card {
    margin: 0;
    background: var(--mandarino);
    border-radius: clamp(22px, 1vw + 14px, 34px);
    padding: clamp(1.75rem, 1rem + 2.5vw, 3.25rem);
    display: grid;
    gap: 3rem;
    align-content: space-between;
    min-height: 22rem;
  }
  .student__card blockquote {
    margin: 0;
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(1.7rem, 1.1rem + 1.6vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .student__card figcaption {
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .student h2 {
    max-width: 14ch;
  }
  .student__p {
    margin: 2rem 0 2.5rem;
    max-width: 36ch;
  }
  .student__list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    gap: 1.75rem;
  }
  .student__list p {
    color: var(--grafite);
    margin-top: 0.35rem;
    max-width: 44ch;
  }
</style>
