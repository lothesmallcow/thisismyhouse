---
/**
 * Home: a full-screen opening with the iPhone film, then a normal website flow over the living
 * background (natural heights, varied layouts); only the makeover pins. See docs/RICERCA-DESIGN.md.
 */
import Base from "../layouts/Base.astro";
import HeroScene from "../components/HeroScene.astro";
import Choose from "../components/Choose.astro";
import Makeover from "../components/Makeover.astro";
import LiveBackground from "../components/LiveBackground.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill, euro, foundersOpen, whatsappHref } from "../lib/util";
import { plans } from "../lib/plans";
import { faqPage, professionalService } from "../lib/schema";

const faqs = (await getCollection("faq")).filter((f) => f.data.home).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const open = foundersOpen();

const who = ["Imprese di ristrutturazione", "Serramentisti", "B&B", "Agriturismi", "Location per matrimoni", "Ville per eventi", "Piccole imprese che vivono di richieste"];
const steps = [
  { t: "Ci racconti l'attività", d: "Dieci minuti, al telefono o su WhatsApp." },
  { t: "Vedi l'anteprima", d: `La homepage del tuo nuovo sito, entro ${site.previewHours} ore. Gratis.` },
  { t: "Se ti convince, partiamo", d: `Acconto del ${site.depositPercent}%, sito pronto in ${site.deliveryDays.professionale} giorni lavorativi.` },
  { t: "Approvi e va online", d: "Il saldo lo paghi solo a sito approvato." },
];
---
<Base
  title={`${site.brand} | Siti web che portano richieste, per piccole imprese`}
  description={`Rifacciamo il sito della tua attività perché si legga bene dal telefono e porti più richieste. Anteprima gratuita in ${site.previewHours} ore, saldo solo a sito approvato.`}
  jsonLd={[professionalService(), faqPage(faqItems)]}
  bodyClass="home"
>
  <LiveBackground />
  <div class="scenes">
    <HeroScene />

    <div class="ticker" data-ticker>
      <ul class="ticker__row" aria-label="Per chi lavoriamo">
        {who.map((w) => <li>{w}</li>)}
      </ul>
      <ul class="ticker__row" aria-hidden="true">
        {who.map((w) => <li>{w}</li>)}
      </ul>
    </div>

    <Choose />

    <Makeover />

    <section class="section sc-how" id="metodo" aria-labelledby="metodo-t">
      <div class="wrap sc-how__in">
        <div class="sc-how__side">
          <h2 id="metodo-t" data-in>Quattro passi. Il primo è gratis.</h2>
          <p class="sc-how__promise" data-in style="--d: 0.1s">Il rischio ce lo prendiamo noi: se l'anteprima non ti piace, finisce lì.</p>
          <a class="textlink" href="/condizioni/" data-in style="--d: 0.15s">Le condizioni</a>
        </div>
        <ol class="sc-how__steps" data-how>
          {
            steps.map((s, i) => (
              <li data-in style={`--d: ${0.1 + i * 0.08}s`}>
                <span class="sc-how__n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section sc-price" id="prezzi" aria-labelledby="prezzi-t">
      <div class="wrap sc-price__in">
        <div class="sc-price__head">
          <h2 id="prezzi-t" data-in>Prezzi scritti qui, non "su richiesta".</h2>
          {
            open && (
              <p class="sc-price__founders" data-in style="--d: 0.1s">
                Prezzo fondatori per i primi {site.foundersSpotsTotal} clienti. Posti liberi: {site.foundersSpotsLeft} su {site.foundersSpotsTotal}.
              </p>
            )
          }
        </div>
        <ul class="sc-price__plans">
          {
            plans.map((p, i) => (
              <li class:list={["sc-price__plan", { "is-rec": p.recommended }]} data-in style={`--d: ${0.15 + i * 0.1}s`}>
                <span class="sc-price__name">
                  {p.name}
                  {p.recommended && <span class="sc-price__tag">Consigliato</span>}
                </span>
                <span class="sc-price__for">{p.forWhom}</span>
                <span class="sc-price__num">
                  {p.from && <small>da </small>}
                  {euro(open ? p.founders : p.standard)}
                </span>
                {open && <span class="sc-price__old">poi {euro(p.standard)}</span>}
              </li>
            ))
          }
        </ul>
        <div class="sc-price__foot" data-in style="--d: 0.5s">
          <p>
            Paghi il {site.depositPercent}% quando partiamo e il saldo solo a sito approvato.
          </p>
          <a class="btn btn--secondary" href="/prezzi/">Confronta i pacchetti</a>
        </div>
      </div>
    </section>

    <section class="section sc-end" id="domande" aria-labelledby="domande-t">
      <div class="wrap sc-end__in">
        <div class="sc-end__cta">
          <h2 data-in>Guarda il tuo nuovo sito prima di decidere.</h2>
          <p class="lead" data-in style="--d: 0.1s">Anteprima in {site.previewHours} ore. Se non ti convince, non ci devi niente.</p>
          <div class="btn-row" data-in style="--d: 0.2s">
            <a href="/anteprima-gratuita" class="btn btn--primary" data-magnetic>Voglio l'anteprima gratuita</a>
            <a href={whatsappHref(`Ciao, ho visto il sito di ${site.brand} e vorrei l'anteprima gratuita per la mia attività.`)} class="btn btn--secondary" target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              WhatsApp
            </a>
          </div>
        </div>
        <div class="sc-end__faq" data-in style="--d: 0.25s">
          <h2 id="domande-t" class="sc-end__faq-t">Domande frequenti</h2>
          <Faq items={faqItems} compact />
          <a class="textlink" href="/come-funziona/#domande">Tutte le domande</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initScenes } from "../scripts/scenes";
  import { initPaths } from "../scripts/paths";
  import { initTilt } from "../scripts/tilt";
  import { later } from "../scripts/later";
  initScenes();
  initPaths();
  initTilt();
  // The real 3D phone (three.js and the model, about 1 MB) loads at the visitor's first gesture,
  // so it never weighs on the first load; until then the CSS phone stands in, almost identical.
  const wake = ["pointermove", "pointerdown", "wheel", "touchstart", "keydown", "scroll"];
  const go = () => {
    wake.forEach((e) => removeEventListener(e, go));
    later(() => import("../scripts/phone3d").then((m) => m.initPhone3D()));
  };
  wake.forEach((e) => addEventListener(e, go, { passive: true }));
</script>

<style>
  /* ---------- Per chi (ticker) ---------- */
  .ticker {
    display: flex;
    overflow: hidden;
    padding-block: clamp(1rem, 2.5vh, 1.6rem);
    border-block: 1px solid rgba(36, 19, 12, 0.14);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__row {
    display: flex;
    flex: none;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: ticker 48s linear infinite;
  }
  .ticker__row li {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.6rem);
  }
  .ticker__row li::after {
    content: "";
    width: 0.32em;
    height: 0.32em;
    margin-inline: 0.9em;
    border-radius: 50%;
    background: var(--mandarino);
  }
  @keyframes ticker {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      flex-wrap: wrap;
    }
    .ticker__row {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.4rem;
      padding-inline: var(--gutter);
      animation: none;
    }
    .ticker__row[aria-hidden] {
      display: none;
    }
    .ticker {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .ticker__row li {
      white-space: normal;
      font-size: clamp(1.2rem, 1rem + 1vw, 2rem);
    }
  }

  /* ---------- Metodo: the heading stays while the steps scroll past, a line fills as you read ---------- */
  .sc-how__in {
    display: grid;
    gap: clamp(2rem, 5vh, 3.5rem);
    width: 100%;
  }
  @media (min-width: 900px) {
    .sc-how__in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 6vw, 7rem);
      align-items: start;
    }
    .sc-how__side {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
  }
  .sc-how__side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .sc-how__side h2 {
    max-width: 12ch;
  }
  .sc-how__promise {
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
    max-width: 26ch;
    color: var(--grafite);
  }
  .sc-how__steps {
    --p: 0;
    position: relative;
    list-style: none;
    padding: 0 0 0 clamp(4rem, 3rem + 3vw, 6rem);
    margin: 0;
    display: grid;
    gap: clamp(2rem, 6vh, 4.5rem);
  }
  /* The rail and its orange fill (scripts/scenes.ts sets --p while the list scrolls past). */
  .sc-how__steps::before,
  .sc-how__steps::after {
    content: "";
    position: absolute;
    left: calc(clamp(1.4rem, 1rem + 1vw, 2rem));
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: rgba(36, 19, 12, 0.14);
  }
  .sc-how__steps::after {
    background: var(--mandarino);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .sc-how__steps li {
    position: relative;
  }
  .sc-how__n {
    position: absolute;
    left: calc(-1 * clamp(4rem, 3rem + 3vw, 6rem));
    top: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(2.8rem, 2rem + 2vw, 4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--carta);
    box-shadow: 0 0 0 2px var(--mandarino);
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.8rem);
    line-height: 1;
    color: #b8400f;
  }
  .sc-how__steps h3 {
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.2rem);
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .sc-how__steps p {
    color: var(--grafite);
    max-width: 40ch;
  }

  /* ---------- Prezzi ---------- */
  .sc-price__in {
    display: grid;
    gap: clamp(2rem, 5vh, 3.5rem);
    width: 100%;
  }
  .sc-price__head {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .sc-price__head {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
      gap: 2rem;
    }
  }
  .sc-price__founders {
    color: var(--grafite);
  }
  .sc-price__plans {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
  }
  @media (min-width: 900px) {
    .sc-price__plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Columns, not boxes: a rule on top, the recommended one in tangerine. */
  .sc-price__plan {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--inchiostro);
  }
  .sc-price__plan.is-rec {
    border-top: 3px solid var(--mandarino);
    padding-top: calc(1.25rem - 2px);
  }
  .sc-price__plan.is-rec .sc-price__num {
    color: #b8400f;
  }
  .sc-price__name {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    font-size: var(--fs-h3);
  }
  .sc-price__tag {
    font-size: var(--fs-micro);
    padding: 0.25rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-ui);
  }
  .sc-price__for {
    color: var(--grafite);
  }

  .sc-price__num {
    margin-top: 0.75rem;
    font-weight: 300;
    font-stretch: 125%;
    font-size: clamp(2.6rem, 1.8rem + 2.4vw, 4.4rem);
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
  .sc-price__num small {
    font-size: 0.4em;
    letter-spacing: 0;
    font-stretch: 100%;
    font-weight: 500;
  }
  .sc-price__old {
    font-size: var(--fs-small);
    color: var(--grafite);
  }
  .sc-price__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  /* ---------- Chiusura e domande ---------- */

  .sc-end__in {
    display: grid;
    gap: clamp(2rem, 5vh, 3.5rem);
    width: 100%;
  }
  @media (min-width: 1000px) {
    .sc-end__in {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 6rem);
    }
  }
  .sc-end__cta {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .sc-end__cta h2 {
    font-size: clamp(2.4rem, 1.2rem + 3.6vw, 5rem);
    line-height: 1;
    max-width: 12ch;
  }
  .sc-end__faq {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .sc-end__faq :global(.faq) {
    width: 100%;
  }
  .sc-end__faq-t {
    font-size: var(--fs-h3);
  }
</style>
