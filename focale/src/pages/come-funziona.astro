---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import ChatSteps from "../components/visual/ChatSteps.astro";
import FreePreview from "../components/visual/FreePreview.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill } from "../lib/util";
import { breadcrumbs, faqPage } from "../lib/schema";

const faqs = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const steps = [
  {
    title: "Ci racconti la tua attività.",
    text: "Dieci minuti al telefono o su WhatsApp. Ci dici cosa fai, per chi lavori, in che zona e cosa vorresti che il sito facesse per te. Se hai già un sito, gli diamo un'occhiata prima di sentirci.",
  },
  {
    title: "Ricevi l'anteprima gratuita.",
    text: `Entro ${site.previewHours} ore ti mandiamo la homepage del tuo nuovo sito, con il tuo nome, i tuoi servizi e le foto che troviamo sulla tua scheda Google o che ci mandi tu. È privata: la vedi solo tu, da un link.`,
  },
  {
    title: "Se ti convince, partiamo.",
    text: `Ti mandiamo un preventivo scritto con il pacchetto scelto. Ci versi un acconto del ${site.depositPercent}% e ci mandi foto e informazioni. Da quel giorno il sito è pronto in ${site.deliveryDays.essenziale} o ${site.deliveryDays.professionale} giorni lavorativi, secondo il pacchetto.`,
  },
  {
    title: "Approvi, paghi il saldo, va online.",
    text: `Lo provi dal tuo telefono e chiedi le modifiche: ${site.revisionRounds} giri sono inclusi. Quando lo approvi, paghi il saldo e lo mettiamo online sul tuo dominio.`,
  },
];
const whens = ["Oggi", `Entro ${site.previewHours} ore`, `${site.deliveryDays.essenziale}-${site.deliveryDays.professionale} giorni lavorativi`, "Alla fine"];
const need = [
  "Il nome dell'attività e cosa fai, in parole tue",
  "La zona in cui lavori",
  "Telefono, WhatsApp ed email da mostrare sul sito",
  "Il logo, se ce l'hai. Se non ce l'hai, scriviamo il nome in modo pulito",
  "Da 10 a 30 foto dei tuoi lavori, anche fatte col telefono",
  "Gli accessi al dominio, se ne hai già uno. Ti spieghiamo noi dove trovarli",
];
const get = [
  "Il sito online sul tuo dominio",
  "Un messaggio di prova, per vedere come ti arrivano le richieste",
  "La scheda Google collegata al sito",
  "Un documento di una pagina con tutti gli accessi, intestati a te",
  "Il punteggio di velocità di Google, misurato davanti a te",
];
---
<Base
  title={`Come funziona | ${site.brand}`}
  description={`Quattro passi dal primo messaggio al sito online. Anteprima gratuita, acconto del ${site.depositPercent}%, saldo solo dopo la tua approvazione.`}
  jsonLd={[breadcrumbs([{ name: "Come funziona", path: "/come-funziona/" }]), faqPage(faqItems)]}
>
  <PageHead
    label="Come funziona"
    title="Come funziona, dal primo messaggio al sito online."
    lead="Dal primo messaggio al sito online in quattro passi. Il primo è gratis, e il saldo lo paghi solo quando il sito ti convince."
  >
    <ChatSteps slot="visual" />
  </PageHead>

  <section class="section" aria-labelledby="passi-t">
    <div class="wrap">
      <div class="hs-head">
        <p class="eyebrow">I passi</p>
        <h2 id="passi-t">Dal primo messaggio al sito online.</h2>
      </div>
      <ol class="hs-how__steps cf-steps">
        {
          steps.map((st, i) => (
            <li>
              <span class="hs-how__when">{whens[i]}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="cf-ask">
        <a href="/anteprima-gratuita" class="btn btn--primary btn--big">Voglio l'anteprima gratuita</a>
        <p class="muted small">Gratis e senza impegno. Rispondiamo in giornata.</p>
      </div>
    </div>
  </section>

  <section class="section section--pietra" aria-labelledby="serve">
    <div class="wrap">
      <div class="hs-head">
        <p class="eyebrow">Da te e per te</p>
        <h2 id="serve">Cosa ci serve da te, cosa ricevi.</h2>
      </div>
      <div class="cf-two">
        <div class="cf-card">
          <h3>Cosa ci serve da te</h3>
          <ul class="cf-list">{need.map((n) => <li><Icon name="list" size={18} />{n}</li>)}</ul>
        </div>
        <div class="cf-card cf-card--get">
          <h3>Cosa ricevi</h3>
          <ul class="cf-list">{get.map((n) => <li><Icon name="check" size={18} />{n}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sole" aria-labelledby="garanzia">
    <div class="wrap cf-g-grid">
      <div>
        <p class="eyebrow">Garanzia</p>
        <h2 id="garanzia" class="cf-g-title" data-focus>La garanzia</h2>
        <p class="lead cf-g">
          L'anteprima è gratuita. Se non ti piace, finisce lì: non ci devi niente e non ti richiamiamo dieci volte. Se ti piace e partiamo, il
          saldo lo paghi solo dopo aver approvato il sito finito.
        </p>
        <a class="btn btn--secondary" href="/condizioni">Leggi le condizioni complete</a>
      </div>
      <FreePreview />
    </div>
  </section>

  <section class="section section--pietra" id="domande" aria-labelledby="domande-t">
    <div class="wrap">
      <div class="hs-head">
        <p class="eyebrow">Domande</p>
        <h2 id="domande-t">Tutte le domande.</h2>
      </div>
      <Faq items={faqItems} cols />
    </div>
  </section>

  <Closing />
</Base>
<style>
  .cf-ask {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    margin-top: 2.5rem;
  }
  .cf-two {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .cf-two {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  .cf-card {
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.25rem);
    border-radius: 20px;
    background: #fff;
  }
  .cf-card--get {
    background: var(--blu);
    color: #fff;
    --inchiostro: #fff;
    --filo: rgba(255, 255, 255, 0.2);
  }
  .cf-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .cf-list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--filo);
  }
  .cf-list :global(.icon) {
    margin-top: 0.25rem;
    color: var(--blu);
  }
  .cf-card--get .cf-list :global(.icon) {
    color: #fff;
  }
  .cf-g-grid {
    display: grid;
    gap: 3rem;
    justify-items: center;
  }
  .cf-g-grid > div {
    justify-self: stretch;
  }
  @media (min-width: 1000px) {
    .cf-g-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
  }
  .cf-g-title {
    margin-top: 0.75rem;
  }
  .cf-g {
    margin: 1.5rem 0 2rem;
    max-width: 40ch;
  }
</style>
