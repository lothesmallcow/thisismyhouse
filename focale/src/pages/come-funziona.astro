---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import ChatSteps from "../components/visual/ChatSteps.astro";
import FreePreview from "../components/visual/FreePreview.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { fill } from "../lib/util";
import { breadcrumbs, faqPage } from "../lib/schema";

const faqs = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const faqItems = faqs.map((f) => ({ q: f.data.q, a: fill(f.data.a) }));
const steps = [
  {
    title: "Ci racconti la tua attività.",
    text: "Dieci minuti al telefono o su WhatsApp: cosa fai, per chi, in che zona. Se hai già un sito, lo guardiamo prima di sentirci.",
  },
  {
    title: "Ricevi l'anteprima gratuita.",
    text: `Entro ${site.previewHours} ore la homepage del tuo nuovo sito, con il tuo nome, i tuoi servizi e le foto della tua scheda Google o le tue. È privata: la vedi solo tu, da un link.`,
  },
  {
    title: "Se ti convince, partiamo.",
    text: `Preventivo scritto, acconto del ${site.depositPercent}%, poi foto e informazioni. Il sito è pronto in ${site.deliveryDays.essenziale} o ${site.deliveryDays.professionale} giorni lavorativi, secondo il pacchetto.`,
  },
  {
    title: "Approvi, paghi il saldo, va online.",
    text: `Lo provi dal telefono, con ${site.revisionRounds} giri di modifiche inclusi. Quando lo approvi paghi il saldo e va online sul tuo dominio.`,
  },
];
const whens = ["Oggi", `Entro ${site.previewHours} ore`, `${site.deliveryDays.essenziale}-${site.deliveryDays.professionale} giorni lavorativi`, "Alla fine"];
const need = [
  "Il nome dell'attività e cosa fai, in parole tue",
  "La zona in cui lavori",
  "Telefono, WhatsApp ed email da mostrare sul sito",
  "Il logo, se ce l'hai. Se non ce l'hai, scriviamo il nome in modo pulito",
  "Da 10 a 30 foto dei tuoi lavori, anche fatte col telefono",
  "Gli accessi al dominio, se ne hai già uno. Ti spieghiamo noi dove trovarli",
];
const get = [
  "Il sito online sul tuo dominio",
  "Un messaggio di prova, per vedere come ti arrivano le richieste",
  "La scheda Google collegata al sito",
  "Un documento di una pagina con tutti gli accessi, intestati a te",
  "Il punteggio di velocità di Google, misurato davanti a te",
];
---
<Base
  title={`Come funziona | ${site.brand}`}
  description={`Quattro passi dal primo messaggio al sito online. Anteprima gratuita, acconto del ${site.depositPercent}%, saldo solo dopo la tua approvazione.`}
  jsonLd={[breadcrumbs([{ name: "Come funziona", path: "/come-funziona/" }]), faqPage(faqItems)]}
>
  <PageHead
    label="Come funziona"
    title="Dal primo messaggio al sito online."
    lead="Tu ci racconti l'attività, noi ti mostriamo il sito. Il saldo lo paghi solo a sito approvato."
  >
    <ChatSteps slot="visual" />
  </PageHead>

  <section class="section" aria-labelledby="passi-t">
    <div class="wrap">
      <div class="hs-head cf-head-row">
        <h2 id="passi-t">Quattro passi, il primo è gratis.</h2>
        <div class="cf-ask">
          <a href="/anteprima-gratuita" class="btn btn--primary btn--big">Voglio l'anteprima gratuita</a>
        </div>
      </div>
      <ol class="hs-how__steps cf-steps">
        {
          steps.map((st, i) => (
            <li>
              <span class="hs-how__when">{whens[i]}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--pietra cf-serve" aria-labelledby="serve">
    <div class="wrap">
      <div class="hs-head hs-head--split">
        <p class="eyebrow">Da te e per te</p>
        <h2 id="serve">Cosa ci serve da te, cosa ricevi.</h2>
        <div class="hs-head__side">
          <p class="lead">Da te, poche informazioni e qualche foto, anche fatta col telefono. Da noi, il sito online, intestato a te.</p>
        </div>
      </div>
      <div class="cf-two">
        <div class="cf-card">
          <h3>Cosa ci serve da te</h3>
          <ul class="cf-list">{need.map((n) => <li><Icon name="list" size={18} />{n}</li>)}</ul>
        </div>
        <div class="cf-card cf-card--get">
          <h3>Cosa ricevi</h3>
          <ul class="cf-list">{get.map((n) => <li><Icon name="check" size={18} />{n}</li>)}</ul>
          <a class="btn cf-card__btn" href="/prezzi/">Vedi i pacchetti e i prezzi</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sole" aria-labelledby="garanzia">
    <div class="wrap cf-g-grid">
      <div>
        <h2 id="garanzia" class="cf-g-title">L'anteprima è gratis e resta a te. Il saldo, a sito approvato.</h2>
        <p class="lead cf-g">Se l'anteprima non ti piace, finisce lì: non ci devi niente e non ti richiamiamo dieci volte.</p>
        <a class="btn btn--secondary" href="/condizioni">Leggi le condizioni complete</a>
      </div>
      <FreePreview />
    </div>
  </section>

  <section class="section section--pietra" id="domande" aria-labelledby="domande-t">
    <div class="wrap">
      <div class="hs-head hs-head--split" style="--hs-gap: 0.6rem">
        <p class="eyebrow">Domande</p>
        <h2 id="domande-t">Tutte le domande.</h2>
        <div class="hs-head__side">
          <p class="lead">Le risposte brevi. Se la tua domanda non c'è, scrivici.</p>
        </div>
      </div>
      <Faq items={faqItems} cols />
    </div>
  </section>

  <Closing />
</Base>
<style>
  /* The button sits on the title's row, not alone under the first step (Lorenzo, 22 Nov 2026: dead space). */
  .cf-head-row {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .cf-head-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 3rem;
    }
  }
  .cf-ask {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  /* The band ends with the two cards, framed by their own padding. */
  .cf-serve {
    padding-bottom: clamp(1.5rem, 0.5rem + 2vw, 2.5rem);
  }
  .cf-two {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .cf-two {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  .cf-card {
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.25rem);
    border-radius: 20px;
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .cf-card__btn {
    margin-top: auto;
    align-self: flex-start;
    background: #fff;
    color: var(--blu);
  }
  .cf-card__btn::after {
    content: none;
  }
  /* Phones: the button across the card, like the rows above it. */
  @media (max-width: 599px) {
    .cf-card__btn {
      align-self: stretch;
    }
  }
  .cf-card--get {
    background: var(--blu);
    color: #fff;
    --inchiostro: #fff;
    --filo: rgba(255, 255, 255, 0.2);
  }
  .cf-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .cf-list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--filo);
  }
  @media (max-width: 599px) {
    .cf-list li {
      padding: 0.55rem 0;
      font-size: 0.9375rem;
      line-height: 1.35;
    }
  }
  .cf-list :global(.icon) {
    margin-top: 0.25rem;
    color: var(--blu);
  }
  .cf-card--get .cf-list :global(.icon) {
    color: #fff;
  }
  .cf-g-grid {
    display: grid;
    gap: 3rem;
    justify-items: center;
  }
  .cf-g-grid > div {
    justify-self: stretch;
    max-width: 40rem;
  }
  @media (min-width: 1000px) {
    .cf-g-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }
  .cf-g-title {
    max-width: 16ch;
    font-size: var(--fs-mega);
  }
  .cf-g {
    margin: 1.5rem 0 2rem;
    max-width: 40ch;
  }
</style>
