---
/**
 * Demo: Cascina Rovere, an invented agriturismo in Brianza. Built like a real client site with the
 * motion kit (scripts/demo-motion.ts): see-through header over a full-screen hero, a statement
 * with highlighter strokes, the rooms in a gallery that slides sideways with the scroll, a day at
 * the farmhouse in four moments, availability on WhatsApp, Italian/English toggle.
 */
import Demo from "../../../layouts/Demo.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/cascina-rovere/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/cascina-rovere/${n}.jpg`].default;

// Every visible string, in Italian and English. The toggle swaps them in place.
const dict: Record<string, [string, string]> = {
  nav_rooms: ["Camere", "Rooms"],
  nav_day: ["La giornata", "A day here"],
  nav_avail: ["Disponibilità", "Availability"],
  nav_where: ["Come arrivare", "Getting here"],
  nav_book: ["Prenota", "Book"],
  menu: ["Menu", "Menu"],
  menu_close: ["Chiudi", "Close"],
  hero_kicker: ["Agriturismo in Brianza", "Farm stay in Brianza"],
  hero_h1: ["Sei camere in cascina, a quaranta minuti da Milano.", "Six rooms in a farmhouse, forty minutes from Milan."],
  hero_sub: [
    "Colazione con i prodotti dell'orto, colline e silenzio. Scrivici per la disponibilità: rispondiamo in giornata.",
    "Breakfast from our garden, hills and quiet. Ask us for availability: we reply the same day.",
  ],
  hero_cta: ["Chiedi la disponibilità", "Check availability"],
  hero_more: ["Scopri le camere", "See the rooms"],
  hero_alt: ["La cascina tra le colline al tramonto", "The farmhouse among the hills at sunset"],
  intro_1: ["Una cascina dell'Ottocento tra le colline, sistemata con calma. Qui si viene per ", "A nineteenth-century farmhouse in the hills, restored slowly. People come here to "],
  intro_2: ["dormire bene", "sleep well"],
  intro_3: [", fare colazione con ", ", have breakfast with "],
  intro_4: ["quello che cresce nell'orto", "what grows in the garden"],
  intro_5: [" e camminare ", " and walk "],
  intro_6: ["fino al lago", "down to the lake"],
  intro_7: [".", "."],
  f_rooms: ["camere, tutte con bagno", "rooms, all en suite"],
  f_milan: ["minuti da Milano", "minutes from Milan"],
  f_lake: ["minuti dal lago", "minutes from the lake"],
  rooms_h2: ["Le camere", "The rooms"],
  rooms_lead: [
    "Ognuna ha il nome di qualcosa che vedi dalla finestra. Bagno privato e colazione inclusa.",
    "Each is named after something you can see from its window. Private bathroom and breakfast included.",
  ],
  rooms_hint: ["Scorri per vederle tutte", "Scroll to see them all"],
  guests: ["ospiti", "guests"],
  ask_room: ["Chiedi questa camera", "Ask for this room"],
  r_noce: ["Pavimento in cotto e travi in noce, vista sull'orto.", "Terracotta floor and walnut beams, looking over the garden."],
  r_glicine: ["La più luminosa, con il glicine che in maggio entra dalla finestra.", "The brightest, with wisteria at the window in May."],
  r_fienile: ["Nel vecchio fienile, con il soffitto a travi a vista.", "In the old hayloft, under exposed beams."],
  r_pergola: ["Accesso diretto alla pergola: ideale per le colazioni lente.", "Direct access to the pergola: made for slow breakfasts."],
  r_frutteto: ["Per famiglie: letto matrimoniale e due singoli, sul frutteto.", "For families: a double and two singles, over the orchard."],
  r_torretta: ["In cima alla torretta, con l'oblò sulle colline.", "At the top of the turret, with a round window on the hills."],
  day_h2: ["Una giornata in cascina", "A day at the farmhouse"],
  m_pergola_w: ["Mattina", "Morning"],
  m_pergola_t: ["Colazione sotto la pergola", "Breakfast under the pergola"],
  m_pergola_d: [
    "Pane del forno del paese, uova delle nostre galline, marmellate dell'orto. Fino alle dieci e mezza, senza fretta.",
    "Bread from the village bakery, eggs from our hens, jams from the garden. Until half past ten, no rush.",
  ],
  m_sentieri_w: ["Pomeriggio", "Afternoon"],
  m_sentieri_t: ["Sentieri tra le colline", "Trails in the hills"],
  m_sentieri_d: ["Passeggiate da un'ora a una giornata, partendo dalla porta. La mappa te la diamo noi.", "Walks from one hour to a full day, right from the door. We give you the map."],
  m_lago_w: ["Sera", "Evening"],
  m_lago_t: ["Il lago a dieci minuti", "The lake, ten minutes away"],
  m_lago_d: ["Un giro in barca o un aperitivo in riva all'acqua, e si torna per cena.", "A boat trip or a drink by the water, and back for dinner."],
  m_borgo_w: ["Sabato", "Saturday"],
  m_borgo_t: ["Il mercato del borgo", "The village market"],
  m_borgo_d: ["Ogni sabato mattina, con i produttori della zona. A piedi sono venti minuti.", "Every Saturday morning, with local producers. Twenty minutes on foot."],
  avail_h2: ["Chiedi la disponibilità", "Check availability"],
  avail_lead: [
    "Scegli le date e quante persone siete. Ti rispondiamo su WhatsApp in giornata, con il prezzo esatto.",
    "Choose your dates and how many you are. We reply on WhatsApp the same day, with the exact price.",
  ],
  avail_p1: ["Risposta in giornata", "Reply the same day"],
  avail_p2: ["Prezzo esatto, niente sorprese", "Exact price, no surprises"],
  avail_p3: ["Colazione sempre inclusa", "Breakfast always included"],
  f_arrivo: ["Arrivo", "Arrival"],
  f_partenza: ["Partenza", "Departure"],
  f_ospiti: ["Ospiti", "Guests"],
  f_lingua: ["Lingua", "Language"],
  f_nome: ["Nome", "Name"],
  f_send: ["Invia su WhatsApp", "Send on WhatsApp"],
  f_note: [
    "Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design.",
    "WhatsApp opens with the message ready. This is a demo site: the message goes to Focus Design.",
  ],
  lang_it: ["Italiano", "Italian"],
  lang_en: ["Inglese", "English"],
  where_h2: ["Come arrivare", "Getting here"],
  where_car_t: ["In auto", "By car"],
  where_car: ["Da Milano in circa quaranta minuti, parcheggio nel cortile.", "From Milan in about forty minutes, parking in the courtyard."],
  where_train_t: ["In treno", "By train"],
  where_train: ["Fino alla stazione più vicina, poi ti veniamo a prendere noi.", "To the nearest station, then we pick you up."],
  foot_tag: ["Sei camere in cascina, tra le colline della Brianza.", "Six rooms in a farmhouse, in the hills of Brianza."],
  foot_nav: ["Il sito", "This site"],
  foot_contact: ["Scrivici", "Write to us"],
  foot_wa: ["WhatsApp, rispondiamo in giornata", "WhatsApp, we reply the same day"],
  foot: ["Cascina Rovere è un'attività inventata. Progetto dimostrativo di Focus Design.", "Cascina Rovere is an invented business. A Focus Design demo project."],
  toggle: ["English", "Italiano"],
  toggle_label: ["Read this site in English", "Leggi il sito in italiano"],
};
const t = (k: string) => dict[k][0];
const rooms = [
  { k: "noce", n: "Noce", g: 2 },
  { k: "glicine", n: "Glicine", g: 2 },
  { k: "fienile", n: "Fienile", g: 3 },
  { k: "pergola", n: "Pergola", g: 2 },
  { k: "frutteto", n: "Frutteto", g: 4 },
  { k: "torretta", n: "Torretta", g: 2 },
];
const moments = ["pergola", "sentieri", "lago", "borgo"];
const nav = [
  { href: "#camere", k: "nav_rooms" },
  { href: "#giornata", k: "nav_day" },
  { href: "#disponibilita", k: "nav_avail" },
  { href: "#arrivare", k: "nav_where" },
];
const waHref = `https://wa.me/${site.whatsappNumber}`;
---
<Demo
  title="Cascina Rovere | Agriturismo in Brianza (demo)"
  description="Sito dimostrativo di Focus Design per un agriturismo inventato in Brianza."
  fonts={["/fonts/demo/fraunces.woff2"]}
  themeColor="#3f4a2c"
>
  <style is:global>
    @font-face {
      font-family: "Fraunces";
      font-style: normal;
      font-display: swap;
      font-weight: 100 900;
      src: url("/fonts/demo/fraunces.woff2") format("woff2");
    }
    @font-face {
      font-family: "Fraunces";
      font-style: italic;
      font-display: swap;
      font-weight: 100 900;
      src: url("/fonts/demo/fraunces-italic.woff2") format("woff2");
    }
  </style>
  <div class="cr">
    <header class="cr-top" data-dh>
      <div class="cr-wrap cr-top__in">
        <a class="cr-logo" href="#">Cascina Rovere</a>
        <nav class="cr-nav" aria-label="Menu">
          {nav.map((n) => <a href={n.href} data-i18n={n.k}>{t(n.k)}</a>)}
        </nav>
        <button type="button" class="cr-lang" data-lang-toggle aria-label={t("toggle_label")} data-i18n-aria="toggle_label" lang="en"><span data-i18n="toggle">{t("toggle")}</span></button>
        <a class="cr-btn cr-btn--sm cr-top__book" href="#disponibilita" data-i18n="nav_book">{t("nav_book")}</a>
        <button type="button" class="cr-burger" data-menu aria-controls="cr-menu" aria-expanded="false">
          <span class="cr-burger__lines" aria-hidden="true"><i></i><i></i></span>
          <span data-i18n="menu">{t("menu")}</span>
        </button>
      </div>
    </header>
    <div class="cr-menu" id="cr-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href} data-i18n={n.k}>{t(n.k)}</a>)}
      </nav>
      <a class="cr-btn cr-btn--light" href="#disponibilita" data-i18n="hero_cta">{t("hero_cta")}</a>
      <button type="button" class="cr-lang cr-lang--menu" data-lang-toggle aria-label={t("toggle_label")} data-i18n-aria="toggle_label" lang="en"><span data-i18n="toggle">{t("toggle")}</span></button>
    </div>

    <section class="cr-hero">
      <div class="cr-hero__media">
        <div class="cr-hero__drift" data-parallax="10">
          <Image src={pic("hero")} alt={t("hero_alt")} data-i18n-alt="hero_alt" widths={[640, 1000, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="cr-hero__img" />
        </div>
      </div>
      <div class="cr-wrap cr-hero__text">
        <p class="cr-kicker" data-i18n="hero_kicker">{t("hero_kicker")}</p>
        <h1 data-split="load" data-i18n="hero_h1">{t("hero_h1")}</h1>
        <p class="cr-sub" data-i18n="hero_sub">{t("hero_sub")}</p>
        <div class="cr-hero__cta">
          <a class="cr-btn cr-btn--light" href="#disponibilita" data-magnetic data-i18n="hero_cta">{t("hero_cta")}</a>
          <a class="cr-link cr-link--light" href="#camere" data-i18n="hero_more">{t("hero_more")}</a>
        </div>
      </div>
      <span class="cr-hero__cue" aria-hidden="true"><span class="dm-cue"></span></span>
    </section>

    <section class="cr-intro">
      <div class="cr-wrap">
        <p class="cr-statement" data-rise>
          <span data-i18n="intro_1">{t("intro_1")}</span><span data-mark data-i18n="intro_2">{t("intro_2")}</span><span data-i18n="intro_3">{t("intro_3")}</span><span data-mark data-i18n="intro_4">{t("intro_4")}</span><span data-i18n="intro_5">{t("intro_5")}</span><span data-mark data-i18n="intro_6">{t("intro_6")}</span><span data-i18n="intro_7">{t("intro_7")}</span>
        </p>
        <dl class="cr-facts" data-rise-group>
          <div><dt><span data-count="6">6</span></dt><dd data-i18n="f_rooms">{t("f_rooms")}</dd></div>
          <div><dt><span data-count="40">40</span></dt><dd data-i18n="f_milan">{t("f_milan")}</dd></div>
          <div><dt><span data-count="10">10</span></dt><dd data-i18n="f_lake">{t("f_lake")}</dd></div>
        </dl>
      </div>
    </section>

    <section class="cr-rooms-sec" id="camere" data-hscroll>
      <div class="cr-wrap cr-rooms-head">
        <h2 data-split data-i18n="rooms_h2">{t("rooms_h2")}</h2>
        <p class="cr-lead" data-i18n="rooms_lead">{t("rooms_lead")}</p>
        <p class="cr-hint" aria-hidden="true"><span data-i18n="rooms_hint">{t("rooms_hint")}</span> <span class="cr-hint__arrow"></span></p>
      </div>
      <ul class="cr-rooms d-rail" data-hscroll-track tabindex="0" aria-label="Le camere">
        {
          rooms.map((r, i) => (
            <li class="cr-room">
              <div class="cr-room__pic dm-zoom">
                <Image src={pic(r.k)} alt="" widths={[400, 800, 1100]} sizes="(min-width: 900px) 34vw, 82vw" />
                <span class="cr-room__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <div class="cr-room__body">
                <h3>{r.n}</h3>
                <p class="cr-guests">
                  {r.g} <span data-i18n="guests">{t("guests")}</span>
                </p>
                <p data-i18n={`r_${r.k}`}>{t(`r_${r.k}`)}</p>
                <a class="cr-link" href="#disponibilita" data-i18n="ask_room">{t("ask_room")}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cr-day" id="giornata">
      <div class="cr-wrap">
        <h2 class="cr-day__h" data-split data-i18n="day_h2">{t("day_h2")}</h2>
        <ol class="cr-moments">
          {
            moments.map((m, i) => (
              <li class:list={["cr-moment", { "cr-moment--alt": i % 2 }]}>
                <figure class="cr-moment__pic" data-wipe>
                  <div class="cr-moment__drift" data-parallax="7">
                    <Image src={pic(m)} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 55vw, 100vw" />
                  </div>
                </figure>
                <div class="cr-moment__txt">
                  <p class="cr-when" data-rise data-i18n={`m_${m}_w`}>{t(`m_${m}_w`)}</p>
                  <h3 data-split data-i18n={`m_${m}_t`}>{t(`m_${m}_t`)}</h3>
                  <p data-rise data-i18n={`m_${m}_d`}>{t(`m_${m}_d`)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="cr-avail-sec" id="disponibilita">
      <div class="cr-wrap cr-avail">
        <div class="cr-avail__intro">
          <h2 data-split data-i18n="avail_h2">{t("avail_h2")}</h2>
          <p class="cr-lead" data-rise data-i18n="avail_lead">{t("avail_lead")}</p>
          <ul class="cr-promises" data-rise-group>
            <li data-i18n="avail_p1">{t("avail_p1")}</li>
            <li data-i18n="avail_p2">{t("avail_p2")}</li>
            <li data-i18n="avail_p3">{t("avail_p3")}</li>
          </ul>
        </div>
        <form
          class="cr-form"
          data-demo-form
          data-wa={site.whatsappNumber}
          data-heading="Richiesta di disponibilità dal sito"
          data-heading-en="Availability request from the website"
          data-err="Completa questo campo."
          data-err-en="Please fill in this field."
          novalidate
        >
          <div class="cr-row">
            <label>
              <span data-i18n="f_arrivo">{t("f_arrivo")}</span>
              <input type="date" name="arrivo" required data-label="Arrivo" data-label-en="Arrival" />
              <span class="cr-err" data-derr="arrivo" aria-live="polite"></span>
            </label>
            <label>
              <span data-i18n="f_partenza">{t("f_partenza")}</span>
              <input type="date" name="partenza" required data-label="Partenza" data-label-en="Departure" />
              <span class="cr-err" data-derr="partenza" aria-live="polite"></span>
            </label>
          </div>
          <div class="cr-row">
            <label>
              <span data-i18n="f_ospiti">{t("f_ospiti")}</span>
              <select name="ospiti" data-label="Ospiti" data-label-en="Guests">
                <option>1 adulto</option>
                <option selected>2 adulti</option>
                <option>2 adulti e 1 bambino</option>
                <option>2 adulti e 2 bambini</option>
                <option>3 adulti</option>
                <option>4 adulti</option>
              </select>
            </label>
            <label>
              <span data-i18n="f_lingua">{t("f_lingua")}</span>
              <select name="lingua" data-label="Lingua" data-label-en="Language">
                <option data-i18n="lang_it">{t("lang_it")}</option>
                <option data-i18n="lang_en">{t("lang_en")}</option>
              </select>
            </label>
          </div>
          <label>
            <span data-i18n="f_nome">{t("f_nome")}</span>
            <input type="text" name="nome" autocomplete="given-name" required data-label="Nome" data-label-en="Name" />
            <span class="cr-err" data-derr="nome" aria-live="polite"></span>
          </label>
          <button type="submit" class="cr-btn" data-magnetic data-i18n="f_send">{t("f_send")}</button>
          <p class="cr-note" data-i18n="f_note">{t("f_note")}</p>
        </form>
      </div>
    </section>

    <section class="cr-where-sec" id="arrivare">
      <div class="cr-wrap">
        <h2 data-split data-i18n="where_h2">{t("where_h2")}</h2>
        <div class="cr-ways" data-rise-group>
          <div class="cr-way">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 19l2.5-7.5A3 3 0 0 1 11.3 9.5h9.4a3 3 0 0 1 2.8 2L26 19v6h-3v-2.5H9V25H6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="10.5" cy="19" r="1.6" fill="currentColor" /><circle cx="21.5" cy="19" r="1.6" fill="currentColor" /></svg>
            <h3 data-i18n="where_car_t">{t("where_car_t")}</h3>
            <p data-i18n="where_car">{t("where_car")}</p>
          </div>
          <div class="cr-way">
            <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="8" y="4.5" width="16" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M8 14h16M12 27.5l2.5-5M20 27.5l-2.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12.5" cy="18.5" r="1.4" fill="currentColor" /><circle cx="19.5" cy="18.5" r="1.4" fill="currentColor" /></svg>
            <h3 data-i18n="where_train_t">{t("where_train_t")}</h3>
            <p data-i18n="where_train">{t("where_train")}</p>
          </div>
        </div>
      </div>
    </section>

    <footer class="cr-foot">
      <div class="cr-wrap">
        <p class="cr-foot__name">Cascina Rovere</p>
        <div class="cr-foot__cols">
          <p class="cr-foot__tag" data-i18n="foot_tag">{t("foot_tag")}</p>
          <div>
            <p class="cr-foot__h" data-i18n="foot_nav">{t("foot_nav")}</p>
            <ul>
              {nav.map((n) => <li><a href={n.href} data-i18n={n.k}>{t(n.k)}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="cr-foot__h" data-i18n="foot_contact">{t("foot_contact")}</p>
            <ul>
              <li><a href={waHref} target="_blank" rel="noopener" data-i18n="foot_wa">{t("foot_wa")}</a></li>
            </ul>
          </div>
        </div>
        <p class="cr-foot__note" data-i18n="foot">{t("foot")}</p>
      </div>
    </footer>
  </div>
  <script type="application/json" id="cr-dict" set:html={JSON.stringify(dict)} />
</Demo>

<style>
  .cr {
    --leaf: #3f4a2c;
    --leaf-deep: #2f3820;
    --wood: #7a5636;
    --cream: #f6efe2;
    --paper: #efe5d2;
    --ink: #2c261d;
    --mark: rgba(226, 178, 76, 0.55);
    background: var(--cream);
    color: var(--ink);
    font-family: "Fraunces", Georgia, serif;
    font-size: 19px;
    line-height: 1.6;
    font-variation-settings: "SOFT" 50, "opsz" 18;
  }
  .cr h1,
  .cr h2,
  .cr h3 {
    font-family: "Fraunces", Georgia, serif;
    color: inherit;
    font-weight: 450;
    font-stretch: 100%;
    letter-spacing: -0.015em;
    font-variation-settings: "SOFT" 100, "opsz" 96;
  }
  .cr h2 {
    font-size: clamp(2.4rem, 1.5rem + 3.4vw, 4.6rem);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .cr h3 {
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
  }
  .cr-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(18px, 4vw, 48px);
  }

  /* ---------- Header: see-through over the hero, cream once the page moves ---------- */
  .cr-top {
    color: #fffaf0;
  }
  .cr-top.is-solid {
    background: rgba(246, 239, 226, 0.97);
    color: var(--ink);
    box-shadow: 0 1px 0 #e1d4bd;
  }
  .cr-top__in {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 72px;
  }
  .cr-logo {
    white-space: nowrap;
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
    letter-spacing: -0.01em;
  }
  .cr-nav {
    display: none;
    gap: 1.75rem;
  }
  .cr-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
    padding: 0.6rem 0;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.35rem) / 0 1px no-repeat;
    transition: background-size 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cr-nav a:hover {
    background-size: 100% 1px;
  }
  .cr-lang {
    font: inherit;
    font-size: 0.95rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1.5px solid currentColor;
    background: transparent;
    color: inherit;
    border-radius: 999px;
    cursor: pointer;
  }
  .cr-top .cr-top__book {
    display: none;
  }
  .cr-burger {
