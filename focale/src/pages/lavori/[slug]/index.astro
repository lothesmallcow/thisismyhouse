---
import Base from "../../../layouts/Base.astro";
import Closing from "../../../components/Closing.astro";
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { site } from "../../../config/site";
import { breadcrumbs } from "../../../lib/schema";

export async function getStaticPaths() {
  const lavori = await getCollection("lavori");
  return lavori.map((l) => ({ params: { slug: l.id }, props: { l } }));
}
const { l } = Astro.props as { l: CollectionEntry<"lavori"> };
const d = l.data;
const blocks = [
  { h: "I problemi tipici del settore", items: d.problems },
  { h: "Le scelte", items: d.choices },
  { h: "Cosa ottiene l'attività", items: d.outcome },
];
---
<Base
  title={`${d.name}: progetto dimostrativo | ${site.brand}`}
  description={`${d.sector}. ${d.goal} Un sito dimostrativo completo, per un'attività inventata.`}
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }, { name: d.name, path: `/lavori/${l.id}/` }])]}
>
  <section class="cs-head" data-hero>
    <div class="wrap">
      <p class="cs-back"><a class="textlink" href="/lavori/">Tutti i lavori</a></p>
      <h1>{d.name}</h1>
      <div class="cs-meta">
        <p>{d.sector}</p>
        <p class="muted">Progetto dimostrativo per un'attività inventata</p>
        <a class="btn btn--primary" href={`/lavori/${l.id}/demo/`} target="_blank" rel="noopener">Apri il sito dimostrativo</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <figure class="cs-stage">
      <Image src={d.shotDesktop} alt={`Il sito di ${d.name} visto da computer`} widths={[700, 1100, 1500]} sizes="(min-width: 1000px) 72vw, 90vw" class="cs-desk" loading="eager" />
      <Image src={d.shotPhone} alt={`Il sito di ${d.name} visto dal telefono`} widths={[240, 480]} sizes="240px" class="cs-phone" />
    </figure>
  </div>

  <section class="section cs" aria-labelledby="obiettivo">
    <div class="wrap sec">
      <p class="sec__label">Obiettivo</p>
      <div class="sec__body">
        <h2 id="obiettivo" class="cs-goal" data-focus>{d.goal}</h2>
        <div class="cs-cols">
          {
            blocks.map((b) => (
              <div>
                <h3>{b.h}</h3>
                <ul>
                  {b.items.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .cs-head {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .cs-back {
    margin-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .cs-meta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
  }
  .cs-meta .btn {
    margin-left: auto;
  }
  @media (max-width: 699px) {
    .cs-meta .btn {
      margin-left: 0;
    }
  }
  .cs-stage {
    position: relative;
    margin: 0;
    padding: clamp(1.25rem, 0.5rem + 4vw, 5rem) clamp(1.25rem, 0.5rem + 4vw, 5rem) clamp(3rem, 2rem + 5vw, 7rem);
    background: var(--nebbia);
    border-radius: clamp(14px, 1vw + 8px, 26px);
    overflow: hidden;
  }
  .cs-stage :global(.cs-desk) {
    width: 82%;
    border-radius: 10px;
    box-shadow: 0 40px 80px -40px rgba(60, 25, 8, 0.4);
  }
  .cs-stage :global(.cs-phone) {
    position: absolute;
    right: 6%;
    bottom: -4%;
    width: 21%;
    border: 7px solid #1b1f1d;
    border-radius: 20px;
    box-shadow: 0 40px 70px -30px rgba(60, 25, 8, 0.5);
  }
  .cs-goal {
    max-width: 18ch;
  }
  .cs-cols {
    display: grid;
    gap: 3rem;
    margin-top: var(--space-block);
  }
  @media (min-width: 1000px) {
    .cs-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  .cs-cols h3 {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .cs-cols ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cs-cols li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--filo);
    color: var(--grafite);
  }
</style>
