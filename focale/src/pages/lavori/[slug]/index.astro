---
import Base from "../../../layouts/Base.astro";
import Closing from "../../../components/Closing.astro";
import DemoViewer from "../../../components/DemoViewer.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { site } from "../../../config/site";
import { breadcrumbs } from "../../../lib/schema";
import { isReal, kindLabel, siteHref } from "../../../lib/lavori";

export async function getStaticPaths() {
  const lavori = await getCollection("lavori");
  return lavori.map((l) => ({ params: { slug: l.id }, props: { l } }));
}
const { l } = Astro.props as { l: CollectionEntry<"lavori"> };
const d = l.data;
const real = isReal(l);
// A real site is new: its third list says what the site does, never results it has not had yet.
const blocks = [
  { h: real ? "Da dove partivamo" : "I problemi tipici del settore", items: d.problems },
  { h: "Le scelte", items: d.choices },
  { h: real ? "Cosa fa il sito" : "Cosa ottiene l'attività", items: d.outcome },
];
---
<Base
  title={`${d.name}: ${real ? "sito per un cliente" : "progetto dimostrativo"} | ${site.brand}`}
  description={`${d.sector}. ${d.goal} ${real ? `Un sito online, fatto da ${site.brand} per un cliente.` : "Un sito dimostrativo completo, per un'attività inventata."}`}
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }, { name: d.name, path: `/lavori/${l.id}/` }])]}
>
  <section class="cs-head" data-hero>
    <div class="wrap">
      <p class="cs-back"><a class="textlink" href="/lavori/">Tutti i lavori</a></p>
      <h1>{d.name}</h1>
      <div class="cs-meta">
        <p>{d.sector}</p>
        <p class="muted">{kindLabel(l)}</p>
        <a class="btn btn--primary" href={siteHref(l)} target="_blank" rel="noopener">{real ? "Apri il sito" : "Apri il sito dimostrativo"}</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <DemoViewer slug={l.id} name={d.name} shotPhone={d.shotPhone} shotDesktop={d.shotDesktop} url={d.url} eager class="cs-live" />
  </div>

  <section class="section cs" aria-labelledby="obiettivo">
    <div class="wrap sec">
      <p class="sec__label">Obiettivo</p>
      <div class="sec__body">
        <h2 id="obiettivo" class="cs-goal" data-focus>{d.goal}</h2>
        <div class="cs-cols">
          {
            blocks.map((b) => (
              <div>
                <h3>{b.h}</h3>
                <ul>
                  {b.items.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .cs-head {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .cs-back {
    margin-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .cs-meta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
  }
  .cs-meta .btn {
    margin-left: auto;
  }
  @media (max-width: 699px) {
    .cs-meta .btn {
      margin-left: 0;
    }
  }
  .wrap :global(.cs-live) {
    --dv-phone: clamp(220px, 34vh, 300px);
    max-width: 1120px;
    margin-inline: auto;
  }
  .cs-goal {
    max-width: 28ch;
  }
  .cs-cols {
    display: grid;
    gap: 3rem;
    margin-top: var(--space-block);
  }
  @media (min-width: 1000px) {
    .cs-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  .cs-cols h3 {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .cs-cols ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cs-cols li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--filo);
    color: var(--grafite);
  }
</style>
