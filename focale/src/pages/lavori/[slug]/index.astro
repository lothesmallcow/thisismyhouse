---
import Base from "../../../layouts/Base.astro";
import Fuoco from "../../../components/Fuoco.astro";
import Closing from "../../../components/Closing.astro";
import Icon from "../../../components/Icon.astro";
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { breadcrumbs } from "../../../lib/schema";

export async function getStaticPaths() {
  const lavori = await getCollection("lavori");
  return lavori.map((l) => ({ params: { slug: l.id }, props: { l } }));
}
const { l } = Astro.props as { l: CollectionEntry<"lavori"> };
const d = l.data;
---
<Base
  title={`${d.name}: progetto dimostrativo | Focale`}
  description={`${d.sector}. ${d.goal} Un sito dimostrativo completo, per un'attività inventata.`}
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }, { name: d.name, path: `/lavori/${l.id}/` }])]}
>
  <section class="cs-head" data-hero>
    <div class="wrap">
      <p class="cs-back"><a class="link ui" href="/lavori/">Tutti i lavori</a></p>
      <Fuoco />
      <h1>{d.name}</h1>
      <p class="lead cs-sector">{d.sector}</p>
      <p class="cs-label">Progetto dimostrativo per un'attività inventata</p>
    </div>
  </section>

  <section class="section cs">
    <div class="wrap cs__grid">
      <div class="cs__text">
        <h2>Obiettivo</h2>
        <p class="lead">{d.goal}</p>
        <h2>I problemi tipici del settore</h2>
        <ul>{d.problems.map((p) => <li><Icon name="alert" />{p}</li>)}</ul>
        <h2>Le scelte</h2>
        <ul>{d.choices.map((p) => <li><Icon name="check" />{p}</li>)}</ul>
        <h2>Cosa ottiene l'attività</h2>
        <ul>{d.outcome.map((p) => <li><Icon name="check" />{p}</li>)}</ul>
        <a class="btn btn--primary cs__open" href={`/lavori/${l.id}/demo/`} target="_blank" rel="noopener">
          Apri il sito dimostrativo
        </a>
      </div>
      <div class="cs__shots">
        <Image src={d.shotPhone} alt={`Il sito di ${d.name} visto dal telefono`} widths={[300, 600]} sizes="300px" class="cs__phone" />
        <Image src={d.shotDesktop} alt={`Il sito di ${d.name} visto da computer`} widths={[600, 1000, 1400]} sizes="(min-width: 960px) 560px, 92vw" class="cs__desk" />
      </div>
    </div>
  </section>

  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .cs-head {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) 1rem;
  }
  .cs-back {
    margin-bottom: 2rem;
    font-weight: 600;
  }
  .cs-back a {
    color: var(--portone);
  }
  .cs-sector {
    margin-top: 1rem;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--portone);
  }
  .cs-label {
    margin-top: 0.5rem !important;
    color: var(--tenue);
    font-family: var(--font-head);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .cs__grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 960px) {
    .cs__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
    }
    .cs__shots {
      position: sticky;
      top: 6rem;
    }
  }
  .cs__text h2 {
    font-size: var(--step-2);
    margin: 2.5rem 0 1rem;
  }
  .cs__text h2:first-child {
    margin-top: 0;
  }
  .cs__text ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .cs__text li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 0.75rem;
  }
  .cs__text li :global(.icon) {
    color: var(--ottone);
    margin-top: 0.2rem;
  }
  .cs__open {
    margin-top: 2.5rem;
  }
  .cs__shots {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .cs__shots :global(.cs__phone) {
    width: 240px;
    border: 8px solid #1b1f1d;
    border-radius: var(--radius-phone);
    box-shadow: 0 24px 50px -24px rgba(64, 48, 20, 0.4);
  }
  .cs__shots :global(.cs__desk) {
    width: 100%;
    border: 2px solid #1b1f1d;
    border-radius: 6px;
  }
</style>
