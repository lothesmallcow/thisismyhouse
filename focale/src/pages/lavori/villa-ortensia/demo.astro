---
/**
 * Demo: Villa Ortensia, an invented wedding venue on Lake Como. Built like a real client site with
 * the motion kit (scripts/demo-motion.ts): see-through header over a full-screen hero, a statement
 * with highlighter strokes, the three spaces as cards that stack while scrolling, the seasons,
 * price bands that count up, and a visit request on WhatsApp.
 */
import Demo from "../../../layouts/Demo.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/villa-ortensia/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/villa-ortensia/${n}.jpg`].default;

const spaces = [
  { k: "giardino", t: "Il giardino sul lago", n: 180, c: "ospiti per la cerimonia", d: "Il prato scende fino all'acqua. La cerimonia si fa qui, con il lago alle spalle degli sposi." },
  { k: "salone", t: "Il salone delle feste", n: 160, c: "ospiti a tavola", d: "Quattro finestre ad arco sul lago e due lampadari d'epoca. La cena si sposta qui se piove." },
  { k: "terrazza", t: "La terrazza", n: 120, c: "ospiti per l'aperitivo", d: "Il tramonto sulle montagne, le luci accese sopra la balaustra." },
];
const seasons = [
  { t: "Primavera", m: "aprile, maggio, giugno", d: "Le ortensie fioriscono a fine maggio: il giardino è al suo meglio." },
  { t: "Estate", m: "luglio, agosto", d: "Cene lunghe in terrazza, il lago ancora chiaro alle nove di sera." },
  { t: "Autunno", m: "settembre, ottobre", d: "Luce bassa e dorata, montagne nitide, prezzi più dolci." },
];
const bands = [
  { n: 120, pre: "Da", post: "€ a persona", d: "Menù e allestimento base" },
  { n: 160, pre: "Da", post: "€ a persona", d: "Menù completo e allestimento floreale" },
  { n: 0, pre: "", post: "Su misura", d: "Esclusiva della villa per tutto il weekend" },
];
const months = ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"];
const years = [2027, 2028];
const nav = [
  { href: "#spazi", t: "Gli spazi" },
  { href: "#stagioni", t: "Le stagioni" },
  { href: "#fasce", t: "Fasce di prezzo" },
];
const waHref = `https://wa.me/${site.whatsappNumber}`;
---
<Demo
  title="Villa Ortensia | Matrimoni sul Lago di Como (demo)"
  description="Sito dimostrativo di Focus Design per una location per matrimoni inventata sul Lago di Como."
  fonts={["/fonts/demo/cormorant-500.woff2", "/fonts/demo/jost.woff2"]}
  themeColor="#56646b"
>
  <style is:global>
    @font-face {
      font-family: "Cormorant Garamond";
      font-style: normal;
      font-display: swap;
      font-weight: 500;
      src: url("/fonts/demo/cormorant-500.woff2") format("woff2");
    }
    @font-face {
      font-family: "Cormorant Garamond";
      font-style: italic;
      font-display: swap;
      font-weight: 500;
      src: url("/fonts/demo/cormorant-500-italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Jost";
      font-style: normal;
      font-display: swap;
      font-weight: 100 900;
      src: url("/fonts/demo/jost.woff2") format("woff2");
    }
  </style>
  <div class="vo">
    <header class="vo-top" data-dh>
      <div class="vo-wrap vo-top__in">
        <a class="vo-logo" href="#">Villa Ortensia</a>
        <nav class="vo-nav" aria-label="Menu">
          {nav.map((n) => <a href={n.href}>{n.t}</a>)}
        </nav>
        <a class="vo-btn vo-btn--sm vo-top__cta" href="#visita">Prenota una visita</a>
        <button type="button" class="vo-burger" data-menu aria-controls="vo-menu" aria-expanded="false">
          <span class="vo-burger__lines" aria-hidden="true"><i></i><i></i></span>
          Menu
        </button>
      </div>
    </header>
    <div class="vo-menu" id="vo-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href}>{n.t}</a>)}
        <a href="#visita">Prenota una visita</a>
      </nav>
    </div>

    <section class="vo-hero">
      <div class="vo-hero__media">
        <div class="vo-hero__drift" data-parallax="9">
          <Image src={pic("hero")} alt="La villa sul lago con il giardino di ortensie e le montagne sullo sfondo" widths={[640, 1100, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="vo-hero__img" />
        </div>
      </div>
      <div class="vo-wrap vo-hero__text">
        <p class="vo-kicker">Matrimoni sul Lago di Como</p>
        <h1 data-split="load">Una villa sul lago, per un giorno solo vostro.</h1>
        <div class="vo-hero__cta">
          <a class="vo-btn vo-btn--light" href="#visita" data-magnetic>Prenota una visita</a>
          <a class="vo-link vo-link--light" href="#spazi">Guarda gli spazi</a>
        </div>
      </div>
      <ul class="vo-hero__facts vo-wrap" aria-label="In breve">
        <li>Fino a 180 ospiti</li>
        <li>Cerimonia e ricevimento</li>
        <li>Giardino sull'acqua</li>
      </ul>
    </section>

    <section class="vo-intro">
      <div class="vo-wrap">
        <p class="vo-statement" data-rise>
          Un giardino che scende <span data-mark>fino all'acqua</span>, un salone con le finestre sul lago, una terrazza per il tramonto. Tutto nello stesso posto, <span data-mark>per un giorno solo vostro</span>.
        </p>
      </div>
    </section>

    <section class="vo-spaces-sec" id="spazi">
      <div class="vo-wrap">
        <div class="vo-head">
          <h2 data-split>Gli spazi</h2>
          <p class="vo-lead" data-rise>Tre luoghi della stessa villa, per ogni momento della giornata.</p>
        </div>
        <ul class="vo-spaces d-rail" data-stack tabindex="0" aria-label="Gli spazi">
          {
            spaces.map((s, i) => (
              <li style={`--i: ${i}`}>
                <article class="vo-space">
                  <div class="vo-space__pic dm-zoom">
                    <Image src={pic(s.k)} alt="" widths={[480, 900, 1400]} sizes="(min-width: 900px) 60vw, 82vw" />
                  </div>
                  <div class="vo-space__txt">
                    <p class="vo-space__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
                    <h3>{s.t}</h3>
                    <p class="vo-cap">
                      Fino a <span data-count={s.n}>{s.n}</span> {s.c}
                    </p>
                    <p>{s.d}</p>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="vo-seasons-sec" id="stagioni">
      <div class="vo-wrap">
        <h2 data-split>Le stagioni</h2>
        <ol class="vo-seasons">
          {
            seasons.map((s) => (
              <li>
                <h3 data-split>{s.t}</h3>
                <p class="vo-months" data-rise>{s.m}</p>
                <p data-rise>{s.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="vo-bands-sec" id="fasce">
      <div class="vo-wrap">
        <div class="vo-head">
          <h2 data-split>Fasce di prezzo</h2>
          <p class="vo-lead" data-rise>Per sapere subito se siamo nel vostro budget, prima ancora di scriverci.</p>
        </div>
        <ul class="vo-bands" data-rise-group>
          {
            bands.map((b) => (
              <li>
                <p class="vo-band">
                  {b.n > 0 ? (
                    <>
                      <small>{b.pre}</small> <span data-count={b.n}>{b.n}</span> <small>{b.post}</small>
                    </>
                  ) : (
                    b.post
                  )}
                </p>
                <p>{b.d}</p>
              </li>
            ))
          }
        </ul>
        <p class="vo-note">Fasce indicative di un'attività inventata.</p>
      </div>
    </section>

    <section class="vo-visit-sec" id="visita">
      <div class="vo-wrap vo-visit">
        <div class="vo-visit__intro">
          <h2 data-split>Prenota una visita</h2>
          <p class="vo-lead" data-rise>Quattro informazioni e vi proponiamo due date per vedere la villa. Rispondiamo su WhatsApp in giornata.</p>
          <figure class="vo-visit__pic" data-wipe>
            <Image src={pic("terrazza")} alt="" widths={[500, 900]} sizes="(min-width: 900px) 40vw, 100vw" />
          </figure>
        </div>
        <form class="vo-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di visita dal sito" data-err="Completa questo campo." novalidate>
          <div class="vo-row">
            <label>Mese dell'evento
              <select name="mese" data-label="Data evento" required>
                <option value="">Scegli</option>
                {years.flatMap((y) => months.map((m) => <option>{`${m} ${y}`}</option>))}
              </select>
              <span class="vo-err" data-derr="mese" aria-live="polite"></span>
            </label>
            <label>Numero di invitati
              <select name="invitati" data-label="Invitati" required>
                <option value="">Scegli</option>
                <option>meno di 60</option>
                <option>circa 80</option>
                <option>circa 120</option>
                <option>circa 150</option>
                <option>più di 160</option>
              </select>
              <span class="vo-err" data-derr="invitati" aria-live="polite"></span>
            </label>
          </div>
          <fieldset>
            <legend>Budget indicativo</legend>
            <div class="vo-opts">
              {["fascia base", "fascia media", "su misura"].map((o) => (
                <label class="vo-opt"><input type="radio" name="budget" value={o} data-label="Budget" required /><span>{o.charAt(0).toUpperCase() + o.slice(1)}</span></label>
              ))}
            </div>
            <span class="vo-err" data-derr="budget" aria-live="polite"></span>
          </fieldset>
          <label>I vostri nomi
            <input type="text" name="nomi" placeholder="es. Marco e Sara" required data-label="Nomi" />
            <span class="vo-err" data-derr="nomi" aria-live="polite"></span>
          </label>
          <button type="submit" class="vo-btn" data-magnetic>Invia su WhatsApp</button>
          <p class="vo-note">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design.</p>
        </form>
      </div>
    </section>

    <footer class="vo-foot">
      <div class="vo-wrap">
        <p class="vo-foot__name">Villa Ortensia</p>
        <div class="vo-foot__cols">
          <p class="vo-foot__tag">Matrimoni ed eventi sul Lago di Como, da aprile a ottobre.</p>
          <div>
            <p class="vo-foot__h">Il sito</p>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.t}</a></li>)}
              <li><a href="#visita">Prenota una visita</a></li>
            </ul>
          </div>
          <div>
            <p class="vo-foot__h">Scriveteci</p>
            <ul>
              <li><a href={waHref} target="_blank" rel="noopener">WhatsApp, rispondiamo in giornata</a></li>
            </ul>
          </div>
        </div>
        <p class="vo-foot__note">Villa Ortensia è un'attività inventata. Progetto dimostrativo di Focus Design.</p>
      </div>
    </footer>
  </div>
</Demo>

<style>
  .vo {
    --ink: #2a2f33;
    --lake: #56646b;
    --lake-deep: #3d4950;
    --mist: #eef1f0;
    --ivory: #fbfaf7;
    --rose: #b98fa8;
    --mark: rgba(214, 177, 200, 0.6);
    background: var(--ivory);
    color: var(--ink);
    font-family: "Jost", "Archivo", sans-serif;
    font-weight: 380;
    font-size: 18px;
    line-height: 1.65;
  }
  .vo h1,
  .vo h2,
  .vo h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-stretch: 100%;
    color: inherit;
    letter-spacing: -0.005em;
  }
  .vo h2 {
    font-size: clamp(2.8rem, 1.8rem + 3.6vw, 5.4rem);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .vo h3 {
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.9rem);
    line-height: 1.05;
  }
  .vo-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
  }

  /* ---------- Header ---------- */
  .vo-top {
    color: #fff;
  }
  .vo-top.is-solid {
    background: rgba(251, 250, 247, 0.97);
    color: var(--ink);
    box-shadow: 0 1px 0 #e3e5e2;
  }
  .vo-top__in {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 78px;
  }
  .vo-logo {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 1.85rem;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }
  .vo-nav {
    display: none;
    gap: 2rem;
  }
  .vo-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    padding: 0.6rem 0;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.35rem) / 0 1px no-repeat;
    transition: background-size 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vo-nav a:hover {
    background-size: 100% 1px;
  }
  .vo-top .vo-top__cta {
    display: none;
  }
  .vo-top:not(.is-solid) .vo-top__cta {
    background: #fff;
    color: var(--ink);
  }
  .vo-burger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  .vo-burger__lines {
    display: grid;
    gap: 6px;
    width: 24px;
  }
  .vo-burger__lines i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s ease;
  }
  .vo-burger[aria-expanded="true"] .vo-burger__lines i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .vo-burger[aria-expanded="true"] .vo-burger__lines i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  @media (min-width: 980px) {
    .vo-nav,
    .vo-top .vo-top__cta {
      display: inline-flex;
    }
    .vo-burger {
      display: none;
    }
  }
  .vo-menu {
    position: fixed;
    inset: 0;
    z-index: 85;
    display: grid;
    align-content: center;
    padding: 6rem clamp(24px, 8vw, 56px) 3rem;
    background: var(--lake-deep);
    color: #fff;
  }
  .vo-menu nav {
    display: grid;
    gap: 0.4rem;
  }
  .vo-menu a {
    color: inherit;
    text-decoration: none;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.4rem, 10vw, 3.4rem);
    line-height: 1.15;
  }
  .vo-menu a:last-child {
    font-style: italic;
  }
  :global(.dm-menu-open) .vo-top {
    color: #fff;
    background: transparent;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vo-menu:not([hidden]) {
      animation: vo-menu 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes vo-menu {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  /* ---------- Buttons and links ---------- */
  .vo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 1.9rem;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .vo-btn:hover {
    background: var(--lake-deep);
  }
  .vo-btn--sm {
    min-height: 44px;
    padding: 0 1.3rem;
    font-size: 0.92rem;
  }
  .vo-btn--light {
    background: #fff;
    color: var(--ink);
  }
  .vo-btn--light:hover {
    background: var(--mist);
  }
  .vo-link {
    color: inherit;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .vo-link--light {
    color: #fff;
  }

  /* ---------- Hero ---------- */
  .vo-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    color: #fff;
    background: #2e3a40;
  }
  .vo-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .vo-hero__drift {
    position: absolute;
    inset: 0;
  }
  .vo-hero__media :global(.vo-hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .vo-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 28, 32, 0.45) 0%, rgba(20, 28, 32, 0) 30%),
      linear-gradient(0deg, rgba(20, 28, 32, 0.82) 0%, rgba(20, 28, 32, 0.4) 40%, rgba(20, 28, 32, 0.1) 70%);
  }
  @media (max-width: 899px) {
    .vo-hero__media::after {
      background: linear-gradient(0deg, rgba(20, 28, 32, 0.88) 0%, rgba(20, 28, 32, 0.66) 48%, rgba(20, 28, 32, 0.32) 72%, rgba(20, 28, 32, 0.15) 100%);
    }
  }
  .vo-hero__text {
    position: relative;
    z-index: 2;
    align-self: end;
    width: 100%;
    padding-top: calc(var(--banner) + 120px);
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  .vo-kicker {
    font-size: 0.92rem;
    letter-spacing: 0.14em;
    margin-bottom: 1.1rem;
    color: #e9eef0;
  }
  .vo h1 {
    font-size: clamp(3rem, 1.4rem + 6.4vw, 8rem);
    line-height: 0.95;
    max-width: 13ch;
    color: #fff;
  }
  .vo-hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
  }
  .vo-hero__facts {
    position: relative;
    z-index: 2;
    list-style: none;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: #eef2f3;
    box-sizing: border-box;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vo-hero__media :global(.vo-hero__img) {
      animation: vo-zoom 3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes vo-zoom {
      from {
        transform: scale(1.12);
      }
    }
  }

  /* ---------- Statement ---------- */
  .vo-intro {
    padding: clamp(90px, 13vw, 190px) 0;
    text-align: center;
  }
  .vo-statement {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    line-height: 1.18;
    max-width: 24ch;
    margin: 0 auto;
  }
  .vo-statement [data-mark] {
    background-image: linear-gradient(var(--mark), var(--mark));
    font-style: italic;
  }

  /* ---------- Spaces: cards that stack ---------- */
  .vo-spaces-sec {
    padding: clamp(40px, 6vw, 80px) 0 clamp(80px, 10vw, 140px);
  }
  .vo-head {
    display: grid;
    gap: 0.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .vo-head {
      grid-template-columns: auto 1fr;
      align-items: end;
    }
    .vo-head h2 {
      margin: 0;
    }
  }
  .vo-lead {
    max-width: 40ch;
    font-size: 1.15rem;
  }
  .vo-spaces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .vo-space {
    display: grid;
    background: var(--mist);
    overflow: hidden;
    transform-origin: 50% 0;
  }
  @media (min-width: 900px) {
    .vo-spaces {
      gap: 14vh;
    }
    .vo-space {
      grid-template-columns: 1.45fr 1fr;
      min-height: min(72vh, 640px);
      box-shadow: 0 -30px 60px -40px rgba(40, 50, 55, 0.35);
    }
  }
  .vo-space__pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }
  .vo-space__txt {
    padding: clamp(1.5rem, 3vw, 3.5rem);
    display: grid;
    align-content: center;
    gap: 0.75rem;
  }
  .vo-space__n {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    color: var(--lake);
    font-size: 1.3rem;
  }
  .vo-cap {
    color: var(--lake);
    letter-spacing: 0.04em;
  }
  .vo-cap span {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.6em;
    line-height: 1;
    color: var(--ink);
  }

  /* ---------- Seasons ---------- */
  .vo-seasons-sec {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--lake-deep);
