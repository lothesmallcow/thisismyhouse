<script>
  import { initDemoForms } from "../../../scripts/demo-form";
  initDemoForms();

  // The plan switches the room shown. Links stay real anchors (#spazio-<key>) without JS.
  const root = document.querySelector<HTMLElement>("[data-plan-root]");
  const list = root?.querySelector<HTMLElement>("[data-rooms]");
  if (root && list) {
    const panels = Array.from(list.querySelectorAll<HTMLElement>(".vo-room"));
    const keyOf = (p: HTMLElement) => p.id.replace("spazio-", "");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const show = (key: string, move: boolean) => {
      const panel = panels.find((p) => keyOf(p) === key);
      if (!panel) return;
      panels.forEach((p) => p.classList.toggle("is-on", p === panel));
      root.querySelectorAll<Element>("[data-room]").forEach((a) => {
        if (a.getAttribute("data-room") === key && !a.closest(".vo-room")) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
      if (!move) return;
      const r = panel.getBoundingClientRect();
      const top = 110;
      if (r.top < top || r.bottom > innerHeight) {
        // An absolute position: Lenis' element targets drift when the page was scrolled natively.
        const y = Math.max(0, scrollY + r.top - top);
        const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number) => void } }).__lenis;
        if (lenis) lenis.scrollTo(y);
        else scrollTo({ top: y, behavior: reduce.matches ? "auto" : "smooth" });
      }
      panel.focus({ preventScroll: true });
    };
    list.classList.add("is-live");
    const fromHash = location.hash.startsWith("#spazio-") ? location.hash.slice(8) : "";
    show(panels.some((p) => keyOf(p) === fromHash) ? fromHash : keyOf(panels[0]), false);
    // Capture phase: handled here before the smooth-scroll anchor handler on the link itself.
    root.addEventListener(
      "click",
      (e) => {
        const a = (e.target as Element).closest("[data-room]");
        if (!a) return;
        e.preventDefault();
        e.stopPropagation();
        const key = a.getAttribute("data-room")!;
        show(key, true);
        history.replaceState(null, "", `#spazio-${key}`);
      },
      true,
    );
  }
</script>
