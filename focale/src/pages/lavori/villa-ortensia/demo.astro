---
/**
 * Demo: Villa Ortensia, an invented wedding venue on Lake Como. Direction "La pianta della villa":
 * an architectural, asymmetric page derived from the place (a Liberty lakeside villa in pink Lombard
 * plaster, wrought-iron balustrades, blue-violet hydrangeas, letterpress invitations, the architect's
 * plan). Bodoni Moda set upright for headings (never italic, no accent word), Hanken Grotesk for text;
 * plaster pink, white, lake ink and ONE accent, "ortensia" blue-violet. Every picture is an arched window.
 * The signature is the floor plan (components/demo/VillaPlan.astro): it is the navigation of "Gli spazi".
 * Without JS its rooms are anchors to the three room panels; with JS they switch the panel in place.
 * Motion kit (scripts/demo-motion.ts): [data-dh] header, [data-menu] menu, [data-split], [data-rise],
 * [data-count], [data-magnetic].
 */
import Demo from "../../../layouts/Demo.astro";
import { Image } from "astro:assets";
import VillaPlan from "../../../components/demo/VillaPlan.astro";
import { site } from "../../../config/site";
import { telHref } from "../../../lib/util";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/villa-ortensia/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/villa-ortensia/${n}.jpg`].default;

const spaces = [
  {
    k: "giardino",
    t: "Il giardino sul lago",
    n: 180,
    c: "ospiti per la cerimonia",
    d: "Il prato scende fino all'acqua. La cerimonia si fa qui, con il lago alle spalle degli sposi.",
    alt: "Il prato sul lago con l'arco di ortensie e le sedie bianche pronte per la cerimonia",
  },
  {
    k: "salone",
    t: "Il salone delle feste",
    n: 160,
    c: "ospiti a tavola",
    d: "Quattro finestre ad arco sul lago e due lampadari d'epoca. La cena si sposta qui se piove.",
    alt: "Il salone con le grandi finestre ad arco sul lago, i lampadari e i tavoli rotondi apparecchiati",
  },
  {
    k: "terrazza",
    t: "La terrazza",
    n: 120,
    c: "ospiti per l'aperitivo",
    d: "Il tramonto sulle montagne, le luci accese sopra la balaustra.",
    alt: "La terrazza al tramonto, con le luci appese sopra la balaustra e le montagne oltre il lago",
  },
];
const plan = spaces.map(({ k, t, n, c }) => ({ k, t, n, c }));
const seasons = [
  { t: "Primavera", m: "aprile, maggio, giugno", d: "Le ortensie fioriscono a fine maggio: il giardino è al suo meglio." },
  { t: "Estate", m: "luglio, agosto", d: "Cene lunghe in terrazza, il lago ancora chiaro alle nove di sera." },
  { t: "Autunno", m: "settembre, ottobre", d: "Luce bassa e dorata, montagne nitide, prezzi più dolci." },
];
const bands = [
  { n: 120, d: "Menù e allestimento base" },
  { n: 160, d: "Menù completo e allestimento floreale" },
  { n: 0, d: "Esclusiva della villa per tutto il weekend" },
];
const months = ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"];
const years = [2027, 2028];
const navLeft = [
  { href: "#spazi", t: "Gli spazi" },
  { href: "#stagioni", t: "Le stagioni" },
];
const navRight = [{ href: "#fasce", t: "Fasce di prezzo" }];
const waHref = `https://wa.me/${site.whatsappNumber}`;
const address = "Via Esempio 1, 22021 Bellagio (CO)";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const reviewsHref = "https://search.google.com/local/reviews?placeid=ESEMPIO";
const ld = {
  "@context": "https://schema.org",
  "@type": "EventVenue",
  name: "Villa Ortensia (attività dimostrativa)",
  address: { "@type": "PostalAddress", streetAddress: "Via Esempio 1", postalCode: "22021", addressLocality: "Bellagio", addressCountry: "IT" },
  maximumAttendeeCapacity: 180,
};
---
<Demo
  title="Villa Ortensia | Matrimoni sul Lago di Como (demo)"
  description="Sito dimostrativo di Focus Design per una location per matrimoni inventata sul Lago di Como."
  fonts={["/fonts/demo/bodoni-moda.woff2", "/fonts/demo/hanken-grotesk.woff2"]}
  themeColor="#ebd8cf"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style is:global>
    @font-face {
      font-family: "Bodoni Moda";
      font-style: normal;
      font-display: swap;
      font-weight: 400 900;
      src: url("/fonts/demo/bodoni-moda.woff2") format("woff2");
    }
    @font-face {
      font-family: "Hanken Grotesk";
      font-style: normal;
      font-display: swap;
      font-weight: 100 900;
      src: url("/fonts/demo/hanken-grotesk.woff2") format("woff2");
    }
  </style>
  <div class="vo">
    <header class="vo-top" data-dh>
      <div class="vo-wrap vo-top__in">
        <nav class="vo-nav vo-nav--l" aria-label="Sezioni">
          {navLeft.map((n) => <a href={n.href}>{n.t}</a>)}
        </nav>
        <a class="vo-mark" href="#" aria-label="Villa Ortensia, torna all'inizio">
          <span class="vo-mono" aria-hidden="true">VO</span>
          <span class="vo-mark__name">Villa Ortensia</span>
        </a>
        <nav class="vo-nav vo-nav--r" aria-label="Prezzi e visita">
          {navRight.map((n) => <a href={n.href}>{n.t}</a>)}
          <a class="vo-nav__visit" href="#visita">Prenota una visita</a>
        </nav>
        <button type="button" class="vo-burger" data-menu aria-controls="vo-menu" aria-expanded="false">
          <span class="vo-burger__lines" aria-hidden="true"><i></i><i></i></span>
          Menu
        </button>
      </div>
    </header>
    <div class="vo-menu" id="vo-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {[...navLeft, ...navRight].map((n) => <a href={n.href}>{n.t}</a>)}
        <a class="vo-menu__visit" href="#visita">Prenota una visita</a>
      </nav>
    </div>

    <section class="vo-hero">
      <div class="vo-wrap vo-hero__in">
        <div class="vo-hero__text">
          <h1 data-split="load">Matrimoni in villa sul Lago di Como</h1>
          <p class="vo-hero__lead">
            La cerimonia nel giardino, la cena nel salone, l'ultimo brindisi in terrazza. Tutto nella stessa villa, per un giorno solo vostro.
          </p>
          <div class="vo-hero__cta">
            <a class="vo-btn" href="#visita" data-magnetic>Prenota una visita</a>
            <p class="vo-hero__meta">Bellagio, da aprile a ottobre.<br />Fino a 180 ospiti.</p>
          </div>
        </div>
        <figure class="vo-hero__pic vo-arch">
          <Image src={pic("hero")} alt="La villa rosa sul lago, con il giardino di ortensie, i cipressi e le montagne sullo sfondo" widths={[480, 760, 1100, 1400]} sizes="(min-width: 900px) 44vw, 92vw" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="vo-spaces" id="spazi" data-plan-root>
      <div class="vo-wrap">
        <div class="vo-spaces__top">
          <div class="vo-spaces__intro">
            <h2 data-split>Gli spazi</h2>
            <p class="vo-statement" data-rise>
              Un giardino che scende fino all'acqua, un salone con le finestre sul lago, una terrazza per il tramonto. Tutto nello stesso posto.
            </p>
            <ul class="vo-legend" aria-label="Gli spazi e quanti ospiti">
              {
                spaces.map((s) => (
                  <li>
                    <a href={`#spazio-${s.k}`} data-room={s.k}>
                      <span class="vo-legend__t">{s.t}</span>
                      <span class="vo-legend__dots" aria-hidden="true" />
                      <span class="vo-legend__n">
                        <b>{s.n}</b> {s.c.replace("ospiti ", "")}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <figure class="vo-sheet">
            <VillaPlan rooms={plan} />
            <figcaption>Pianta del piano terra e del giardino. Scegliete uno spazio per vederlo.</figcaption>
          </figure>
        </div>

        <div class="vo-rooms" data-rooms>
          {
            spaces.map((s, i) => (
              <article class={`vo-room vo-room--${s.k}`} id={`spazio-${s.k}`} tabindex="-1" aria-labelledby={`spazio-${s.k}-t`}>
                <figure class="vo-room__pic vo-arch">
                  <Image src={pic(s.k)} alt={s.alt} widths={[480, 760, 1100, 1400]} sizes="(min-width: 900px) 56vw, 92vw" />
                </figure>
                <div class="vo-room__cap">
                  <h3 id={`spazio-${s.k}-t`}>{s.t}</h3>
                  <p class="vo-room__n">
                    <span>Fino a</span> <b data-count={s.n}>{s.n}</b> <span>{s.c}</span>
                  </p>
                  <p>{s.d}</p>
                  <p class="vo-room__more">
                    <span>Gli altri spazi:</span>
                    {spaces
                      .filter((o) => o.k !== s.k)
                      .map((o) => (
                        <a href={`#spazio-${o.k}`} data-room={o.k}>
                          {o.t}
                        </a>
                      ))}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="vo-card-sec" id="stagioni" aria-label="Le stagioni e le fasce di prezzo">
      <div class="vo-wrap">
        <div class="vo-card">
          <span class="vo-mono vo-card__mono" aria-hidden="true">VO</span>
          <div class="vo-card__in">
            <div class="vo-card__panel">
              <h2 data-split>Le stagioni</h2>
              <p class="vo-card__lead">Da aprile a ottobre, ogni mese ha la sua luce.</p>
              <ul class="vo-entries">
                {
                  seasons.map((s) => (
                    <li>
                      <h3>{s.t}</h3>
                      <p class="vo-entries__m">{s.m}</p>
                      <p>{s.d}</p>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="vo-card__panel" id="fasce">
              <h2 data-split>Fasce di prezzo</h2>
              <p class="vo-card__lead">Per sapere subito se siamo nel vostro budget, prima ancora di scriverci.</p>
              <ul class="vo-entries">
                {
                  bands.map((b) => (
                    <li>
                      <p class="vo-price">
                        {b.n > 0 ? (
                          <>
                            <small>da</small> <span data-count={b.n}>{b.n}</span><small>&nbsp;€ a persona</small>
                          </>
                        ) : (
                          "Su misura"
                        )}
                      </p>
                      <p>{b.d}</p>
                    </li>
                  ))
                }
              </ul>
              <p class="vo-note">Fasce indicative di un'attività inventata.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="vo-visit-sec" id="visita">
      <div class="vo-wrap vo-visit">
        <div class="vo-visit__intro">
          <h2 data-split>Prenota una visita</h2>
          <p class="vo-lead" data-rise>Quattro informazioni e vi proponiamo due date per vedere la villa. Rispondiamo su WhatsApp in giornata.</p>
          <div class="vo-visit__alt">
            <p class="vo-visit__h">Preferite parlarne a voce?</p>
            <p><a href={telHref()}>Chiamateci</a> oppure <a href={waHref} target="_blank" rel="noopener">scriveteci su WhatsApp</a>.</p>
            <p class="vo-visit__h">Dove siamo</p>
            <p>{address}<br /><a href={mapsHref}>Come arrivare</a></p>
          </div>
        </div>
        <form class="vo-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di visita dal sito" data-err="Completa questo campo." novalidate>
          <div class="vo-row">
            <label>Mese dell'evento
              <select name="mese" data-label="Data evento" required>
                <option value="">Scegli</option>
                {years.flatMap((y) => months.map((m) => <option>{`${m} ${y}`}</option>))}
              </select>
              <span class="vo-err" data-derr="mese" aria-live="polite"></span>
            </label>
            <label>Numero di invitati
              <select name="invitati" data-label="Invitati" required>
                <option value="">Scegli</option>
                <option>meno di 60</option>
                <option>circa 80</option>
                <option>circa 120</option>
                <option>circa 150</option>
                <option>più di 160</option>
              </select>
              <span class="vo-err" data-derr="invitati" aria-live="polite"></span>
            </label>
          </div>
          <fieldset>
            <legend>Budget indicativo</legend>
            <div class="vo-opts">
              {["fascia base", "fascia media", "su misura"].map((o) => (
                <label class="vo-opt"><input type="radio" name="budget" value={o} data-label="Budget" required /><span>{o.charAt(0).toUpperCase() + o.slice(1)}</span></label>
              ))}
            </div>
            <span class="vo-err" data-derr="budget" aria-live="polite"></span>
          </fieldset>
          <label>I vostri nomi
            <input type="text" name="nomi" placeholder="es. Marco e Sara" required data-label="Nomi" />
            <span class="vo-err" data-derr="nomi" aria-live="polite"></span>
          </label>
          <button type="submit" class="vo-btn vo-btn--accent" data-magnetic>Invia su WhatsApp</button>
          <p class="vo-note">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design.</p>
        </form>
      </div>
    </section>

    <footer class="vo-foot">
      <div class="vo-wrap vo-foot__in">
        <div class="vo-foot__mid">
          <span class="vo-mono" aria-hidden="true">VO</span>
          <p class="vo-foot__name">Villa Ortensia</p>
          <p class="vo-foot__tag">Matrimoni ed eventi sul Lago di Como, da aprile a ottobre.</p>
        </div>
        <div class="vo-foot__where">
          <address class="vo-foot__addr">{address}</address>
          <a href={mapsHref}>Come arrivare</a>
        </div>
        <ul class="vo-foot__links">
          <li><a href={waHref} target="_blank" rel="noopener">WhatsApp, rispondiamo in giornata</a></li>
          <li><a href={telHref()}>Chiamaci</a></li>
          <li><a href={reviewsHref}>Le recensioni su Google</a></li>
        </ul>
        <p class="vo-foot__note">Villa Ortensia è un'attività inventata: indirizzo e partita IVA sono d'esempio (P.IVA 00000000000). Progetto dimostrativo di Focus Design. <a href="/privacy/">Informativa privacy</a></p>
      </div>
    </footer>
  </div>
</Demo>

<style>
  .vo {
    /* Colours taken from the villa: plaster, paper, the lake at dusk, one hydrangea. */
    --intonaco: #ebd8cf; /* Lombard plaster pink, the page surface */
    --carta: #ffffff; /* invitation paper */
    --lago: #1c2a33; /* deep lake ink, text and buttons (10.7:1 on plaster) */
    --lago-2: #4f5b66; /* secondary text (5.1:1 on plaster, 6.7:1 on white) */
    --ortensia: #4b5fa6; /* the one accent (white text on it 6:1) */
    --ortensia-scura: #3e5094; /* accent as small text on plaster (5.5:1) */
    --filo: rgba(28, 42, 51, 0.28); /* hairlines, decorative */
    --serif: "Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif;
    --sans: "Hanken Grotesk", "Helvetica Neue", Arial, sans-serif;
    /* One section padding; two neighbours together stay under about 150 px of empty (dead-space check). */
    --pad: clamp(48px, 5vw, 72px);
    --gut: clamp(18px, 4.5vw, 64px);
    background: var(--intonaco);
    color: var(--lago);
    font-family: var(--sans);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
  }
  .vo h1,
  .vo h2,
  .vo h3 {
    font-family: var(--serif);
    font-style: normal;
    font-optical-sizing: auto;
    color: inherit;
    letter-spacing: 0;
  }
  .vo h2 {
    font-size: clamp(2.4rem, 1.7rem + 2.6vw, 4.25rem);
    font-weight: 500;
    line-height: 1.02;
  }
  .vo h3 {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.2rem);
    font-weight: 600;
    line-height: 1.1;
  }
  .vo-wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--gut);
  }
  .vo :is(section[id], article[id], [id="fasce"]) {
    scroll-margin-top: calc(var(--banner) + 84px);
  }

  /* The monogram: two letters under an arch, like the villa's windows. */
  .vo-mono {
    display: inline-grid;
    place-items: end center;
    width: 2.1rem;
    height: 2.55rem;
    padding-bottom: 0.2rem;
    border: 1px solid currentColor;
    border-radius: 999px 999px 0 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1;
    letter-spacing: 0.04em;
    box-sizing: border-box;
  }

  /* ---------- Header: centred like an invitation ---------- */
  .vo-top {
    color: var(--lago);
  }
  .vo-top.is-solid {
    background: var(--intonaco);
    box-shadow: 0 1px 0 var(--filo);
  }
  .vo-top__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 76px;
  }
  .vo-mark {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .vo-mark__name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1;
    white-space: nowrap;
  }
  .vo-nav {
    display: none;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
    font-size: 0.98rem;
  }
  .vo-nav--l {
    grid-column: 1;
    justify-self: end;
    margin-right: clamp(0.5rem, 2vw, 2rem);
  }
  .vo-nav--r {
    grid-column: 3;
    justify-self: start;
    margin-left: clamp(0.5rem, 2vw, 2rem);
  }
  .vo-nav a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }
  .vo-nav .vo-nav__visit {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ortensia);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  @media (hover: hover) and (pointer: fine) {
    .vo-nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }
  }
  .vo-burger {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  .vo-burger__lines {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .vo-burger__lines i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }
  .vo-burger[aria-expanded="true"] .vo-burger__lines i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .vo-burger[aria-expanded="true"] .vo-burger__lines i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  @media (min-width: 1040px) {
    .vo-nav {
      display: inline-flex;
    }
    .vo-burger {
      display: none;
    }
  }
  .vo-menu {
    position: fixed;
    inset: 0;
    z-index: 85;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: 6rem var(--gut) 3rem;
    background: var(--intonaco);
    color: var(--lago);
  }
  .vo-menu nav {
    display: grid;
    gap: 0.5rem;
  }
  .vo-menu a {
    color: inherit;
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.2rem, 9vw, 3.2rem);
    line-height: 1.2;
  }
  .vo-menu .vo-menu__visit {
    margin-top: 1rem;
    color: var(--ortensia-scura);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vo-menu:not([hidden]) {
      animation: vo-menu 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes vo-menu {
      from {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
    .vo-burger__lines i {
      transition: transform 0.35s ease;
    }
  }

  /* ---------- Buttons: solid, square, no arrow ---------- */
  .vo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 1.9rem;
    background: var(--lago);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }
  .vo-btn--accent {
    background: var(--ortensia);
  }
  @media (hover: hover) and (pointer: fine) {
    .vo-btn:hover {
      background: var(--ortensia);
    }
    .vo-btn--accent:hover {
      background: var(--lago);
    }
  }
  @media (hover: none), (pointer: coarse) {
    .vo-btn:active {
      transform: scale(0.98);
    }
  }

  /* Pictures are arched windows: square sides, one round arch on top. */
  .vo-arch {
    margin: 0;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
    background: var(--carta);
  }
  .vo-arch :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Hero: text on the left, the villa in an arch on the right ---------- */
  .vo-hero {
    padding-top: calc(var(--banner) + 76px + clamp(24px, 4vw, 56px));
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .vo-hero__in {
    display: grid;
