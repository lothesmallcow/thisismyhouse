---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closing from "../../components/Closing.astro";
import PhoneFan from "../../components/visual/PhoneFan.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "../../config/site";
import { breadcrumbs } from "../../lib/schema";

const lavori = (await getCollection("lavori")).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title={`Lavori | ${site.brand}`}
  description="Tre siti dimostrativi completi: un'impresa di ristrutturazioni, un agriturismo e una location per matrimoni."
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }])]}
>
  <PageHead
    label="Lavori"
    title="Tre siti completi, per tre attività inventate."
    lead={`${site.brand} è appena nato. Per farti vedere come lavoriamo, abbiamo costruito tre siti completi per attività inventate, nei settori dove il sito conta di più. Appena i primi clienti ci danno il permesso, i loro lavori veri compaiono qui.`}
  >
    <PhoneFan slot="visual" />
  </PageHead>
  <section class="lv" aria-label="Progetti">
    <div class="wrap">
      <ol class="lv__list">
        {
          lavori.map((l) => (
            <li class:list={["lv__item", `lv__item--${l.id}`]}>
              <a class="lv__media" href={`/lavori/${l.id}/`} aria-label={`${l.data.name}, leggi il progetto`}>
                <Image
                  src={l.data.shotDesktop}
                  alt=""
                  widths={[640, 1000, 1400]}
                  sizes="(min-width: 1000px) 66vw, 92vw"
                  class="lv__desk"
                  loading="eager"
                />
                <Image src={l.data.shotPhone} alt="" widths={[200, 400]} sizes="200px" class="lv__phone" loading="eager" />
              </a>
              <div class="lv__text">
                <h2>{l.data.name}</h2>
                <p class="muted">{l.data.sector}</p>
                <p class="lv__goal">{l.data.goal}</p>
                <p class="small muted">Progetto dimostrativo per un'attività inventata.</p>
                <div class="lv__links">
                  <a class="textlink" href={`/lavori/${l.id}/`}>Leggi il progetto</a>
                  <a class="textlink" href={`/lavori/${l.id}/demo/`} target="_blank" rel="noopener">Apri il sito</a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .lv {
    padding-bottom: var(--space-section);
  }
  .lv__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  /* Each project is one card in its own colour: text and pictures share it, so nothing floats
     in empty space. Text runs top to bottom (name above, links at the foot). */
  .lv__item {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.75rem);
    border-radius: clamp(18px, 1vw + 12px, 32px);
    background: var(--nebbia);
    overflow: hidden;
  }
  .lv__item--arcadi-ristrutturazioni {
    background: #ecebe6;
  }
  .lv__item--cascina-rovere {
    background: #f4e2c8;
  }
  .lv__item--villa-ortensia {
    background: #e2e8dd;
  }
  .lv__text {
    display: flex;
    flex-direction: column;
  }
  /* Name on top, the goal and links at the foot of the card. */
  .lv__text .lv__goal {
    margin-top: auto !important;
    padding-top: 1.5rem;
  }
  .lv__links {
    padding-top: 1.75rem;
  }
  /* Long one-word names ("Ristrutturazioni") must fit the narrow text column. */
  .lv__text h2 {
    font-size: clamp(1.8rem, 1.2rem + 1.6vw, 2.8rem);
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  @media (min-width: 1000px) {
    .lv__item {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      align-items: stretch;
    }
    .lv__item:nth-child(even) {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
    .lv__item:nth-child(even) .lv__text {
      order: -1;
    }
  }
  .lv__media {
    position: relative;
    display: block;
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .lv__media :global(.lv__desk) {
    width: 86%;
    border-radius: 8px;
    box-shadow: 0 30px 60px -30px rgba(11, 27, 63, 0.35);
    transition: transform 0.9s var(--ease-out);
  }
  .lv__media :global(.lv__phone) {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 22%;
    border: 6px solid #1b1f1d;
    border-radius: 18px;
    box-shadow: 0 30px 60px -20px rgba(11, 27, 63, 0.45);
    transition: transform 0.9s var(--ease-out);
  }
  @media (hover: hover) {
    .lv__media:hover :global(.lv__desk) {
      transform: translateY(-6px);
    }
    .lv__media:hover :global(.lv__phone) {
      transform: translateY(-14px);
    }
  }
  .lv__text > .muted:first-of-type {
    margin-top: 0.75rem;
  }
  .lv__goal {
    margin-top: 1.5rem !important;
    font-size: var(--fs-lead);
    line-height: 1.4;
    max-width: 26ch;
  }
  .lv__text .small {
    margin-top: 1rem !important;
  }
  .lv__links {
    display: flex;
    gap: 1.5rem;
  }
</style>
