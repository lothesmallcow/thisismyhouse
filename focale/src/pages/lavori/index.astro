---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closing from "../../components/Closing.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "../../config/site";
import { breadcrumbs } from "../../lib/schema";

const lavori = (await getCollection("lavori")).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title={`Lavori | ${site.brand}`}
  description="Tre siti dimostrativi completi: un'impresa di ristrutturazioni, un agriturismo e una location per matrimoni."
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }])]}
>
  <PageHead
    label="Lavori"
    title="Tre siti completi, per tre attività inventate."
    lead={`${site.brand} è appena nato. Per farti vedere come lavoriamo, abbiamo costruito tre siti completi per attività inventate, nei settori dove il sito conta di più. Appena i primi clienti ci danno il permesso, i loro lavori veri compaiono qui.`}
  />
  <section class="lv" aria-label="Progetti">
    <div class="wrap">
      <ol class="lv__list">
        {
          lavori.map((l, i) => (
            <li class="lv__item">
              <a class="lv__media" href={`/lavori/${l.id}/`} aria-label={`${l.data.name}, leggi il progetto`}>
                <Image
                  src={l.data.shotDesktop}
                  alt=""
                  widths={[640, 1000, 1400]}
                  sizes="(min-width: 1000px) 66vw, 92vw"
                  class="lv__desk"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <Image src={l.data.shotPhone} alt="" widths={[200, 400]} sizes="200px" class="lv__phone" />
              </a>
              <div class="lv__text">
                <h2>{l.data.name}</h2>
                <p class="muted">{l.data.sector}</p>
                <p class="lv__goal">{l.data.goal}</p>
                <p class="small muted">Progetto dimostrativo per un'attività inventata.</p>
                <div class="lv__links">
                  <a class="textlink" href={`/lavori/${l.id}/`}>Leggi il progetto</a>
                  <a class="textlink" href={`/lavori/${l.id}/demo/`} target="_blank" rel="noopener">Apri il sito</a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .lv {
    padding-bottom: var(--space-section);
  }
  .lv__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(5rem, 3rem + 6vw, 10rem);
  }
  .lv__item {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .lv__item {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
      align-items: end;
    }
    .lv__media {
      grid-column: 1 / span 8;
    }
    .lv__text {
      grid-column: 9 / -1;
    }
    .lv__item:nth-child(even) .lv__media {
      grid-column: 5 / -1;
      grid-row: 1;
    }
    .lv__item:nth-child(even) .lv__text {
      grid-column: 1 / span 4;
      grid-row: 1;
    }
  }
  .lv__media {
    position: relative;
    display: block;
    padding: clamp(1rem, 0.5rem + 2.5vw, 3rem) clamp(1rem, 0.5rem + 2.5vw, 3rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    background: var(--nebbia);
    border-radius: clamp(14px, 1vw + 8px, 24px);
    overflow: hidden;
  }
  .lv__media :global(.lv__desk) {
    width: 86%;
    border-radius: 8px;
    box-shadow: 0 30px 60px -30px rgba(60, 25, 8, 0.35);
    transition: transform 0.9s var(--ease-out);
  }
  .lv__media :global(.lv__phone) {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 22%;
    border: 6px solid #1b1f1d;
    border-radius: 18px;
    box-shadow: 0 30px 60px -20px rgba(60, 25, 8, 0.45);
    transition: transform 0.9s var(--ease-out);
  }
  @media (hover: hover) {
    .lv__media:hover :global(.lv__desk) {
      transform: translateY(-6px);
    }
    .lv__media:hover :global(.lv__phone) {
      transform: translateY(-14px);
    }
  }
  .lv__text h2 {
    font-size: var(--fs-h2);
  }
  .lv__text > .muted:first-of-type {
    margin-top: 0.75rem;
  }
  .lv__goal {
    margin-top: 1.5rem !important;
    font-size: var(--fs-lead);
    line-height: 1.4;
    max-width: 26ch;
  }
  .lv__text .small {
    margin-top: 1rem !important;
  }
  .lv__links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
</style>
