---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closing from "../../components/Closing.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { breadcrumbs } from "../../lib/schema";

const lavori = (await getCollection("lavori")).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Lavori | Focale"
  description="Tre siti dimostrativi completi: un'impresa di ristrutturazioni, un agriturismo e una location per matrimoni."
  jsonLd={[breadcrumbs([{ name: "Lavori", path: "/lavori/" }])]}
>
  <PageHead
    title="Lavori"
    lead="Focale è appena nata. Per farti vedere come lavoro, ho costruito tre siti completi per attività inventate, nei settori dove il sito conta di più. Appena i primi clienti mi danno il permesso, i loro lavori veri compaiono qui."
  />
  <section class="section lv">
    <div class="wrap">
      <ol class="lv__list">
        {
          lavori.map((l, i) => (
            <li class="lv__item">
              <div class="lv__shots">
                <Image
                  src={l.data.shotDesktop}
                  alt={`Il sito dimostrativo di ${l.data.name} visto da computer`}
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 960px) 700px, 92vw"
                  class="lv__desk"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <Image
                  src={l.data.shotPhone}
                  alt={`Il sito dimostrativo di ${l.data.name} visto dal telefono`}
                  widths={[180, 300]}
                  sizes="180px"
                  class="lv__phone"
                />
              </div>
              <div class="lv__text">
                <p class="lv__label">Progetto dimostrativo per un'attività inventata</p>
                <h2>{l.data.name}</h2>
                <p class="lv__sector">{l.data.sector}</p>
                <p>{l.data.goal}</p>
                <div class="btn-row">
                  <a class="btn btn--secondary" href={`/lavori/${l.id}/`}>
                    Leggi il progetto
                  </a>
                  <a class="btn btn--secondary" href={`/lavori/${l.id}/demo/`} target="_blank" rel="noopener">
                    Apri il sito
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Closing title="Vuoi un sito così per la tua attività?" />
</Base>
<style>
  .lv {
    padding-top: 1rem;
  }
  .lv__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .lv__item {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    border-top: var(--bar) solid var(--pietra-scura);
  }
  @media (min-width: 960px) {
    .lv__item {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }
  .lv__shots {
    position: relative;
    padding-right: 3rem;
    padding-bottom: 2rem;
  }
  .lv__shots :global(.lv__desk) {
    width: 100%;
    border: 2px solid #1b1f1d;
    border-radius: 6px;
  }
  .lv__shots :global(.lv__phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
    max-width: 180px;
    border: 6px solid #1b1f1d;
    border-radius: var(--radius-phone);
    box-shadow: 0 20px 40px -18px rgba(64, 48, 20, 0.45);
  }
  .lv__label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--tenue);
    margin-bottom: 0.75rem;
  }
  .lv__sector {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--portone);
    margin: 0.5rem 0 1rem;
  }
  .lv__text .btn-row {
    margin-top: 1.75rem;
  }
</style>
