---
import Demo from "../../../layouts/Demo.astro";
import BeforeAfter from "../../../components/demo/BeforeAfter.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";
import { telHref } from "../../../lib/util";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/arcadi-ristrutturazioni/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/arcadi-ristrutturazioni/${n}.jpg`].default;

const services = [
  { t: "Bagni completi", d: "Dallo smontaggio alle piastrelle, impianti compresi. Di solito in due settimane.", img: "bagno-dopo" },
  { t: "Cucine", d: "Impianti, muri, pavimenti e montaggio dei mobili, con un solo referente.", img: "cucina-dopo" },
  { t: "Appartamenti chiavi in mano", d: "Progetto, pratiche e cantiere: ti consegniamo la casa pronta da abitare.", img: "soggiorno-dopo" },
  { t: "Infissi e serramenti", d: "Finestre nuove che isolano davvero, posate in giornata.", img: "infissi-dopo" },
];
const works = [
  { b: "bagno-prima", a: "bagno-dopo", c: "Bagno, zona Lambrate, 9 giorni di lavoro", alt: "bagno in zona Lambrate" },
  { b: "cucina-prima", a: "cucina-dopo", c: "Cucina, zona Città Studi, 12 giorni di lavoro", alt: "cucina in zona Città Studi" },
  { b: "soggiorno-prima", a: "soggiorno-dopo", c: "Soggiorno, NoLo, 15 giorni di lavoro", alt: "soggiorno a NoLo" },
  { b: "infissi-prima", a: "infissi-dopo", c: "Finestre, Porta Romana, 1 giorno di lavoro", alt: "finestre a Porta Romana" },
  { b: "vasca-prima", a: "vasca-dopo", c: "Bagno con vasca, Isola, 10 giorni di lavoro", alt: "bagno con vasca all'Isola" },
  { b: "camera-prima", a: "camera-dopo", c: "Camera, Sesto San Giovanni, 7 giorni di lavoro", alt: "camera a Sesto San Giovanni" },
];
const how = [
  { t: "Sopralluogo", d: "Veniamo a vedere entro 48 ore, gratis. Misuriamo e ascoltiamo." },
  { t: "Preventivo scritto", d: "Voce per voce, con i tempi. Quello che firmi è quello che paghi." },
  { t: "Cantiere pulito e puntuale", d: "Proteggiamo pavimenti e mobili, puliamo ogni sera, ti aggiorniamo ogni venerdì." },
  { t: "Consegna e garanzia", d: "Controlliamo tutto insieme. Due anni di garanzia sui lavori." },
];
const zones = ["Città Studi", "Lambrate", "NoLo", "Porta Romana", "Navigli", "Isola", "Sesto San Giovanni"];
// Demo: calls and messages go to Focus Design, never to a real business.
const tel = telHref();
---
<Demo
  title="Arcadi Ristrutturazioni | Ristrutturazioni a Milano (demo)"
  description="Sito dimostrativo di Focus Design per un'impresa di ristrutturazioni inventata a Milano."
  themeColor="#1d1f21"
  fonts={["/fonts/archivo-latin.woff2"]}
>
  <div class="ar">
    <header class="ar-top">
      <div class="ar-wrap ar-top__in">
        <span class="ar-logo">ARCADI<small>Ristrutturazioni</small></span>
        <a class="ar-top__call" href={tel}>Chiama</a>
      </div>
    </header>

    <section class="ar-hero2" aria-labelledby="ar-h1">
      <div class="ar-hero2__media" aria-hidden="true">
        <Image src={pic("bagno-prima")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" class="ar-hero2__img" />
        <Image src={pic("bagno-dopo")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="ar-hero2__img ar-hero2__after" />
        <span class="ar-hero2__line"></span>
        <span class="ar-hero2__tag ar-hero2__tag--prima">Prima</span>
        <span class="ar-hero2__tag ar-hero2__tag--dopo">Dopo</span>
      </div>
      <div class="ar-wrap ar-hero2__text">
        <p class="ar-hero2__kicker">Milano e prima cintura</p>
        <h1 id="ar-h1">Ristrutturiamo case a Milano. Bene, e nei tempi detti.</h1>
        <p class="ar-hero2__sub">Bagni, cucine e appartamenti completi. Sopralluogo e preventivo gratuiti entro 48 ore.</p>
        <div class="ar-hero2__cta">
          <a class="ar-hero2__btn" href="#preventivo">Chiedi un preventivo</a>
          <a class="ar-hero2__btn ar-hero2__btn--ghost" href={tel}>Chiama ora</a>
        </div>
        <ul class="ar-hero2__chips">
          <li>Preventivo scritto</li>
          <li>Cantiere pulito</li>
          <li>Due anni di garanzia</li>
        </ul>
      </div>
    </section>

    <section class="ar-sec" id="servizi">
      <div class="ar-wrap">
        <h2>Cosa facciamo</h2>
        <ul class="ar-services d-rail" tabindex="0" aria-label="I servizi">
          {
            services.map((s) => (
              <li>
                <Image src={pic(s.img)} alt="" widths={[360, 720]} sizes="(min-width: 900px) 280px, 92vw" />
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="ar-sec ar-sec--grey" id="lavori">
      <div class="ar-wrap">
        <h2>Lavori finiti, prima e dopo</h2>
        <p class="ar-lead">Trascina la linea per confrontare.</p>
        <div class="ar-works d-more">
          {works.map((w) => <BeforeAfter before={pic(w.b)} after={pic(w.a)} caption={w.c} alt={w.alt} />)}
        </div>
        <button type="button" class="d-more-btn ar-btn ar-btn--ghost ar-more">Altri {works.length - 3} lavori</button>
      </div>
    </section>

    <section class="ar-sec" id="come-lavoriamo">
      <div class="ar-wrap">
        <h2>Come lavoriamo</h2>
        <ol class="ar-how">
          {
            how.map((h, i) => (
              <li>
                <span class="ar-how__n">{i + 1}</span>
                <h3>{h.t}</h3>
                <p>{h.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ar-sec ar-sec--warm" id="zone">
      <div class="ar-wrap ar-zone">
        <h2>Dove lavoriamo</h2>
        <ul>{zones.map((z) => <li>{z}</li>)}</ul>
      </div>
    </section>

    <section class="ar-sec" id="preventivo">
      <div class="ar-wrap ar-quote-grid">
        <div>
          <h2>Chiedi un preventivo</h2>
          <p class="ar-lead">Tre domande. Ti rispondiamo su WhatsApp in giornata, con un giorno per il sopralluogo.</p>
        </div>
        <form class="ar-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di preventivo dal sito" data-err="Completa questo campo per continuare." novalidate>
          <p class="ar-form__progress" data-dprogress data-tpl="Passo {n} di 3">Passo 1 di 3</p>
          <fieldset data-dstep>
            <legend tabindex="-1">Che lavoro devi fare?</legend>
            <div class="ar-opts">
              {["Bagno", "Cucina", "Appartamento", "Infissi", "Altro"].map((o) => (
                <label class="ar-opt"><input type="radio" name="lavoro" value={o} data-label="Lavoro" required /><span>{o}</span></label>
              ))}
            </div>
            <p class="ar-err" data-derr="lavoro" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">Dove e quanto?</legend>
            <label class="ar-field">Zona
              <select name="zona" data-label="Zona" required>
                <option value="">Scegli la zona</option>
                {zones.map((z) => <option>{z}</option>)}
                <option>Altra zona</option>
              </select>
            </label>
            <p class="ar-err" data-derr="zona" aria-live="polite"></p>
            <label class="ar-field">Metratura indicativa, in metri quadri
              <input name="metratura" type="number" inputmode="numeric" min="1" max="1000" required data-label="Metratura" />
            </label>
            <p class="ar-err" data-derr="metratura" aria-live="polite"></p>
            <fieldset class="ar-sub">
              <legend>Quando vorresti iniziare?</legend>
              <div class="ar-opts">
                {["Entro 1 mese", "Entro 3 mesi", "Più avanti"].map((o) => (
                  <label class="ar-opt"><input type="radio" name="inizio" value={o} data-label="Inizio" required /><span>{o}</span></label>
                ))}
              </div>
              <p class="ar-err" data-derr="inizio" aria-live="polite"></p>
            </fieldset>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--ghost" data-dback>Indietro</button><button type="button" class="ar-btn" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">A chi rispondiamo?</legend>
            <label class="ar-field">Nome <input name="nome" type="text" autocomplete="given-name" required data-label="Nome" /></label>
            <p class="ar-err" data-derr="nome" aria-live="polite"></p>
            <label class="ar-field">Telefono <input name="telefono" type="tel" autocomplete="tel" required data-label="Telefono" /></label>
            <p class="ar-err" data-derr="telefono" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--ghost" data-dback>Indietro</button><button type="submit" class="ar-btn">Invia su WhatsApp</button></div>
            <p class="ar-small">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design, non a un'impresa.</p>
          </fieldset>
        </form>
      </div>
    </section>

    <footer class="ar-foot">
      <div class="ar-wrap">
        <p class="ar-foot__logo">ARCADI<small>Ristrutturazioni</small></p>
        <p>Arcadi Ristrutturazioni è un'attività inventata. Progetto dimostrativo di Focus Design.</p>
      </div>
    </footer>

    <a class="ar-sticky" href={tel}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>
      Chiama ora
    </a>
  </div>
</Demo>

<style>
  .ar {
    --o: #c4510e;
    --ink: #1d1f21;
    --grey: #e4e4e0;
    background: #f2f2f0;
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 18px;
    line-height: 1.55;
    padding-bottom: 80px;
  }
  @media (min-width: 900px) {
    .ar {
      padding-bottom: 0;
    }
  }
  .ar :global(.ar-hero) {
    min-height: auto;
  }
  /* Header and hero: the bathroom renovates itself behind an orange line as the page opens. */
  .ar-top {
    background: #f2f2f0;
    border-bottom: 1px solid #d9d9d4;
  }
  .ar-top__in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64px;
  }
  .ar-logo {
    font-weight: 900;
    font-stretch: 75%;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .ar-logo small {
    display: block;
    font-size: 0.55em;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0.04em;
    color: #a8430b;
  }
  .ar-top__call {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--o);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .ar-hero2 {
    position: relative;
    display: grid;
    overflow: hidden;
    background: #2a2622;
  }
  .ar-hero2__media,
  .ar-hero2__text {
    grid-area: 1 / 1;
  }
  .ar-hero2__media {
    position: relative;
    height: min(86vh, 860px);
    min-height: 520px;
  }
  .ar-hero2__media :global(.ar-hero2__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  .ar-hero2__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, rgba(20, 18, 16, 0.86) 0%, rgba(20, 18, 16, 0.6) 38%, rgba(20, 18, 16, 0.05) 70%);
  }
  @media (max-width: 899px) {
    .ar-hero2__media::after {
      background: linear-gradient(0deg, rgba(20, 18, 16, 0.94) 0%, rgba(20, 18, 16, 0.8) 50%, rgba(20, 18, 16, 0.55) 72%, rgba(20, 18, 16, 0) 94%);
    }
  }
  .ar-hero2__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 4px;
    margin-left: -2px;
    background: #ff6a1f;
    box-shadow: 0 0 30px 8px rgba(255, 106, 31, 0.55);
    z-index: 1;
    opacity: 0;
  }
  .ar-hero2__tag {
    position: absolute;
    top: 1.25rem;
    z-index: 3;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    background: rgba(29, 31, 33, 0.85);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    opacity: 0;
  }
  .ar-hero2__tag--prima {
    right: 1.25rem;
  }
  .ar-hero2__tag--dopo {
    right: 1.25rem;
    background: var(--o);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-hero2__media :global(.ar-hero2__after) {
      animation: ar-wipe 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero2__line {
      animation: ar-line 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero2__tag--prima {
      animation: ar-tag-out 3.2s ease both;
    }
    .ar-hero2__tag--dopo {
      animation: ar-tag-in 0.5s ease 3s both;
    }
    .ar-hero2__media :global(.ar-hero2__img:not(.ar-hero2__after)) {
      animation: ar-zoom 6s ease-out both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ar-hero2__tag--dopo {
      opacity: 1;
    }
  }
  @keyframes ar-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes ar-line {
    0% {
      left: 100%;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 0%;
      opacity: 0;
    }
  }
  @keyframes ar-tag-out {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ar-tag-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes ar-zoom {
    from {
      transform: scale(1.08);
    }
  }
  .ar-hero2__text {
    position: relative;
    z-index: 3;
    align-self: center;
    width: 100%;
    color: #fff;
    padding-block: 3rem;
  }
  @media (max-width: 899px) {
    .ar-hero2__text {
      align-self: end;
    }
  }
  .ar-hero2__kicker {
    color: #ffb27a;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .ar .ar-hero2__text h1 {
    font-weight: 850;
    font-stretch: 80%;
    font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5.6rem);
    line-height: 0.95;
    color: #fff;
    max-width: 12ch;
    margin: 0;
  }
  .ar-hero2__sub {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    max-width: 32ch;
    color: #eceae6;
  }
  .ar-hero2__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .ar-hero2__btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 1.5rem;
    border-radius: 4px;
    background: var(--o);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .ar-hero2__btn--ghost {
    background: transparent;
    border: 2px solid #fff;
  }
  .ar-hero2__chips {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ar-hero2__chips li {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    font-size: 0.85rem;
    color: #fff;
  }
  .ar h2 {
    font-family: var(--font-head);
    font-weight: 850;
    font-stretch: 72%;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    line-height: 0.98;
    color: var(--ink);
    letter-spacing: 0;
    margin-bottom: 1.5rem;
  }
  .ar h3 {
    font-family: var(--font-head);
    font-weight: 800;
    font-stretch: 85%;
    font-size: 1.5rem;
    color: var(--ink);
  }
  .ar-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(18px, 4vw, 40px);
  }
  .ar-sec {
    padding: clamp(56px, 8vw, 110px) 0;
  }
  .ar-sec--grey {
    background: var(--grey);
  }
  .ar-sec--warm {
    background: #f7e6da;
  }
  .ar-lead {
    font-size: 1.25rem;
    max-width: 40ch;
    margin-bottom: 2rem;
  }
  .ar-services {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 700px) {
    .ar-services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .ar-services {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ar-services :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 1rem;
  }
  .ar-services li {
    border-top: 6px solid var(--o);
    padding-top: 1rem;
  }
  .ar-services p {
    margin-top: 0.4rem;
    color: #3f4347;
    font-weight: 450;
  }
  .ar-works {
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 900px) {
    .ar-works {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .ar-how {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .ar-how {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ar-how__n {
    display: block;
    font-weight: 900;
    font-stretch: 70%;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--o);
    margin-bottom: 0.5rem;
  }
  .ar-how p {
    margin-top: 0.4rem;
    font-weight: 450;
    color: #3f4347;
  }
  .ar-zone ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .ar-zone li {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 2px var(--o);
    color: #a8430b;
    font-weight: 700;
  }
  .ar-quote-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .ar-quote-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }
  .ar-form {
    background: #fff;
    padding: clamp(20px, 3vw, 36px);
    border-top: 8px solid var(--o);
    display: grid;
    gap: 1rem;
  }
  .ar-form__progress {
    font-weight: 700;
    color: var(--o);
  }
  .ar-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .ar-form legend {
    font-weight: 850;
    font-stretch: 80%;
    font-size: 1.75rem;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    padding: 0;
  }
  :global(.ar-form.is-steps) [data-dstep]:not(.is-current) {
    display: none;
  }
  .ar-sub legend {
    font-size: 1.0625rem;
    font-stretch: 100%;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .ar-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ar-opt {
    position: relative;
  }
  .ar-opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .ar-opt span {
    display: inline-grid;
    place-items: center;
    min-height: 48px;
    padding: 0 1.1rem;
    border: 2px solid var(--ink);
    border-radius: 4px;
    font-weight: 700;
  }
  .ar-opt input:checked + span {
    background: var(--ink);
    color: #fff;
  }
  .ar-opt input:focus-visible + span {
    outline: 3px solid var(--o);
    outline-offset: 2px;
  }
  .ar-field {
    display: grid;
    gap: 0.35rem;
    font-weight: 700;
  }
  .ar-field input,
  .ar-field select {
    font: inherit;
    font-weight: 500;
    min-height: 50px;
    padding: 0 0.8rem;
    border: 2px solid #8b8f93;
    border-radius: 4px;
    background: #fff;
  }
  .ar-err {
    color: #a3230f;
