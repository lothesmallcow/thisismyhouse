---
/**
 * Arcadi Ristrutturazioni (invented): direction "La casa che cambia".
 * The work carries the site: the hero IS a finished bathroom you drag from before to after,
 * across the whole first screen, with the headline set on a piece of white wall cut into it.
 * The same bathroom then changes step by step in "Come lavoriamo", and the finished jobs are a
 * gallery of big sliders (one featured kitchen, five more). Materials from the illustrations:
 * white walls, the bottle green of the kitchen doors, the oak of floors and vanity tops.
 * Type: Zilla Slab (bold slab, the workshop's sign-painted letter) with Fira Sans for text,
 * the pair it was drawn with. Rounded corners everywhere (one radius family), no rules, no mono.
 */
import Demo from "../../../layouts/Demo.astro";
import Compare from "../../../components/demo/Compare.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";
import { telHref, isPlaceholder } from "../../../lib/util";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/arcadi-ristrutturazioni/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/arcadi-ristrutturazioni/${n}.jpg`].default;

const services = [
  { t: "Bagni completi", d: "Dallo smontaggio alle piastrelle, impianti compresi. Di solito in due settimane.", img: "bagno-dopo" },
  { t: "Cucine", d: "Impianti, muri, pavimenti e montaggio dei mobili, con un solo referente.", img: "cucina-dopo" },
  { t: "Appartamenti chiavi in mano", d: "Progetto, pratiche e cantiere: ti consegniamo la casa pronta da abitare.", img: "soggiorno-dopo" },
  { t: "Infissi e serramenti", d: "Finestre nuove che isolano davvero, posate in giornata.", img: "infissi-dopo" },
];
// The first job is the featured one in the gallery; the hero bathroom closes the list.
const works = [
  { b: "cucina-prima", a: "cucina-dopo", tipo: "Cucina", zona: "Città Studi", giorni: 12, alt: "cucina in zona Città Studi" },
  { b: "soggiorno-prima", a: "soggiorno-dopo", tipo: "Soggiorno", zona: "NoLo", giorni: 15, alt: "soggiorno a NoLo" },
  { b: "vasca-prima", a: "vasca-dopo", tipo: "Bagno con vasca", zona: "Isola", giorni: 10, alt: "bagno con vasca all'Isola" },
  { b: "infissi-prima", a: "infissi-dopo", tipo: "Finestre", zona: "Porta Romana", giorni: 1, alt: "finestre a Porta Romana" },
  { b: "camera-prima", a: "camera-dopo", tipo: "Camera", zona: "Sesto San Giovanni", giorni: 7, alt: "camera a Sesto San Giovanni" },
  { b: "bagno-prima", a: "bagno-dopo", tipo: "Bagno", zona: "Lambrate", giorni: 9, alt: "bagno in zona Lambrate" },
];
const days = (n: number) => `${n} ${n === 1 ? "giorno" : "giorni"} di lavoro`;
// Each phase shows the same bathroom a little further on: how much of the finished room is in.
const how = [
  { t: "Sopralluogo", d: "Veniamo a vedere entro 48 ore, gratis. Misuriamo e ascoltiamo.", done: 0 },
  { t: "Preventivo scritto", d: "Voce per voce, con i tempi. Quello che firmi è quello che paghi.", done: 34 },
  { t: "Cantiere pulito e puntuale", d: "Proteggiamo pavimenti e mobili, puliamo ogni sera, ti aggiorniamo ogni venerdì.", done: 67 },
  { t: "Consegna e garanzia", d: "Controlliamo tutto insieme. Due anni di garanzia sui lavori.", done: 100 },
];
const nav = [
  { href: "#servizi", t: "Servizi" },
  { href: "#lavori", t: "Lavori" },
  { href: "#come-lavoriamo", t: "Come lavoriamo" },
  { href: "#zone", t: "Zone" },
  { href: "#preventivo", t: "Preventivo" },
];
const zones = ["Città Studi", "Lambrate", "NoLo", "Porta Romana", "Navigli", "Isola", "Sesto San Giovanni"];
// The firm's standing facts, said once in the hero.
const facts = ["Sopralluogo entro 48 ore, gratuito", "Preventivo scritto, voce per voce", "Garanzia di 2 anni sui lavori"];
// Demo: calls and messages go to Focus Design, never to a real business.
const tel = telHref();
const hasPhone = !isPlaceholder(site.phoneDisplay);
const phoneLabel = hasPhone ? site.phoneDisplay : "Chiama ora";
const waHref = `https://wa.me/${site.whatsappNumber}`;
const address = "Via Esempio 8, 20133 Milano";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const reviewsHref = "https://search.google.com/local/reviews?placeid=ESEMPIO";
const ld = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: "Arcadi Ristrutturazioni (attività dimostrativa)",
  address: { "@type": "PostalAddress", streetAddress: "Via Esempio 8", postalCode: "20133", addressLocality: "Milano", addressCountry: "IT" },
  areaServed: zones.map((z) => ({ "@type": "Place", name: z })),
};
const phoneIcon = `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>`;
---
<Demo
  title="Arcadi Ristrutturazioni | Ristrutturazioni a Milano (demo)"
  description="Sito dimostrativo di Focus Design per un'impresa di ristrutturazioni inventata a Milano."
  themeColor="#ffffff"
  fonts={["/fonts/demo/zilla-slab-700.woff2", "/fonts/demo/fira-sans-400.woff2"]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="ar">
    <header class="ar-top" data-dh>
      <div class="ar-top__bar">
        <a class="ar-name" href="#">Arcadi <span>Ristrutturazioni</span></a>
        <nav class="ar-nav-main" aria-label="Menu">
          {nav.map((n) => <a href={n.href}>{n.t}</a>)}
        </nav>
        <a class="ar-top__tel" href={tel}>
          <Fragment set:html={phoneIcon} />
          <span>{phoneLabel}</span>
        </a>
        <a class="ar-btn ar-btn--green ar-top__cta" href="#preventivo">Preventivo</a>
        <button type="button" class="ar-burger" data-menu aria-controls="ar-menu" aria-expanded="false">
          <span class="ar-burger__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </header>
    <div class="ar-menu" id="ar-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href}>{n.t}</a>)}
      </nav>
      <div class="ar-menu__cta">
        <a class="ar-btn ar-btn--green" href="#preventivo">Chiedi un preventivo</a>
        <a class="ar-btn ar-btn--line" href={tel}>Chiama ora</a>
      </div>
    </div>

    <section class="ar-hero" aria-labelledby="ar-h1">
      <Compare
        class="ar-hero__cmp"
        before={pic("bagno-prima")}
        after={pic("bagno-dopo")}
        alt="bagno in zona Lambrate"
        label="Bagno, zona Lambrate, 9 giorni di lavoro"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 899px) 180vw, 100vw"
        eager
        intro="load"
      />
      <div class="ar-wrap ar-hero__body">
        <div class="ar-hero__card">
          <h1 id="ar-h1" data-split="load">Ristrutturiamo case a Milano. Bene, e nei tempi detti.</h1>
          <p class="ar-hero__sub">Quello che firmi nel preventivo è quello che paghi. Il cantiere lo puliamo ogni sera e ti aggiorniamo ogni venerdì.</p>
          <div class="ar-hero__cta">
            <a class="ar-btn ar-btn--green" href="#preventivo" data-magnetic>Chiedi un preventivo</a>
            <a class="ar-btn ar-btn--line" href={tel}><Fragment set:html={phoneIcon} />Chiama ora</a>
          </div>
        </div>
        <div class="ar-hero__aside">
          <p class="ar-hero__job"><strong>Questo è un bagno a Lambrate, finito in 9 giorni.</strong> Trascina la linea sulla foto per vedere com'era.</p>
          <ul class="ar-facts">
            {facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="ar-sec" id="servizi" aria-labelledby="h-servizi">
      <div class="ar-wrap ar-svc">
        <div class="ar-svc__text">
          <h2 id="h-servizi" data-split>Cosa facciamo</h2>
          <p class="ar-lead">Dallo smontaggio alla finitura, impianti compresi. Per ogni lavoro hai un preventivo scritto e un solo referente.</p>
          <ul class="ar-svc__list d-rail" aria-label="I nostri lavori" tabindex="0">
            {
              services.map((s, i) => (
                <li class:list={["ar-svc__item", { "is-on": i === 0 }]} data-svc={i}>
                  <div class="ar-svc__pic">
                    <Image src={pic(s.img)} alt="" widths={[480, 800]} sizes="82vw" loading="lazy" />
                  </div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ar-svc__stage" aria-hidden="true" data-wipe>
          {
            services.map((s, i) => (
              <Image src={pic(s.img)} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1300px) 720px, 56vw" loading="lazy" class:list={["ar-svc__shot", { "is-on": i === 0 }]} data-shot={i} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="ar-sec ar-sec--green" id="lavori" aria-labelledby="h-lavori">
      <div class="ar-wrap">
        <div class="ar-head">
          <h2 id="h-lavori" data-split>Lavori finiti, prima e dopo</h2>
          <p class="ar-lead">Sei cantieri chiusi a Milano. Trascina la linea su ogni foto per confrontare.</p>
        </div>
        <ol class="ar-gal d-more">
          {
            works.map((w, i) => (
              <li class:list={["ar-gal__item", { "ar-gal__item--big": i === 0 }]}>
                <Compare
                  before={pic(w.b)}
                  after={pic(w.a)}
                  alt={w.alt}
                  label={`${w.tipo}, ${w.zona}, ${days(w.giorni)}`}
                  widths={i === 0 ? [640, 960, 1280, 1600] : [480, 800]}
                  sizes={i === 0 ? "(min-width: 900px) 66vw, 100vw" : "(min-width: 900px) 33vw, 100vw"}
                  intro={i === 0 ? "view" : undefined}
                >
                  <figcaption class="ar-gal__cap">
                    <h3>{w.tipo}, {w.zona}</h3>
                    <span>{days(w.giorni)}</span>
                  </figcaption>
                </Compare>
              </li>
            ))
          }
        </ol>
        <button type="button" class="d-more-btn ar-btn ar-btn--oak ar-more">Altri {works.length - 3} lavori</button>
      </div>
    </section>

    <section class="ar-sec" id="come-lavoriamo" aria-labelledby="h-come">
      <div class="ar-wrap">
        <div class="ar-head">
          <h2 id="h-come" data-split>Come lavoriamo</h2>
          <p class="ar-lead">Quattro fasi, sempre le stesse. Sai sempre a che punto siamo, e la casa cambia sotto i tuoi occhi.</p>
        </div>
        <ol class="ar-steps" data-rise-group>
          {
            how.map((h) => (
              <li class="ar-step" style={`--done: ${h.done}`}>
                <div class="ar-step__pic" aria-hidden="true">
                  <Image src={pic("bagno-prima")} alt="" widths={[480, 800]} sizes="(min-width: 900px) 300px, 120px" loading="lazy" />
                  <div class="ar-step__after">
                    <Image src={pic("bagno-dopo")} alt="" widths={[480, 800]} sizes="(min-width: 900px) 300px, 120px" loading="lazy" />
                  </div>
                  {h.done > 0 && h.done < 100 && <span class="ar-step__seam"></span>}
                </div>
                <span class="ar-step__dot" aria-hidden="true"></span>
                <div class="ar-step__text">
                  <h3>{h.t}</h3>
                  <p>{h.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ar-sec ar-sec--oak" id="zone" aria-labelledby="h-zone">
      <div class="ar-wrap ar-zone">
        <div class="ar-zone__text">
          <h2 id="h-zone" data-split>Dove lavoriamo</h2>
          <p class="ar-lead">Milano e prima cintura, {zones.length} zone. Sopralluogo gratuito in tutte.</p>
          <p class="ar-zone__addr">La sede è in {address}.</p>
          <a class="ar-btn ar-btn--green" href={mapsHref}>Come arrivare</a>
        </div>
        <ul class="ar-zones" aria-label="Le zone">{zones.map((z) => <li>{z}</li>)}</ul>
      </div>
    </section>

    <section class="ar-sec ar-sec--green ar-sec--quote" id="preventivo" aria-labelledby="h-prev">
      <div class="ar-wrap ar-quote">
        <div class="ar-quote__side">
          <h2 id="h-prev" data-split>Chiedi un preventivo</h2>
          <p class="ar-lead">Tre domande. Ti rispondiamo su WhatsApp in giornata, con un giorno per il sopralluogo.</p>
          <div class="ar-quote__alt">
            <a class="ar-alt" href={tel}>
              <span class="ar-alt__k">Preferisci parlare?</span>
              <span class="ar-alt__v">{phoneLabel}</span>
            </a>
            <a class="ar-alt" href={waHref} target="_blank" rel="noopener">
              <span class="ar-alt__k">O scrivere?</span>
              <span class="ar-alt__v">WhatsApp</span>
            </a>
          </div>
        </div>
        <form class="ar-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di preventivo dal sito" data-err="Completa questo campo per continuare." novalidate>
          <div class="ar-form__top">
            <p class="ar-form__progress" data-dprogress data-tpl="Passo {n} di 3">Passo 1 di 3</p>
            <span class="ar-form__bar" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <fieldset data-dstep>
            <legend tabindex="-1">Che lavoro devi fare?</legend>
            <div class="ar-opts ar-opts--big">
              {["Bagno", "Cucina", "Appartamento", "Infissi", "Altro"].map((o) => (
                <label class="ar-opt"><input type="radio" name="lavoro" value={o} data-label="Lavoro" required /><span>{o}</span></label>
              ))}
            </div>
            <p class="ar-err" data-derr="lavoro" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--green" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">Dove e quanto?</legend>
            <label class="ar-field">Zona
              <select name="zona" data-label="Zona" required>
                <option value="">Scegli la zona</option>
                {zones.map((z) => <option>{z}</option>)}
                <option>Altra zona</option>
              </select>
            </label>
            <p class="ar-err" data-derr="zona" aria-live="polite"></p>
            <label class="ar-field">Metratura indicativa, in metri quadri
              <input name="metratura" type="number" inputmode="numeric" min="1" max="1000" required data-label="Metratura" />
            </label>
            <p class="ar-err" data-derr="metratura" aria-live="polite"></p>
            <fieldset class="ar-sub">
              <legend>Quando vorresti iniziare?</legend>
              <div class="ar-opts">
                {["Entro 1 mese", "Entro 3 mesi", "Più avanti"].map((o) => (
                  <label class="ar-opt"><input type="radio" name="inizio" value={o} data-label="Inizio" required /><span>{o}</span></label>
                ))}
              </div>
              <p class="ar-err" data-derr="inizio" aria-live="polite"></p>
            </fieldset>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--line" data-dback>Indietro</button><button type="button" class="ar-btn ar-btn--green" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">A chi rispondiamo?</legend>
            <label class="ar-field">Nome <input name="nome" type="text" autocomplete="given-name" required data-label="Nome" /></label>
            <p class="ar-err" data-derr="nome" aria-live="polite"></p>
            <label class="ar-field">Telefono <input name="telefono" type="tel" autocomplete="tel" required data-label="Telefono" /></label>
            <p class="ar-err" data-derr="telefono" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--line" data-dback>Indietro</button><button type="submit" class="ar-btn ar-btn--green">Invia su WhatsApp</button></div>
            <p class="ar-small">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design, non a un'impresa.</p>
          </fieldset>
        </form>
      </div>
    </section>

    <footer class="ar-foot">
      <div class="ar-wrap ar-foot__in">
        <p class="ar-foot__name">Arcadi Ristrutturazioni</p>
        <dl class="ar-foot__data">
          <div>
            <dt>Sede</dt>
            <dd>{address}</dd>
          </div>
          <div>
            <dt>Telefono</dt>
            <dd><a href={tel}>{phoneLabel}</a></dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><a href={waHref} target="_blank" rel="noopener">Scrivici</a></dd>
          </div>
          <div>
            <dt>Mappa</dt>
            <dd><a href={mapsHref}>Come arrivare</a></dd>
          </div>
          <div>
            <dt>Recensioni</dt>
            <dd><a href={reviewsHref}>Su Google</a></dd>
          </div>
          <div>
            <dt>Partita IVA</dt>
            <dd>00000000000</dd>
          </div>
        </dl>
        <p class="ar-foot__note">Arcadi Ristrutturazioni è un'attività inventata: indirizzo e partita IVA sono d'esempio. Progetto dimostrativo di Focus Design. <a href="/privacy/">Informativa privacy</a></p>
      </div>
    </footer>

    <a class="ar-sticky" href={tel}>
      <Fragment set:html={phoneIcon} />
      Chiama ora
    </a>
  </div>
</Demo>

<style is:global>
  /* Arcadi's own type: Zilla Slab (bold, for headings) with Fira Sans for text. */
  @font-face {
    font-family: "Zilla Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 700;
    src: url("/fonts/demo/zilla-slab-700.woff2") format("woff2");
  }
  @font-face {
    font-family: "Zilla Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 600;
    src: url("/fonts/demo/zilla-slab-600.woff2") format("woff2");
  }
  @font-face {
    font-family: "Fira Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url("/fonts/demo/fira-sans-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "Fira Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 600;
    src: url("/fonts/demo/fira-sans-600.woff2") format("woff2");
  }
  body.demo {
    --font-head: "Fira Arcadi", "Segoe UI", system-ui, sans-serif;
    --font: var(--font-head);
    background: #ffffff;
  }
  /* Anchors land under the banner and the floating header. */
  html {
    scroll-padding-top: 120px;
  }
</style>
<style>
  /* ================= Tokens: named after where they come from ================= */
  .ar {
    --parete: #ffffff; /* white walls */
    --anta: #1e3b34; /* bottle green of the kitchen doors: text, buttons, bands (white on it 12.1:1) */
    --anta-2: #2b4d45; /* hover, surfaces inside green bands */
    --anta-notte: #152b25; /* footer */
    --rovere: #c99d73; /* oak of floors and vanity tops: fills with green text (4.9:1) */
    --rovere-chiaro: #e1c4a4; /* light oak: band surface (green text 7.7:1) */
    --rovere-scuro: #85562f; /* oak for small text on white (6.2:1) */
    --corpo: #24302c; /* body text */
    --grigio: #55625e; /* secondary text (6.4:1 on white) */
    --nebbia: #c4d0cc; /* secondary text on green (7.6:1) */
    --slab: "Zilla Arcadi", Rockwell, "Roboto Slab", Georgia, serif;
    --r: 22px; /* pictures, cards, panels */
    --r-s: 14px; /* buttons, fields, chips */
    --pad: clamp(18px, 4.5vw, 48px);
    --max: 1280px;
    --sec: clamp(48px, 5vw, 72px); /* two bands meet with at most 144 px of empty space */
    background: var(--parete);
    color: var(--corpo);
    font-family: var(--font-head);
    font-size: 18px;
    line-height: 1.55;
  }
  @media (max-width: 899px) {
    .ar {
      padding-bottom: 64px; /* room for the call bar */
      font-size: 17px;
      --sec: 40px;
    }
  }
  .ar ::selection {
    background: var(--anta);
    color: var(--parete);
  }
  .ar :focus-visible {
    outline: 3px solid var(--anta);
    outline-offset: 3px;
  }
  .ar-sec--green :focus-visible,
  .ar-foot :focus-visible {
    outline-color: var(--rovere-chiaro);
  }
  .ar-wrap {
    max-width: calc(var(--max) + 2 * var(--pad));
    margin: 0 auto;
    padding-inline: max(var(--pad), env(safe-area-inset-left)) max(var(--pad), env(safe-area-inset-right));
  }
  .ar h1,
  .ar h2,
  .ar h3,
  .ar legend {
    font-family: var(--slab);
    font-weight: 700;
    color: var(--anta);
    letter-spacing: -0.01em;
  }
  .ar h2 {
    font-size: clamp(2.25rem, 1.2rem + 3.3vw, 4.75rem);
    line-height: 0.98;
  }
  .ar h3 {
    font-weight: 600;
    font-size: clamp(1.45rem, 1.15rem + 0.8vw, 2rem);
    line-height: 1.08;
  }
  .ar-sec {
    padding-block: var(--sec);
  }
  .ar-sec--green {
    background: var(--anta);
    color: var(--parete);
  }
  .ar-sec--green h2,
  .ar-sec--green h3 {
    color: var(--parete);
  }
  .ar-sec--oak {
    background: var(--rovere-chiaro);
  }
  .ar-lead {
    margin-top: 1.1rem;
    max-width: 40ch;
    color: var(--grigio);
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .ar-lead {
      max-width: none;
    }
  }
  .ar-sec--green .ar-lead {
    color: var(--nebbia);
  }
  .ar-sec--oak .ar-lead {
    color: var(--anta);
  }
  /* Section heads: title left, intro right, both on the content's columns. */
  .ar-head {
    margin-bottom: clamp(28px, 3.5vw, 48px);
  }
  @media (min-width: 900px) {
    .ar-head {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(16px, 2vw, 24px);
      align-items: end;
    }
    .ar-head h2 {
      grid-column: 1 / 3;
    }
    .ar-head .ar-lead {
      margin: 0;
    }
  }

  /* ================= Buttons: rounded, solid, no arrows ================= */
  .ar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 56px;
    padding: 0 1.5rem;
    border: 2px solid transparent;
    border-radius: var(--r-s);
    font: inherit;
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .ar-btn--green {
    background: var(--anta);
    color: var(--parete);
  }
  .ar-btn--line {
    background: var(--parete);
    color: var(--anta);
    border-color: var(--anta);
  }
  .ar-btn--oak {
    background: var(--rovere);
    color: var(--anta);
  }
  @media (hover: hover) and (pointer: fine) {
    .ar-btn--green:hover {
      background: var(--anta-2);
    }
    .ar-btn--line:hover {
      background: var(--anta);
      color: var(--parete);
    }
    .ar-btn--oak:hover {
      background: var(--rovere-chiaro);
    }
  }
  @media (hover: none), (pointer: coarse) {
    .ar-btn:active {
      transform: scale(0.98);
    }
  }

  /* ================= Header: a floating white bar with rounded ends ================= */
  .ar-top {
    padding: 12px max(var(--pad), env(safe-area-inset-left)) 0;
    pointer-events: none;
  }
  .ar-top__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(var(--max) + 24px);
    min-height: 64px;
    margin: 0 auto;
    padding: 0 8px 0 20px;
    background: var(--parete);
    border-radius: 18px;
    box-shadow: 0 2px 10px rgba(21, 43, 37, 0.1);
    transition: box-shadow 0.35s ease;
  }
  :global(.is-solid) .ar-top__bar {
    box-shadow: 0 8px 28px rgba(21, 43, 37, 0.16);
  }
  .ar-name {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    margin-right: auto;
    padding: 10px 0;
    font-family: var(--slab);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--anta);
    text-decoration: none;
    white-space: nowrap;
  }
  .ar-name span {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 1rem;
    color: var(--grigio);
  }
  .ar-nav-main {
    display: none;
  }
  .ar-nav-main a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.8rem;
    border-radius: 10px;
    color: var(--anta);
    text-decoration: none;
    font-size: 1rem;
    transition: background-color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ar-nav-main a:hover {
      background: #eef1ef;
    }
  }
  .ar-top__tel {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0 0.8rem;
    color: var(--anta);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .ar-top__cta {
    display: none;
    min-height: 48px;
    padding: 0 1.1rem;
  }
  .ar-burger {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 12px;
    background: var(--anta);
    color: var(--parete);
    cursor: pointer;
  }
  .ar-burger__lines {
    display: grid;
    gap: 6px;
    width: 20px;
  }
  .ar-burger__lines i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-burger__lines i {
      transition: transform 0.3s ease;
    }
  }
  @media (max-width: 420px) {
    .ar-name span {
      display: none;
    }
  }
  @media (min-width: 640px) {
    .ar-top__tel {
      display: flex;
    }
  }
  @media (min-width: 1100px) {
    .ar-nav-main {
      display: flex;
    }
    .ar-top__cta {
      display: inline-flex;
    }
    .ar-burger {
      display: none;
    }
  }
  /* Phone menu: white sheet, big slab entries. */
  .ar-menu {
    position: fixed;
    inset: 0;
    z-index: 85;
    display: grid;
    align-content: start;
    gap: 2rem;
    padding: calc(var(--banner) + 100px) var(--pad) 2rem;
    background: var(--parete);
    overflow-y: auto;
  }
  .ar-menu nav {
    display: grid;
  }
  .ar-menu nav a {
    display: block;
    padding: 0.35rem 0;
    color: var(--anta);
    text-decoration: none;
    font-family: var(--slab);
    font-weight: 700;
    font-size: clamp(2.1rem, 9vw, 2.9rem);
    line-height: 1.15;
  }
  .ar-menu__cta {
    display: grid;
    gap: 0.6rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-menu:not([hidden]) {
      animation: ar-menu 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes ar-menu {
      from {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }

  /* ================= Hero: the finished bathroom fills the first screen ================= */
  .ar-hero {
    overflow-x: clip;
    padding-top: var(--banner);
  }
  .ar-hero :global(.ar-hero__cmp) {
    --knob: 68px;
    --tag-top: 98px;
    --tag-x: max(var(--pad), 16px);
    height: max(440px, calc(100svh - var(--banner) - 170px));
    max-height: 900px;
  }
  .ar-hero :global(.ar-hero__cmp .cmp__media) {
    border-radius: 0;
  }
  .ar-hero :global(.ar-hero__cmp .cmp__tag) {
    padding: 8px 16px;
    font-size: 16px;
  }
  .ar-hero__body {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(24px, 3vw, 48px);
  }
  /* A piece of white wall cut into the picture: it runs out to the left edge of the screen. */
  .ar-hero__card {
    position: relative;
    margin-top: -150px;
    padding: 34px 44px 0 0;
    background: var(--parete);
    border-radius: 0 var(--r) 0 0;
  }
  .ar-hero__card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    width: 50vw;
    background: var(--parete);
  }
  .ar .ar-hero__card h1 {
    font-size: clamp(2.5rem, 0.6rem + 3.3vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .ar-hero__sub {
    margin-top: 1rem;
    max-width: 50ch;
    color: var(--grigio);
    font-size: 1.1875rem;
  }
  .ar-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .ar-hero__aside {
    padding-top: 28px;
  }
  .ar-hero__job {
    color: var(--grigio);
  }
  .ar-hero__job strong {
    display: block;
    color: var(--anta);
    font-family: var(--slab);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.15;
    margin-bottom: 0.35rem;
  }
  .ar-facts {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .ar-facts li {
    position: relative;
    padding-left: 2rem;
    color: var(--anta);
    font-weight: 600;
  }
  /* Oak tick, drawn with borders. */
  .ar-facts li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.3em;
    width: 0.5rem;
    height: 0.85rem;
    border: solid var(--rovere-scuro);
    border-width: 0 3px 3px 0;
    transform: rotate(45deg);
  }
  @media (max-width: 899px) {
    .ar-hero :global(.ar-hero__cmp) {
      --knob: 56px;
      --tag-top: 92px;
      height: max(320px, 52svh);
    }
    .ar-hero__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .ar-hero__card {
      margin-top: -28px;
      margin-inline: calc(-1 * var(--pad));
      padding: 26px var(--pad) 0;
      border-radius: var(--r) var(--r) 0 0;
    }
    .ar-hero__card::before {
      content: none;
    }
    .ar .ar-hero__card h1 {
      font-size: clamp(2.125rem, 1.2rem + 3.6vw, 3rem);
      line-height: 1.02;
    }
    .ar-hero__sub {
      font-size: 1.0625rem;
    }
    .ar-hero__aside {
      padding-top: 32px;
    }
  }
  @media (max-width: 599px) {
    .ar-hero__cta {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.6rem;
      margin-top: 1.3rem;
    }
    .ar-hero__job strong {
      font-size: 1.375rem;
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .ar-hero__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  /* Tablets: words beside the facts, so no half-empty row under the picture. */
  @media (min-width: 600px) and (max-width: 899px) {
    .ar-hero__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .ar-hero__card {
      margin-inline: calc(-1 * var(--pad)) 0;
      padding: 26px 24px 0 var(--pad);
      border-radius: 0 var(--r) 0 0;
    }
  }

  /* ================= Services: the list drives one big picture ================= */
  .ar-svc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
  }
  .ar-svc__text {
    min-width: 0;
  }
  .ar-svc__list {
    margin: clamp(24px, 3vw, 40px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .ar-svc__item {
    position: relative;
    padding: 16px 20px 18px 24px;
    border-radius: var(--r-s);
    transition: background-color 0.3s ease;
  }
  .ar-svc__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    bottom: 18px;
    width: 4px;
    border-radius: 4px;
    background: var(--rovere);
    transform: scaleY(0);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ar-svc__item.is-on {
    background: #f3ece3;
  }
  .ar-svc__item.is-on::before {
    transform: scaleY(1);
  }
  .ar-svc__item p {
    margin-top: 0.35rem;
    color: var(--grigio);
  }
  .ar-svc__pic {
    display: none;
  }
  .ar-svc__stage {
    position: relative;
    min-height: 520px;
    border-radius: var(--r);
    overflow: hidden;
    background: #e9e4dc;
  }
  .ar-svc__stage :global(.ar-svc__shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .ar-svc__stage :global(.ar-svc__shot.is-on) {
    opacity: 1;
  }
  @media (max-width: 899px) {
    .ar-svc {
      grid-template-columns: minmax(0, 1fr);
    }
    .ar-svc__stage {
      display: none;
    }
    .ar-svc__item {
      padding: 0;
      background: none;
    }
    .ar-svc__item.is-on {
      background: none;
    }
    .ar-svc__item::before {
      content: none;
    }
    .ar-svc__pic {
      display: block;
      aspect-ratio: 4 / 3;
      margin-bottom: 0.9rem;
      border-radius: var(--r);
      overflow: hidden;
      background: #e9e4dc;
    }
    .ar-svc__pic :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  @media (min-width: 761px) and (max-width: 899px) {
    .ar-svc__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  /* ================= Works: a gallery of sliders, one big ================= */
  .ar-gal {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(14px, 1.6vw, 22px);
  }
  .ar-gal__item {
    min-width: 0;
  }
  .ar-gal :global(.cmp) {
    --cmp-focus: var(--rovere-chiaro);
    height: 100%;
    border-radius: var(--r);
  }
  .ar-gal :global(.cmp__media) {
    aspect-ratio: 16 / 10;
    height: auto;
  }
  .ar-gal__cap {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    padding: 10px 14px;
    border-radius: var(--r-s);
    background: var(--parete);
    color: var(--grigio);
    font-size: 0.9375rem;
    line-height: 1.3;
    pointer-events: none;
  }
  .ar .ar-gal__cap h3 {
    color: var(--anta);
    font-size: 1.25rem;
    line-height: 1.1;
  }
  /* Tablets: the featured job on its own row, then pairs; the last job closes full width. */
  @media (min-width: 600px) and (max-width: 899px) {
    .ar-gal {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ar-gal__item--big,
    .ar-gal__item:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .ar-gal {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ar-gal__item--big {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
    .ar-gal__item--big :global(.cmp__media) {
      aspect-ratio: auto;
      height: 100%;
    }
    .ar-gal__item--big :global(.cmp) {
      --knob: 68px;
    }
    .ar-gal__item--big .ar-gal__cap {
      left: 20px;
      bottom: 20px;
      padding: 16px 22px;
      font-size: 1.0625rem;
    }
    .ar .ar-gal__item--big .ar-gal__cap h3 {
      font-size: clamp(1.75rem, 1.2rem + 1vw, 2.4rem);
      margin-bottom: 0.15rem;
    }
  }
  .ar-more {
    margin-top: 1.25rem;
    width: 100%;
  }
  .ar-more:not(:global(.is-on)) {
    display: none;
  }
  @media (min-width: 761px) {
    .ar-more {
      display: none;
    }
  }

  /* ================= How we work: the same bathroom, a step further each time ================= */
  .ar-steps {
    --gap: clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .ar-step {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
  }
  .ar-step__pic {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r);
    overflow: hidden;
    background: #e9e4dc;
  }
  .ar-step__pic :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ar-step__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 calc((100 - var(--done)) * 1%));
  }
  .ar-step__seam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((100 - var(--done)) * 1%);
    width: 3px;
    margin-left: -1.5px;
    background: var(--parete);
  }
  /* The track: a dot per phase on one line that runs under the pictures. */
  .ar-step__dot {
    position: relative;
    display: block;
    height: 18px;
    margin: 22px 0 18px;
  }
  .ar-step__dot::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--rovere);
    box-shadow: 0 0 0 4px var(--parete);
    z-index: 1;
  }
  .ar-step__dot::after {
    content: "";
    position: absolute;
    left: 0;
    right: calc(-1 * var(--gap));
    top: 8px;
    height: 2px;
    background: var(--rovere);
  }
  .ar-step:last-child .ar-step__dot::after {
    right: 0;
    background: linear-gradient(90deg, var(--rovere), var(--rovere-chiaro));
  }
  .ar-step:last-child .ar-step__dot::before {
    background: var(--anta);
  }
  .ar-step p {
    margin-top: 0.5rem;
    color: var(--grigio);
  }
  @media (max-width: 899px) {
    .ar-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .ar-step {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: 18px;
      padding-bottom: 28px;
    }
    .ar-step:last-child {
      padding-bottom: 0;
    }
    .ar-step__pic {
      aspect-ratio: 1;
      grid-row: 1;
      border-radius: var(--r-s);
    }
    .ar-step__dot {
      display: none;
    }
    /* On phones the line runs down from picture to picture. */
    .ar-step:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 55px;
      top: 112px;
      bottom: 0;
      width: 2px;
      background: var(--rovere);
    }
    .ar-step__text {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }
    .ar .ar-step h3 {
      font-size: 1.375rem;
    }
    .ar-step p {
      font-size: 1rem;
    }
  }

  /* Tablets: two phases a row, the picture on top. */
  @media (min-width: 600px) and (max-width: 899px) {
    .ar-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
    .ar-step {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 0;
    }
    .ar-step__pic {
      aspect-ratio: 4 / 3;
      border-radius: var(--r);
    }
    .ar-step:not(:last-child)::after {
      content: none;
    }
    .ar-step__text {
      grid-column: 1;
      grid-row: 2;
      margin-top: 14px;
    }
  }

  /* ================= Zones: big oak-tinted band, the zones as large chips ================= */
  .ar-zone {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .ar-zone__addr {
    margin: 0.6rem 0 1.5rem;
    color: var(--anta);
    font-weight: 600;
  }
  .ar-zones {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ar-zones li {
    flex: 1 1 auto;
    text-align: center;
    padding: 0.55em 0.9em;
    border-radius: var(--r-s);
    background: var(--parete);
    color: var(--anta);
    font-family: var(--slab);
    font-weight: 700;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.75rem);
    line-height: 1.05;
  }
  @media (max-width: 599px) {
    .ar-zone {
      grid-template-columns: minmax(0, 1fr);
    }
    .ar-zones {
      gap: 8px;
    }
  }

  /* ================= Quote request: green band, white sheet ================= */
  .ar-quote {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: stretch;
  }
  .ar-quote__alt {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(24px, 3vw, 40px);
  }
  .ar-alt {
    display: grid;
    gap: 0.15rem;
    min-height: 56px;
    padding: 18px 22px;
    border-radius: var(--r);
    background: var(--anta-2);
    color: var(--parete);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .ar-alt__k {
    color: var(--nebbia);
  }
  .ar-alt__v {
    font-family: var(--slab);
    font-weight: 700;
    font-size: clamp(1.375rem, 1rem + 1vw, 1.75rem);
    line-height: 1.1;
  }
  @media (hover: hover) and (pointer: fine) {
    .ar-alt:hover {
      background: #355a51;
    }
  }
  .ar-form {
    --fpad: clamp(20px, 3vw, 40px);
    display: grid;
    gap: 1rem;
    align-content: start;
