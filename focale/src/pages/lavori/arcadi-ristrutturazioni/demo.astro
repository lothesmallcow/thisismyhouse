---
import Demo from "../../../layouts/Demo.astro";
import BeforeAfter from "../../../components/demo/BeforeAfter.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";
import { telHref } from "../../../lib/util";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/arcadi-ristrutturazioni/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/arcadi-ristrutturazioni/${n}.jpg`].default;

const services = [
  { t: "Bagni completi", d: "Dallo smontaggio alle piastrelle, impianti compresi. Di solito in due settimane.", img: "bagno-dopo" },
  { t: "Cucine", d: "Impianti, muri, pavimenti e montaggio dei mobili, con un solo referente.", img: "cucina-dopo" },
  { t: "Appartamenti chiavi in mano", d: "Progetto, pratiche e cantiere: ti consegniamo la casa pronta da abitare.", img: "soggiorno-dopo" },
  { t: "Infissi e serramenti", d: "Finestre nuove che isolano davvero, posate in giornata.", img: "infissi-dopo" },
];
const works = [
  { b: "bagno-prima", a: "bagno-dopo", c: "Bagno, zona Lambrate, 9 giorni di lavoro", alt: "bagno in zona Lambrate" },
  { b: "cucina-prima", a: "cucina-dopo", c: "Cucina, zona Città Studi, 12 giorni di lavoro", alt: "cucina in zona Città Studi" },
  { b: "soggiorno-prima", a: "soggiorno-dopo", c: "Soggiorno, NoLo, 15 giorni di lavoro", alt: "soggiorno a NoLo" },
  { b: "infissi-prima", a: "infissi-dopo", c: "Finestre, Porta Romana, 1 giorno di lavoro", alt: "finestre a Porta Romana" },
  { b: "vasca-prima", a: "vasca-dopo", c: "Bagno con vasca, Isola, 10 giorni di lavoro", alt: "bagno con vasca all'Isola" },
  { b: "camera-prima", a: "camera-dopo", c: "Camera, Sesto San Giovanni, 7 giorni di lavoro", alt: "camera a Sesto San Giovanni" },
];
const how = [
  { t: "Sopralluogo", d: "Veniamo a vedere entro 48 ore, gratis. Misuriamo e ascoltiamo." },
  { t: "Preventivo scritto", d: "Voce per voce, con i tempi. Quello che firmi è quello che paghi." },
  { t: "Cantiere pulito e puntuale", d: "Proteggiamo pavimenti e mobili, puliamo ogni sera, ti aggiorniamo ogni venerdì." },
  { t: "Consegna e garanzia", d: "Controlliamo tutto insieme. Due anni di garanzia sui lavori." },
];
const nav = [
  { href: "#servizi", t: "Servizi" },
  { href: "#lavori", t: "Lavori" },
  { href: "#come-lavoriamo", t: "Come lavoriamo" },
  { href: "#zone", t: "Zone" },
];
const bandWords = ["Bagni", "Cucine", "Appartamenti", "Infissi", "Impianti", "Pavimenti", "Cartongesso"];
const numbers = [
  { v: 48, u: "ore", d: "per il sopralluogo gratuito" },
  { v: 2, u: "anni", d: "di garanzia sui lavori" },
  { v: 1, u: "referente", d: "dal preventivo alla consegna" },
  { v: 7, u: "zone", d: "di Milano e prima cintura" },
];
const zones = ["Città Studi", "Lambrate", "NoLo", "Porta Romana", "Navigli", "Isola", "Sesto San Giovanni"];
// Demo: calls and messages go to Focus Design, never to a real business.
const tel = telHref();
---
<Demo
  title="Arcadi Ristrutturazioni | Ristrutturazioni a Milano (demo)"
  description="Sito dimostrativo di Focus Design per un'impresa di ristrutturazioni inventata a Milano."
  themeColor="#171717"
  fonts={["/fonts/archivo-latin.woff2"]}
>
  <div class="ar">
    <header class="ar-top" data-dh>
      <div class="ar-wrap ar-top__in">
        <a class="ar-logo" href="#">ARCADI<small>Ristrutturazioni</small></a>
        <nav class="ar-nav-main" aria-label="Menu">
          {nav.map((n) => <a href={n.href}>{n.t}</a>)}
        </nav>
        <a class="ar-top__quote" href="#preventivo" data-magnetic>Preventivo gratuito</a>
        <a class="ar-top__call" href={tel}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>
          Chiama
        </a>
        <button type="button" class="ar-burger" data-menu aria-controls="ar-menu" aria-expanded="false">
          <span class="ar-burger__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </header>
    <div class="ar-menu" id="ar-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href}>{n.t}</a>)}
      </nav>
      <a class="ar-btn" href="#preventivo">Chiedi un preventivo</a>
    </div>

    <section class="ar-hero2" aria-labelledby="ar-h1">
      <div class="ar-hero2__media" aria-hidden="true">
        <Image src={pic("bagno-prima")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" class="ar-hero2__img" />
        <Image src={pic("bagno-dopo")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="ar-hero2__img ar-hero2__after" />
        <span class="ar-hero2__track"><span class="ar-hero2__line"></span></span>
        <span class="ar-hero2__tag ar-hero2__tag--prima">Prima</span>
        <span class="ar-hero2__tag ar-hero2__tag--dopo">Dopo</span>
      </div>
      <div class="ar-wrap ar-hero2__text">
        <p class="ar-hero2__kicker">Milano e prima cintura</p>
        <h1 id="ar-h1" data-split="load">Ristrutturiamo case a Milano. Bene, e nei tempi detti.</h1>
        <p class="ar-hero2__sub">Bagni, cucine e appartamenti completi. Sopralluogo e preventivo gratuiti entro 48 ore.</p>
        <div class="ar-hero2__cta">
          <a class="ar-hero2__btn" href="#preventivo" data-magnetic>Chiedi un preventivo</a>
          <a class="ar-hero2__btn ar-hero2__btn--ghost" href={tel}>Chiama ora</a>
        </div>
        <ul class="ar-hero2__chips" aria-label="Le nostre garanzie">
          <li>Preventivo scritto, voce per voce</li>
          <li>Cantiere pulito ogni sera</li>
          <li>Due anni di garanzia</li>
        </ul>
      </div>
    </section>


    <section class="ar-sec ar-svc-sec" id="servizi">
      <div class="ar-wrap ar-svc">
        <div class="ar-svc__stage" aria-hidden="true">
          {
            services.map((s, i) => (
              <div class:list={["ar-svc__pic", { "is-on": i === 0 }]} data-svc-pic={i}>
                <Image src={pic(s.img)} alt="" widths={[600, 1000]} sizes="(min-width: 900px) 46vw, 92vw" />
              </div>
            ))
          }
        </div>
        <div class="ar-svc__list">
          <h2 data-split>Cosa facciamo</h2>
          <ol class="ar-services d-rail" tabindex="0" aria-label="I servizi">
            {
              services.map((s, i) => (
                <li class:list={["ar-service", { "is-on": i === 0 }]} data-svc={i}>
                  <div class="ar-service__pic">
                    <Image src={pic(s.img)} alt="" widths={[360, 720]} sizes="82vw" />
                  </div>
                  <span class="ar-service__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="ar-works-sec" id="lavori" data-hscroll>
      <div class="ar-wrap ar-works-head">
        <h2 data-split>Lavori finiti, prima e dopo</h2>
        <p class="ar-lead" data-rise>Trascina la linea per confrontare.</p>
      </div>
      <div class="ar-works d-more" data-hscroll-track>
        {works.map((w) => <BeforeAfter before={pic(w.b)} after={pic(w.a)} caption={w.c} alt={w.alt} />)}
      </div>
      <div class="ar-wrap">
        <button type="button" class="d-more-btn ar-btn ar-btn--ghost ar-more">Altri {works.length - 3} lavori</button>
      </div>
    </section>

    <section class="ar-numbers" aria-label="In numeri">
      <div class="ar-wrap">
        <dl class="ar-numbers__list" data-rise-group>
          {
            numbers.map((n) => (
              <div>
                <dt>
                  <span data-count={n.v}>{n.v}</span>
                  <small>{n.u}</small>
                </dt>
                <dd>{n.d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="ar-sec" id="come-lavoriamo">
      <div class="ar-wrap ar-how-grid">
        <div class="ar-how-side">
          <h2 data-split>Come lavoriamo</h2>
          <p class="ar-lead" data-rise>Quattro passi, sempre gli stessi. Sai sempre a che punto siamo.</p>
        </div>
        <ol class="ar-how" data-how-rail>
          {
            how.map((h, i) => (
              <li data-rise>
                <span class="ar-how__n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{h.t}</h3>
                  <p>{h.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ar-sec ar-sec--warm" id="zone">
      <div class="ar-wrap ar-zone">
        <h2 data-split>Dove lavoriamo</h2>
        <p class="ar-lead" data-rise>Milano e prima cintura. Il sopralluogo è gratuito in tutte queste zone.</p>
        <ul class="ar-zones" data-rise-group>{zones.map((z) => <li>{z}</li>)}</ul>
      </div>
    </section>

    <section class="ar-sec" id="preventivo">
      <div class="ar-wrap ar-quote-grid">
        <div>
          <h2 data-split>Chiedi un preventivo</h2>
          <p class="ar-lead" data-rise>Tre domande. Ti rispondiamo su WhatsApp in giornata, con un giorno per il sopralluogo.</p>
        </div>
        <form class="ar-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di preventivo dal sito" data-err="Completa questo campo per continuare." novalidate>
          <p class="ar-form__progress" data-dprogress data-tpl="Passo {n} di 3">Passo 1 di 3</p>
          <fieldset data-dstep>
            <legend tabindex="-1">Che lavoro devi fare?</legend>
            <div class="ar-opts">
              {["Bagno", "Cucina", "Appartamento", "Infissi", "Altro"].map((o) => (
                <label class="ar-opt"><input type="radio" name="lavoro" value={o} data-label="Lavoro" required /><span>{o}</span></label>
              ))}
            </div>
            <p class="ar-err" data-derr="lavoro" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">Dove e quanto?</legend>
            <label class="ar-field">Zona
              <select name="zona" data-label="Zona" required>
                <option value="">Scegli la zona</option>
                {zones.map((z) => <option>{z}</option>)}
                <option>Altra zona</option>
              </select>
            </label>
            <p class="ar-err" data-derr="zona" aria-live="polite"></p>
            <label class="ar-field">Metratura indicativa, in metri quadri
              <input name="metratura" type="number" inputmode="numeric" min="1" max="1000" required data-label="Metratura" />
            </label>
            <p class="ar-err" data-derr="metratura" aria-live="polite"></p>
            <fieldset class="ar-sub">
              <legend>Quando vorresti iniziare?</legend>
              <div class="ar-opts">
                {["Entro 1 mese", "Entro 3 mesi", "Più avanti"].map((o) => (
                  <label class="ar-opt"><input type="radio" name="inizio" value={o} data-label="Inizio" required /><span>{o}</span></label>
                ))}
              </div>
              <p class="ar-err" data-derr="inizio" aria-live="polite"></p>
            </fieldset>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--ghost" data-dback>Indietro</button><button type="button" class="ar-btn" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">A chi rispondiamo?</legend>
            <label class="ar-field">Nome <input name="nome" type="text" autocomplete="given-name" required data-label="Nome" /></label>
            <p class="ar-err" data-derr="nome" aria-live="polite"></p>
            <label class="ar-field">Telefono <input name="telefono" type="tel" autocomplete="tel" required data-label="Telefono" /></label>
            <p class="ar-err" data-derr="telefono" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--ghost" data-dback>Indietro</button><button type="submit" class="ar-btn">Invia su WhatsApp</button></div>
            <p class="ar-small">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design, non a un'impresa.</p>
          </fieldset>
        </form>
      </div>
    </section>

    <footer class="ar-foot">
      <div class="ar-wrap">
        <div class="ar-foot__top">
          <p class="ar-foot__logo">ARCADI<small>Ristrutturazioni</small></p>
          <a class="ar-btn" href="#preventivo">Chiedi un preventivo</a>
        </div>
        <div class="ar-foot__cols">
          <p class="ar-foot__tag">Bagni, cucine e appartamenti a Milano. Bene, e nei tempi detti.</p>
          <div>
            <p class="ar-foot__h">Il sito</p>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.t}</a></li>)}</ul>
          </div>
          <div>
            <p class="ar-foot__h">Contatti</p>
            <ul>
              <li><a href={tel}>Chiama</a></li>
              <li><a href="#preventivo">Preventivo in 3 domande</a></li>
            </ul>
          </div>
        </div>
        <p class="ar-foot__note">Arcadi Ristrutturazioni è un'attività inventata. Progetto dimostrativo di Focus Design.</p>
      </div>
    </footer>

    <a class="ar-sticky" href={tel}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>
      Chiama ora
    </a>
  </div>
</Demo>

<style is:global>
  /* Arcadi's own typeface (the demo is a different business from Focus Design). */
  @font-face {
    font-family: "Archivo";
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    src: url("/fonts/archivo-latin.woff2") format("woff2-variations"), url("/fonts/archivo-latin.woff2") format("woff2");
  }
  body.demo {
    --font-head: "Archivo", "Archivo Fallback", Arial, sans-serif;
    --font: var(--font-head);
  }
</style>
<style>
  .ar {
    --o: #c4510e;
    --ink: #1d1f21;
    --grey: #e4e4e0;
    background: #f2f2f0;
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 18px;
    line-height: 1.55;
    padding-bottom: 80px;
  }
  @media (min-width: 900px) {
    .ar {
      padding-bottom: 0;
    }
  }
  .ar :global(.ar-hero) {
    min-height: auto;
  }
  /* Header and hero: the bathroom renovates itself behind an orange line as the page opens. */
  /* ---------- Header: see-through over the hero, white once the page moves ---------- */
  .ar-top {
    color: #fff;
  }
  .ar-top.is-solid {
    background: rgba(242, 242, 240, 0.97);
    color: var(--ink);
    box-shadow: 0 1px 0 #d9d9d4;
  }
  .ar-top__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 70px;
  }
  .ar-logo {
    font-weight: 900;
    font-stretch: 75%;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
  }
  .ar-logo small {
    display: block;
    font-size: 0.55em;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0.04em;
    color: #ff8a4c;
  }
  .ar-top.is-solid .ar-logo small {
    color: #a8430b;
  }
  .ar-nav-main {
    display: none;
    gap: 1.6rem;
  }
  .ar-nav-main a {
    color: inherit;
    text-decoration: none;
    font-weight: 650;
    font-size: 0.98rem;
    padding: 0.6rem 0;
    background: linear-gradient(var(--o), var(--o)) 0 calc(100% - 0.3rem) / 0 3px no-repeat;
    transition: background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ar-nav-main a:hover {
    background-size: 100% 3px;
  }
  .ar-top__quote {
    display: none;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 4px;
    border: 2px solid currentColor;
    color: inherit;
    font-weight: 750;
    text-decoration: none;
  }
  .ar-top__call {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 4px;
    background: var(--o);
    color: #fff;
    font-weight: 750;
    text-decoration: none;
  }
  .ar-burger {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .ar-burger__lines {
    display: grid;
    gap: 7px;
    width: 24px;
  }
  .ar-burger__lines i {
    display: block;
    height: 2.5px;
    background: currentColor;
    transition: transform 0.35s ease;
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:first-child {
    transform: translateY(4.75px) rotate(45deg);
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:last-child {
    transform: translateY(-4.75px) rotate(-45deg);
  }
  @media (min-width: 1000px) {
    .ar-nav-main,
    .ar-top__quote {
      display: inline-flex;
    }
    .ar-burger {
      display: none;
    }
  }
  .ar-menu {
    position: fixed;
    inset: 0;
    z-index: 85;
    display: grid;
    align-content: center;
    gap: 2.5rem;
    padding: 6rem clamp(24px, 8vw, 48px) 3rem;
    background: var(--ink);
    color: #fff;
  }
  .ar-menu nav {
    display: grid;
    gap: 0.25rem;
  }
  .ar-menu nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 900;
    font-stretch: 72%;
    font-size: clamp(2.6rem, 12vw, 3.6rem);
    line-height: 1.1;
  }
  .ar-menu .ar-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  :global(.dm-menu-open) .ar-top {
    color: #fff;
    background: transparent;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-menu:not([hidden]) {
      animation: ar-menu 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes ar-menu {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
  .ar-hero2 {
    position: relative;
    display: grid;
    overflow: hidden;
    background: #2a2622;
  }
  .ar-hero2__media,
  .ar-hero2__text {
    grid-area: 1 / 1;
  }
  .ar-hero2__media {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
  }
  .ar-hero2__media :global(.ar-hero2__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  .ar-hero2__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(20, 18, 16, 0.7) 0%, rgba(20, 18, 16, 0) 22%),
      linear-gradient(90deg, rgba(20, 18, 16, 0.86) 0%, rgba(20, 18, 16, 0.6) 38%, rgba(20, 18, 16, 0.05) 70%);
  }
  @media (max-width: 899px) {
    .ar-hero2__media::after {
      background: linear-gradient(0deg, rgba(20, 18, 16, 0.94) 0%, rgba(20, 18, 16, 0.8) 50%, rgba(20, 18, 16, 0.55) 72%, rgba(20, 18, 16, 0) 94%);
    }
  }
  /* The line rides a full-width track moved by transform: no layout shift. */
  .ar-hero2__track {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    transform: translateX(100%);
  }
  .ar-hero2__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    margin-left: -2px;
    background: #ff6a1f;
    box-shadow: 0 0 30px 8px rgba(255, 106, 31, 0.55);
    opacity: 0;
  }
  .ar-hero2__tag {
    position: absolute;
    top: 1.25rem;
    z-index: 3;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    background: rgba(29, 31, 33, 0.85);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    opacity: 0;
  }
  .ar-hero2__tag--prima {
    right: 1.25rem;
  }
  .ar-hero2__tag--dopo {
    right: 1.25rem;
    background: var(--o);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-hero2__media :global(.ar-hero2__after) {
      animation: ar-wipe 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero2__track {
      animation: ar-track 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero2__line {
      animation: ar-line 2.2s linear 0.9s both;
    }
    .ar-hero2__tag--prima {
      animation: ar-tag-out 3.2s ease both;
    }
    .ar-hero2__tag--dopo {
      animation: ar-tag-in 0.5s ease 3s both;
    }
    .ar-hero2__media :global(.ar-hero2__img:not(.ar-hero2__after)) {
      animation: ar-zoom 6s ease-out both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ar-hero2__tag--dopo {
      opacity: 1;
    }
  }
  @keyframes ar-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes ar-track {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes ar-line {
    0%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ar-tag-out {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ar-tag-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes ar-zoom {
    from {
      transform: scale(1.08);
    }
  }
