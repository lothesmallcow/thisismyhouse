<script>
  import { initDemoForms } from "../../../scripts/demo-form";
  initDemoForms();
  const sticky = document.querySelector<HTMLElement>(".ar-sticky");
  const hero = document.querySelector<HTMLElement>(".ar-hero2");
  if (sticky && hero) new IntersectionObserver(([e]) => sticky.classList.toggle("is-on", !e.isIntersecting), { rootMargin: "-40% 0px 0px 0px" }).observe(hero);

  // Services (wide screens): the item in the middle of the screen, or under the mouse, shows its picture.
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-svc]"));
  const pics = Array.from(document.querySelectorAll<HTMLElement>("[data-svc-pic]"));
  const show = (i: number) => {
    items.forEach((el, j) => el.classList.toggle("is-on", i === j));
    pics.forEach((el, j) => el.classList.toggle("is-on", i === j));
  };
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && show(Number((e.target as HTMLElement).dataset.svc))),
    { rootMargin: "-45% 0px -45% 0px" },
  );
  items.forEach((el) => {
    io.observe(el);
    el.addEventListener("pointerenter", () => show(Number(el.dataset.svc)));
  });

  // How we work: the orange rail fills as the steps scroll past.
  const rail = document.querySelector<HTMLElement>("[data-how-rail]");
  if (rail && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    let ticking = false;
    const fill = () => {
      ticking = false;
      const r = rail.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.65 - r.top) / r.height));
      rail.style.setProperty("--p", p.toFixed(3));
    };
    addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(fill);
      }
    }, { passive: true });
    fill();
  } else if (rail) rail.style.setProperty("--p", "1");
</script>
