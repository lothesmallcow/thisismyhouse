</style>
<script>
  import { initDemoForms } from "../../../scripts/demo-form";
  initDemoForms();
  const sticky = document.querySelector<HTMLElement>(".ar-sticky");
  const hero = document.querySelector<HTMLElement>(".ar-hero");
  if (sticky && hero) new IntersectionObserver(([e]) => sticky.classList.toggle("is-on", !e.isIntersecting), { rootMargin: "-40% 0px 0px 0px" }).observe(hero);
  // Services: the line the pointer is on picks the big picture (decorative; on phones every
  // service shows its own picture).
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-svc]"));
  const shots = Array.from(document.querySelectorAll<HTMLElement>("[data-shot]"));
  const pick = (i: number) => {
    items.forEach((el, k) => el.classList.toggle("is-on", k === i));
    shots.forEach((el, k) => el.classList.toggle("is-on", k === i));
  };
  items.forEach((el, i) => el.addEventListener("pointerenter", () => pick(i)));
</script>
