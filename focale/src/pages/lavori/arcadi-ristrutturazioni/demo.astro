  /* ================= Studio look =================
     A renovation firm that wants to look like an architecture practice: stone and ink, one
     rust accent used sparingly, lighter type, hairlines, square buttons, quieter pictures. */
  .ar {
    --o: #9a3c16;
    --o-soft: #d98a63;
    --ink: #171717;
    --stone: #ecebe6;
    --stone-2: #e2e0d9;
    --line: #cdcac2;
    background: var(--stone);
    letter-spacing: -0.005em;
  }
  .ar :global(img) {
    filter: saturate(0.85) contrast(1.04) brightness(1.01);
  }
  /* Before in black and white, after in colour: the portfolio convention of architecture
     studios, and it reads as a choice rather than as a drawing. */
  .ar :global(.ba__media > .ba__img),
  .ar .ar-hero2__media :global(.ar-hero2__img:not(.ar-hero2__after)) {
    filter: grayscale(1) sepia(0.14) contrast(1.06) brightness(1.03);
  }
  .ar h2 {
    font-weight: 450;
    font-stretch: 100%;
    font-size: clamp(2.3rem, 1.4rem + 3vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .ar h3 {
    font-weight: 550;
    font-stretch: 100%;
    letter-spacing: -0.02em;
  }
  .ar .ar-lead {
    color: #4a4a48;
    font-size: 1.15rem;
  }
  /* Header */
  .ar .ar-logo {
    font-weight: 700;
    font-stretch: 100%;
    font-size: 1.05rem;
    letter-spacing: 0.34em;
  }
  .ar .ar-logo small {
    font-weight: 450;
    letter-spacing: 0.08em;
    font-size: 0.72em;
    margin-top: 0.35rem;
    color: inherit;
    opacity: 0.75;
  }
  .ar .ar-nav-main a {
    font-weight: 450;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
  }
  .ar .ar-nav-main a:hover {
    background-size: 100% 1px;
  }
  .ar .ar-top__quote {
    border-width: 1px;
    border-radius: 0;
    font-weight: 500;
  }
  .ar .ar-top__call {
    border-radius: 0;
    font-weight: 500;
    background: var(--o);
  }
  .ar .ar-menu nav a {
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: -0.03em;
  }
  /* Hero: room for the fixed header above the text (.ar-wrap would reset the padding) */
  .ar .ar-hero2__text {
    padding-top: calc(var(--banner) + 96px);
    padding-bottom: 3rem;
  }
  .ar .ar-hero2__kicker {
    color: #e9c3ad;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .ar .ar-hero2__text h1 {
    font-weight: 500;
    font-stretch: 100%;
    font-size: clamp(2.7rem, 1.2rem + 5vw, 6.2rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 13ch;
  }
  .ar .ar-hero2__btn {
    border-radius: 0;
    font-weight: 500;
    background: #fff;
    color: var(--ink);
  }
  .ar .ar-hero2__btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.8);
  }
  .ar .ar-hero2__chips {
    gap: 0.4rem 2rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
