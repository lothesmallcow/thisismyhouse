---
/**
 * Arcadi Ristrutturazioni (invented): direction "Il cartello di cantiere".
 * Document/catalogue archetype taken from the trade's own objects: the construction-site sign
 * with its fixed rows (the hero), the itemised written quote (the working phases), the job
 * catalogue (works with zone and days), the letterhead (footer). One superfamily, Archivo
 * (condensed headings, normal-width text), IBM Plex Mono only for real data. Plaster grey,
 * white, ink and one accent: minio, the red-orange primer. Zero radius, no shadows.
 */
import Demo from "../../../layouts/Demo.astro";
import BeforeAfter from "../../../components/demo/BeforeAfter.astro";
import { Image } from "astro:assets";
import { site } from "../../../config/site";
import { telHref, isPlaceholder } from "../../../lib/util";

const img = import.meta.glob<{ default: ImageMetadata }>("../../../assets/demo/arcadi-ristrutturazioni/*.jpg", { eager: true });
const pic = (n: string) => img[`../../../assets/demo/arcadi-ristrutturazioni/${n}.jpg`].default;

const services = [
  { t: "Bagni completi", d: "Dallo smontaggio alle piastrelle, impianti compresi. Di solito in due settimane.", img: "bagno-dopo" },
  { t: "Cucine", d: "Impianti, muri, pavimenti e montaggio dei mobili, con un solo referente.", img: "cucina-dopo" },
  { t: "Appartamenti chiavi in mano", d: "Progetto, pratiche e cantiere: ti consegniamo la casa pronta da abitare.", img: "soggiorno-dopo" },
  { t: "Infissi e serramenti", d: "Finestre nuove che isolano davvero, posate in giornata.", img: "infissi-dopo" },
];
const works = [
  { b: "bagno-prima", a: "bagno-dopo", tipo: "Bagno", zona: "Lambrate", giorni: 9, c: "Bagno, zona Lambrate, 9 giorni di lavoro", alt: "bagno in zona Lambrate" },
  { b: "cucina-prima", a: "cucina-dopo", tipo: "Cucina", zona: "Città Studi", giorni: 12, c: "Cucina, zona Città Studi, 12 giorni di lavoro", alt: "cucina in zona Città Studi" },
  { b: "soggiorno-prima", a: "soggiorno-dopo", tipo: "Soggiorno", zona: "NoLo", giorni: 15, c: "Soggiorno, NoLo, 15 giorni di lavoro", alt: "soggiorno a NoLo" },
  { b: "infissi-prima", a: "infissi-dopo", tipo: "Finestre", zona: "Porta Romana", giorni: 1, c: "Finestre, Porta Romana, 1 giorno di lavoro", alt: "finestre a Porta Romana" },
  { b: "vasca-prima", a: "vasca-dopo", tipo: "Bagno con vasca", zona: "Isola", giorni: 10, c: "Bagno con vasca, Isola, 10 giorni di lavoro", alt: "bagno con vasca all'Isola" },
  { b: "camera-prima", a: "camera-dopo", tipo: "Camera", zona: "Sesto San Giovanni", giorni: 7, c: "Camera, Sesto San Giovanni, 7 giorni di lavoro", alt: "camera a Sesto San Giovanni" },
];
const how = [
  { t: "Sopralluogo", d: "Veniamo a vedere entro 48 ore, gratis. Misuriamo e ascoltiamo." },
  { t: "Preventivo scritto", d: "Voce per voce, con i tempi. Quello che firmi è quello che paghi." },
  { t: "Cantiere pulito e puntuale", d: "Proteggiamo pavimenti e mobili, puliamo ogni sera, ti aggiorniamo ogni venerdì." },
  { t: "Consegna e garanzia", d: "Controlliamo tutto insieme. Due anni di garanzia sui lavori." },
];
const nav = [
  { href: "#servizi", t: "Servizi" },
  { href: "#lavori", t: "Lavori" },
  { href: "#come-lavoriamo", t: "Come lavoriamo" },
  { href: "#zone", t: "Zone" },
  { href: "#preventivo", t: "Preventivo" },
];
const zones = ["Città Studi", "Lambrate", "NoLo", "Porta Romana", "Navigli", "Isola", "Sesto San Giovanni"];
// The site sign: the firm's standing facts (they used to be a separate row of big numbers).
const sign = [
  { k: "Lavori", v: "Bagni, cucine, appartamenti, infissi" },
  { k: "Sopralluogo", v: "Entro 48 ore, gratuito" },
  { k: "Preventivo", v: "Scritto, voce per voce" },
  { k: "Garanzia", v: "2 anni sui lavori" },
  { k: "Zona", v: `Milano e prima cintura, ${zones.length} zone` },
  { k: "Referente", v: "Uno solo, dal preventivo alla consegna" },
];
// Demo: calls and messages go to Focus Design, never to a real business.
const tel = telHref();
const hasPhone = !isPlaceholder(site.phoneDisplay);
const phoneLabel = hasPhone ? site.phoneDisplay : "Chiama ora";
const waHref = `https://wa.me/${site.whatsappNumber}`;
const address = "Via Esempio 8, 20133 Milano";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const reviewsHref = "https://search.google.com/local/reviews?placeid=ESEMPIO";
const ld = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: "Arcadi Ristrutturazioni (attività dimostrativa)",
  address: { "@type": "PostalAddress", streetAddress: "Via Esempio 8", postalCode: "20133", addressLocality: "Milano", addressCountry: "IT" },
  areaServed: zones.map((z) => ({ "@type": "Place", name: z })),
};
---
<Demo
  title="Arcadi Ristrutturazioni | Ristrutturazioni a Milano (demo)"
  description="Sito dimostrativo di Focus Design per un'impresa di ristrutturazioni inventata a Milano."
  themeColor="#e4e3df"
  fonts={["/fonts/demo/archivo-wdth-wght.woff2", "/fonts/demo/plex-mono-400.woff2", "/fonts/demo/plex-mono-500.woff2"]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="ar">
    <header class="ar-top" data-dh>
      <div class="ar-wrap ar-top__in">
        <a class="ar-name" href="#">Arcadi <span>Ristrutturazioni</span></a>
        <nav class="ar-nav-main" aria-label="Menu">
          {nav.map((n) => <a href={n.href}>{n.t}</a>)}
        </nav>
        <a class="ar-top__tel" href={tel}>
          {hasPhone && <span class="ar-top__k">Tel.</span>}
          <span>{phoneLabel}</span>
        </a>
        <button type="button" class="ar-burger" data-menu aria-controls="ar-menu" aria-expanded="false">
          <span class="ar-burger__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </header>
    <div class="ar-menu" id="ar-menu" data-menu-panel hidden>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href}>{n.t}</a>)}
      </nav>
      <div class="ar-menu__cta">
        <a class="ar-btn ar-btn--minio" href="#preventivo">Chiedi un preventivo</a>
        <a class="ar-btn" href={tel}>Chiama ora</a>
      </div>
    </div>

    <section class="ar-hero" aria-labelledby="ar-h1">
      <div class="ar-hero__text">
        <h1 id="ar-h1" data-split="load">Ristrutturiamo case a Milano. Bene, e nei tempi detti.</h1>
        <p class="ar-hero__sub">Quello che firmi nel preventivo è quello che paghi. Il cantiere lo puliamo ogni sera e ti aggiorniamo ogni venerdì.</p>
        <div class="ar-hero__cta">
          <a class="ar-btn ar-btn--minio" href="#preventivo" data-magnetic>Chiedi un preventivo</a>
          <a class="ar-btn" href={tel}>Chiama ora</a>
        </div>
      </div>
      <aside class="ar-sign" aria-labelledby="ar-sign-h">
        <p class="ar-sign__head" id="ar-sign-h"><span>Impresa esecutrice</span> Arcadi Ristrutturazioni</p>
        <dl class="ar-sign__rows">
          {
            sign.map((r) => (
              <div>
                <dt>{r.k}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
      <div class="ar-hero__media" aria-hidden="true">
        <Image src={pic("bagno-prima")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" class="ar-hero__img" />
        <div class="ar-hero__after">
          <Image src={pic("bagno-dopo")} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="ar-hero__img" />
        </div>
        <span class="ar-hero__tag ar-hero__tag--prima">Prima</span>
        <span class="ar-hero__tag ar-hero__tag--dopo">Dopo</span>
      </div>
    </section>

    <section class="ar-sec ar-sec--white" id="servizi" aria-labelledby="h-servizi">
      <div class="ar-wrap ar-svc">
        <div class="ar-svc__side">
          <h2 id="h-servizi" data-split>Cosa facciamo</h2>
          <p class="ar-lead">Dallo smontaggio alla finitura, impianti compresi. Per ogni lavoro hai un preventivo scritto e un solo referente.</p>
          <div class="ar-svc__big">
            <Image src={pic("camera-dopo")} alt="Una camera finita: finestra nuova, pareti chiare e parquet" widths={[480, 800, 1000]} sizes="34vw" />
          </div>
        </div>
        <ul class="ar-svc__list" data-rise-group>
          {
            services.map((s) => (
              <li class="ar-svc__item">
                <div class="ar-svc__pic">
                  <Image src={pic(s.img)} alt="" widths={[240, 480]} sizes="(min-width: 900px) 240px, 104px" />
                </div>
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="ar-sec" id="lavori" aria-labelledby="h-lavori">
      <div class="ar-wrap">
        <div class="ar-doc__head ar-doc__head--jobs">
          <h2 id="h-lavori" data-split>Lavori finiti, prima e dopo</h2>
          <p class="ar-lead">Sei cantieri chiusi. Trascina la linea su ogni foto per confrontare.</p>
        </div>
        <ol class="ar-jobs d-more">
          {
            works.map((w) => (
              <li class="ar-job">
                <div class="ar-job__meta">
                  <h3>{w.tipo}</h3>
                  <dl class="ar-job__data">
                    <div>
                      <dt>Zona</dt>
                      <dd>{w.zona}</dd>
                    </div>
                    <div>
                      <dt>Durata</dt>
                      <dd>{w.giorni} {w.giorni === 1 ? "giorno" : "giorni"}</dd>
                    </div>
                  </dl>
                </div>
                <BeforeAfter before={pic(w.b)} after={pic(w.a)} caption={w.c} alt={w.alt} />
              </li>
            ))
          }
        </ol>
        <button type="button" class="d-more-btn ar-btn ar-more">Altri {works.length - 3} lavori</button>
      </div>
    </section>

    <section class="ar-sec ar-sec--white" id="come-lavoriamo" aria-labelledby="h-come">
      <div class="ar-wrap">
        <div class="ar-doc__head ar-doc__head--fasi">
          <h2 id="h-come" data-split>Come lavoriamo</h2>
          <p class="ar-lead">Quattro fasi, sempre le stesse. Sai sempre a che punto siamo.</p>
        </div>
        <ol class="ar-fasi" data-rise-group>
          {
            how.map((h, i) => (
              <li>
                <span class="ar-fasi__n">Fase {i + 1}</span>
                <h3>{h.t}</h3>
                <p>{h.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ar-sec" id="zone" aria-labelledby="h-zone">
      <div class="ar-wrap ar-zone">
        <div class="ar-doc__head ar-doc__head--zone">
          <h2 id="h-zone" data-split>Dove lavoriamo</h2>
          <p class="ar-lead">Milano e prima cintura, {zones.length} zone.</p>
        </div>
        <ul class="ar-zones" aria-label="Le zone">{zones.map((z) => <li>{z}</li>)}</ul>
        <p class="ar-zone__note">
          <span>Sede: {address}.</span>
          <span>Sopralluogo gratuito in tutte le zone.</span>
          <a href={mapsHref}>Come arrivare</a>
        </p>
      </div>
    </section>

    <section class="ar-sec ar-sec--white" id="preventivo" aria-labelledby="h-prev">
      <div class="ar-wrap ar-quote-grid">
        <div class="ar-quote-side">
          <h2 id="h-prev" data-split>Chiedi un preventivo</h2>
          <p class="ar-lead">Tre domande. Ti rispondiamo su WhatsApp in giornata, con un giorno per il sopralluogo.</p>
          <dl class="ar-quote-alt">
            <div>
              <dt>Preferisci parlare?</dt>
              <dd><a href={tel}>{phoneLabel}</a></dd>
            </div>
            <div>
              <dt>O scrivere?</dt>
              <dd><a href={waHref} target="_blank" rel="noopener">WhatsApp</a></dd>
            </div>
          </dl>
        </div>
        <form class="ar-form" data-demo-form data-wa={site.whatsappNumber} data-heading="Richiesta di preventivo dal sito" data-err="Completa questo campo per continuare." novalidate>
          <p class="ar-form__progress" data-dprogress data-tpl="Passo {n} di 3">Passo 1 di 3</p>
          <fieldset data-dstep>
            <legend tabindex="-1">Che lavoro devi fare?</legend>
            <div class="ar-opts">
              {["Bagno", "Cucina", "Appartamento", "Infissi", "Altro"].map((o) => (
                <label class="ar-opt"><input type="radio" name="lavoro" value={o} data-label="Lavoro" required /><span>{o}</span></label>
              ))}
            </div>
            <p class="ar-err" data-derr="lavoro" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn ar-btn--minio" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">Dove e quanto?</legend>
            <label class="ar-field">Zona
              <select name="zona" data-label="Zona" required>
                <option value="">Scegli la zona</option>
                {zones.map((z) => <option>{z}</option>)}
                <option>Altra zona</option>
              </select>
            </label>
            <p class="ar-err" data-derr="zona" aria-live="polite"></p>
            <label class="ar-field">Metratura indicativa, in metri quadri
              <input name="metratura" type="number" inputmode="numeric" min="1" max="1000" required data-label="Metratura" />
            </label>
            <p class="ar-err" data-derr="metratura" aria-live="polite"></p>
            <fieldset class="ar-sub">
              <legend>Quando vorresti iniziare?</legend>
              <div class="ar-opts">
                {["Entro 1 mese", "Entro 3 mesi", "Più avanti"].map((o) => (
                  <label class="ar-opt"><input type="radio" name="inizio" value={o} data-label="Inizio" required /><span>{o}</span></label>
                ))}
              </div>
              <p class="ar-err" data-derr="inizio" aria-live="polite"></p>
            </fieldset>
            <div class="ar-nav"><button type="button" class="ar-btn" data-dback>Indietro</button><button type="button" class="ar-btn ar-btn--minio" data-dnext>Avanti</button></div>
          </fieldset>
          <fieldset data-dstep>
            <legend tabindex="-1">A chi rispondiamo?</legend>
            <label class="ar-field">Nome <input name="nome" type="text" autocomplete="given-name" required data-label="Nome" /></label>
            <p class="ar-err" data-derr="nome" aria-live="polite"></p>
            <label class="ar-field">Telefono <input name="telefono" type="tel" autocomplete="tel" required data-label="Telefono" /></label>
            <p class="ar-err" data-derr="telefono" aria-live="polite"></p>
            <div class="ar-nav"><button type="button" class="ar-btn" data-dback>Indietro</button><button type="submit" class="ar-btn ar-btn--minio">Invia su WhatsApp</button></div>
            <p class="ar-small">Si apre WhatsApp con il messaggio già scritto. Questo è un sito dimostrativo: il messaggio arriva a Focus Design, non a un'impresa.</p>
          </fieldset>
        </form>
      </div>
    </section>

    <footer class="ar-foot">
      <div class="ar-wrap ar-foot__in">
        <p class="ar-foot__name">Arcadi Ristrutturazioni</p>
        <dl class="ar-foot__data">
          <div>
            <dt>Sede</dt>
            <dd>{address}</dd>
          </div>
          <div>
            <dt>Telefono</dt>
            <dd><a href={tel}>{phoneLabel}</a></dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><a href={waHref} target="_blank" rel="noopener">Scrivici</a></dd>
          </div>
          <div>
            <dt>Mappa</dt>
            <dd><a href={mapsHref}>Come arrivare</a></dd>
          </div>
          <div>
            <dt>Recensioni</dt>
            <dd><a href={reviewsHref}>Su Google</a></dd>
          </div>
          <div>
            <dt>Partita IVA</dt>
            <dd>00000000000</dd>
          </div>
        </dl>
        <p class="ar-foot__note">Arcadi Ristrutturazioni è un'attività inventata: indirizzo e partita IVA sono d'esempio. Progetto dimostrativo di Focus Design. <a href="/privacy/">Informativa privacy</a></p>
      </div>
    </footer>

    <a class="ar-sticky" href={tel}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5.5 3.5h3l1.5 4.25-2 1.25a11 11 0 0 0 7 7l1.25-2 4.25 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z"></path></svg>
      Chiama ora
    </a>
  </div>
</Demo>

<style is:global>
  /* Arcadi's own type: one superfamily (Archivo, width and weight axes) plus a mono for data. */
  @font-face {
    font-family: "Archivo Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    src: url("/fonts/demo/archivo-wdth-wght.woff2") format("woff2-variations"), url("/fonts/demo/archivo-wdth-wght.woff2") format("woff2");
  }
  @font-face {
    font-family: "Plex Mono Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url("/fonts/demo/plex-mono-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "Plex Mono Arcadi";
    font-style: normal;
    font-display: swap;
    font-weight: 500;
    src: url("/fonts/demo/plex-mono-500.woff2") format("woff2");
  }
  body.demo {
    --font-head: "Archivo Arcadi", "Arial Narrow", Arial, sans-serif;
    --font: var(--font-head);
    background: #e4e3df;
  }
  /* Anchors land under the banner and the ruled header strip. */
  html {
    scroll-padding-top: 120px;
  }
</style>
<style>
  /* ================= Tokens ================= */
  .ar {
    --intonaco: #e4e3df; /* plaster: the page surface */
    --bianco: #ffffff; /* the sign, the quote sheet */
    --inchiostro: #151515; /* text and rules */
    --grafite: #46464a; /* secondary text: 7.1:1 on plaster, 9.4:1 on white */
    --riga: #b3b1aa; /* hairlines */
    --minio: #c8461c; /* minium primer: button fills, white text 4.8:1 */
    --minio-hover: #ad3b16;
    --minio-scuro: #9e3412; /* minio for small text: 5.5:1 on plaster, 7.1:1 on white */
    --mono: "Plex Mono Arcadi", ui-monospace, "SFMono-Regular", Menlo, monospace;
    --pad: clamp(18px, 4.5vw, 40px);
    --max: 1240px;
    --sec: clamp(48px, 5vw, 72px); /* two sections meet with at most 144 px of empty band */
    --top-h: 56px;
    background: var(--intonaco);
    color: var(--inchiostro);
    font-family: var(--font-head);
    font-size: 18px;
    font-weight: 400;
    font-stretch: 100%;
    line-height: 1.55;
    letter-spacing: 0;
  }
  @media (max-width: 899px) {
    .ar {
      padding-bottom: 64px; /* room for the call bar */
      font-size: 17px;
    }
  }
  .ar ::selection {
    background: var(--minio);
    color: var(--bianco);
  }
  .ar :focus-visible {
    outline: 3px solid var(--minio-scuro);
    outline-offset: 2px;
    border-radius: 0;
  }
  .ar-wrap {
    max-width: calc(var(--max) + 2 * var(--pad));
    margin: 0 auto;
    padding-inline: max(var(--pad), env(safe-area-inset-left)) max(var(--pad), env(safe-area-inset-right));
  }
  .ar h1,
  .ar h2,
  .ar h3,
  .ar legend {
    font-family: var(--font-head);
    font-stretch: 75%;
    letter-spacing: -0.005em;
    color: var(--inchiostro);
  }
  .ar h2 {
    font-weight: 800;
    font-size: clamp(2.25rem, 1.3rem + 3vw, 4.25rem);
    line-height: 0.98;
  }
  .ar h3 {
    font-weight: 700;
    font-size: clamp(1.45rem, 1.1rem + 0.9vw, 2rem);
    line-height: 1.05;
  }
  .ar-sec {
    padding-block: var(--sec);
  }
  .ar-sec--white {
    background: var(--bianco);
  }
  .ar-lead {
    margin-top: 1rem;
    max-width: 44ch;
    color: var(--grafite);
    font-size: 1.125rem;
  }

  /* ================= Buttons: rectangles, solid ink or solid minio ================= */
  .ar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 1.35rem;
    border: 0;
    border-radius: 0;
    background: var(--inchiostro);
    color: var(--bianco);
    font: inherit;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .ar-btn--minio {
    background: var(--minio);
  }
  @media (hover: hover) and (pointer: fine) {
    .ar-btn:hover {
      background: #333;
    }
    .ar-btn--minio:hover {
      background: var(--minio-hover);
    }
  }
  @media (hover: none), (pointer: coarse) {
    .ar-btn:active {
      transform: scale(0.98);
    }
  }

  /* ================= Header: a thin ruled strip ================= */
  .ar-top {
    background: var(--intonaco);
    border-bottom: 2px solid var(--inchiostro);
  }
  .ar-top__in {
    display: flex;
    align-items: stretch;
    min-height: var(--top-h);
  }
  .ar-name {
    display: flex;
    align-items: center;
    gap: 0.3em;
    margin-right: auto;
    font-stretch: 72%;
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1;
    color: var(--inchiostro);
    text-decoration: none;
    white-space: nowrap;
  }
  .ar-name span {
    font-weight: 500;
  }
  .ar-nav-main {
    display: none;
    align-items: stretch;
  }
  .ar-nav-main a {
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    color: var(--inchiostro);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    background: linear-gradient(var(--minio), var(--minio)) 50% 100% / 0 4px no-repeat;
    transition: background-size 0.3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ar-nav-main a:hover {
      background-size: calc(100% - 1.8rem) 4px;
    }
  }
  .ar-top__tel {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 0 0 0.9rem;
    margin-left: 0.4rem;
    border-left: 1px solid var(--inchiostro);
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--inchiostro);
    text-decoration: none;
    white-space: nowrap;
  }
  .ar-top__k {
    color: var(--grafite);
    font-weight: 400;
  }
  .ar-burger {
    display: grid;
    place-items: center;
    width: 48px;
    margin-left: 0.6rem;
    margin-right: -6px;
    border: 0;
    border-left: 1px solid var(--inchiostro);
    background: transparent;
    color: var(--inchiostro);
    cursor: pointer;
  }
  .ar-burger__lines {
    display: grid;
    gap: 7px;
    width: 22px;
  }
  .ar-burger__lines i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }
  .ar-burger[aria-expanded="true"] .ar-burger__lines i:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-burger__lines i {
      transition: transform 0.3s ease;
    }
  }
  @media (max-width: 420px) {
    .ar-name {
      font-size: 1.2rem;
    }
    .ar-top__tel {
      font-size: 0.875rem;
      padding-left: 0.7rem;
    }
  }
  @media (min-width: 1060px) {
    .ar-nav-main {
      display: flex;
    }
    .ar-burger {
      display: none;
    }
    .ar-top__tel {
      padding-left: 1.25rem;
      margin-left: 0.9rem;
    }
  }
  /* Phone menu: the same ruled sheet, big condensed entries. */
  .ar-menu {
    position: fixed;
    inset: 0;
    z-index: 85;
    display: grid;
    align-content: start;
    gap: 2rem;
    padding: calc(var(--banner) + var(--top-h) + 1.5rem) var(--pad) 2rem;
    background: var(--intonaco);
    color: var(--inchiostro);
    overflow-y: auto;
  }
  .ar-menu nav {
    display: grid;
    border-top: 2px solid var(--inchiostro);
  }
  .ar-menu nav a {
    display: block;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--inchiostro);
    color: inherit;
    text-decoration: none;
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(2rem, 9vw, 2.75rem);
    line-height: 1.1;
  }
  .ar-menu__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar-menu:not([hidden]) {
      animation: ar-menu 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes ar-menu {
      from {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }

  /* ================= Hero: text, the site sign, and the photo it is hung on ================= */
  .ar-hero {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--pad), 1fr)
      [in-start] minmax(0, 700px)
      [mid] minmax(0, 540px)
      [in-end] minmax(var(--pad), 1fr)
      [full-end];
    padding-top: calc(var(--banner) + var(--top-h) + clamp(28px, 4.5vw, 64px));
  }
  .ar-hero__text {
    grid-column: in-start / mid;
    grid-row: 1;
    padding-right: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(32px, 3vw, 44px);
  }
  .ar .ar-hero__text h1 {
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(2.5rem, 1.1rem + 4.4vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.01em;
    max-width: 17ch;
  }
  .ar-hero__sub {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: 1.1875rem;
    color: var(--grafite);
  }
  .ar-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  /* The sign: white board, thick black frame, fixed rows like the ones on site hoardings. */
  /* It hangs over the top of the photo by --hang, like a sign fixed to the site hoarding. */
  .ar-sign {
    --hang: clamp(56px, 7vw, 112px);
    grid-column: mid / in-end;
    grid-row: 1;
    align-self: end;
    margin-bottom: calc(-1 * var(--hang));
    position: relative;
    z-index: 2;
    background: var(--bianco);
    border: 8px solid var(--inchiostro);
  }
  .ar-sign__head {
    padding: 1.1rem 1.4rem 1.25rem;
    background: var(--inchiostro);
    color: var(--bianco);
    font-weight: 800;
    font-stretch: 72%;
    font-size: clamp(1.75rem, 1.1rem + 1.6vw, 2.75rem);
    line-height: 1;
  }
  .ar-sign__head span {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--mono);
    font-weight: 400;
    font-stretch: 100%;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: #d9d8d3;
  }
  .ar-sign__rows {
    margin: 0;
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1.4;
  }
  .ar-sign__rows div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
  }
  .ar-sign__rows div + div {
    border-top: 1px solid var(--inchiostro);
  }
  .ar-sign__rows dt {
    padding: 1.15rem 0.75rem 1.15rem 1.4rem;
    border-right: 1px solid var(--inchiostro);
    font-weight: 400;
    color: var(--grafite);
  }
  .ar-sign__rows dd {
    margin: 0;
    padding: 1.15rem 1.4rem 1.15rem 0.9rem;
    font-weight: 500;
  }
  .ar-hero__media {
    grid-column: full-start / full-end;
    grid-row: 2;
    position: relative;
    height: clamp(300px, 36vw, 560px);
    overflow: hidden;
    background: #cfcdc7;
  }
  .ar-hero__media :global(.ar-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .ar-hero__after {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* The minio line rides the left edge of the "after" window as it slides in. */
  .ar-hero__after::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    width: 5px;
    background: var(--minio);
    opacity: 0;
  }
  .ar-hero__tag {
    position: absolute;
    left: var(--pad);
    bottom: 1rem;
    z-index: 3;
    padding: 0.3rem 0.6rem;
    background: var(--inchiostro);
    color: var(--bianco);
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8125rem;
  }
  .ar-hero__tag--dopo {
    background: var(--minio-scuro);
  }
  @media (min-width: 1240px) {
    .ar-hero__tag {
      left: calc((100% - var(--max)) / 2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ar-hero__tag--prima {
      opacity: 0;
    }
  }
  /* Transforms and opacity only: the window slides in while its picture slides back, so the
     bathroom "renovates itself" behind the line without moving. */
  @media (prefers-reduced-motion: no-preference) {
    .ar-hero__after {
      animation: ar-slide 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero__after > :global(.ar-hero__img) {
      animation: ar-slide-back 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.9s both;
    }
    .ar-hero__after::before {
      animation: ar-line 2.4s linear 0.9s both;
    }
    .ar-hero__tag--prima {
      animation: ar-out 0.4s ease 2.9s both;
    }
    .ar-hero__tag--dopo {
      animation: ar-in 0.4s ease 3.1s both;
    }
  }
  @keyframes ar-slide {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes ar-slide-back {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes ar-line {
    0%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ar-out {
    to {
      opacity: 0;
    }
  }
  @keyframes ar-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 899px) {
    .ar-hero {
      grid-template-columns: [full-start] var(--pad) [in-start] minmax(0, 1fr) [in-end] var(--pad) [full-end];
    }
    .ar-hero__text {
      grid-column: in-start / in-end;
      padding-right: 0;
      padding-bottom: 1.75rem;
    }
    .ar-sign {
      grid-column: in-start / in-end;
      grid-row: 2;
      align-self: start;
      margin-bottom: 0;
      border-width: 6px;
    }
    .ar-hero__media {
      grid-row: 3;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-top: -2.5rem; /* the sign overlaps the top of the photo */
    }
  }
  @media (max-width: 599px) {
    .ar-hero__sub {
      font-size: 1.0625rem;
      margin-top: 1.1rem;
    }
    .ar-hero__cta {
      margin-top: 1.4rem;
    }
    .ar-sign__head {
      padding: 0.8rem 1rem 0.9rem;
    }
    .ar-sign__rows {
      font-size: 0.875rem;
    }
    .ar-sign__rows div {
      grid-template-columns: 7.25rem minmax(0, 1fr);
    }
    .ar-sign__rows dt {
      padding: 0.65rem 0.6rem 0.65rem 0.9rem;
    }
    .ar-sign__rows dd {
      padding: 0.65rem 0.9rem 0.65rem 0.7rem;
    }
  }

  /* ================= Services: sticky heading, a ruled list with a picture per line ================= */
  .ar-svc {
    display: grid;
    gap: 2rem;
  }
  .ar-svc > * {
    min-width: 0;
  }
  .ar-svc__big {
    display: none;
  }
  .ar-svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--inchiostro);
  }
  .ar-svc__item {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .ar-svc__pic :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .ar-svc__item p {
    margin-top: 0.35rem;
    color: var(--grafite);
    max-width: 46ch;
  }
  @media (max-width: 599px) {
    .ar-svc__item {
      align-items: start;
    }
    .ar-svc__item p {
      font-size: 1rem;
    }
  }
  @media (min-width: 900px) {
    .ar-svc {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
    /* The side column is as tall as the list: its picture takes whatever height is left. */
    .ar-svc {
      align-items: stretch;
    }
    .ar-svc__side {
      display: flex;
      flex-direction: column;
    }
    .ar-svc__big {
      display: block;
      position: relative;
      flex: 1 1 auto;
      min-height: 240px;
      margin-top: 2rem;
      overflow: hidden;
    }
    .ar-svc__big :global(img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ar-svc__item {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      padding-block: 1.25rem;
    }
    /* Picture about as tall as the name and two lines of text beside it: no empty block in the row. */
    .ar-svc__pic :global(img) {
      aspect-ratio: 16 / 9;
    }
    .ar-svc__item p {
      max-width: none;
    }
  }

  /* ================= Works: a catalogue of jobs, ruled like a table ================= */
  .ar-jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 2px solid var(--inchiostro);
  }
  .ar-job {
    min-width: 0;
    padding-block: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .ar-job__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-bottom: 0.9rem;
  }
  .ar-job__data {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.875rem;
  }
  .ar-job__data div {
    display: flex;
    gap: 0.5em;
  }
  .ar-job__data dt {
    color: var(--grafite);
  }
  .ar-job__data dd {
    margin: 0;
    font-weight: 500;
  }
  /* The slider's caption repeats the row data above it (title, zone, days); the slider's own
     label and picture alts still carry it. */
  .ar-job :global(figcaption) {
    display: none;
  }
  .ar-job :global(.ba__knob) {
    border-radius: 0;
    box-shadow: none;
    border: 2px solid var(--inchiostro);
  }
  .ar-job :global(.ba__line) {
    width: 4px;
    margin-left: -2px;
  }
  .ar-job :global(.ba__tag) {
    border-radius: 0;
    background: var(--inchiostro);
    font-family: var(--mono);
    font-weight: 500;
  }
  .ar-job :global(.ba__media:has(.ba__range:focus-visible)) {
    outline-color: var(--minio-scuro);
  }
  .ar-more {
    margin-top: 1.5rem;
  }
  @media (max-width: 599px) {
    .ar-more {
      width: 100%;
    }
  }
  /* Only on phones, and only while the list is short (Demo.astro adds .is-on). */
  .ar-more:not(:global(.is-on)) {
    display: none;
  }
  @media (min-width: 761px) {
    .ar-more {
      display: none;
    }
  }
  @media (min-width: 761px) {
    .ar-jobs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ar-job:nth-child(odd) {
      padding-right: clamp(1.25rem, 2.5vw, 2rem);
      border-right: 1px solid var(--inchiostro);
    }
    .ar-job:nth-child(even) {
      padding-left: clamp(1.25rem, 2.5vw, 2rem);
    }
  }

  /* ================= How we work: the phases, set like the lines of a written quote ================= */
  /* Section heads: title and note side by side on computers, the note lined up with a column of the
     ruled list below it (the jobs' second column, the phases' description column), so neither half is empty. */
  .ar-doc__head {
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .ar-doc__head {
      display: grid;
      align-items: start;
    }
    .ar-doc__head .ar-lead {
      margin-top: 0;
      padding-top: 0.4em; /* the note's first line sits on the title's first line */
    }
    .ar-doc__head--jobs,
    .ar-doc__head--zone {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(2 * clamp(1.25rem, 2.5vw, 2rem));
    }
    .ar-doc__head--fasi {
      grid-template-columns: 9rem minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 2rem;
    }
    .ar-doc__head--fasi h2 {
      grid-column: 1 / 3;
    }
  }
  .ar-fasi {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 6px solid var(--inchiostro);
  }
  .ar-fasi li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .ar-fasi li:last-child {
    border-bottom-width: 2px;
  }
  .ar-fasi__n {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--minio-scuro);
  }
  .ar-fasi p {
    color: var(--grafite);
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .ar-fasi li {
      grid-template-columns: 9rem minmax(0, 4fr) minmax(0, 7fr);
      gap: 2rem;
      align-items: baseline;
      padding-block: 1.5rem;
    }
    .ar-fasi__n {
      font-size: 0.9375rem;
    }
    .ar-fasi p {
      font-size: 1.125rem;
    }
  }

  /* ================= Zones: one flowing line, no grid to leave half empty ================= */
  .ar-zones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    font-weight: 500;
    font-stretch: 75%;
    font-size: clamp(1.9rem, 1rem + 3vw, 3.75rem);
    line-height: 1.12;
  }
  .ar-zones li {
    white-space: nowrap;
  }
  .ar-zones li:not(:last-child)::after {
    content: ",";
    margin-right: 0.3em;
  }
  .ar-zones li:last-child::after {
    content: ".";
  }
  .ar-zone__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between; /* the ruled line is filled end to end, like a form footer */
    gap: 0 1.5rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-top: 0.75rem;
    border-top: 1px solid var(--inchiostro);
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .ar-zone__note a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--minio-scuro);
    font-weight: 500;
    text-underline-offset: 0.2em;
  }

  /* ================= Quote request ================= */
  .ar-quote-grid {
    display: grid;
    gap: 2rem;
  }
  .ar-quote-grid > * {
    min-width: 0;
  }
  @media (min-width: 900px) {
    .ar-quote-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
  }
  .ar-quote-alt {
    margin: 1.75rem 0 0;
    border-top: 2px solid var(--inchiostro);
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .ar-quote-alt div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    border-bottom: 1px solid var(--inchiostro);
  }
  .ar-quote-alt dt {
    color: var(--grafite);
  }
  .ar-quote-alt dd {
    margin: 0;
  }
  .ar-quote-alt a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--inchiostro);
    font-weight: 500;
    text-underline-offset: 0.2em;
  }
  .ar-form {
    --fpad: clamp(20px, 3vw, 36px);
    display: grid;
    gap: 1rem;
    padding: 0 var(--fpad) var(--fpad);
    background: var(--bianco);
    border: 2px solid var(--inchiostro);
  }
  /* The progress line is the sheet's ink header band, like the head of the site sign. */
  .ar-form__progress {
    margin: 0 calc(-1 * var(--fpad)) 0.5rem;
    padding: 0.7rem var(--fpad);
    background: var(--inchiostro);
    color: var(--bianco);
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
  }
  .ar-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .ar-form legend {
    padding: 0;
    margin-bottom: 0.75rem;
    font-weight: 800;
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem);
    line-height: 1.05;
  }
  :global(.ar-form.is-steps) [data-dstep]:not(.is-current) {
    display: none;
  }
  .ar .ar-sub legend {
    font-family: var(--font-head);
    font-stretch: 100%;
    font-size: 1.0625rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .ar-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ar-opt {
    position: relative;
  }
  /* Phones: options in two equal columns, an odd last one spans both (no ragged half-empty rows). */
  @media (max-width: 599px) {
    .ar-opts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ar-opt:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .ar-opt span {
      display: grid;
      width: 100%;
    }
    .ar-nav > .ar-btn {
      flex: 1 1 0;
    }
