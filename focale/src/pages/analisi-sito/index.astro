---
/**
 * /analisi-sito/: the free Website Scorer. The visitor pastes an address (and may pick a sector);
 * /api/score fetches the page safely, measures speed and returns the report for every sector.
 * The report is drawn by scripts/scorer-ui.ts. It is private: shown only to whoever asked, never
 * published or stored. The only thing saved is the optional request at the end (email + consent).
 * A sample result, computed at build time from an INVENTED old-style studio page, shows how the
 * report looks without running a real analysis (and is what the static preview can show).
 */
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { rubric, fromPartsAll } from "../../scorer/analyze";
import offer from "../../scorer/offer.json";
import benchmark from "../../scorer/benchmark.json";
import { CONSENT } from "../../scorer/consent";
import { breadcrumbs } from "../../lib/schema";
import sampleHtml from "../../../test/scorer/fixtures/old-studio.html?raw";
import goodHtml from "../../../test/scorer/fixtures/new-studio.html?raw";

// Invented page and invented lab numbers, clearly labelled as an example on the page.
const samplePsi = {
  lighthouseResult: {
    lighthouseVersion: "13.0.0",
    audits: {
      "largest-contentful-paint": { numericValue: 5200 },
      "total-blocking-time": { numericValue: 740 },
      "cumulative-layout-shift": { numericValue: 0.18 },
      "total-byte-weight": { numericValue: 4_600_000 },
    },
    categories: { accessibility: { score: 0.71 } },
  },
};
const sample = fromPartsAll("http://www.studio-esempio.it/", sampleHtml, samplePsi, { sector: "fitness", measuredAt: "2026-11-21T09:00:00Z" });
const goodPsi = {
  lighthouseResult: {
    lighthouseVersion: "13.0.0",
    audits: {
      "largest-contentful-paint": { numericValue: 2900 },
      "total-blocking-time": { numericValue: 120 },
      "cumulative-layout-shift": { numericValue: 0.02 },
      "total-byte-weight": { numericValue: 1_400_000 },
    },
    categories: { accessibility: { score: 0.93 } },
  },
};
const sampleGood = fromPartsAll("https://www.studio-esempio-due.it/", goodHtml, goodPsi, { sector: "fitness", measuredAt: "2026-11-21T09:00:00Z" });
const sectors = rubric.sectors.map((s) => ({ id: s.id, label: s.label }));
const checkTitles = [...new Set(rubric.checks.filter((c) => !c.flag).map((c) => c.title))];
const data = { sectors, offer, benchmark, consent: CONSENT, sample, sampleGood, checkTitles, rubricVersion: rubric.version };
const best = (benchmark.templates as unknown as Record<string, { total: number; label: string; path: string }>).fitness;

const checkCount = new Set(rubric.checks.filter((c) => !c.flag).map((c) => c.id)).size;
---
<Base
  title="Analisi gratuita del sito: quanto lavora il tuo sito? | Focus Design"
  description="Incolla l'indirizzo del tuo sito: velocità da telefono, contatti, Google e basi legali, con un punteggio su 100 e le 5 cose da sistemare. Gratis."
  jsonLd={[breadcrumbs([{ name: "Analisi del sito", path: "/analisi-sito/" }])]}
  bodyClass="sc-page"
>
  <PageHead
    label="Analisi del sito"
    title="Quanto lavora il tuo sito? Scoprilo in un minuto."
    lead="Incolla l'indirizzo: controlliamo velocità da telefono, contatti, Google e basi legali, con la stessa griglia che usiamo sui nostri siti. Gratis e senza email: il risultato lo vedi solo tu."
  >
    <div class="sc-mini" slot="visual" aria-label={`Il nostro sito d'esempio per uno studio fitness: ${best.total} su 100`}>
      <p class="sc-mini__k">Il nostro sito d'esempio, misurato con la stessa griglia</p>
      <p class="sc-mini__n"><span>{best.total}</span><small>su 100</small></p>
      <p class="sc-mini__t">{best.label}</p>
      <a class="link" href={best.path}>Guarda il sito d'esempio</a>
    </div>
  </PageHead>

  <section class="section sc-tool" id="analisi" aria-labelledby="sc-tool-t">
    <div class="wrap">
      <h2 id="sc-tool-t" class="sc-visually-hidden">Analizza il tuo sito</h2>
      <form class="sc-form" data-sc-form novalidate>
        <div class="field sc-form__url">
          <label for="sc-url">Indirizzo del sito</label>
          <input id="sc-url" name="url" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder="www.iltuosito.it" required aria-describedby="sc-url-hint sc-error" />
          <p class="hint" id="sc-url-hint">Basta l'indirizzo, anche senza https://</p>
        </div>
        <div class="field sc-form__sector">
          <label for="sc-sector">Settore</label>
          <select id="sc-sector" name="sector">
            <option value="">Lo capiamo noi dalla pagina</option>
            {sectors.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </div>
        <button class="btn btn--primary btn--big sc-form__go" type="submit">Analizza il sito</button>
        <p class="error sc-form__error" id="sc-error" role="alert" data-sc-error></p>
      </form>
      <p class="sc-privacy">Il risultato lo vedi solo tu: non lo pubblichiamo e non salviamo la pagina. Guardiamo solo la pagina che indichi, come la vede chiunque.</p>
      <p class="sc-sample-row">Non hai un sito a portata di mano? Guarda un esempio su un sito inventato:
        <button type="button" class="link sc-linkbtn" data-sc-sample="old">uno vecchio</button> oppure
        <button type="button" class="link sc-linkbtn" data-sc-sample="good">uno quasi a posto</button></p>

      <div class="sc-scan" data-sc-scan hidden aria-hidden="true">
        <svg class="sc-scan__ring" viewBox="0 0 160 160" data-sc-scan-ring></svg>
        <div>
          <p class="sc-scan__k">Controlliamo</p>
          <p class="sc-scan__t" data-sc-scan-t></p>
        </div>
      </div>
      <ol class="sc-steps sc-visually-hidden" data-sc-steps hidden aria-live="polite">
        <li>Apriamo la pagina</li>
        <li>Leggiamo cosa c'è: contatti, orari, prezzi, dati per Google</li>
        <li>Misuriamo la velocità da telefono (può servire fino a un minuto)</li>
        <li>Calcoliamo il punteggio</li>
      </ol>
    </div>
  </section>

  <section class="sc-report" data-sc-result hidden aria-labelledby="sc-res-t" tabindex="-1">
    <div class="wrap">
      <p class="sc-sample-note" data-sc-sample-note hidden>Esempio su un sito inventato: numeri e pagina non sono di nessuna attività reale.</p>

      <header class="sc-rhead sc-in">
        <div>
          <p class="sc-rhead__k">Report del sito</p>
          <h2 id="sc-res-t" class="sc-rhead__url" data-sc-url></h2>
          <p class="sc-rhead__meta" data-sc-meta></p>
        </div>
        <div class="sc-rhead__tools sc-noprint">
          <div class="field sc-top__sector">
            <label for="sc-sector-now">Valutato come</label>
            <select id="sc-sector-now" data-sc-sector-now>
              {sectors.map((s) => <option value={s.id}>{s.label}</option>)}
            </select>
          </div>
          <button type="button" class="link sc-linkbtn" data-sc-print>Stampa o salva in PDF</button>
        </div>
      </header>

      <div class="sc-grid">
        <article class="sc-card sc-card--score sc-in" aria-labelledby="sc-score-t">
          <h3 id="sc-score-t" class="sc-card__k">Punteggio</h3>
          <div class="sc-gauge">
            <div class="sc-ring" data-sc-ring role="img">
              <svg viewBox="0 0 200 200" data-sc-arcs></svg>
              <div class="sc-ring__c" aria-hidden="true">
                <p class="sc-ring__n" data-sc-total>0</p>
                <p class="sc-ring__w" data-sc-verdict></p>
              </div>
            </div>
            <ul class="sc-legend" data-sc-cats></ul>
          </div>
        </article>

        <article class="sc-card sc-card--sum sc-in" aria-labelledby="sc-sum-t">
          <h3 id="sc-sum-t" class="sc-card__k">In sintesi</h3>
          <p class="sc-sum" data-sc-summary></p>
          <dl class="sc-hl" data-sc-highlights></dl>
          <p class="sc-top__note" data-sc-note></p>
          <p class="sc-top__bands">Fasce: sotto 50 molto da sistemare, da 50 a 74 discreto, da 75 a 89 buono, da 90 in su ottimo.</p>
        </article>
      </div>

      <article class="sc-card sc-in" data-sc-why></article>

      <article class="sc-card sc-in" aria-labelledby="sc-fix-t">
        <h3 id="sc-fix-t" class="sc-card__h">Le 5 cose che valgono più punti</h3>
        <p class="sc-climb" data-sc-climb></p>
        <ol class="sc-fixes" data-sc-fixes></ol>
      </article>

      <article class="sc-card sc-in" data-sc-flags-wrap aria-labelledby="sc-flag-t">
        <h3 id="sc-flag-t" class="sc-card__h">Da verificare con chi ti segue</h3>
        <p class="sc-sub">Non sono voti e non tolgono punti: sono informazioni che un commercialista o un consulente può confermare.</p>
        <ul class="sc-flags" data-sc-flags></ul>
      </article>

      <details class="sc-card sc-all sc-in">
        <summary>Tutti i controlli, uno per uno</summary>
        <div data-sc-all></div>
      </details>
    </div>
  </section>

  <section class="section section--sole sc-offer" data-sc-offer hidden aria-labelledby="sc-offer-t">
    <div class="wrap">
      <div class="hs-head">
        <h2 id="sc-offer-t">Cosa possiamo fare noi</h2>
        <p class="lead" data-sc-proj-lead></p>
      </div>
      <div class="sc-proj" data-sc-proj></div>
      <ul class="hs-price__plans sc-plans" data-sc-plans></ul>
      <p class="sc-reason" data-sc-reason></p>
      <div class="sc-care" data-sc-care></div>
    </div>
  </section>

  <section class="section sc-cta" data-sc-cta hidden aria-labelledby="sc-cta-t">
    <div class="wrap sc-cta__in">
      <div>
        <h2 id="sc-cta-t">Vuoi vedere il tuo sito rifatto, prima di decidere?</h2>
        <p class="lead">Lasciaci l'email: prepariamo un'anteprima gratuita del tuo nuovo sito e te la mandiamo insieme a questi risultati. Nessun impegno, nessuna newsletter.</p>
      </div>
      <form class="sc-lead" data-sc-lead novalidate>
        <div class="field">
          <label for="sc-email">La tua email</label>
          <input id="sc-email" name="email" type="email" autocomplete="email" required aria-describedby="sc-lead-error" />
        </div>
        <input type="text" name="website" class="sc-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="check">
          <input type="checkbox" name="consent" data-sc-consent />
          <span>{CONSENT.text.replace(" Ho letto l'informativa privacy.", "")} Ho letto l'<a class="link" href="/privacy/" target="_blank" rel="noopener">informativa privacy</a>.</span>
        </label>
        <button class="btn btn--primary btn--big" type="submit">Voglio l'anteprima gratuita</button>
        <p class="error" id="sc-lead-error" role="alert" data-sc-lead-error></p>
        <p class="sc-lead__ok" data-sc-lead-ok hidden role="status">Fatto. Ti scriviamo entro due giorni lavorativi con l'anteprima.</p>
      </form>
    </div>
  </section>

  <section class="section section--pietra sc-method" aria-labelledby="sc-method-t">
    <div class="wrap sc-method__in">
      <h2 id="sc-method-t">Come calcoliamo il punteggio</h2>
      <div class="sc-method__cols">
        <div>
          <h3>Stessa pagina, stesso punteggio</h3>
          <p>Usiamo {checkCount} controlli automatici, scritti in una griglia pubblica (versione {rubric.version}). Ogni controllo vale dei punti e dice cosa ha trovato. Per la velocità usiamo i dati delle persone che visitano davvero il sito, quando Google li ha; altrimenti una prova da telefono letta in fasce larghe, così il risultato non cambia da una volta all'altra per pochi millisecondi.</p>
        </div>
        <div>
          <h3>Ogni settore ha la sua griglia</h3>
          <p>Un ristorante ha bisogno del menu, un'impresa edile dei lavori fatti, un B&amp;B della prenotazione diretta. Le basi (velocità, Google, legale) sono uguali per tutti; il resto cambia con il settore. Se il tuo non c'è, scegli "Altro": controlliamo solo quello che serve a qualsiasi attività.</p>
        </div>
        <div>
          <h3>Cosa non possiamo vedere</h3>
          <p>Non sappiamo quante richieste ricevi, e nessun punteggio te le promette. Non diciamo se sei in regola con la legge: segnaliamo solo cosa si vede sulla pagina. Guardiamo la pagina che indichi, non tutto il sito.</p>
        </div>
      </div>
      <p class="sc-method__self">Lo usiamo anche su di noi: i nostri siti d'esempio devono fare almeno 90, e lo controlliamo a ogni modifica.</p>
    </div>
  </section>

  <script type="application/json" id="sc-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { initScorer } from "../../scripts/scorer-ui";
  initScorer();
</script>

<style is:global>
  .sc-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .sc-mini {
    background: var(--blu);
    color: #fff;
    border-radius: 24px;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: grid;
    gap: 0.5rem;
    max-width: 26rem;
    justify-self: end;
    align-self: center;
    width: 100%;
  }
  .sc-mini .link {
    color: #fff;
  }
  .sc-mini__k {
    color: var(--on-dark-muted);
    font-weight: 600;
  }
  .sc-mini__n {
    font-weight: 800;
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .sc-mini__n small {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0;
    margin-left: 0.5rem;
  }
  .sc-mini__t {
    font-weight: 600;
  }

  .sc-tool {
    padding-top: 0 !important;
  }
  .sc-form {
    display: grid;
    gap: 1rem;
    background: var(--nebbia);
    border: 1px solid var(--filo);
    border-radius: 24px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  @media (min-width: 900px) {
    .sc-form {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) auto;
      align-items: start;
    }
    .sc-form__go {
      margin-top: 1.9rem;
    }
    .sc-form__error {
      grid-column: 1 / -1;
    }
  }
  .sc-form .field {
    margin: 0;
  }
  .sc-form__error:empty,
  .sc-lead .error:empty {
    display: none;
  }
  .sc-privacy {
    color: var(--grafite);
    margin-top: 1rem !important;
    max-width: 70ch;
  }
  .sc-sample-row {
    margin-top: 0.25rem !important;
  }
  .sc-linkbtn {
    background: none;
    border: 0;
    padding: 0.6rem 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .sc-real {
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
    max-width: 30rem;
    padding: 1rem 1.25rem;
    border: 2px dashed var(--blu);
    border-radius: 16px;
  }
  .sc-real__k {
    font-weight: 600;
    color: var(--blu);
  }
  .sc-real label {
    font-weight: 600;
  }
  .sc-real__pick {
    min-height: 48px;
    border: 1px solid var(--filo);
    border-radius: 10px;
    padding: 0 0.75rem;
    font: inherit;
  }
  .sc-steps {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .sc-steps li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--grafite);
  }
  .sc-steps li::before {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--filo);
    flex: none;
  }
  .sc-steps li.is-now {
    color: var(--inchiostro);
    font-weight: 600;
  }
  .sc-steps li.is-now::before {
    border-color: var(--blu);
    background: var(--blu);
  }
  .sc-steps li.is-done::before {
    border-color: var(--blu);
    background: var(--pesca);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-steps li.is-now::before {
      animation: sc-pulse 1.2s var(--ease-out) infinite;
    }
    @keyframes sc-pulse {
      50% {
        transform: scale(1.35);
        opacity: 0.6;
      }
    }
  }

  .sc-result {
    outline: none;
  }
  .sc-sample-note {
    background: var(--pesca);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-weight: 600;
    margin-bottom: 1.5rem !important;
  }
  .sc-top {
    display: grid;
    gap: 2rem;
    align-items: center;
    background: var(--blu);
    color: #fff;
    border-radius: 28px;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    --inchiostro: #fff;
    --grafite: var(--on-dark-muted);
    --filo: rgba(255, 255, 255, 0.22);
  }
  .sc-top h2 {
    color: #fff;
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.8rem);
  }
  .sc-top .link,
  .sc-top label {
    color: #fff;
  }
  .sc-top select {
    color: var(--notte);
  }
  .sc-top__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    font-size: 0.95rem;
    color: var(--on-dark-muted);
  }
  .sc-dot {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    margin-right: -0.5rem;
    vertical-align: -0.05rem;
  }
  .sc-dot--pass,
  .sc-seg--pass {
    background: #5fd68e;
    stroke: #5fd68e;
  }
  .sc-dot--partial,
  .sc-seg--partial {
    background: #ffc857;
    stroke: #ffc857;
  }
  .sc-dot--fail,
  .sc-seg--fail {
    background: #ff7a6b;
    stroke: #ff7a6b;
  }
  .sc-dot--unmeasured,
  .sc-seg--unmeasured {
    background: rgba(255, 255, 255, 0.28);
    stroke: rgba(255, 255, 255, 0.28);
  }
  [data-sc-segs] circle,
  [data-sc-scan-ring] circle {
    fill: none;
    stroke-width: 16;
  }
  [data-sc-segs] {
    overflow: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-anim .sc-seg {
      opacity: 0;
      transition: opacity 0.35s var(--ease-out);
      transition-delay: calc(var(--i) * 45ms);
    }
    .sc-anim.is-in .sc-seg {
      opacity: 1;
    }
    .sc-scan__seg {
      animation: sc-blink 1.6s var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 64ms);
    }
    @keyframes sc-blink {
      0%,
      100% {
        opacity: 0.25;
      }
      40% {
        opacity: 1;
      }
    }
  }
  .sc-scan {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    background: var(--blu);
    color: #fff;
    border-radius: 24px;
    padding: 1.5rem;
  }
  .sc-scan[hidden] {
    display: none;
  }
  .sc-scan__ring {
    width: 96px;
    height: 96px;
    flex: none;
    transform: rotate(-90deg);
  }
  .sc-scan__seg {
    stroke: rgba(255, 255, 255, 0.85);
  }
  .sc-scan__k {
    color: var(--on-dark-muted);
    font-weight: 600;
  }
  .sc-scan__t {
    font-weight: 700;
    font-size: 1.2rem;
    min-height: 2.6em;
  }
  .sc-climb {
    font-weight: 700;
    font-size: 1.15rem;
    margin-top: 0.5rem !important;
  }
  .sc-climb strong {
    color: var(--blu);
    font-size: 1.4em;
  }
  .sc-fix__run {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--grafite);
    margin-top: 0.25rem;
  }
  .sc-compare {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .sc-compare__n {
    font-size: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
    letter-spacing: -0.03em;
  }
  .sc-compare__n small {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--on-dark-muted);
    margin-top: 0.4rem;
  }
  .sc-compare__arrow {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    color: var(--fuoco);
  }
  @media (min-width: 760px) {
    .sc-top {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .sc-ring {
    position: relative;
    width: min(240px, 64vw);
    aspect-ratio: 1;
    margin: 0;
  }
  .sc-ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .sc-ring__n {
    color: #fff;
  }
  .sc-ring circle {
    fill: none;
    stroke-width: 14;
  }
  .sc-ring__bg {
    stroke: var(--filo);
  }
  .sc-ring__fg {
    stroke: var(--sc-c, var(--blu));
    stroke-linecap: round;
    stroke-dasharray: 439.82;
    stroke-dashoffset: 439.82;
  }
  .sc-ring__n {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    font-weight: 800;
    font-size: clamp(3.5rem, 2.5rem + 3vw, 4.75rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sc-ring__n small {
    font-size: 1rem;
    font-weight: 600;
    color: var(--grafite);
    margin-top: 0.35rem;
  }
