---
/**
 * /analisi-sito/: the free site report, as designed in Claude Design ("Analisi del sito v4",
 * Lorenzo, 21 Nov 2026) and wired to the real engine. Four states: start, waiting, report, error.
 * /api/score fetches the page safely, measures speed and returns the report for every sector; the
 * client (scripts/scorer-ui.ts) draws it. Reports are private: shown only to whoever asked.
 * The two examples are computed at build time from INVENTED pages, and say so.
 */
import Base from "../../layouts/Base.astro";
import { rubric } from "../../scorer/analyze";
import { resolveRubric } from "../../scorer/sectors";
import offer from "../../scorer/offer.json";
import benchmark from "../../scorer/benchmark.json";
import { CONSENT } from "../../scorer/consent";
import { breadcrumbs } from "../../lib/schema";
import { sample, sampleGood } from "../../scorer/samples";

const sectors = rubric.sectors.map((s) => ({ id: s.id, label: s.label }));
// For the waiting ring: each sector's categories, weights and check titles.
const skeleton = Object.fromEntries(
  rubric.sectors.map((s) => {
    const r = resolveRubric(rubric, s.id);
    return [s.id, r.categories.filter((c) => c.weight > 0).map((c) => ({ id: c.id, label: c.label, weight: c.weight, checks: r.checks.filter((x) => x.category === c.id && x.points > 0).map((x) => x.title) }))];
  }),
);
const checkCount = resolveRubric(rubric, "fitness").checks.filter((c) => c.points > 0).length;
const data = { sectors, offer, benchmark, consent: CONSENT, sample, sampleGood, skeleton, checkCount, rubricVersion: rubric.version };
---
<Base
  title="Quanto lavora il tuo sito? Analisi gratuita | Focus Design"
  description="Incolla l'indirizzo: apriamo il sito come un cliente dal telefono, facciamo i controlli e ti diamo un voto su 100, con cosa sistemare per primo. Gratis."
  jsonLd={[breadcrumbs([{ name: "Analisi del sito", path: "/analisi-sito/" }])]}
  bodyClass="az-page"
>
  <!-- Start -->
  <section class="az-screen az-narrow" data-az-screen="inizio" aria-labelledby="az-h1">
    <div class="az-stack az-stack--40">
      <div class="az-stack az-stack--16">
        <h1 id="az-h1" class="az-mega">Quanto lavora il tuo sito?</h1>
        <p class="az-lead">Apriamo il sito come un cliente dal telefono, facciamo {checkCount} controlli e ti diamo un voto su 100.</p>
      </div>
      <form class="az-stack az-stack--12" data-az-form novalidate>
        <label for="az-url" class="sr-only">Indirizzo del sito</label>
        <div class="az-row">
          <input id="az-url" name="url" class="az-input" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder="www.nomeattivita.it" aria-describedby="az-url-err" />
          <button type="submit" class="az-btn"><span>Analizza</span><span aria-hidden="true">→</span></button>
        </div>
        <p id="az-url-err" class="az-err" role="alert" data-az-url-err hidden></p>
        <div class="az-inline">
          <label for="az-sector">Settore</label>
          <select id="az-sector" name="sector" class="az-select">
            <option value="">Automatico</option>
            {sectors.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </div>
      </form>
      <div class="az-inline az-examples">
        <span>Vedi un esempio:</span>
        <a href="#voto-12" data-az-sample="old">voto {sample.results.fitness.report.total}</a>
        <a href="#voto-97" data-az-sample="good">voto {sampleGood.results.fitness.report.total}</a>
      </div>
      <p class="az-note">Il risultato lo vedi solo tu: non lo pubblichiamo e non salviamo la pagina.</p>
    </div>
  </section>

  <!-- Waiting -->
  <section class="az-screen az-narrow az-center" data-az-screen="attesa" hidden aria-live="polite">
    <p class="az-mono" data-az-wait-url></p>
    <div class="az-wait-ring"><svg viewBox="0 0 300 300" aria-hidden="true" data-az-wait-ring></svg></div>
    <p class="az-wait-cat" data-az-wait-cat></p>
    <div class="az-wait-check" data-az-wait-check></div>
    <button type="button" class="az-linkbtn" data-az-restart>Annulla</button>
  </section>

  <!-- Error -->
  <section class="az-screen az-narrow" data-az-screen="errore" hidden aria-labelledby="az-err-t">
    <div class="az-stack az-stack--20">
      <p class="az-mono" data-az-err-url></p>
      <h1 id="az-err-t" class="az-h1" data-az-err-title></h1>
      <p class="az-err-text" data-az-err-text></p>
      <p class="az-err-todo" data-az-err-todo></p>
      <div><button type="button" class="az-btn az-btn--56" data-az-restart><span>Riprova con un altro indirizzo</span><span aria-hidden="true">→</span></button></div>
    </div>
  </section>

  <!-- Report -->
  <div data-az-screen="report" hidden>
    <main class="az-report" aria-labelledby="az-rep-t">
      <p class="az-sample" data-az-sample-note hidden>Esempio su un sito inventato: numeri e pagina non sono di nessuna attività reale.</p>

      <section class="az-stack az-stack--14" data-parte="testata">
        <h1 id="az-rep-t" class="az-url" data-az-url></h1>
        <div class="az-meta">
          <span data-az-meta></span>
          <label for="az-sector-now" class="sr-only">Valutato come</label>
          <select id="az-sector-now" class="az-select az-select--40" data-az-sector-now>
            {sectors.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
          <button type="button" class="az-ghost az-noprint" data-az-print>Stampa o salva in PDF</button>
          <button type="button" class="az-ghost az-noprint" data-az-restart>Nuova analisi</button>
        </div>
        <p class="az-small" data-az-note></p>
      </section>

      <section class="az-score" data-parte="voto">
        <div class="az-score__ring">
          <div class="az-ring" role="img" data-az-ring-wrap>
            <svg viewBox="0 0 300 300" aria-hidden="true" data-az-ring></svg>
            <div class="az-ring__c" aria-hidden="true">
              <span class="az-ring__n" data-az-total>0</span>
              <span class="az-ring__w" data-az-verdict></span>
              <span class="az-ring__s">su 100</span>
            </div>
          </div>
        </div>
        <ul class="az-cats" data-az-cats></ul>
      </section>

      <p class="az-sintesi" data-parte="sintesi" data-az-summary></p>

      <section class="az-stack az-stack--24" data-parte="correzioni" data-az-fixes-wrap>
        <div class="az-split">
          <h2 class="az-h2" data-az-fixes-title>Da sistemare per prime</h2>
          <p class="az-climb"><span data-az-climb-from></span> <span class="az-blue">→ <span data-az-climb-to></span></span></p>
        </div>
        <ol class="az-fixes" data-az-fixes></ol>
      </section>

      <section class="az-stack az-stack--12" data-parte="avvisi" data-az-flags-wrap>
        <h2 class="az-h-small">Da verificare · non tolgono punti</h2>
        <ul class="az-flags" data-az-flags></ul>
      </section>

      <section class="az-stack az-stack--20" data-parte="controlli">
        <h2 class="az-h2">Tutti i controlli</h2>
        <div class="az-allcats" data-az-all></div>
      </section>
    </main>

    <section class="az-offer" data-parte="offerta" aria-labelledby="az-offer-t">
      <div class="az-offer__in">
        <h2 id="az-offer-t" class="sr-only">Cosa possiamo fare noi</h2>
        <p class="az-compare" data-az-compare></p>
        <p class="az-compare-note" data-az-compare-note></p>
        <div class="az-packs" data-az-packs></div>
        <p class="az-reason" data-az-reason></p>
        <p class="az-care">{offer.care.line}</p>
      </div>
    </section>

    <section class="az-invite" data-parte="invito" aria-labelledby="az-inv-t">
      <h2 id="az-inv-t" class="az-h1">Vuoi vedere come diventerebbe?</h2>
      <p class="az-lead az-lead--19">Ti mandiamo gratis un'anteprima della prima pagina rifatta. Decidi dopo.</p>
      <p class="az-sent" role="status" data-az-sent hidden></p>
      <form class="az-stack az-stack--14 az-noprint" data-az-lead novalidate>
        <label for="az-email" class="sr-only">La tua email</label>
        <div class="az-row">
          <input id="az-email" name="email" class="az-input az-input--18" type="email" autocomplete="email" placeholder="La tua email" aria-describedby="az-lead-err" />
          <button type="submit" class="az-btn"><span>Invia</span><span aria-hidden="true">→</span></button>
        </div>
        <input type="text" name="website" class="az-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="az-consent">
          <input type="checkbox" name="consent" data-az-consent />
          <span>{CONSENT.text} <a href="/privacy/">Informativa privacy</a></span>
        </label>
        <p id="az-lead-err" class="az-err" role="alert" data-az-lead-err hidden></p>
      </form>
    </section>
  </div>

  <script type="application/json" id="az-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { initScorer } from "../../scripts/scorer-ui";
  initScorer();
</script>

<style is:global>
  .az-page main#contenuto,
  .az-page {
    --az-ink: #1d1d1f;
    --az-soft: #6e6e73;
    --az-grey: #f5f5f7;
    --az-line: #e8e8ed;
    --az-blue: #0071e3;
    --az-blue-h: #0077ed;
    --az-link: #0066cc;
    --az-track: #ededf0;
  }
  .az-page [hidden] {
    display: none !important;
  }
  .az-screen {
    padding: 72px 20px 120px;
  }
  .az-narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .az-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
    padding-top: 56px;
  }
  .az-stack {
    display: flex;
    flex-direction: column;
  }
  .az-stack--40 { gap: 40px; }
  .az-stack--24 { gap: 24px; }
  .az-stack--20 { gap: 20px; }
  .az-stack--16 { gap: 16px; }
  .az-stack--14 { gap: 14px; }
  .az-stack--12 { gap: 12px; }
  .az-mega {
    margin: 0;
    font-weight: 600;
    font-size: clamp(48px, 9vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .az-h1 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(40px, 7vw, 64px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .az-h2 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(30px, 4.5vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .az-h-small {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--az-soft);
    letter-spacing: 0;
  }
  .az-lead {
    margin: 0;
    font-size: 20px;
    color: var(--az-soft);
  }
  .az-lead--19 {
    font-size: 19px;
    margin-top: -12px !important;
  }
  .az-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .az-input {
    flex: 1 1 280px;
    height: 60px;
    padding: 0 20px;
    border: 0;
    border-radius: 14px;
    font: inherit;
    font-size: 19px;
    color: var(--az-ink);
    background: var(--az-grey);
    outline: none;
  }
  .az-input--18 {
    flex-basis: 260px;
    font-size: 18px;
  }
  .az-input:focus-visible {
    box-shadow: 0 0 0 2px var(--az-ink);
  }
  .az-input[aria-invalid="true"] {
    box-shadow: 0 0 0 2px #c2261b;
  }
  .az-btn {
    flex: 0 0 auto;
    height: 60px;
    padding: 0 26px;
    border: 0;
    border-radius: 14px;
    background: var(--az-blue);
    color: #fff;
    font: inherit;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .az-btn--56 {
    height: 56px;
    padding: 0 24px;
  }
  .az-btn:focus-visible {
    outline: 2px solid var(--az-ink);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .az-btn:hover {
      background: var(--az-blue-h);
    }
