    font-size: 15px;
  }
  .az-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: 15px;
    color: var(--az-soft);
  }
  .az-select {
    height: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-size: 15px;
    color: var(--az-ink);
    background: var(--az-grey);
    max-width: 100%;
  }
  .az-select--40 {
    height: 40px;
  }
  .az-examples a,
  .az-page a.az-link,
  .az-consent a {
    color: var(--az-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .az-examples a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .az-note {
    margin: 0;
    font-size: 15px;
    color: var(--az-soft);
  }
  .az-real {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 20px;
    border-radius: 14px;
    background: var(--az-grey);
    font-size: 15px;
  }
  .az-mono {
    margin: 0;
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 14px;
    color: var(--az-soft);
    overflow-wrap: anywhere;
  }
  .az-linkbtn {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--az-link);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  .az-wait-ring {
    width: min(100%, 260px);
    aspect-ratio: 1;
  }
  .az-wait-cat {
    margin: 0 0 -16px;
    font-size: 15px;
    color: var(--az-soft);
  }
  .az-wait-check {
    min-height: 64px;
    font-weight: 600;
    font-size: clamp(24px, 4.5vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 520px;
  }
  .az-wait-check > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .az-wait-check > span {
      animation: azIn 420ms ease both;
    }
  }
  @keyframes azIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .az-err-text {
    margin: 0;
    font-size: 19px;
    max-width: 560px;
  }
  .az-err-todo {
    margin: 0;
    font-size: 17px;
    color: var(--az-soft);
    max-width: 560px;
  }

  /* Report */
  .az-report {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px 20px 0;
    display: flex;
    flex-direction: column;
    gap: 96px;
  }
  .az-sample {
    margin: 24px 0 -72px;
    padding: 12px 16px;
    border-radius: 14px;
    background: #e8f1fd;
    color: #0058b0;
    font-size: 15px;
    font-weight: 500;
  }
  .az-url {
    margin: 0;
    font-weight: 600;
    font-size: clamp(36px, 6.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .az-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-size: 15px;
    color: var(--az-soft);
  }
  .az-ghost {
    height: 40px;
    padding: 0 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--az-soft);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    .az-ghost:hover {
      background: var(--az-grey);
      color: var(--az-ink);
    }
  }
  .az-small {
    margin: 0;
    font-size: 15px;
    color: var(--az-soft);
    max-width: 720px;
  }
  .az-small:empty {
    display: none;
  }
  .az-score {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 48px 80px;
    align-items: center;
    margin-top: -48px;
  }
  .az-score__ring {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .az-ring {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 1;
  }
  .az-ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .az-ring__c {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .az-ring__n {
    font-weight: 600;
    font-size: clamp(96px, 22vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }
  .az-ring__w {
    font-size: 17px;
    font-weight: 500;
    margin-top: 10px;
  }
  .az-ring__s {
    font-size: 13px;
    color: var(--az-soft);
    margin-top: 2px;
  }
  .az-cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .az-cat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .az-cat__top {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .az-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
    align-self: center;
  }
  .az-cat__name {
    flex: 1;
    font-weight: 500;
  }
  .az-num {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 14px;
    color: var(--az-soft);
    white-space: nowrap;
  }
  .az-num b {
    color: var(--az-ink);
    font-weight: 400;
  }
