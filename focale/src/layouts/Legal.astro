---
import Base from "./Base.astro";
import { fillHtml } from "../lib/util";
import { breadcrumbs } from "../lib/schema";
import type { LegalDoc } from "../lib/legal";
interface Props {
  doc: LegalDoc;
  pageTitle: string;
  description: string;
  path: string;
}
const { doc, pageTitle, description, path } = Astro.props;
---
<Base title={pageTitle} description={description} jsonLd={[breadcrumbs([{ name: doc.title, path }])]}>
  <article class="lg">
    <div class="wrap">
      <header data-hero>
        <h1>{doc.title}</h1>
        <p class="lg-date">Ultimo aggiornamento: <Fragment set:html={fillHtml("{legalLastUpdated}")} /></p>
      </header>
      <div class="lg-body prose">
        {doc.intro.map((p) => <p set:html={fillHtml(p)} />)}
        {
          doc.sections.map((s) => (
            <section>
              {s.h && <h2>{s.h}</h2>}
              {s.p.map((p) => (
                <p set:html={fillHtml(p)} />
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </article>
</Base>
<style>
  .lg {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--space-section);
  }
  .lg-date {
    margin-top: 1.5rem;
    color: var(--grafite);
    font-size: var(--fs-small);
  }
  .lg-body {
    margin-top: 3rem;
    max-width: var(--measure);
  }
  .lg-body h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    margin: 3rem 0 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--filo);
  }
  .lg-body p {
    color: #33312d;
  }
  .lg-body p + p {
    margin-top: 1em;
  }
</style>
