---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { site } from "../config/site";
import { absUrl } from "../lib/util";
import { ogKey } from "../lib/og";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  sticky?: boolean;
  minimal?: boolean;
  og?: string;
  bodyClass?: string;
}
const { title, description, noindex = false, jsonLd = [], sticky = true, minimal = false, og, bodyClass } = Astro.props;
const path = Astro.url.pathname;
const canonical = absUrl(path === "/" ? "/" : path.replace(/\/?$/, "/"));
const ogImage = absUrl(`/og/${og ?? ogKey(path)}.png`);
const isDev = import.meta.env.DEV;
const showSticky = sticky && !minimal;
---
<!doctype html>
<html lang="it" class={isDev ? "is-dev" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href="/fonts/schibsted-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" />
    <!-- Light only: stops Chrome's auto dark theme (and asks Samsung Internet) from recolouring the site. -->
    <meta name="color-scheme" content="light only" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, { "has-sticky": showSticky }]}>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <Header minimal={minimal} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    {!minimal && <Footer />}
    {minimal && <slot name="footer" />}
    {showSticky && <StickyBar />}
    <script is:inline>
      /* Every page opens at the top. A link to the page you are on scrolls back up instead of reloading
         (a reload would keep you at the bottom). Inside a frame (the preview link) the frame is brought to
         the top too. Back and forward keep the browser's own scroll memory. */
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
        if (window.top !== window && !location.hash && !(nav && nav.type === "back_forward")) {
          try {
            document.documentElement.scrollIntoView({ block: "start" });
          } catch (e) {}
        }
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest && e.target.closest("a[href]");
          if (!a || a.target === "_blank" || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var url = new URL(a.href, location.href);
          var here = function (p) { return p.replace(/(index\.html)?$/, "").replace(/\/$/, ""); };
          if (url.origin !== location.origin || here(url.pathname) !== here(location.pathname) || url.hash) return;
          e.preventDefault();
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        });
      })();
    </script>
    <script>
      import { initFocusMotif } from "../scripts/focus";
      import { later } from "../scripts/later";
      initFocusMotif();
      later(() => import("../scripts/smooth").then((m) => m.initSmoothScroll()));
      later(() => import("../scripts/motion").then((m) => m.initMotion()));
      later(() => import("../scripts/inner").then((m) => m.initInner()));
    </script>
    {
      site.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cfBeaconToken })}
        />
      )
    }
  </body>
</html>
<style>
  main:focus {
    outline: none;
  }
</style>
