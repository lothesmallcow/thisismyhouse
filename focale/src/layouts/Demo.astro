---
/** Layout for the demo sites of invented businesses: their own look, a slim Focus Design banner, noindex. */
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  lang?: string;
  fonts?: string[];
  themeColor?: string;
  bodyClass?: string;
}
const { title, description, lang = "it", fonts = [], themeColor = "#1E3A2C", bodyClass } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Shown inside Focus Design's own pages (DemoViewer): no banner, it is already framed.
      if (window.self !== window.top) document.documentElement.classList.add("in-frame");
    </script>
  </head>
  <body class:list={["demo", bodyClass]}>
    <div class="demo-banner on-dark">
      <p>Progetto dimostrativo di Focus Design per un'attività inventata. <a href="/lavori/">Torna a Focus Design</a></p>
    </div>
    <main>
      <slot />
    </main>
    <script>
      import { initDemoMotion } from "../scripts/demo-motion";
      // "Show more" lists: the button lives anywhere in the same section.
      document.querySelectorAll<HTMLElement>(".d-more").forEach((list) => {
        const btn = list.closest("section")?.querySelector<HTMLButtonElement>(".d-more-btn");
        if (!btn) return;
        list.classList.add("is-short");
        btn.classList.add("is-on");
        btn.addEventListener("click", () => {
          list.classList.remove("is-short");
          btn.remove();
        });
      });
      initDemoMotion();
    </script>
  </body>
</html>
<style is:global>
  /* The Focus Design banner sits on top; each demo's fixed header sits right under it. */
  body.demo {
    --banner: 40px;
  }
  @media (max-width: 600px) {
    /* The banner wraps to two lines on phones. */
    body.demo {
      --banner: 52px;
    }
  }
  .in-frame body.demo {
    --banner: 0px;
  }
  .in-frame .demo-banner {
    display: none;
  }
  .demo-banner {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    min-height: var(--banner);
    display: flex;
    align-items: center;
    padding: 0.35rem var(--gutter);
    background: var(--portone);
    color: var(--calce);
    font-family: var(--font-head);
    font-size: 0.875rem;
    line-height: 1.3;
    box-sizing: border-box;
  }
  .demo-banner a {
    color: var(--calce);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-block;
    padding: 0.4rem 0;
  }
  /* ---------- Motion kit (scripts/demo-motion.ts) ---------- */
  [data-dh] {
    position: fixed;
    top: var(--banner);
    left: 0;
    right: 0;
    z-index: 90;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      color 0.35s ease;
  }
  [data-dh].is-hidden {
    transform: translateY(calc(-100% - var(--banner)));
  }
  [data-menu-panel][hidden] {
    display: none;
  }
  .dm-menu-open,
  .dm-menu-open body {
    overflow: hidden;
  }
  /* Highlighter stroke under words; drawn with the scroll when motion is on. */
  [data-mark] {
    background-image: linear-gradient(var(--mark, rgba(255, 210, 90, 0.7)), var(--mark, rgba(255, 210, 90, 0.7)));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 38%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  /* Stacking cards: each sticks a little lower than the one before. */
  @media (min-width: 900px) {
    [data-stack] > * {
      position: sticky;
      top: calc(var(--banner) + 96px + var(--i, 0) * 18px);
    }
  }
  /* Scroll cue in heroes */
  .dm-cue {
    display: inline-block;
    width: 1px;
    height: 54px;
    background: currentColor;
    opacity: 0.6;
    transform-origin: top;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dm-cue {
      animation: dm-cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    @keyframes dm-cue {
      0% {
        transform: scaleY(0);
        transform-origin: top;
      }
      45% {
        transform: scaleY(1);
        transform-origin: top;
      }
      55% {
        transform: scaleY(1);
        transform-origin: bottom;
      }
      100% {
        transform: scaleY(0);
        transform-origin: bottom;
      }
    }
  }
  /* Pictures: a slow zoom on hover (mouse only). */
  @media (hover: hover) and (pointer: fine) {
    .dm-zoom {
      overflow: hidden;
    }
    .dm-zoom img {
      transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .dm-zoom:hover img {
      transform: scale(1.06);
    }
  }
  .demo-banner p {
    margin: 0;
  }
  /* Phones: long lists become a row you swipe, the next card peeking in (no endless column). */
  @media (max-width: 760px) {
    body.demo :is(ul, ol).d-rail {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--rail-pad, 18px);
      margin-inline: calc(-1 * var(--rail-pad, 18px));
      padding-inline: var(--rail-pad, 18px);
      padding-bottom: 6px;
      scrollbar-width: none;
    }
    body.demo :is(ul, ol).d-rail::-webkit-scrollbar {
      display: none;
    }
    body.demo :is(ul, ol).d-rail > li {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
  /* Phones: only the first works, the rest behind a button (scripts below). */
  @media (max-width: 760px) {
    .d-more.is-short > :nth-child(n + 4) {
      display: none;
    }
  }
  .d-more-btn {
    display: none;
  }
  @media (max-width: 760px) {
    .d-more-btn.is-on {
      display: inline-flex;
    }
  }
</style>
