---
/** Layout for the demo sites of invented businesses: their own look, a slim Focus Design banner, noindex. */
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  lang?: string;
  fonts?: string[];
  themeColor?: string;
  bodyClass?: string;
}
const { title, description, lang = "it", fonts = [], themeColor = "#1E3A2C", bodyClass } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
  </head>
  <body class:list={["demo", bodyClass]}>
    <div class="demo-banner on-dark">
      <p>Progetto dimostrativo di Focus Design per un'attività inventata. <a href="/lavori/">Torna a Focus Design</a></p>
    </div>
    <main>
      <slot />
    </main>
    <script>
      // Soft reveal of section content as it scrolls in. Content is visible without JS and with reduced motion.
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
        const els = Array.from(document.querySelectorAll<HTMLElement>("main section:not(:first-of-type) :is(h2, li, figure, form, dl, p)"));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        const vh = window.innerHeight;
        els.forEach((el, i) => {
          if (el.getBoundingClientRect().top < vh) return;
          el.classList.add("d-rev");
          el.style.transitionDelay = `${(i % 4) * 60}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
<style is:global>
  body.demo {
    padding-top: 40px;
  }
  .demo-banner {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: 0.35rem var(--gutter);
    background: var(--portone);
    color: var(--calce);
    font-family: var(--font-head);
    font-size: 0.875rem;
    line-height: 1.3;
    box-sizing: border-box;
  }
  .demo-banner a {
    color: var(--calce);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-block;
    padding: 0.4rem 0;
  }
  .d-rev {
    transform: translateY(26px);
    filter: blur(6px);
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .d-rev.is-in {
    transform: none;
    filter: none;
  }
  .demo-banner p {
    margin: 0;
  }
</style>
