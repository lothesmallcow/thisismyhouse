---
/** Layout for the demo sites of invented businesses: their own look, a slim Focus Design banner, noindex. */
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  lang?: string;
  fonts?: string[];
  themeColor?: string;
  bodyClass?: string;
}
const { title, description, lang = "it", fonts = [], themeColor = "#1E3A2C", bodyClass } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Shown inside Focus Design's own pages (DemoViewer): no banner, it is already framed.
      if (window.self !== window.top) document.documentElement.classList.add("in-frame");
    </script>
  </head>
  <body class:list={["demo", bodyClass]}>
    <div class="demo-banner on-dark">
      <p>Progetto dimostrativo di Focus Design per un'attività inventata. <a href="/lavori/">Torna a Focus Design</a></p>
    </div>
    <main>
      <slot />
    </main>
    <script>
      document.querySelectorAll<HTMLElement>(".d-more").forEach((list) => {
        const btn = list.nextElementSibling as HTMLButtonElement | null;
        if (!btn?.classList.contains("d-more-btn")) return;
        list.classList.add("is-short");
        btn.addEventListener("click", () => {
          list.classList.remove("is-short");
          btn.remove();
        });
      });
      // Soft reveal of section content as it scrolls in. Content is visible without JS and with reduced motion.
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
        const els = Array.from(document.querySelectorAll<HTMLElement>("main section:not(:first-of-type) :is(h2, li, figure, form, dl, p)"));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        const vh = window.innerHeight;
        els.forEach((el, i) => {
          if (el.getBoundingClientRect().top < vh) return;
          el.classList.add("d-rev");
          el.style.transitionDelay = `${(i % 4) * 60}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
<style is:global>
  body.demo {
    padding-top: 40px;
  }
  .in-frame body.demo {
    padding-top: 0;
  }
  .in-frame .demo-banner {
    display: none;
  }
  .demo-banner {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    min-height: 40px;
    display: flex;
    align-items: center;
    padding: 0.35rem var(--gutter);
    background: var(--portone);
    color: var(--calce);
    font-family: var(--font-head);
    font-size: 0.875rem;
    line-height: 1.3;
    box-sizing: border-box;
  }
  .demo-banner a {
    color: var(--calce);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-block;
    padding: 0.4rem 0;
  }
  .d-rev {
    transform: translateY(26px);
    filter: blur(6px);
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .d-rev.is-in {
    transform: none;
    filter: none;
  }
  .demo-banner p {
    margin: 0;
  }
  /* Phones: long lists become a row you swipe, the next card peeking in (no endless column). */
  @media (max-width: 760px) {
    body.demo ul.d-rail {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--rail-pad, 18px);
      margin-inline: calc(-1 * var(--rail-pad, 18px));
      padding-inline: var(--rail-pad, 18px);
      padding-bottom: 6px;
      scrollbar-width: none;
    }
    body.demo ul.d-rail::-webkit-scrollbar {
      display: none;
    }
    body.demo ul.d-rail > li {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
  /* Phones: only the first works, the rest behind a button (scripts below). */
  @media (max-width: 760px) {
    .d-more.is-short > :nth-child(n + 4) {
      display: none;
    }
  }
  .d-more-btn {
    display: none;
  }
  @media (max-width: 760px) {
    .d-more.is-short + .d-more-btn {
      display: inline-flex;
    }
  }
</style>
