# Web3Forms access key (free at https://web3forms.com, created with Lorenzo's email).
# Without it the forms fall back to the prefilled WhatsApp message.
PUBLIC_WEB3FORMS_KEY=

# Optional: URL of the Google Apps Script web app that logs each request to a Google Sheet
# (see automation/README.md). Leave empty to disable.
PUBLIC_SHEETS_ENDPOINT=

# Optional: Cloudflare Web Analytics beacon token (Cloudflare dashboard > Analytics & Logs >
# Web Analytics > Add a site). Leave empty to load no analytics at all.
PUBLIC_CF_BEACON_TOKEN=
